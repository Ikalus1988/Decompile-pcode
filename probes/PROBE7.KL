PROGRAM PROBE7
%COMMENT = 'probe7 select case'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  SYM_SEL : INTEGER
BEGIN
  SYM_SEL = 3
  SELECT SYM_SEL OF
  CASE(3):
    SYM_SEL = 30
  CASE(5):
    SYM_SEL = 50
  ELSE:
    SYM_SEL = 99
  ENDSELECT
END PROBE7
