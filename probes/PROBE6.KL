PROGRAM PROBE6
%COMMENT = 'probe6 symbol table calibration'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  SYM_A : INTEGER
  SYM_B : INTEGER
  SYM_C : BOOLEAN
  SYM_D : STRING[7]
  SYM_E : ARRAY[3] OF INTEGER
  SYM_F : REAL
  SYM_G : FILE

ROUTINE SUBX(LOCP : INTEGER) : INTEGER
VAR
  LOCI : INTEGER
  LOCR : REAL
  LOCS : STRING[5]
  LOCB : BOOLEAN
BEGIN
  LOCI = 11
  LOCR = 2.5
  LOCS = 'LOCSTR'
  LOCB = TRUE
  LOCP = 22
  RETURN(LOCI)
END SUBX

BEGIN
  SYM_B = 3
  SYM_A = 4
  SYM_C = FALSE
  SYM_D = 'ABCDEFG'
  SYM_E[2] = 5
  SYM_F = 1.5
  OPEN FILE SYM_G('AP', 'FR:PROBE6.DT')
  CLOSE FILE SYM_G
  SYM_A = SUBX(SYM_A)
END PROBE6
