--------------------------------------------------------------------------------
-- 
-- xyz_sw_ta
-- 
-- brief: xyz_sw_ta,
--        switch task
--------------------------------------------------------------------------------
PROGRAM xyz_sw_ta


%COMMENT = 'switch task'
%ALPHABETIZE
%NOLOCKGROUP
%NOPAUSESHFT
%NOBUSYLAMP

%INCLUDE include\xyz_const
%INCLUDE include\xyz_pkt_t
%INCLUDE include\xyz_sock_t

CONST
    PARAM_NUM = 1

VAR
    ret         : INTEGER
    data_type   : INTEGER
    int_NA      : INTEGER
    real_NA     : REAL
    ta_codename : STRING[20]
    
%INCLUDE include\xyz_pkt_h
%INCLUDE include\xyz_sock_h
%INCLUDE include\xyz_log_h
%INCLUDE include\xyz_bkgd_h

BEGIN
GET_TPE_PRM(PARAM_NUM, data_type, int_NA, real_NA, ta_codename, ret)
IF (ret <> 0) OR (data_type <> 3) THEN
    log_error('[SW_FLW] get task codename')
ENDIF
ResetOutData
ret = AddInttoArr(CMD_SW_TA)
IF (ret <> 0) THEN
    log_error('[SW_FLW] fail to pack cmd')
ENDIF
ret = AddStrtoArr(ta_codename)
IF (ret <> 0) THEN
    log_error('[SW_FLW] pack task codename failed')
ENDIF
FLG[F_BKGD_COMM] = ON
WAIT FOR FLG[F_BKGD_COMM] = OFF
END xyz_sw_ta