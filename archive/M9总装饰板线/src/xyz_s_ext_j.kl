--------------------------------------------------------------------------------
-- 
-- xyz_s_ext_j
-- 
-- brief: xyz_s_joints,
--        send external joints
--------------------------------------------------------------------------------
PROGRAM xyz_s_ext_j


%COMMENT = 'send external joints'
%ALPHABETIZE
%NOLOCKGROUP
%NOPAUSESHFT
%NOBUSYLAMP

%INCLUDE include\xyz_const
%INCLUDE include\xyz_pkt_t
%INCLUDE include\xyz_sock_t

CONST
    PARAM_NUM = 1

VAR
    ret        :  INTEGER
    data_type  :  INTEGER
    joint_pose :  JOINTPOS
    reg_no     :  INTEGER
    real_NA    :  REAL
    str_NA     :  STRING[1]

%INCLUDE include\xyz_pkt_h
%INCLUDE include\xyz_sock_h
%INCLUDE include\xyz_log_h
%INCLUDE include\xyz_bkgd_h
BEGIN
GET_TPE_PRM(PARAM_NUM, data_type, reg_no, real_NA, str_NA, ret)
IF (ret <> 0) OR (data_type <> 1) THEN
    log_error('[S_EXT_J] fail to get reg number')
ENDIF
ResetOutData
joint_pose = GET_JPOS_REG(reg_no, ret)
IF (ret <> 0) THEN
    log_error('[S_EXT_J] fail to get joint pose')
ENDIF
ret = AddInttoArr(CMD_S_EXT_J)
IF (ret <> 0) THEN
    log_error('[S_EXT_J] fail to pack cmd')
ENDIF
ret = AddExtJtoArr(joint_pose)
IF (ret <> 0) THEN
    log_error('[S_EXT_J] fail to pack joint pose')
ENDIF
FLG[F_BKGD_COMM] = ON
WAIT FOR FLG[F_BKGD_COMM] = OFF
END xyz_s_ext_j