--------------------------------------------------------------------------------
-- 
-- xyz_c_g_pose
-- 
-- brief: xyz_c_g_pose,
--        calculate grasp pose result
--------------------------------------------------------------------------------
PROGRAM xyz_c_g_pose


%COMMENT = 'calculate grasp pose'
%ALPHABETIZE
%NOLOCKGROUP
%NOPAUSESHFT
%NOBUSYLAMP

%INCLUDE include\xyz_const
%INCLUDE include\xyz_pkt_t
%INCLUDE include\xyz_sock_t

CONST
    PARAM_NUM = 1

VAR
    ret      : INTEGER
    data_type: INTEGER
    vs_id    : INTEGER
    real_NA  : REAL
    str_NA   : STRING[1]

%INCLUDE include\xyz_pkt_h
%INCLUDE include\xyz_sock_h
%INCLUDE include\xyz_log_h
%INCLUDE include\xyz_bkgd_h

BEGIN
GET_TPE_PRM(PARAM_NUM, data_type, vs_id, real_NA, str_NA, ret)
IF (ret <> 0) OR (data_type <> 1) THEN
    log_error('[C_G_POSE] fail to get token')
ENDIF
ResetOutData
ret = AddInttoArr(CMD_C_G_POSE)
IF (ret <> 0) THEN
    log_error('[C_G_POSE] fail to pack cmd')
ENDIF
ret = AddInttoArr(vs_id)
IF (ret <> 0) THEN
    log_error('[C_G_POSE] fail to pack vs_id')
ENDIF
FLG[F_BKGD_COMM] = ON
WAIT FOR FLG[F_BKGD_COMM] = OFF
END xyz_c_g_pose