TYPE
    xyz_sock_t FROM xyz_sock = STRUCTURE
        type_        : STRING[1]        -- S on server, C on client
        connected_   : BOOLEAN
        status_      : INTEGER
        tag_idx_     : INTEGER
        tag_str_     : STRING[3]
        port_        : INTEGER
        host_        : STRING[30]
    ENDSTRUCTURE