--------------------------------------------------------------------------------
-- 
-- xyz_sw_item
-- 
-- brief: xyz_sw_item,
--        switch item
--------------------------------------------------------------------------------
PROGRAM xyz_sw_item


%COMMENT = 'switch item'
%ALPHABETIZE
%NOLOCKGROUP
%NOPAUSESHFT
%NOBUSYLAMP

%INCLUDE include\xyz_const
%INCLUDE include\xyz_pkt_t
%INCLUDE include\xyz_sock_t

CONST
    INT_PARAM = 1
    STR_PARAM = 2

VAR
    ret       : INTEGER
    data_type : INTEGER
    int_NA    : INTEGER
    vs_id     : INTEGER
    real_NA   : REAL
    item_name : STRING[20]
    str_NA    : STRING[1]
    
%INCLUDE include\xyz_pkt_h
%INCLUDE include\xyz_sock_h
%INCLUDE include\xyz_log_h
%INCLUDE include\xyz_bkgd_h

BEGIN
GET_TPE_PRM(INT_PARAM, data_type, vs_id, real_NA, str_NA, ret)
IF (ret <> 0) OR (data_type <> 1) THEN
    log_error('[SW_ITEM] fail to get vs_id')
ENDIF
GET_TPE_PRM(STR_PARAM, data_type, int_NA, real_NA, item_name, ret)
IF (ret <> 0) OR (data_type <> 3) THEN
    log_error('[SW_ITEM] fail to get flow name')
ENDIF
ResetOutData
ret = AddInttoArr(CMD_SW_ITEM)
IF (ret <> 0) THEN
    log_error('[SW_ITEM] fail to pack cmd')
ENDIF
ret = AddInttoArr(vs_id)
IF (ret <> 0) THEN
    log_error('[SW_ITEM] fail to pack vs_id')
ENDIF
ret = AddStrtoArr(item_name)
IF (ret <> 0) THEN
    log_error('[SW_ITEM] fail to pack item name')
ENDIF
FLG[F_BKGD_COMM] = ON
WAIT FOR FLG[F_BKGD_COMM] = OFF
END xyz_sw_item