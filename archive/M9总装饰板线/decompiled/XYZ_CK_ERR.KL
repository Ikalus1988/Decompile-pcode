-- XYZ_CK_ERR.KL (decompiled v3)
PROGRAM XYZ_CK_ERR
%COMMENT = 'check error code'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  REAL_FLAG : INTEGER
  ERR_CODE : INTEGER
  ERR_MSG : STRING[64]
  REAL_NA : REAL
  STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE LOG_CLEAR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_FORCE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  REAL_FLAG = 0
  ERR_CODE = 0
  ERR_MSG = ''
  GET_REG(40, (REAL_FLAG <> 0), ERR_CODE, REAL_NA, STATUS)
  -- Æú²ÎÔ­Ê½: REAL_FLAG
  IF ((STATUS <> 0)) THEN
  sv_i = LOG_ERROR('[CK_ERR] get err reg value failed')
  -- stmt41 stray sv_i
  ELSE
  CNV_INT_STR(ERR_CODE, 1, 10, ERR_MSG)
  ERR_MSG = 'error code:' + ERR_MSG
  IF ((ERR_CODE <> 0)) THEN
  POST_ERR(38092, ERR_MSG, 0, 2)
  ENDIF
  ENDIF
END XYZ_CK_ERR

