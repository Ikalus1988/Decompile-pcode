ROUTINE PRNT_TIME_ : INTEGER
VAR
  time_ : INTEGER
  tmp_ : STRING[64]
BEGIN
  GET_TIME(time_)
  IF (time_ <> 0) AND (65535 <> 0) THEN
    time_ = 1
  ELSE
    time_ = 0
  ENDIF
  CNV_INT_STR(time_, 4, 10, tmp_)
  WRITE(tmp_)
  RETURN(0)
END PRNT_TIME_

ROUTINE LOG_FORCE : INTEGER
BEGIN
  FORCE_SPMENU(1, 37, 1)
  RETURN(0)
END LOG_FORCE

ROUTINE LOG_CLEAR : INTEGER
VAR
  stat__ : FILE
BEGIN
  sv_i = CLEAR_WIN(stat__, 0)
  -- stmt102 stray sv_i
  sv_i = LOG_FORCE
  -- stmt103 stray sv_i
  RETURN(0)
END LOG_CLEAR

ROUTINE LOG_INFO(p0 : STRING) : INTEGER
BEGIN
  sv_i = PRNT_TIME_
  -- stmt119 stray sv_i
  WRITE(' I ', p0, CR)
  RETURN(0)
END LOG_INFO

