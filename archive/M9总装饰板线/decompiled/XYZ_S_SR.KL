-- XYZ_S_SR.KL (decompiled v3)
PROGRAM XYZ_S_SR
%COMMENT = 'set sr'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  DATA_TYPE : INTEGER
  SREG_ID : INTEGER
  REAL_NA : REAL
  STR_NA : STRING[64]
  RET : INTEGER
  INT_NA : INTEGER
  SR_VALUE : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE LOG_CLEAR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_FORCE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  GET_TPE_PRM(1, DATA_TYPE, SREG_ID, REAL_NA, STR_NA, RET)
  IF ((RET <> 0) OR (DATA_TYPE <> 1)) THEN
  sv_i = LOG_ERROR('[S_SR] fail to get sreg_id')
  -- stmt43 stray sv_i
  ENDIF
  GET_TPE_PRM(2, DATA_TYPE, INT_NA, REAL_NA, SR_VALUE, RET)
  IF ((RET <> 0) OR (DATA_TYPE <> 3)) THEN
  sv_i = LOG_ERROR('[S_SR] fail to get SR value')
  -- stmt47 stray sv_i
  ENDIF
  SET_STR_REG(SREG_ID, SR_VALUE, RET)
  IF ((RET <> 0)) THEN
  sv_i = LOG_ERROR('[S_SR] fail to set SR value')
  -- stmt51 stray sv_i
  ENDIF
END XYZ_S_SR

