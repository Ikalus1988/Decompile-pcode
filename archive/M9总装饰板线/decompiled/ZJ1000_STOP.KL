	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  ZJMAINRUN : INTEGER
  ZJMAINSTOP : INTEGER
  PORTNO1 : INTEGER
  PORTNO2 : INTEGER
  ERRCODE : INTEGER
  ZJFILE : FILE
  SOCKCFG : SOCK_CFG_T
