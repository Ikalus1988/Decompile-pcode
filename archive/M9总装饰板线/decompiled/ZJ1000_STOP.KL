PROGRAM ZJ1000_STOP
%COMMENT = 'Zj Stop 221112'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	SOCK_CFG_T = STRUCTURE
	CONNECTED: INTEGER
