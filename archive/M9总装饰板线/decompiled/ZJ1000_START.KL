-- ZJ1000_START.KL (decompiled v3)
PROGRAM ZJ1000_START
%COMMENT = 'Zj St 221112'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	SOCK_CFG_T = STRUCTURE
	CONNECTED: INTEGER
	HOST: STRING[127]
	PORTTAG: STRING[3]
	SERVERPORT: INTEGER
	NBYTE: INTEGER
	ATRTIMEOUT: INTEGER
	ATRBINARY: INTEGER
	ATRINTACT: INTEGER
	ATRPROBABLY: INTEGER
	ENDSTRUCTURE
VAR
  SENDMODE : INTEGER
  USERFRMNO : INTEGER
  USERTOLNO : INTEGER
  PORTNO1 : INTEGER
  PORTNO2 : INTEGER
  HTBTTIME : INTEGER
  TASKID : INTEGER
  ERRCODE : INTEGER
  SOCKCFG : REAL
  ZJFILE : FILE
  ZJMAINRUN : BOOLEAN
  ZJMAINSTOP : BOOLEAN
  ZJ______ : BOOLEAN
  ZJERRTIMER : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE SOCK_PING_(p0 : SOCK_CFG_T) : INTEGER FROM MI_LIB
ROUTINE CSOCK_CONN_(p0 : SOCK_CFG_T) : INTEGER FROM MI_LIB
ROUTINE SOCK_DCONN_(p0 : SOCK_CFG_T) : INTEGER FROM MI_LIB
ROUTINE FILE_INIT_(p0 : FILE; p1 : SOCK_CFG_T) : INTEGER FROM MI_LIB
ROUTINE FILE_OFD_(p0 : FILE; p1 : SOCK_CFG_T) : INTEGER FROM MI_LIB
ROUTINE FILE_CFD_(p0 : FILE) : INTEGER FROM MI_LIB
ROUTINE TO_INT_(p0 : FILE; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE TO_BYTE_(p0 : FILE; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE TO_REAL_(p0 : FILE; p1 : REAL) : INTEGER FROM MI_LIB
ROUTINE TO_BUFFER_(p0 : FILE) : INTEGER FROM MI_LIB
ROUTINE FROM_INT_(p0 : FILE; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE GET_IPARM_(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE GET_RPARM_(p0 : INTEGER) : REAL FROM MI_LIB
ROUTINE GET_SPARM_(p0 : INTEGER) : STRING FROM MI_LIB
ROUTINE GET_IREG_(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE SET_IREG_(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE INT_TO_STR_(p0 : INTEGER) : STRING FROM MI_LIB
ROUTINE THRD_CREATE_(p0 : STRING; p1 : INTEGER; p2 : BOOLEAN) : INTEGER FROM MI_LIB
ROUTINE THRD_END_(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE CUR_POS_(p0, p1 : INTEGER) : POSITION FROM MI_LIB
ROUTINE CUR_JPOS_(p0 : INTEGER) : JOINTPOS FROM MI_LIB
ROUTINE DECOM_AXIS_(p0 : JOINTPOS) : INTEGER FROM MI_LIB
ROUTINE IO_IS_CFG_(p0, p1 : INTEGER) : BOOLEAN FROM MI_LIB
ROUTINE INSTALL_AH_(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE AB_HNDLR_(p0 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  sv_i = GET_IPARM_(1)
  SENDMODE = sv_i
  sv_i = GET_IPARM_(2)
  USERFRMNO = sv_i
  sv_i = GET_IPARM_(3)
  USERTOLNO = sv_i
  sv_i = GET_IPARM_(4)
  PORTNO1 = sv_i
  sv_i = GET_IPARM_(5)
  PORTNO2 = sv_i
  sv_i = GET_IPARM_(6)
  HTBTTIME = sv_i
  sv_i = THRD_CREATE_('Zj1000_main', 0, (0 <> 0))
  -- Æú²ÎÔ­Ê½: 0
  TASKID = sv_i
  IF ((TASKID <= 0)) THEN
  ERRCODE = (0 - 9)
  ENDIF
END ZJ1000_START

