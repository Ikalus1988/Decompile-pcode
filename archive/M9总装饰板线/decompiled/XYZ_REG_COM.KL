-- XYZ_REG_COM.KL (decompiled v3)
PROGRAM XYZ_REG_COM
%COMMENT = 'comment'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE LOG_CLEAR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_FORCE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE SET_REG_MULT(p0, p1 : INTEGER; p2 : STRING; p3 : INTEGER) : INTEGER
VAR
  I : INTEGER
  TMPBUFF : STRING[64]
BEGIN
  I = p0 + 1
  FOR I = 1 TO 3 DO
  CNV_INT_STR(I - p0, 1, 0, TMPBUFF)
  TMPBUFF = ''
  IF ((p3 = 0)) THEN
  SET_REG_CMT(I - 1, TMPBUFF, STATUS)
  ENDIF
  IF ((p3 = 1)) THEN
  SET_PREG_CMT(I - 1, TMPBUFF, STATUS)
  ENDIF
  IF ((p3 = 2)) THEN
  SET_SREG_CMT(I - 1, TMPBUFF, STATUS)
  ENDIF
  ENDFOR
  SET_REG_CMT(31, 'MOT movej speed', STATUS)
  SET_REG_CMT(32, 'MOT movel speed', STATUS)
  SET_REG_CMT(33, 'MOT acceleration', STATUS)
  SET_REG_CMT(34, 'MOT cnt data', STATUS)
  SET_REG_CMT(38, 'MAST connect flag', STATUS)
  SET_REG_CMT(39, 'MAST comm flag', STATUS)
  SET_REG_CMT(40, 'MAST error code', STATUS)
  SET_REG_CMT(41, 'MAST parsed int', STATUS)
  SET_REG_CMT(42, 'MAST pose num', STATUS)
  SET_REG_CMT(43, 'MAST pipeline num', STATUS)
  SET_REG_CMT(44, 'MAST register num', STATUS)
  SET_PREG_CMT(11, 'MOT joint pose', STATUS)
  SET_PREG_CMT(15, 'MAST cart pose', STATUS)
  sv_i = SET_REG_MULT(45, 30, 'MAST waypoint type', 0)
  -- stmt69 stray sv_i
  sv_i = SET_REG_MULT(20, 30, 'MAST waypoint', 1)
  -- stmt70 stray sv_i
  SET_INT_REG(37, 600, STATUS)
  IF ((STATUS <> 0)) THEN
  sv_i = LOG_ERROR('[REG_COM] set heart beat interval failed')
  -- stmt75 stray sv_i
  ENDIF
  RETURN(0)
END SET_REG_MULT

BEGIN
END XYZ_REG_COM
