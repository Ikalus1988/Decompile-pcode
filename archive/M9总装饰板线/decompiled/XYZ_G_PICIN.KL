-- XYZ_G_PICIN.KL (decompiled v3)
PROGRAM XYZ_G_PICIN
%COMMENT = 'get pick in'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	XYZ_MSG_T = STRUCTURE
	MSG_QUOT_: INTEGER
	MSG_REMA_: INTEGER
	MSG_ARRAY_: ARRAY[6] OF STRING[200]
	ENDSTRUCTURE
	XYZ_DATA_T = STRUCTURE
	DATA_NUM_: INTEGER
	DATA_ARRAY_: ARRAY[70] OF STRING[20]
	ENDSTRUCTURE
	XYZ_SOCK_T = STRUCTURE
	TYPE_: STRING[1]
	CONNECTED_: INTEGER
	STATUS_: INTEGER
	TAG_IDX_: INTEGER
	TAG_STR_: STRING[3]
	PORT_: INTEGER
	HOST_: STRING[30]
	ENDSTRUCTURE
VAR
  io_23 : ARRAY[512] OF INTEGER
  DATA_TYPE : INTEGER
  VS_ID : INTEGER
  REAL_NA : REAL
  STR_NA : STRING[64]
  RET : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE PKT_CTOR_MSG(p0 : XYZ_MSG_T) : INTEGER FROM MI_LIB
ROUTINE PKT_CTOR_DAT(p0 : XYZ_DATA_T) : INTEGER FROM MI_LIB
ROUTINE PKT_GET_MLEN(p0 : XYZ_MSG_T) : INTEGER FROM MI_LIB
ROUTINE PKT_ADD_MSG(p0 : XYZ_MSG_T; p1 : STRING) : INTEGER FROM MI_LIB
ROUTINE PKT_CNV_MTD(p0 : XYZ_MSG_T; p1 : XYZ_DATA_T) : INTEGER FROM MI_LIB
ROUTINE PKT_ADD_DAT(p0 : XYZ_DATA_T; p1 : STRING) : INTEGER FROM MI_LIB
ROUTINE PKT_CNV_DTM(p0 : XYZ_DATA_T; p1 : XYZ_MSG_T) : INTEGER FROM MI_LIB
ROUTINE PKT_RECV_SM(p0 : XYZ_MSG_T; p1 : XYZ_SOCK_T; p2 : FILE) : INTEGER FROM MI_LIB
ROUTINE PKT_SEND_ALL(p0 : XYZ_MSG_T; p1 : XYZ_SOCK_T; p2 : FILE) : INTEGER FROM MI_LIB
ROUTINE PKT_RECV_UT(p0 : XYZ_MSG_T; p1 : XYZ_SOCK_T; p2 : FILE) : INTEGER FROM MI_LIB
ROUTINE SOCK_CTOR(p0 : XYZ_SOCK_T; p1 : INTEGER; p2 : STRING) : INTEGER FROM MI_LIB
ROUTINE SOCK_CONN(p0 : XYZ_SOCK_T; p1 : FILE) : INTEGER FROM MI_LIB
ROUTINE SOCK_CLOSE(p0 : XYZ_SOCK_T; p1 : FILE) : INTEGER FROM MI_LIB
ROUTINE SOCK_SET_RT(p0 : FILE; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE SOCK_OPFD(p0 : FILE; p1 : STRING) : INTEGER FROM MI_LIB
ROUTINE SOCK_CLFD(p0 : FILE) : INTEGER FROM MI_LIB
ROUTINE SOCK_SEND(p0 : FILE; p1 : STRING) : INTEGER FROM MI_LIB
ROUTINE SOCK_RECV(p0 : FILE; p1 : STRING; p2 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_CLEAR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_FORCE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_INFO_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_WARN_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE LOG_ERROR_A(p0 : STRING; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE XYZBKGD(p0 : FILE) : INTEGER FROM MI_LIB
ROUTINE WAITCOMM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE GETCMD(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE RESETOUTDATA(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE ADDINTTOARR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE ADDREALTOARR(p0 : REAL) : INTEGER FROM MI_LIB
ROUTINE ADDARRTOARR(p0 : ARRAY OF REAL) : INTEGER FROM MI_LIB
ROUTINE ADDSTRTOARR(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE ADDJPOSTOARR(p0 : JOINTPOS) : INTEGER FROM MI_LIB
ROUTINE ADDCPOSTOARR(p0 : POSITION) : INTEGER FROM MI_LIB
ROUTINE ADDEXTJTOARR(p0 : JOINTPOS) : INTEGER FROM MI_LIB
ROUTINE RECVANDPARSE(p0 : XYZ_SOCK_T; p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE PACKANDSEND(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE XYZHEARTBEAT(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSEERRCODE(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSEINT(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSEPOSE(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSEPIPE(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSEIHPOSE(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSETRAJ(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB
ROUTINE PARSECUSTOM(p0 : XYZ_SOCK_T) : INTEGER FROM MI_LIB

BEGIN
  GET_TPE_PRM(1, DATA_TYPE, VS_ID, REAL_NA, STR_NA, RET)
  IF ((RET <> 0) OR (DATA_TYPE <> 1)) THEN
  sv_i = LOG_ERROR('[G_PICIN] fail to get vs_id')
  -- stmt45 stray sv_i
  ENDIF
  sv_i = RESETOUTDATA(0)
  -- stmt47 stray sv_i
  sv_i = ADDINTTOARR(518)
  RET = sv_i
  IF ((RET <> 0)) THEN
  sv_i = LOG_ERROR('[G_PICIN] fail to pack cmd')
  -- stmt50 stray sv_i
  ENDIF
  sv_i = ADDINTTOARR(VS_ID)
  RET = sv_i
  IF ((RET <> 0)) THEN
  sv_i = LOG_ERROR('[G_PICIN] fail to pack vs_id')
  -- stmt54 stray sv_i
  ENDIF
  io_23[15] = 1
  -- stmt57 stray 15
END XYZ_G_PICIN

