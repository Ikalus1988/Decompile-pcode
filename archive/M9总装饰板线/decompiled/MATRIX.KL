%NOABORT = ERROR + COMMAND
VAR
  v1 : INTEGER
  v2 : INTEGER
  v3 : STRING[64]
  v4 : INTEGER
  v5 : POSITION
  v6 : POSITION
  v7 : ARRAY[64] OF INTEGER
  v8 : INTEGER
