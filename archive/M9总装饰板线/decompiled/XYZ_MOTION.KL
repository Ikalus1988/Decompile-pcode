  RETURN(0)
  RETURN(0)
END XYZMOVJSEQ

ROUTINE XYZMOTION(p0 : FILE) : INTEGER
VAR
  data_str : STRING[64]
  err_code : INTEGER
  mot_cmd : INTEGER
  ret_str : STRING[64]
  state_ : INTEGER
  temp_str : STRING[64]
  xdat : XYZ_DATA_T
  xmsgt : XYZ_MSG_T
  xsock : XYZ_SOCK_T
BEGIN
  sv_i = LOG_INFO('[MOT] Version is ' + '1.1.8')
  -- stmt58 stray sv_i
  sv_i = SOCK_CTOR(xsock, 3, 'S')
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] init sock failed')
  -- stmt62 stray sv_i
  ELSE
  ENDIF
  sv_i = LOG_INFO('[MOT] Waiting connection')
  -- stmt66 stray sv_i
  sv_i = SOCK_CONN(xsock, p0)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] sock connect failed')
  -- stmt70 stray sv_i
  ELSE
  ENDIF
  sv_i = LOG_INFO('[MOT] connection success')
  -- stmt73 stray sv_i
  IF ((1 <> 0)) THEN
  err_code = 0
  data_str = ''
  ret_str = ''
  sv_i = PKT_CTOR_MSG(xmsgt)
  -- stmt79 stray sv_i
  sv_i = PKT_CTOR_DAT(xdat)
  -- stmt80 stray sv_i
  sv_i = PKT_RECV_SM(xmsgt, xsock, p0)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] recv msg failed')
  -- stmt85 stray sv_i
  ELSE
  ENDIF
  sv_i = PKT_CNV_MTD(xmsgt, xdat)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] cnv msg to data failed')
  -- stmt92 stray sv_i
  ELSE
  ENDIF
  sv_i = GETMOTCMD(xdat)
  mot_cmd = sv_i
  SELECT mot_cmd OF
  CASE(100):
  sv_i = XYZGETVER(xdat, data_str)
  err_code = sv_i
  CASE(101):
  sv_i = XYZSETSPD(xdat)
  err_code = sv_i
  CASE(102):
  sv_i = XYZSETACC(xdat)
  err_code = sv_i
  CASE(103):
  sv_i = XYZSETZONE(xdat)
  err_code = sv_i
  CASE(105):
  sv_i = XYZSETDOUT(xdat)
  err_code = sv_i
  CASE(106):
  sv_i = SETJNTSMOVJ(xdat)
  err_code = sv_i
  CASE(108):
  sv_i = SETJNTSMOVL(xdat)
  err_code = sv_i
  CASE(110):
  sv_i = XYZMOVJSEQ(xdat)
  err_code = sv_i
  CASE(118):
  sv_i = XYZMOVLUTL(xdat)
  err_code = sv_i
  CASE(119):
  sv_i = XYZGETDIN(xdat, data_str)
  err_code = sv_i
  CASE(120):
  sv_i = XYZGETDOUT(xdat, data_str)
  err_code = sv_i
  CASE(122):
  sv_i = XYZGETJNTS(xdat, data_str)
  err_code = sv_i
  CASE(123):
  sv_i = XYZGETCPOS(xdat, data_str)
  err_code = sv_i
  ELSE:
  err_code = 200
  ENDIF
  temp_str = ''
  CNV_INT_STR(mot_cmd, 1, 10, temp_str)
  ret_str = '' + ','
  temp_str = ''
  CNV_INT_STR(err_code, 1, 10, temp_str)
  ret_str = '' + ','
  ret_str = '' + '#'
  sv_i = SOCK_SEND(p0, ret_str)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] send reply to ipc failed')
  -- stmt140 stray sv_i
  ELSE
  ENDIF
  ENDSELECT
  sv_i = LOG_ERROR('[MOT] Err happend will close socket')
  -- stmt147 stray sv_i
  sv_i = SOCK_CLOSE(xsock, p0)
  -- stmt148 stray sv_i
  RETURN(0)
END XYZMOTION

