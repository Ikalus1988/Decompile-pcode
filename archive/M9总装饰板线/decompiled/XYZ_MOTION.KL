ROUTINE XYZGETJNTS(p0 : XYZ_DATA_T; p1 : STRING) : INTEGER
VAR
  cur_j_pos_ : INTEGER
  i__ : JOINTPOS
  joint_data : INTEGER
  ret : ARRAY[64] OF REAL
  temp_str : STRING[64]
BEGIN
  sv_j = curjpos(0, 0)
  i__ = sv_j
  FOR cur_j_pos_ = 1 TO 3 DO
  ret[cur_j_pos_] = 0
  ENDFOR
  cnv_jpos_rel(i__, ret, joint_data)
  IF ((joint_data <> 0)) THEN
  sv_i = LOG_ERROR('[MOT] jpos to rel failed')
  -- stmt221 stray sv_i
  ENDIF
  p1 = ''
  FOR cur_j_pos_ = 1 TO 3 DO
  temp_str = ''
  CNV_REAL_STR((ret[cur_j_pos_]), 1, 4, temp_str)
  p1 = '' + ','
  ENDFOR
  p1 = p1 + '0' + ',' + '0' + ','
  RETURN(joint_data)
  RETURN(0)
END XYZGETJNTS

