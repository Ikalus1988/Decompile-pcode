  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get pipeline_num')
  -- stmt175 stray sv_i
  RETURN(i)
  ENDIF
  CNV_STR_INT('', wp_type)
  -- 弃参原式: (GINDATA_f04[3])
