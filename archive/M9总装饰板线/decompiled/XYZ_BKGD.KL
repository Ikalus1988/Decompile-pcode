  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to parse string')
  -- stmt16 stray sv_i
  RETURN(joint_pose)
  ENDIF
  ENDFOR
  FOR tmp_pose = 1 TO 3 DO
  CNV_STR_INT('', (err_code[tmp_pose]))
  -- 弃参原式: (GINDATA_f04[tmp_pose + 6])
  SET_INT_REG(152 + tmp_pose - 1, (err_code[tmp_pose]), joint_pose)
  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to parse int')
  -- stmt24 stray sv_i
  RETURN(joint_pose)
  ENDIF
  ENDFOR
  FOR tmp_pose = 1 TO 3 DO
  CNV_STR_REAL('', (state_[tmp_pose]))
  -- 弃参原式: (GINDATA_f04[tmp_pose + 16])
  SET_REAL_REG(153 + tmp_pose - 1, (state_[tmp_pose]), joint_pose)
  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to parse float')
  -- stmt32 stray sv_i
  RETURN(joint_pose)
  ENDIF
  ENDFOR
  CNV_STR_REAL('', ints_f08)
  -- 弃参原式: (GINDATA_f04[27])
  CNV_STR_REAL('', ints_f0c)
  -- 弃参原式: (GINDATA_f04[28])
  CNV_STR_REAL('', ints_f10)
  -- 弃参原式: (GINDATA_f04[29])
  CNV_STR_REAL('', ints_f14)
  -- 弃参原式: (GINDATA_f04[30])
  CNV_STR_REAL('', ints_f18)
  -- 弃参原式: (GINDATA_f04[31])
  CNV_STR_REAL('', ints_f1c)
  -- 弃参原式: (GINDATA_f04[32])
  sv_p = GET_POS_REG(198, joint_pose)
  joints = sv_p
  ints_f20 = joints_f20
  SET_POS_REG(198, sv_p, joint_pose)
  -- 弃参原式: ints | ints
  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get cart pose')
  -- stmt46 stray sv_i
  RETURN(joint_pose)
  ENDIF
  FOR tmp_pose = 1 TO 3 DO
  CNV_STR_REAL('', (i[tmp_pose]))
  -- 弃参原式: (GINDATA_f04[tmp_pose + 33])
  ENDFOR
  i[3] = i[3] - i[2]
  cnv_rel_jpos(i, sv_j, joint_pose)
  -- 弃参原式: floats | floats
  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get joint pose')
  -- stmt56 stray sv_i
  RETURN(joint_pose)
  ENDIF
  SET_JPOS_REG(196, sv_j, joint_pose)
  -- 弃参原式: floats | floats
  IF ((joint_pose <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get joint pose')
  -- stmt61 stray sv_i
  RETURN(joint_pose)
  ENDIF
  io_23[15] = 0
  RETURN(joint_pose)
  RETURN(0)
END PARSECUSTOM

ROUTINE XYZBKGD(p0 : FILE) : INTEGER
VAR
  CMD : INTEGER
  comm_error : INTEGER
  comm_state : INTEGER
  err_code : INTEGER
  hb_interval : INTEGER
  real_NA : REAL
  state_ : INTEGER
  temp_str : STRING[64]
  xsock : XYZ_SOCK_T
BEGIN
  sv_i = LOG_CLEAR(0)
  -- stmt61 stray sv_i
  sv_i = LOG_INFO('[BKGD] Version is ' + '1.1.8')
  -- stmt62 stray sv_i
  io_23[15] = 0
  sv_i = SOCK_CTOR(xsock, 2, 'C')
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] init sock failed')
  -- stmt67 stray sv_i
  ELSE
  ENDIF
  sv_i = SOCK_SET_RT(p0, 10000)
  -- stmt72 stray sv_i
  sv_i = SOCK_CONN(xsock, p0)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] sock connect failed')
  -- stmt77 stray sv_i
  SET_INT_REG(38, 0, state_)
  SET_INT_REG(39, 0, state_)
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to set state code')
  -- stmt81 stray sv_i
  ENDIF
  ELSE
  ENDIF
  sv_i = LOG_INFO('[BKGD] connection success')
  -- stmt86 stray sv_i
  SET_INT_REG(38, 1, state_)
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to set state code')
  -- stmt89 stray sv_i
  ELSE
  ENDIF
  GET_REG(37, (0 <> 0), comm_error, real_NA, state_)
  -- 弃参原式: 0
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get heart_beat interval')
  -- stmt95 stray sv_i
  ELSE
  ENDIF
  GET_TIME(CMD)
  IF ((1 <> 0)) THEN
  GET_TIME(err_code)
  hb_interval = err_code - CMD
  hb_interval = hb_interval * 2
  IF ((hb_interval > comm_error)) THEN
  GET_TIME(CMD)
  sv_i = XYZHEARTBEAT(xsock)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  ELSE
  ENDIF
  ENDIF
  IF ((io_23[15] = 1)) THEN
  sv_i = GETCMD
  comm_state = sv_i
  sv_i = PACKANDSEND
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  ELSE
  ENDIF
  SELECT comm_state OF
  CASE(502):
  CASE(503):
  CASE(504):
  CASE(528):
  CASE(511):
  CASE(512):
  CASE(514):
  CASE(513):
  CASE(517):
  CASE(523):
  CASE(711):
  CASE(712):
  CASE(700):
  CASE(705):
  sv_i = PARSEERRCODE(xsock)
  state_ = sv_i
  CASE(507):
  CASE(509):
  CASE(710):
  sv_i = PARSEINT(xsock)
  state_ = sv_i
  CASE(510):
  CASE(530):
  sv_i = PARSEPOSE(xsock)
  state_ = sv_i
  CASE(508):
  CASE(529):
  sv_i = PARSEPIPE(xsock)
  state_ = sv_i
  CASE(524):
  sv_i = PARSEIHPOSE(xsock)
  state_ = sv_i
  CASE(518):
  CASE(519):
  CASE(520):
  CASE(521):
  sv_i = PARSETRAJ(xsock)
  state_ = sv_i
  CASE(600):
  sv_i = PARSECUSTOM(xsock)
  state_ = sv_i
  ELSE:
  CNV_INT_STR(comm_state, 1, 10, temp_str)
  sv_i = LOG_ERROR('[BKGD] invalid command id: ' + temp_str)
  -- stmt144 stray sv_i
  ENDIF
  IF ((state_ <> 0)) THEN
  SET_INT_REG(39, 0, state_)
  sv_i = LOG_ERROR('[BKGD] fail to recv and parse messages')
  -- stmt149 stray sv_i
  ELSE
  ENDIF
  SET_INT_REG(39, 1, state_)
  ENDIF
  DELAY 10
  ENDSELECT
  sv_i = LOG_ERROR('[BKGD] close connect')
  -- stmt160 stray sv_i
  sv_i = SOCK_CLOSE(xsock, p0)
  -- stmt161 stray sv_i
  DELAY 200
  RETURN(0)
END XYZBKGD

ROUTINE WAITCOMM(p0 : INTEGER) : INTEGER
VAR
  ctr : INTEGER
  hb_dur : INTEGER
  max_ctr : INTEGER
BEGIN
  ctr = 0
  hb_dur = p0
  IF ((p0 < 10)) THEN
  hb_dur = 600
  ENDIF
  max_ctr = hb_dur * 100
  IF ((1 <> 0)) THEN
  IF ((io_23[15] = 0)) THEN
  DELAY 10
  ctr = ctr + 1
  IF ((ctr > max_ctr)) THEN
  sv_i = LOG_INFO('[BKGD] sending heartbeat signal to server')
  -- stmt193 stray sv_i
  ctr = 0
  RETURN(1)
  ENDIF
  ELSE
  RETURN(0)
  ENDIF
  ENDIF
  RETURN(0)
END WAITCOMM

ROUTINE RESETOUTDATA : INTEGER
BEGIN
  sv_i = PKT_CTOR_DAT(GOUTDATA)
  -- stmt215 stray sv_i
  RETURN(0)
END RESETOUTDATA

ROUTINE ADDINTTOARR(p0 : INTEGER) : INTEGER
VAR
  temp_str : STRING[64]
BEGIN
  IF ((GOUTDATA_f00 + 1 > 70)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add int, data array is full')
  -- stmt224 stray sv_i
  RETURN(1)
  ENDIF
  CNV_INT_STR(0, 1, 10, temp_str)
  -- 弃参原式: p0
  GOUTDATA_f04[GOUTDATA_f00 + 1] = temp_str
  GOUTDATA_f00 = GOUTDATA_f00 + 1
  RETURN(0)
  RETURN(0)
END ADDINTTOARR

ROUTINE ADDREALTOARR(p0 : REAL) : INTEGER
VAR
  temp_str : STRING[64]
BEGIN
  IF ((GOUTDATA_f00 + 1 > 70)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add real, data array is full')
  -- stmt239 stray sv_i
  RETURN(1)
  ENDIF
  CNV_REAL_STR(p0, 1, 4, temp_str)
  GOUTDATA_f04[GOUTDATA_f00 + 1] = temp_str
  GOUTDATA_f00 = GOUTDATA_f00 + 1
  RETURN(0)
  RETURN(0)
END ADDREALTOARR

ROUTINE ADDARRTOARR(p0 : ARRAY OF REAL) : INTEGER
VAR
  i : INTEGER
  ret : INTEGER
BEGIN
  FOR i = 1 TO 3 DO
  sv_i = ADDREALTOARR((p0[i]))
  ret = sv_i
  IF ((ret <> 0)) THEN
  sv_i = LOG_ERROR_A('[BKGD] fail to add the ith real num to array', i)
  -- stmt1 stray sv_i
  RETURN(ret)
  ENDIF
  ENDFOR
  RETURN(0)
  RETURN(0)
END ADDARRTOARR

ROUTINE ADDSTRTOARR(p0 : STRING) : INTEGER
BEGIN
  IF ((GOUTDATA_f00 + 1 > 70)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add string, data array is full')
  -- stmt12 stray sv_i
  RETURN(1)
  ENDIF
  GOUTDATA_f04[GOUTDATA_f00 + 1] = p0
  GOUTDATA_f00 = GOUTDATA_f00 + 1
  RETURN(0)
  RETURN(0)
END ADDSTRTOARR

ROUTINE ADDJPOSTOARR(p0 : JOINTPOS) : INTEGER
VAR
  joints : ARRAY[64] OF INTEGER
  state_ : INTEGER
BEGIN
  cnv_jpos_rel(sv_j, sv_a, 0)
  -- 弃参原式: p0 | p0 | p0 | p0 | joints
  joints[3] = joints[3] + joints[2]
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to convert jointpos')
  -- stmt30 stray sv_i
  ENDIF
  sv_i = ADDARRTOARR(joints)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add joint pose')
  -- stmt34 stray sv_i
  ENDIF
  RETURN(0)
  RETURN(0)
END ADDJPOSTOARR

ROUTINE ADDCPOSTOARR(p0 : POSITION) : INTEGER
VAR
  pose : ARRAY[64] OF INTEGER
  state_ : INTEGER
BEGIN
  pose[1] = p0_f08
  pose[2] = p0_f0c
  pose[3] = p0_f10
  pose[4] = p0_f14
  pose[5] = p0_f18
  pose[6] = p0_f1c
  pose[7] = 0
  sv_i = ADDARRTOARR(pose)
  state_ = sv_i
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add cart pose')
  -- stmt54 stray sv_i
  ENDIF
  RETURN(0)
  RETURN(0)
END ADDCPOSTOARR

ROUTINE ADDEXTJTOARR(p0 : JOINTPOS) : INTEGER
VAR
  joints : ARRAY[64] OF INTEGER
  out_joints : INTEGER
  state_ : ARRAY[64] OF INTEGER
BEGIN
  cnv_jpos_rel(sv_j, sv_a, 0)
  -- 弃参原式: p0 | p0 | p0 | p0 | joints
  IF ((out_joints <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to convert jointpos')
  -- stmt68 stray sv_i
  ENDIF
  state_[1] = joints[7]
  state_[2] = joints[8]
  state_[3] = joints[9]
  state_[4] = 0
  state_[5] = 0
  state_[6] = 0
  sv_i = ADDARRTOARR(state_)
  out_joints = sv_i
  IF ((out_joints <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to add external joints')
  -- stmt78 stray sv_i
  ENDIF
  RETURN(0)
  RETURN(0)
END ADDEXTJTOARR

BEGIN
  sv_i = XYZBKGD(SOCK_FD)
