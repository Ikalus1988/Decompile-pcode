ROUTINE PARSETRAJ(p0 : XYZ_SOCK_T) : INTEGER
VAR
  cart_pose : INTEGER
  err_code : INTEGER
  i : INTEGER
  j : INTEGER
  joint_pose : INTEGER
  joints : INTEGER
  pipe_num : INTEGER
  pose_num : INTEGER
  reg_num : POSITION
  state_ : ARRAY[64] OF REAL
  tmp_pose : INTEGER
  wp_type : INTEGER
BEGIN
  sv_i = RECVANDPARSE(p0, pose_num)
  i = sv_i
  IF ((i <> 0)) THEN
  RETURN(i)
  ENDIF
  SET_INT_REG(40, pose_num, i)
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get error code')
  -- stmt169 stray sv_i
  RETURN(i)
