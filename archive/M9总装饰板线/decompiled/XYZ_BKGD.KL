ROUTINE PACKANDSEND : INTEGER
VAR
  i : INTEGER
  packed_data : STRING[64]
  s_state_ : INTEGER
  state_ : INTEGER
  tem_len : INTEGER
BEGIN
  packed_data = ''
  tem_len = 0
  state_ = 0
