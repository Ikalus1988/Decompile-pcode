  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get register_num')
  -- stmt181 stray sv_i
  RETURN(i)
  ENDIF
  CNV_STR_INT('', cart_pose)
  -- 弃参原式: (GINDATA_f04[4])
  SET_INT_REG(42, cart_pose, i)
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get pose num')
  -- stmt187 stray sv_i
  RETURN(i)
  ENDIF
  FOR joints = 1 TO 3 DO
  state_[joints] = 0
  ENDFOR
  FOR joints = 1 TO 3 DO
  CNV_STR_INT('', tmp_pose)
  -- 弃参原式: (GINDATA_f04[7 * joints - 2])
  SET_INT_REG(45 + joints - 1, tmp_pose, i)
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get wp type')
  -- stmt197 stray sv_i
  RETURN(i)
  ENDIF
  SELECT tmp_pose OF
  CASE(11):
  CASE(12):
  FOR joint_pose = 1 TO 3 DO
  CNV_STR_REAL('', (state_[joint_pose]))
  -- 弃参原式: (GINDATA_f04[7 * joints - 2 + joint_pose])
  ENDFOR
  state_[3] = state_[3] - state_[2]
  cnv_rel_jpos(state_, sv_j, i)
  -- 弃参原式: pipe_num | pipe_num
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get joint pose')
  -- stmt209 stray sv_i
  RETURN(i)
  ENDIF
  SET_JPOS_REG(20 + joints - 1, sv_j, i)
  -- 弃参原式: pipe_num | pipe_num
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get joint pose')
  -- stmt214 stray sv_i
  RETURN(i)
  ENDIF
  CASE(21):
  CASE(22):
  CNV_STR_REAL('', err_code_f08)
  -- 弃参原式: (GINDATA_f04[7 * joints - 1])
  CNV_STR_REAL('', err_code_f0c)
  -- 弃参原式: (GINDATA_f04[7 * joints])
  CNV_STR_REAL('', err_code_f10)
  -- 弃参原式: (GINDATA_f04[7 * joints + 1])
  CNV_STR_REAL('', err_code_f14)
  -- 弃参原式: (GINDATA_f04[7 * joints + 2])
  CNV_STR_REAL('', err_code_f18)
  -- 弃参原式: (GINDATA_f04[7 * joints + 3])
  CNV_STR_REAL('', err_code_f1c)
  -- 弃参原式: (GINDATA_f04[7 * joints + 4])
  sv_p = GET_POS_REG(14, i)
  reg_num = sv_p
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] failed to get ref config for PR[4]')
  -- stmt226 stray sv_i
  RETURN(i)
  ENDIF
  err_code_f20 = reg_num_f20
  SET_POS_REG(20 + joints - 1, sv_p, i)
  -- 弃参原式: err_code | err_code
  IF ((i <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] fail to get cart pose')
  -- stmt235 stray sv_i
  RETURN(i)
  ENDIF
  ELSE:
  sv_i = LOG_ERROR('[BKGD] wrong waypoint type')
  -- stmt239 stray sv_i
  RETURN((0 - 100))
  ENDFOR
  io_23[15] = 0
  RETURN(0)
  RETURN(0)
  ENDSELECT
END PARSETRAJ

