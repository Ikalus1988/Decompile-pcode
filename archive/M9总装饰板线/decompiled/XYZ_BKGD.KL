  sv_i = SOCK_SEND(SOCK_FD, packed_data)
  s_state_ = sv_i
  IF ((s_state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] send reply to ipc failed')
  -- stmt130 stray sv_i
  SET_INT_REG(38, 0, state_)
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] failed to set state code')
  -- stmt133 stray sv_i
  ENDIF
  RETURN(s_state_)
  ENDIF
  packed_data = ''
  tem_len = 0
  ENDIF
  ENDFOR
  packed_data = packed_data + '#'
  sv_i = SOCK_SEND(SOCK_FD, packed_data)
  s_state_ = sv_i
  IF ((s_state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] send reply to ipc failed')
  -- stmt145 stray sv_i
  SET_INT_REG(38, 0, state_)
  IF ((state_ <> 0)) THEN
  sv_i = LOG_ERROR('[BKGD] failed to set state code')
  -- stmt148 stray sv_i
  ENDIF
  RETURN(s_state_)
  ENDIF
  RETURN(0)
  RETURN(0)
END PACKANDSEND

