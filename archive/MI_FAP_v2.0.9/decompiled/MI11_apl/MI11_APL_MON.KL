-- MI11_APL_MON.KL (decompiled v3)
PROGRAM MI11_APL_MON
%COMMENT = 'MI11 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  B_MON_11 : INTEGER
  I_MON : INTEGER
  I_MI11_DI : INTEGER
  I_MI11_DO : INTEGER
  I_MI11_GI : INTEGER
  I_MI11_GO : INTEGER
  I_MI11_DP_DI : INTEGER
  I_MI11_DP_DO : INTEGER
  I_DRYRUNTIME : INTEGER
  I_STROKEPOS : INTEGER
  R_COMPULSE : REAL
  I_COMPULSE : INTEGER
  I_DOPULSE : INTEGER
  I_NEWSPOT_SELCT_PULSE : INTEGER
  I_WELDCOMPLETE_TIMEOUT : INTEGER
  R_SCALE : REAL
  R_ORIGINAL_TCP_Z : REAL
  R_TOTAL_TD : REAL
  I_STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE MI11_SENDBSNUM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI11_IOINTER(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE ARPLASINIT(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI11_ARPLAS(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE M11_DMPCHK(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE M11_CLOSEGUN(p0 : REAL) : INTEGER FROM MI_LIB
ROUTINE MI11_TIPDRESS(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI11_TD_NEW(p0 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  IF ((B_MON_11 <> 0)) THEN
  sv_i = MI11_SENDBSNUM(0)
  -- stmt28 stray sv_i
  IF (UNINIT(I_MON)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON < 32)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON > 1024)) THEN
  I_MON = 1024
  ENDIF
  DELAY I_MON
  ELSE
  ENDIF
END MI11_APL_MON

