ROUTINE MI11_SENDBSNUM : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  FOR r0_lc1 = 1 TO 3 DO
  IF ((io_01[I_MI01_DI + 129 + r0_lc1 - 1] <> 0)) THEN
  io_02[I_MI11_DO + 145 + r0_lc1 - 1] = 1
  ELSE
  io_02[I_MI11_DO + 145 + r0_lc1 - 1] = 0
  ENDIF
  ENDFOR
  RETURN(0)
END MI11_SENDBSNUM

ROUTINE MI11_IOINTER(p0 : INTEGER) : INTEGER
BEGIN
  SET_VAR(1, '*SYSTEM*', '$THRSDITABLE[111].$THR_ENB', 1, I_STATUS)
  SET_VAR(1, '*SYSTEM*', '$THRSDITABLE[111].$DO_NO', 171, I_STATUS)
  SELECT p0 OF
  CASE(1):
  SET_VAR(1, '*SYSTEM*', '$THRSDITABLE[111].$DI_NO', I_MI11_DI + 3, I_STATUS)
  CASE(2):
  SET_VAR(1, '*SYSTEM*', '$THRSDITABLE[111].$DI_NO', I_MI11_DP_DI + 1, I_STATUS)
  ELSE:
  ENDSELECT
  RETURN(0)
END MI11_IOINTER

ROUTINE ARPLASINIT : INTEGER
VAR
  r2_lc1 : INTEGER
  r2_lc2 : INTEGER
BEGIN
  io_02[I_MI11_DO + 1] = 0
  io_02[I_MI11_DO + 3] = 0
  io_02[I_MI11_DO + 4] = 0
  io_02[I_MI11_DO + 5] = 0
  io_02[I_MI11_DO + 37] = 0
  IF ((io_01[I_MI11_DI + 1] <> 0)) THEN
  r2_lc2 = 1
  LST_ERROR_f00[r2_lc2] = 'APL'
  LST_ERROR_f10[r2_lc2] = 0
  LST_ERROR_f14[r2_lc2] = 'Spot Selection Invalid'
  LST_ERROR_f38[r2_lc2] = 'Spot selection taken over'
  sv_i = WAIT_SIGNAL(r2_lc2, 1, I_MI11_DI + 1, 0, 3000, 2)
  r2_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI11_DI + 3] <> 0)) THEN
  r2_lc2 = 2
  LST_ERROR_f00[r2_lc2] = 'APL'
  LST_ERROR_f10[r2_lc2] = 0
  LST_ERROR_f14[r2_lc2] = 'Weld complete Error'
  LST_ERROR_f38[r2_lc2] = 'Not at end of sequence'
  sv_i = WAIT_SIGNAL(r2_lc2, 1, I_MI11_DI + 3, 0, 3000, 2)
  r2_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI11_DI + 4] = 0)) THEN
  r2_lc2 = 3
  LST_ERROR_f00[r2_lc2] = 'APL'
  LST_ERROR_f10[r2_lc2] = 0
  LST_ERROR_f14[r2_lc2] = 'Timer Ready Error'
  LST_ERROR_f38[r2_lc2] = 'Timer is not Ready'
  sv_i = WAIT_SIGNAL(r2_lc2, 1, I_MI11_DI + 4, 1, 3000, 2)
  r2_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI11_DI + 5] <> 0)) THEN
  r2_lc2 = 4
  LST_ERROR_f00[r2_lc2] = 'APL'
  LST_ERROR_f10[r2_lc2] = 0
  LST_ERROR_f14[r2_lc2] = 'Welding Error'
  LST_ERROR_f38[r2_lc2] = 'Welding Error Happened'
  sv_i = WAIT_SIGNAL(r2_lc2, 1, I_MI11_DI + 5, 0, 3000, 2)
  r2_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI11_DI + 41] = 0)) THEN
  r2_lc2 = 5
  LST_ERROR_f00[r2_lc2] = 'APL'
  LST_ERROR_f10[r2_lc2] = 0
  LST_ERROR_f14[r2_lc2] = 'Gun Opened Error'
  LST_ERROR_f38[r2_lc2] = 'Gun is not opened'
  sv_i = WAIT_SIGNAL(r2_lc2, 1, I_MI11_DI + 41, 1, 3000, 2)
  r2_lc1 = sv_i
  ENDIF
  IF (UNINIT(R_COMPULSE)) THEN
  R_COMPULSE = 1
  ENDIF
  IF ((R_COMPULSE > 2)) THEN
  R_COMPULSE = 2
  ENDIF
  IF ((R_COMPULSE < 0.5)) THEN
  R_COMPULSE = 0.5
  ENDIF
  sv_i = round(R_COMPULSE * 1000)
  I_COMPULSE = sv_i
  IF (UNINIT(I_NEWSPOT_SELCT_PULSE)) THEN
  I_NEWSPOT_SELCT_PULSE = 500
  ENDIF
  IF (UNINIT(I_WELDCOMPLETE_TIMEOUT)) THEN
  I_WELDCOMPLETE_TIMEOUT = 3000
  ENDIF
  IF ((I_WELDCOMPLETE_TIMEOUT > 15000)) THEN
  I_WELDCOMPLETE_TIMEOUT = 15000
  ENDIF
  IF ((I_WELDCOMPLETE_TIMEOUT < 3000)) THEN
  I_WELDCOMPLETE_TIMEOUT = 3000
  ENDIF
  RETURN(0)
END ARPLASINIT

ROUTINE MI11_ARPLAS(p0 : INTEGER) : INTEGER
VAR
  r3_lc1 : INTEGER
  r3_lc2 : INTEGER
BEGIN
  sv_i = ROBOTINPROC(1)
  -- stmt174 stray sv_i
  sv_i = ARPLASINIT
  -- stmt176 stray sv_i
  io_13[I_MI11_GO + 1] = p0 MOD 65536
  io_13[I_MI11_GO + 1 + 1] = p0 DIV 65536
  IF ((io_01[I_MI11_DI + 1] = 0)) THEN
  r3_lc2 = 6
  LST_ERROR_f00[r3_lc2] = 'APL'
  LST_ERROR_f10[r3_lc2] = 0
  LST_ERROR_f14[r3_lc2] = 'Spot Selection Invalid'
  LST_ERROR_f38[r3_lc2] = 'Spot selection taken over'
  sv_i = WAIT_SIGNAL(r3_lc2, 1, I_MI11_DI + 1, 1, 3000, 2)
  r3_lc1 = sv_i
  ENDIF
  io_02[I_MI11_DO + 9] = 1
  io_02[I_MI11_DO + 37] = 1
  DELAY 16
  io_02[I_MI11_DO + 3] = 1
  IF ((io_01[I_MI11_DI + 3] = 0)) THEN
  I_PROCESSTIM = 0
  ENDIF
  REPEAT
  DELAY 8
  UNTIL((io_01[I_MI11_DI + 3] = 1) OR (I_PROCESSTIM > I_WELDCOMPLETE_TIMEOUT))
  IF ((I_PROCESSTIM > I_WELDCOMPLETE_TIMEOUT)) THEN
  io_13[I_MI01_GO + 6] = 286
  sv_s = INTTOSTR(I_MI11_DI + 3)
  POST_ERR(38100, 'Weld not finished' + ': Wait DI[' + sv_s + ']', 0, 1)
  ENDIF
  r3_lc2 = 8
  LST_ERROR_f00[r3_lc2] = 'APL'
  LST_ERROR_f10[r3_lc2] = 0
  LST_ERROR_f14[r3_lc2] = 'Weld Timeout'
  LST_ERROR_f38[r3_lc2] = 'Weld not finished'
  sv_i = WAIT_SIGNAL(r3_lc2, 1, I_MI11_DI + 3, 1, 500, 2)
  r3_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  io_02[I_MI11_DO + 3] = 0
  IF ((io_01[I_MI11_DI + 41] = 0)) THEN
  r3_lc2 = 5
  LST_ERROR_f00[r3_lc2] = 'APL'
  LST_ERROR_f10[r3_lc2] = 0
  LST_ERROR_f14[r3_lc2] = 'Gun Opened Error'
  LST_ERROR_f38[r3_lc2] = 'Gun is not opened'
  sv_i = WAIT_SIGNAL(r3_lc2, 1, I_MI11_DI + 41, 1, 3000, 2)
  r3_lc1 = sv_i
  ENDIF
  IF ((io_12[I_MI11_GI + 1] <> I_STROKEPOS)) THEN
  r3_lc2 = 6
  LST_ERROR_f00[r3_lc2] = 'APL'
  LST_ERROR_f10[r3_lc2] = 0
  LST_ERROR_f14[r3_lc2] = 'Gun Stroke Position'
  LST_ERROR_f38[r3_lc2] = 'Gun Stroke Position is not correct'
  sv_i = WAIT_SIGNAL(r3_lc2, 3, I_MI11_GI + 1, 1000, 3000, 2)
  r3_lc1 = sv_i
  ENDIF
  io_02[I_MI11_DO + 37] = 0
  io_02[I_MI11_DO + 9] = 0
  sv_i = ROBOTINPROC(2)
  -- stmt9 stray sv_i
  RETURN(0)
END MI11_ARPLAS

ROUTINE M11_DMPCHK : INTEGER
VAR
  r4_lc1 : INTEGER
  r4_lc2 : INTEGER
BEGIN
  IF ((io_01[I_MI11_DP_DI + 1] = 0)) THEN
  r4_lc2 = 8
  LST_ERROR_f00[r4_lc2] = 'APL'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Gun Position Error'
  LST_ERROR_f38[r4_lc2] = 'Gun not Home'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI11_DP_DI + 1, 1, 5000, 2)
  r4_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI11_DP_DI + 3] = 0)) THEN
  r4_lc2 = 9
  LST_ERROR_f00[r4_lc2] = 'APL'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Equalizer Position Error'
  LST_ERROR_f38[r4_lc2] = 'Equalizer not Home'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI11_DP_DI + 3, 1, 5000, 2)
  r4_lc1 = sv_i
  ENDIF
  RETURN(0)
END M11_DMPCHK

ROUTINE M11_CLOSEGUN(p0 : REAL) : INTEGER
VAR
  r5_lc3 : INTEGER
  r5_lc4 : INTEGER
  r5_lc5 : INTEGER
BEGIN
  sv_i = ROBOTINPROC(1)
  -- stmt61 stray sv_i
  io_02[I_MI11_DP_DO + 1] = 0
  io_02[I_MI11_DP_DO + 2] = 1
  r5_lc3 = 0
  r5_lc4 = 0
  I_PROCESSTIM = 0
  IF ((io_01[I_MI11_DP_DI + 5] <> 0)) THEN
  r5_lc3 = 1
  ENDIF
  IF ((r5_lc3 <> 0)) THEN
  IF ((io_01[I_MI11_DP_DI + 6] <> 0)) THEN
  r5_lc4 = 1
  ELSE
  r5_lc4 = 0
  ENDIF
  ENDIF
  DELAY 8
  IF ((I_PROCESSTIM > p0 * 1000)) THEN
  IF ((r5_lc3 = 0)) THEN
  POST_ERR(38100, 'Dimple Failed', 0, 0)
  r5_lc5 = 0
  ENDIF
  REPEAT
  DELAY 8
  sv_i = DB_PROMPT(1, 'Dimple Failed', 'Please press OK to retry;\nPlease press CANCEL to skip.', 1)
  I_STATUS = sv_i
  -- stmt91 residue 'Please press OK to retry;\\nPlease press CANCEL to skip.'
  IF ((I_STATUS = 1)) THEN
  io_02[I_MI11_DP_DO + 2] = 0
  io_02[I_MI11_DP_DO + 1] = 1
  sv_s = INTTOSTR(I_MI11_DP_DI + 1)
  POST_ERR(38100, 'WAIT FOR DI[' + sv_s + ']', 0, 0)
  -- stmt99 stray I_MI11_DP_DI + 1
  io_02[I_MI11_DP_DO + 2] = 1
  io_02[I_MI11_DP_DO + 1] = 0
  ELSE
  POST_ERR(38100, 'Process Skipped', 0, 0)
  r5_lc5 = 1
  ENDIF
  ENDIF
  UNTIL((io_01[I_MI11_DP_DI + 5] <> 0) OR (r5_lc5 = 1))
  IF ((r5_lc5 = 0)) THEN
  IF ((io_01[I_MI11_DP_DI + 6] <> 0)) THEN
  POST_ERR(38100, 'Dimple Success', 0, 0)
  ELSE
  POST_ERR(38100, 'Dimple Success with Large Pressure', 0, 0)
  ENDIF
  ENDIF
  IF ((r5_lc3 <> 0)) THEN
  IF ((r5_lc4 <> 0)) THEN
  POST_ERR(38100, 'Dimple Success', 0, 0)
  ELSE
  POST_ERR(38100, 'Dimple Success with Large Pressure', 0, 0)
  ENDIF
  ENDIF
  io_02[I_MI11_DP_DO + 1] = 1
  io_02[I_MI11_DP_DO + 2] = 0
  IF ((io_01[I_MI11_DP_DI + 1] = 0)) THEN
  sv_i = DIMSGOUT(I_MI11_DP_DI + 1, 1, 5000, 0, 'Not Home')
  -- stmt128 stray sv_i
  ENDIF
  sv_i = ROBOTINPROC(2)
  -- stmt131 stray sv_i
  RETURN(0)
END M11_CLOSEGUN

ROUTINE MI11_TIPDRESS : INTEGER
VAR
  r6_lc15 : POSITION
  r6_lc24 : POSITION
  r6_lc25 : REAL
BEGIN
  r6_lc25 = io_12[112] * R_SCALE
  GET_VAR(1, '*SYSTEM*', '$MNUTOOL[1,1]', r6_lc15, I_STATUS)
  r6_lc24 = r6_lc15
  r6_lc24_f10 = R_ORIGINAL_TCP_Z + r6_lc25
  r6_lc15 = r6_lc24
  SET_VAR(1, '*SYSTEM*', '$MNUTOOL[1,1]', r6_lc15, I_STATUS)
  SET_REAL_REG(32, r6_lc25, I_STATUS)
  RETURN(0)
END MI11_TIPDRESS

ROUTINE MI11_TD_NEW : INTEGER
VAR
  r7_lc15 : POSITION
  r7_lc24 : POSITION
BEGIN
  IF (UNINIT(R_ORIGINAL_TCP_Z)) THEN
  POST_ERR(38100, 'Set original TCP in GUI first', 0, 2)
  ENDIF
  GET_VAR(1, '*SYSTEM*', '$MNUTOOL[1,1]', r7_lc15, I_STATUS)
  r7_lc24 = r7_lc15
  r7_lc24_f10 = R_ORIGINAL_TCP_Z
  r7_lc15 = r7_lc24
  SET_VAR(1, '*SYSTEM*', '$MNUTOOL[1,1]', r7_lc15, I_STATUS)
  SET_REAL_REG(32, 0, I_STATUS)
  RETURN(0)
END MI11_TD_NEW

