  IF (UNINIT(I_MI11_DI)) THEN
  I_MI11_DI = 1688
  ENDIF
  IF (UNINIT(I_MI11_DO)) THEN
  I_MI11_DO = 1688
  ENDIF
  IF (UNINIT(I_MI11_GI)) THEN
