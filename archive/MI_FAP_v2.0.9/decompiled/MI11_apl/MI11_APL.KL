  ENDIF
  RETURN(0)
END INIT

ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc10 : INTEGER
  r1_lc11 : INTEGER
  r1_lc12 : INTEGER
  r1_lc13 : REAL
  r1_lc14 : INTEGER
  r1_lc15 : INTEGER
  r1_lc16 : REAL
  r1_lc17 : INTEGER
  r1_lc9 : STRING[64]
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc10 = sv_i
  SELECT r1_lc10 OF
  CASE(1):
  sv_i = MI11_IOINTER(1)
  -- stmt91 stray sv_i
  sv_i = GETTPEPRMINT(2)
  r1_lc11 = sv_i
  CASE(1):
  sv_i = GETTPEPRMINT(3)
  r1_lc12 = sv_i
  sv_i = GETTPEPRMINT(4)
  I_STROKEPOS = sv_i
  sv_i = ROBOTINPROC(1)
  -- stmt97 stray sv_i
  IF ((io_01[I_MI01_DI + 35] = 0)) THEN
  sv_i = MI11_ARPLAS(r1_lc12)
  -- stmt99 stray sv_i
  ELSE
  DELAY I_DRYRUNTIME
  ENDIF
  sv_i = ROBOTINPROC(2)
  CASE(2):
  sv_i = GETTPEPRMINT(3)
  r1_lc17 = sv_i
  CASE(1):
  sv_i = MI11_TIPDRESS(0)
  CASE(2):
  sv_i = MI11_TD_NEW(0)
  ELSE:
  ENDSELECT
  SELECT sv_i OF
  CASE(2):
  sv_i = MI11_IOINTER(2)
  -- stmt123 stray sv_i
  sv_i = GETTPEPRMINT(2)
  r1_lc11 = sv_i
  sv_i = ROBOTINPROC(1)
  -- stmt125 stray sv_i
  CASE(1):
  IF ((io_01[I_MI01_DI + 35] = 0)) THEN
  sv_i = M11_DMPCHK(0)
  -- stmt129 stray sv_i
  ELSE
  DELAY I_DRYRUNTIME
  ENDIF
  CASE(2):
  GET_TPE_PRM(3, r1_lc15, r1_lc14, r1_lc16, r1_lc9, I_STATUS)
  IF ((r1_lc15 = 2)) THEN
  r1_lc13 = r1_lc16
  ELSE
  IF ((r1_lc15 = 1)) THEN
  r1_lc13 = r1_lc14 * 1
  ELSE
  sv_s = INTTOSTR(3)
  sv_s = KILLBLANKS(sv_s)
  POST_ERR(38100, 'Wrong data type for PRM[' + sv_s + ']', 38099, 2)
  ENDIF
  ENDIF
  IF ((io_01[I_MI01_DI + 35] = 0)) THEN
  sv_i = M11_CLOSEGUN(r1_lc13)
  -- stmt146 stray sv_i
  ELSE
  DELAY I_DRYRUNTIME
  ENDIF
  ELSE:
  ENDSELECT
  sv_i = ROBOTINPROC(2)
  sv_i = INIT
  -- stmt168 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt170 stray sv_i
  RETURN(0)
END ACTIONSELECT

