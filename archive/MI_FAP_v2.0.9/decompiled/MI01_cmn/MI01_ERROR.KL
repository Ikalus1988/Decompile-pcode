ROUTINE INITLOALVARS : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  IF (UNINIT(B_PRIO_USE)) THEN
  B_PRIO_USE = 1
  ENDIF
  FOR r0_lc1 = 1 TO 3 DO
  IF (UNINIT(AR_B_PRIO[r0_lc1])) THEN
  AR_B_PRIO[r0_lc1] = 1
  ENDIF
  ENDFOR
  IF (UNINIT(B_LOGBOOK_USE)) THEN
  B_LOGBOOK_USE = 1
  ENDIF
  IF (UNINIT(I_LOGBOOK_DEV)) THEN
  I_LOGBOOK_DEV = 1
  ENDIF
  SELECT I_LOGBOOK_DEV OF
  CASE(1):
  DEVICE = 'MC'
  CASE(2):
  DEVICE = 'UD1'
  CASE(3):
  DEVICE = 'UT1'
  CASE(4):
  DEVICE = 'FR'
  ELSE:
  ENDSELECT
  RETURN(0)
END INITLOALVARS

ROUTINE CREAT_FOLDER(p0, p1, p2, p3 : STRING) : INTEGER
VAR
  r1_lc1 : INTEGER
BEGIN
  SPRUNCMD('MKDIR ' + p0 + p1, r1_lc1)
  IF ((r1_lc1 <> 0)) THEN
  POST_ERR(38100, 'Create floder error', 0, 1)
  ELSE
  IF ((p2 <> '')) THEN
  SPRUNCMD('MKDIR ' + p0 + p1 + '\' + p2, r1_lc1)
  -- stmt99 residue '\\'
  IF ((r1_lc1 <> 0)) THEN
  POST_ERR(38100, 'Create floder error', 0, 1)
  ELSE
  IF ((p3 <> '')) THEN
  SPRUNCMD('MKDIR ' + p0 + p1 + '\' + p2 + '\' + p3, r1_lc1)
  -- stmt104 residue '\\', '\\'
  IF ((r1_lc1 <> 0)) THEN
  POST_ERR(38100, 'Create floder error', 0, 1)
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  RETURN(0)
END CREAT_FOLDER

ROUTINE COPY_CMD(p0, p1, p2 : STRING) : INTEGER
VAR
  r2_lc1 : INTEGER
BEGIN
  COPY_FILE('', '', (1 <> 0), (0 <> 0), r2_lc1)
  -- Æú²ÎÔ­Ê½: p1 + p0 | p2 + p0 | 1 | 0
  IF ((r2_lc1 <> 0)) THEN
  POST_ERR(r2_lc1, '', 0, 0)
  POST_ERR(38100, 'Failed to copy ' + p0, 0, 0)
  ELSE
  POST_ERR(38100, 'Copied File ' + 'logbook_' + ST_FILE_NUM + ' Complete', 0, 0)
  DELAY 100
  ENDIF
  RETURN(0)
END COPY_CMD

ROUTINE FOLDER_CMD : INTEGER
BEGIN
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', '', '')
  -- stmt140 stray sv_i
  -- stmt140 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_01', '')
  -- stmt141 stray sv_i
  -- stmt141 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_02', '')
  -- stmt142 stray sv_i
  -- stmt142 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_03', '')
  -- stmt143 stray sv_i
  -- stmt143 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_04', '')
  -- stmt144 stray sv_i
  -- stmt144 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_05', '')
  -- stmt145 stray sv_i
  -- stmt145 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_06', '')
  -- stmt146 stray sv_i
  -- stmt146 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_07', '')
  -- stmt147 stray sv_i
  -- stmt147 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_08', '')
  -- stmt148 stray sv_i
  -- stmt148 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_09', '')
  -- stmt149 stray sv_i
  -- stmt149 residue ':\\'
  sv_i = CREAT_FOLDER(DEVICE + ':\', 'logbook', 'logbook_10', '')
  -- stmt150 stray sv_i
  -- stmt150 residue ':\\'
  RETURN(0)
END FOLDER_CMD

ROUTINE BACKUPLOG : INTEGER
BEGIN
  IF (UNINIT(I_FILE_NUM)) THEN
  I_FILE_NUM = 1
  ENDIF
  IF ((I_FILE_NUM < 10)) THEN
  sv_s = INT_TO_STRG(I_FILE_NUM)
  ST_FILE_NUM = '0' + sv_s
  ELSE
  sv_s = INT_TO_STRG(I_FILE_NUM)
  ST_FILE_NUM = sv_s
  ENDIF
  sv_i = COPY_CMD('logbook.ls', 'MD:\', DEVICE + ':\logbook\logbook_' + ST_FILE_NUM + '\')
  -- stmt167 stray sv_i
  -- stmt167 residue 'MD:\\', ':\\logbook\\logbook_', '\\'
  I_FILE_NUM = I_FILE_NUM + 1
  IF ((I_FILE_NUM > 10)) THEN
  I_FILE_NUM = 1
  ENDIF
  ENABLE CONDITION[1]
  RETURN(0)
END BACKUPLOG

ROUTINE BACKUPRESET : INTEGER
BEGIN
  IF ((B_LOGBOOK_USE <> 0)) THEN
  B_BACKUP_DONE = 0
  ENDIF
  RETURN(0)
END BACKUPRESET

