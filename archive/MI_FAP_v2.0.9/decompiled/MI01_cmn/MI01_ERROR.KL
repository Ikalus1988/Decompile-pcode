ROUTINE PRIOERROR_652 : INTEGER
BEGIN
  IF ((B_PRIO_USE <> 0)) THEN
  IF ((AR_B_PRIO[10] <> 0)) THEN
  POST_ERR(38100, 'Profinet Error', 0, 1)
  ENDIF
  ENDIF
  ENABLE CONDITION[1]
  sv_i = INITLOALVARS
  -- stmt100 stray sv_i
  B_MONITOR = 1
  B_BACKUP_DONE = 1
  sv_i = FOLDER_CMD
  -- stmt104 stray sv_i
  PURGE CONDITION[1]
  -- stmt107 stray 1 | 148005
  ENABLE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt113 stray 2 | 13000 + 602 | 13000 + 604 | 13000 + 610 | 13000 + 619 | 13000 + 620 | 13000 + 621 | 13000 + 622 | 13000 + 623 | 13000 + 651 | 13000 + 652
  ENABLE CONDITION[1]
  IF ((B_MONITOR <> 0)) THEN
  IF ((B_LOGBOOK_USE <> 0)) THEN
  IF ((B_BACKUP_DONE = 0)) THEN
  sv_i = BACKUPLOG
  -- stmt130 stray sv_i
  B_BACKUP_DONE = 1
  ENDIF
  ENDIF
  DELAY 256
  ELSE
  ENDIF
  RETURN(0)
END PRIOERROR_652

