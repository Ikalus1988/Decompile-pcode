ROUTINE IO_INIT : INTEGER
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
BEGIN
  FOR r0_lc2 = 1 TO 3 DO
  SET_PORT_ASG(21, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  ENDFOR
  FOR r0_lc2 = 1 TO 3 DO
  SET_PORT_ASG(20, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  ENDFOR
  FOR r0_lc2 = 1 TO 3 DO
  SET_PORT_ASG(1, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  SET_PORT_ASG(2, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  ENDFOR
  FOR r0_lc2 = 1 TO 3 DO
  SET_PORT_ASG(18, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  SET_PORT_ASG(19, r0_lc2, 0, 0, 0, 0, 0, r0_lc1)
  ENDFOR
  RETURN(0)
END IO_INIT

