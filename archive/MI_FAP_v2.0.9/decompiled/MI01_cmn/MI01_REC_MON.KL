ROUTINE INITLOALVARS : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  IF (UNINIT(I_SCAN_TIME)) THEN
  I_SCAN_TIME = 60
  ENDIF
  IF (UNINIT(I_PULSE_TIME)) THEN
  I_PULSE_TIME = 30
  ENDIF
  FOR r0_lc1 = 1 TO 3 DO
  IF (UNINIT(AR_ST_PROGNAME[r0_lc1])) THEN
  AR_ST_PROGNAME[r0_lc1] = '************************'
  ENDIF
  ENDFOR
  RETURN(0)
END INITLOALVARS

ROUTINE SETSTATUS : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
BEGIN
  FOR r1_lc1 = 1 TO 3 DO
  r1_lc2 = 0
  IF (NOT (UNINIT(AR_ST_PROGNAME[r1_lc1]))) THEN
  IF (('' <> '')) THEN
  IF (NOT (UNINIT(AR_I_PINCODE[r1_lc1]))) THEN
  IF ((AR_I_PINCODE[r1_lc1] > 0)) THEN
  r1_lc2 = 1
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  IF ((r1_lc2 <> 0)) THEN
  AR_ST_STATUS[r1_lc1] = 'ING'
  ELSE
  AR_ST_STATUS[r1_lc1] = '***'
  ENDIF
  ENDFOR
  RETURN(0)
END SETSTATUS

ROUTINE GETBASICTIME : INTEGER
VAR
  r2_lc14 : STRING[64]
  r2_lc15 : INTEGER
  r2_lc16 : INTEGER
BEGIN
  FOR r2_lc15 = 1 TO 3 DO
  IF (NOT (UNINIT(AR_ST_PROGNAME[r2_lc15]))) THEN
  IF (sv_b) THEN
  IF (UNINIT(AR_ST_BASIC[r2_lc15])) THEN
  GET_ATTR_PRG('', 7, r2_lc16, r2_lc14, I_STATUS)
  -- 弃参原式: (AR_ST_PROGNAME[r2_lc15])
  CNV_TIME_STR(r2_lc16, r2_lc14)
  AR_ST_BASIC[r2_lc15] = r2_lc14
  ELSE
  IF (('' = '***')) THEN
  GET_ATTR_PRG('', 7, r2_lc16, r2_lc14, I_STATUS)
  -- 弃参原式: (AR_ST_PROGNAME[r2_lc15])
  CNV_TIME_STR(r2_lc16, r2_lc14)
  AR_ST_BASIC[r2_lc15] = r2_lc14
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  ENDFOR
  RETURN(0)
END GETBASICTIME

ROUTINE GETCURRENTTIME : INTEGER
VAR
  r3_lc14 : STRING[64]
  r3_lc15 : INTEGER
  r3_lc16 : INTEGER
BEGIN
  FOR r3_lc15 = 1 TO 3 DO
  IF (NOT (UNINIT(AR_ST_PROGNAME[r3_lc15]))) THEN
  IF (sv_b) THEN
  GET_ATTR_PRG('', 7, r3_lc16, r3_lc14, I_STATUS)
  -- 弃参原式: (AR_ST_PROGNAME[r3_lc15])
  CNV_TIME_STR(r3_lc16, r3_lc14)
  AR_ST_MODIFIED[r3_lc15] = r3_lc14
  ENDIF
  ENDIF
  ENDFOR
  RETURN(0)
END GETCURRENTTIME

ROUTINE SENDCODE(p0 : INTEGER) : INTEGER
VAR
  r4_lc10 : INTEGER
  r4_lc11 : INTEGER
  r4_lc9 : ARRAY[64] OF INTEGER
BEGIN
  r4_lc9[8] = p0 DIV 128
  r4_lc10 = p0 MOD 128
  r4_lc9[7] = r4_lc10 DIV 64
  r4_lc10 = r4_lc10 MOD 64
  r4_lc9[6] = r4_lc10 DIV 32
  r4_lc10 = r4_lc10 MOD 32
  r4_lc9[5] = r4_lc10 DIV 16
  r4_lc10 = r4_lc10 MOD 16
  r4_lc9[4] = r4_lc10 DIV 8
  r4_lc10 = r4_lc10 MOD 8
  r4_lc9[3] = r4_lc10 DIV 4
  r4_lc10 = r4_lc10 MOD 4
  r4_lc9[2] = r4_lc10 DIV 2
  r4_lc10 = r4_lc10 MOD 2
  r4_lc9[1] = r4_lc10
  IF (UNINIT(I_DO_START)) THEN
  I_DO_START = 193
  ENDIF
  FOR r4_lc11 = 1 TO 3 DO
  IF ((r4_lc9[r4_lc11] = 1)) THEN
  -- stmt174 residue 1000
  ENDIF
  ENDFOR
  DELAY I_PULSE_TIME * 1000
  RETURN(0)
END SENDCODE

ROUTINE COMPARETIME : INTEGER
VAR
  r5_lc1 : INTEGER
BEGIN
  FOR r5_lc1 = 1 TO 3 DO
  IF (NOT (UNINIT(AR_ST_BASIC[r5_lc1]))) THEN
  IF (NOT (UNINIT(AR_ST_MODIFIED[r5_lc1]))) THEN
  IF ((AR_ST_BASIC[r5_lc1] <> '')) THEN
  IF (NOT (UNINIT(AR_I_PINCODE[r5_lc1]))) THEN
  AR_ST_BASIC[r5_lc1] = ''
  -- stmt197 stray AR_ST_MODIFIED[r5_lc1]
  sv_i = SENDCODE((AR_I_PINCODE[r5_lc1]))
  -- stmt198 stray sv_i
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  ENDFOR
  B_REC_MON = 1
  sv_i = INITLOALVARS
  -- stmt213 stray sv_i
  I_TIMER = 0
  IF ((B_REC_MON <> 0)) THEN
  I_TIMER = 0
  sv_i = SETSTATUS
  -- stmt220 stray sv_i
  sv_i = GETBASICTIME
  -- stmt222 stray sv_i
  sv_i = GETCURRENTTIME
  -- stmt224 stray sv_i
  sv_i = COMPARETIME
  -- stmt226 stray sv_i
  ENDIF
  REPEAT
  DELAY 100
  UNTIL((B_REC_MON = 0) OR (I_TIMER > I_SCAN_TIME * 1000))
  -- stmt230 residue 1000
  RETURN(0)
END COMPARETIME

BEGIN
END MI01_REC_MON
