ROUTINE INITPLCIO : INTEGER
VAR
  r10_lc1 : INTEGER
  r10_lc2 : INTEGER
  r10_lc3 : INTEGER
BEGIN
  IF (UNINIT(POP_INTERVAL)) THEN
  POP_INTERVAL = 1024
  ENDIF
  IF ((io_02[I_MI01_DO + 7] = 0) AND (io_02[I_MI01_DO + 63] = 0)) THEN
  ENDIF
  REPEAT
  DELAY POP_INTERVAL
  sv_i = DB_PROMPT(0, 'Robot not in home or pounce', 'Move robot to home or pounce position', 0)
  r10_lc2 = sv_i
  UNTIL((io_02[I_MI01_DO + 7] <> 0) OR (io_02[I_MI01_DO + 63] <> 0))
  io_13[I_MI01_GO + 4] = 0
  io_13[I_MI01_GO + 5] = 0
  FOR r10_lc1 = 1 TO 3 DO
  io_02[I_MI01_DO + 89 + r10_lc1 - 1] = 0
  io_02[I_MI01_DO + 121 + r10_lc1 - 1] = 1
  ENDFOR
  FOR r10_lc1 = 1 TO 3 DO
  io_02[I_MI01_DO + 153 + r10_lc1 - 1] = 1
  ENDFOR
  io_02[I_MI01_DO + 42] = 0
  io_02[I_MI01_DO + 49] = 0
  io_02[I_MI01_DO + 50] = 0
  io_02[I_MI01_DO + 52] = 0
  io_02[I_MI01_DO + 53] = 0
  io_02[I_MI01_DO + 57] = 0
  io_02[I_MI01_DO + 58] = 0
  GET_VAR(1, 'APPS_LOADER', 'apps_lst[2].installed', r10_lc3, r10_lc2)
  IF ((r10_lc3 = 0)) THEN
  io_13[I_MI01_GO + 3] = 1
  ENDIF
  RETURN(0)
END INITPLCIO

ROUTINE REQCOLZONE(p0 : INTEGER) : INTEGER
VAR
  r11_lc1 : INTEGER
  r11_lc2 : INTEGER
BEGIN
  io_02[I_MI01_DO + 89 + p0 - 1] = 0
  r11_lc2 = 1
  LST_ERROR_f00[r11_lc2] = 'PLC'
  LST_ERROR_f10[r11_lc2] = 0
  LST_ERROR_f14[r11_lc2] = 'collision zone request'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r11_lc2] = 'collision zone[' + sv_s + ']' + 'is not ready'
  sv_i = WAIT_SIGNAL(r11_lc2, 1, I_MI01_DI + 89 + p0 - 1, 0, 3000, 2)
  r11_lc1 = sv_i
  io_02[I_MI01_DO + 89 + p0 - 1] = 1
  IF ((io_01[I_MI01_DI + 89 + p0 - 1] = 0)) THEN
  r11_lc2 = 2
  LST_ERROR_f00[r11_lc2] = 'PLC'
  LST_ERROR_f10[r11_lc2] = 0
  LST_ERROR_f14[r11_lc2] = 'collision zone request'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r11_lc2] = 'collision zone[' + sv_s + ']' + 'is occupied'
  sv_i = WAIT_SIGNAL(r11_lc2, 1, I_MI01_DI + 89 + p0 - 1, 1, 3000, 2)
  r11_lc1 = sv_i
  ENDIF
  io_02[I_MI01_DO + 89 + p0 - 1] = 0
  io_02[I_MI01_DO + 121 + p0 - 1] = 0
  IF ((io_01[I_MI01_DI + 89 + p0 - 1] = 0)) THEN
  r11_lc2 = 2
  LST_ERROR_f00[r11_lc2] = 'PLC'
  LST_ERROR_f10[r11_lc2] = 0
  LST_ERROR_f14[r11_lc2] = 'collision zone request'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r11_lc2] = 'collision zone[' + sv_s + ']' + 'is occupied'
  sv_i = WAIT_SIGNAL(r11_lc2, 1, I_MI01_DI + 89 + p0 - 1, 1, 3000, 2)
  r11_lc1 = sv_i
  ENDIF
  RETURN(0)
END REQCOLZONE

