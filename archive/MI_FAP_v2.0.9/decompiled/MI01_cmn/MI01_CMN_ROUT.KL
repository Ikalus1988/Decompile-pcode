  LST_ERROR_f10[r18_lc2] = 0
  LST_ERROR_f14[r18_lc2] = 'RIP Flow NOK'
  LST_ERROR_f38[r18_lc2] = 'RIP Flow is not OK'
  sv_i = WAIT_SIGNAL(r18_lc2, 1, I_MI01_FS_DI + 1, 1, 3000, 2)
  r18_lc1 = sv_i
  ENDIF
  CASE(3):
  io_02[I_MI01_FS_DO + 2] = 1
  -- stmt178 residue 3000
  IF ((io_01[I_MI01_FS_DI + 2] = 0)) THEN
  r18_lc2 = 5
  LST_ERROR_f00[r18_lc2] = 'PLC-RIP'
  LST_ERROR_f10[r18_lc2] = 0
  LST_ERROR_f14[r18_lc2] = 'RIP Valve Error'
  LST_ERROR_f38[r18_lc2] = 'RIP Valve not closed'
  sv_i = WAIT_SIGNAL(r18_lc2, 1, I_MI01_FS_DI + 2, 1, 3000, 2)
  r18_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI01_FS_DI + 1] <> 0)) THEN
  r18_lc2 = 5
  LST_ERROR_f00[r18_lc2] = 'PLC-RIP'
  LST_ERROR_f10[r18_lc2] = 0
  LST_ERROR_f14[r18_lc2] = 'RIP Flow NOK'
  LST_ERROR_f38[r18_lc2] = 'RIP Flow is not OK'
  sv_i = WAIT_SIGNAL(r18_lc2, 1, I_MI01_FS_DI + 1, 0, 3000, 2)
  r18_lc1 = sv_i
  ENDIF
  IF (UNINIT(I_PRIEM_PUMP_PULSE)) THEN
  I_PRIEM_PUMP_PULSE = 5
  ENDIF
  IF (UNINIT(I_PRIEM_PUMP_DO)) THEN
  I_PRIEM_PUMP_DO = 2938
  ENDIF
  r18_lc3 = I_PRIEM_PUMP_PULSE * 1000
  io_02[I_PRIEM_PUMP_DO] = 1
  ELSE:
  ENDSELECT
  RETURN(0)
END MI01_RIP_CHECK

ROUTINE BSN_ENABLE : INTEGER
BEGIN
  -- stmt221 residue 5000
  RETURN(0)
END BSN_ENABLE

ROUTINE PROGNUMBERCHECK(p0 : INTEGER) : INTEGER
VAR
  r20_lc1 : INTEGER
BEGIN
  r20_lc1 = io_12[I_MI01_GI + 1]
  IF ((p0 <> r20_lc1)) THEN
  sv_i = MI01_GIMSGOUT(I_MI01_GI + 1, p0, 3000, 0, 'Wait Prog Num')
  -- stmt238 stray sv_i
  ENDIF
  RETURN(0)
END PROGNUMBERCHECK

BEGIN
END MI01_CMN_ROUT
