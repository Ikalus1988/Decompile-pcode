ROUTINE SEGMENTECHO(p0 : INTEGER) : INTEGER
VAR
  r13_lc4 : INTEGER
BEGIN
  io_13[I_MI01_GO + 4] = p0
  sv_i = MI01_GIMSGOUT(I_MI01_GI + 4, p0, 3000, 0, 'Wait Segment')
  -- stmt224 stray sv_i
  IF (UNINIT(POP_INTERVAL)) THEN
  POP_INTERVAL = 1024
  ENDIF
  IF ((io_02[I_MI01_DO + 8] <> 0)) THEN
  ENDIF
  REPEAT
  DELAY POP_INTERVAL
  sv_i = DB_PROMPT(2, 'Need to choose', 'Segment fulfilled, continue?', 3)
  r13_lc4 = sv_i
  UNTIL((io_02[I_MI01_DO + 8] = 0) OR (r13_lc4 = 3))
  RETURN(0)
  RETURN(0)
END SEGMENTECHO

ROUTINE DECCODESET(p0, p1 : INTEGER) : INTEGER
VAR
  r14_lc1 : INTEGER
  r14_lc2 : INTEGER
  r14_lc3 : INTEGER
BEGIN
  r14_lc2 = io_12[I_MI01_GI + 5]
  SELECT p0 OF
  CASE(1):
  IF ((r14_lc2 = 0)) THEN
  r14_lc1 = 1
  I_PROCESSTIM = 0
  ENDIF
  REPEAT
  DELAY 16
  r14_lc2 = io_12[I_MI01_GI + 5]
  UNTIL((r14_lc2 > 0) OR (I_PROCESSTIM > I_DECICODE_TIMEOUT))
  IF ((I_PROCESSTIM > I_DECICODE_TIMEOUT) AND (r14_lc1 = 1)) THEN
  r14_lc1 = 0
  io_13[I_MI01_GO + 6] = 3
  POST_ERR(38100, 'Decision Code is Zero', 0, 0)
  ENDIF
  IF ((r14_lc2 > 0)) THEN
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  SET_INT_REG(p1, r14_lc2, r14_lc3)
  CASE(2):
  IF ((p1 <> r14_lc2)) THEN
  I_GO_ERROR_NUM = 4
  sv_i = MI01_GIMSGOUT(I_MI01_GI + 5, p1, 3000, 0, 'Wait DecCode')
  -- stmt38 stray sv_i
  ENDIF
  io_13[I_MI01_GO + 5] = p1
  ELSE:
  ENDSELECT
  RETURN(0)
END DECCODESET

