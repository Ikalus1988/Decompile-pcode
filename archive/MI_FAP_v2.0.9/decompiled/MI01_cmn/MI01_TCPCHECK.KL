ROUTINE INITPLCIO(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE REQCOLZONE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE RELCOLZONE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE SEGMENTECHO(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DECCODESET(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE FIXTURESET(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
