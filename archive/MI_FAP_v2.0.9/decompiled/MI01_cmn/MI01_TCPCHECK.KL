ROUTINE MI01_RIP_CHECK(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE BSN_ENABLE(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE PROGNUMBERCHECK(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE CURRENTUT : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  r0_lc1 = 0
  -- stmt63 stray v1[1]
  RETURN(r0_lc1)
  RETURN(0)
END CURRENTUT

ROUTINE CURRENTUF : INTEGER
VAR
  r1_lc1 : INTEGER
BEGIN
  r1_lc1 = 0
  -- stmt78 stray v2[1]
  RETURN(r1_lc1)
  RETURN(0)
END CURRENTUF

ROUTINE GETCURRENTPOS : POSITION
VAR
  r2_lc15 : POSITION
  r2_lc30 : POSITION
  r2_lc45 : POSITION
  r2_lc60 : POSITION
  r2_lc69 : POSITION
  r2_lc70 : INTEGER
  r2_lc71 : INTEGER
  r2_lc72 : INTEGER
BEGIN
  r2_lc70 = 0
  -- stmt97 stray v2[1]
  r2_lc71 = 0
  -- stmt98 stray v1[1]
  IF ((r2_lc70 <> 0)) THEN
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt101 residue '*SYSTEM*', '$MNUFRAME[1,', ']'
  ELSE
  PURGE CONDITION[1]
  r2_lc15 = v3_f00[1]
  ENDIF
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt105 residue '*SYSTEM*', '$MNUTOOL[1,', ']'
  PURGE CONDITION[1]
  r2_lc45 = v0_f1c[1]
  PURGE CONDITION[1]
  r2_lc60 = v0_f58[1]
  PURGE CONDITION[1]
  -- stmt108 stray r2_lc15 | v0_f1c[1]
  PURGE CONDITION[1]
  -- stmt109 stray r2_lc30 | v0_f58[1]
  sv_p = curpos(0, 0)
  r2_lc69 = sv_p
  PURGE CONDITION[1]
  -- stmt111 stray r2_lc45 | v0_f1c[1]
  PURGE CONDITION[1]
  -- stmt112 stray r2_lc60 | v0_f58[1]
  -- stmt113 stray r2_lc69
  RETURN(sv_p)
END GETCURRENTPOS

ROUTINE CHECKFRAMENO(p0, p1 : INTEGER) : INTEGER
VAR
  r3_lc1 : INTEGER
  r3_lc2 : INTEGER
  r3_lc3 : INTEGER
BEGIN
  SELECT p0 OF
  CASE(1):
  GET_VAR(1, '*SYSTEM*', '$SCR.$MAXNUMUTOOL', r3_lc2, r3_lc3)
  IF ((p1 > r3_lc2)) THEN
  POST_ERR(38100, 'UTOOL Number exceed the max value', 0, 2)
  ENDIF
  CASE(2):
  GET_VAR(1, '*SYSTEM*', '$SCR.$MAXNUMUFRAM', r3_lc1, r3_lc3)
  IF ((p1 > r3_lc1)) THEN
  POST_ERR(38100, 'UFRAME Number exceed the max value', 0, 2)
  ENDIF
  ELSE:
  ENDSELECT
  RETURN(0)
END CHECKFRAMENO

ROUTINE ACTIONSELECT : INTEGER
VAR
  r4_lc100 : POSITION
  r4_lc101 : INTEGER
  r4_lc102 : INTEGER
  r4_lc103 : INTEGER
  r4_lc104 : INTEGER
  r4_lc105 : INTEGER
  r4_lc106 : INTEGER
  r4_lc107 : INTEGER
  r4_lc108 : INTEGER
  r4_lc109 : INTEGER
  r4_lc14 : STRING[64]
  r4_lc28 : STRING[64]
  r4_lc43 : POSITION
  r4_lc58 : POSITION
  r4_lc73 : POSITION
  r4_lc82 : POSITION
  r4_lc91 : POSITION
BEGIN
  sv_i = GETTPEPRMINT(1)
  r4_lc101 = sv_i
  sv_i = GETTPEPRMINT(2)
  r4_lc102 = sv_i
  sv_i = CHECKFRAMENO(2, r4_lc102)
  -- stmt174 stray sv_i
  IF ((r4_lc102 <> sv_i)) THEN
  DELAY 8
  r4_lc14 = 'UF Number not equal to active UF number'
  sv_i = CURRENTUF
  sv_s = INTTOSTR(sv_i)
  r4_lc28 = 'Change UF to ' + sv_s + ' and record? '
  sv_i = DB_PROMPT(1, r4_lc14, r4_lc28, 2)
  r4_lc106 = sv_i
  IF ((r4_lc106 = 1)) THEN
  sv_i = CURRENTUF
  r4_lc102 = sv_i
  ELSE
  ABORT
  ENDIF
  ENDIF
  sv_i = GETTPEPRMINT(3)
  r4_lc103 = sv_i
  sv_i = CHECKFRAMENO(1, r4_lc103)
  -- stmt187 stray sv_i
  IF ((r4_lc103 <> sv_i)) THEN
  DELAY 8
  r4_lc14 = 'UT Number not equal to active UT number'
  sv_i = CURRENTUT
  sv_s = INTTOSTR(sv_i)
  r4_lc28 = 'Change UT to ' + sv_s + ' and record?'
  sv_i = DB_PROMPT(1, r4_lc14, r4_lc28, 2)
  r4_lc106 = sv_i
  IF ((r4_lc106 = 1)) THEN
  sv_i = CURRENTUT
  r4_lc103 = sv_i
  ELSE
  ABORT
  ENDIF
  ENDIF
  SELECT r4_lc101 OF
  CASE(1):
  sv_i = GETTPEPRMINT(4)
  r4_lc104 = sv_i
  sv_p = GETCURRENTPOS
  v4 = sv_p
  SET_POS_REG(r4_lc104, v4, v5)
  CASE(2):
  sv_i = GETTPEPRMINT(4)
  r4_lc107 = sv_i
  sv_i = CHECKFRAMENO(1, r4_lc107)
  -- stmt210 stray sv_i
  IF ((r4_lc107 = r4_lc103)) THEN
  POST_ERR(38100, 'Suggest to use another UTool as backup', 0, 2)
  ENDIF
  sv_i = GETTPEPRMINT(5)
  r4_lc108 = sv_i
  sv_i = CHECKFRAMENO(1, r4_lc108)
  -- stmt217 stray sv_i
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt218 residue '*SYSTEM*', '$MNUTOOL[1,', ']'
  sv_s = INTTOSTR(1)
  SET_VAR(0, '', '', 0, 0)
  -- stmt219 residue '*SYSTEM*', '$MNUTOOL[1,', ']'
  IF ((r4_lc102 <> 0)) THEN
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt223 residue '*SYSTEM*', '$MNUFRAME[1,', ']'
  ELSE
  PURGE CONDITION[1]
  r4_lc58 = v3_f00[1]
  ENDIF
  sv_p = curpos(0, 0)
  r4_lc82 = sv_p
  sv_p = inv(r4_lc82)
  r4_lc73 = v4
  -- stmt229 stray sv_p | r4_lc58
  r4_lc91 = r4_lc43
  r4_lc100 = r4_lc73
  r4_lc109 = 1
  IF ((0 > 2)) THEN
  DELAY 8
  r4_lc14 = 'Force to update?'
  sv_s = REALTOSTR(r4_lc100_f08 - r4_lc91_f08)
  r4_lc28 = 'The diffence of X direction is about ' + sv_s + ' mm'
  sv_i = DB_PROMPT(1, r4_lc14, r4_lc28, 2)
  r4_lc106 = sv_i
  IF ((r4_lc106 = 2)) THEN
  r4_lc109 = 0
  ENDIF
  ENDIF
  IF ((0 > 2)) THEN
  DELAY 8
  r4_lc14 = 'Force to update?'
  sv_s = REALTOSTR(r4_lc100_f0c - r4_lc91_f0c)
  r4_lc28 = 'The diffence of Y direction is about ' + sv_s + ' mm'
  sv_i = DB_PROMPT(1, r4_lc14, r4_lc28, 2)
  r4_lc106 = sv_i
  IF ((r4_lc106 = 2)) THEN
  r4_lc109 = 0
  ENDIF
  ENDIF
  IF ((0 > 2)) THEN
  DELAY 8
  r4_lc14 = 'Force to update?'
  sv_s = REALTOSTR(r4_lc100_f10 - r4_lc91_f10)
  r4_lc28 = 'The diffence of Z direction is about ' + sv_s + ' mm'
  sv_i = DB_PROMPT(1, r4_lc14, r4_lc28, 2)
  r4_lc106 = sv_i
  IF ((r4_lc106 = 2)) THEN
  r4_lc109 = 0
  ENDIF
  ENDIF
  IF ((r4_lc109 <> 0)) THEN
  sv_s = INTTOSTR(1)
  SET_VAR(0, '', '', 0, 0)
  -- stmt7 residue '*SYSTEM*', '$MNUTOOL[1,', ']'
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
  -- Æú²ÎÔ­Ê½: 0
  -- stmt8 stray '' + sv_s + '] successfully'
  -- stmt8 residue 'UTool update to ['
  ELSE
  POST_ERR(38100, 'Cancel to update UTool', 0, 0)
  ENDIF
  ELSE:
  ENDSELECT
  sv_i = ACTIONSELECT
  -- stmt26 stray sv_i
  RETURN(0)
END ACTIONSELECT

BEGIN
END MI01_TCPCHECK
