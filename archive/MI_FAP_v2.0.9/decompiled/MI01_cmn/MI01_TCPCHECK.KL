ROUTINE CHECKHOMEPOS(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE CURR_LANG(p0 : INTEGER) : STRING FROM MI_LIB
ROUTINE DO_COPY(p0, p1, p2 : STRING) : INTEGER FROM MI_LIB
ROUTINE GET_YN(p0 : STRING) : BOOLEAN FROM MI_LIB
ROUTINE CONV_P_LTYP(p0 : STRING) : INTEGER FROM MI_LIB
ROUTINE CHECKARGTYPE(p0, p1 : INTEGER) : BOOLEAN FROM MI_LIB
ROUTINE GETTPEPARAM(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
