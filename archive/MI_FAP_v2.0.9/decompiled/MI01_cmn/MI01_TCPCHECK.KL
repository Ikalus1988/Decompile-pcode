-- MI01_TCPCHECK.KL (decompiled v3)
PROGRAM MI01_TCPCHECK
%COMMENT = 'MI01 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  v1 : ARRAY[64] OF INTEGER
  v2 : ARRAY[64] OF INTEGER
  v3 : ARRAY[64] OF INTEGER
  v4 : POSITION
  v5 : INTEGER
  r4_lc100_f08 : INTEGER
  r4_lc100_f0c : INTEGER
  r4_lc100_f10 : INTEGER
  r4_lc91_f08 : INTEGER
  r4_lc91_f0c : INTEGER
  r4_lc91_f10 : INTEGER
  v0_f1c : ARRAY[64] OF INTEGER
  v0_f58 : ARRAY[64] OF INTEGER
  v3_f00 : ARRAY[64] OF INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE KILLBLANKS(p0 : STRING) : STRING FROM MI_LIB
ROUTINE STRTOINT(p0 : STRING) : INTEGER FROM MI_LIB
