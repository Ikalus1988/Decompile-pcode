ROUTINE KILLBLANKS(p0 : STRING) : STRING
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
  r0_lc3 : INTEGER
BEGIN
  sv_i = str_len(p0)
  FOR r0_lc1 = 1 TO 3 DO
  IF ((sv_i <> sv_i) AND (sv_i <> 9)) THEN
  r0_lc2 = r0_lc1
  sv_i = str_len(p0)
  r0_lc1 = sv_i
  ENDIF
  ENDFOR
  sv_i = str_len(p0)
  r0_lc1 = sv_i
  FOR r0_lc1 = 1 TO 3 DO
  IF ((sv_i <> sv_i) AND (sv_i <> 9)) THEN
  r0_lc3 = r0_lc1
  r0_lc1 = 1
  ENDIF
  ENDFOR
  sv_s = sub_str(p0, r0_lc2, r0_lc3 - r0_lc2 + 1)
  -- stmt152 stray sv_s
  RETURN(sv_s)
END KILLBLANKS

ROUTINE KILLPATH(p0 : STRING) : STRING
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
BEGIN
  r1_lc2 = 0
  sv_i = str_len(p0)
  FOR r1_lc1 = 1 TO 3 DO
  IF ((sv_s = '\')) THEN
  r1_lc2 = r1_lc1
  ENDIF
  ENDFOR
  IF ((r1_lc2 = 0)) THEN
  -- stmt173 stray p0
  ELSE
  sv_i = str_len(p0)
  sv_s = sub_str(p0, r1_lc2 + 1, sv_i - r1_lc2)
  -- stmt175 stray sv_s
  ENDIF
  RETURN(sv_s)
END KILLPATH

ROUTINE KILLTYPE(p0 : STRING) : STRING
VAR
  r2_lc1 : INTEGER
  r2_lc2 : INTEGER
BEGIN
  r2_lc2 = 0
  sv_i = str_len(p0)
  FOR r2_lc1 = 1 TO 3 DO
  IF ((sv_s = '.')) THEN
  r2_lc2 = r2_lc1
  ENDIF
  ENDFOR
  IF ((r2_lc2 = 0)) THEN
  -- stmt198 stray p0
  ELSE
  sv_s = sub_str(p0, 1, r2_lc2 - 1)
  -- stmt200 stray sv_s
  ENDIF
  RETURN(sv_s)
END KILLTYPE

ROUTINE DO_COPY(p0, p1, p2 : STRING) : INTEGER
VAR
  r3_lc17 : STRING[64]
  r3_lc34 : STRING[64]
BEGIN
  r3_lc17 = ''
  sv_s = KILLPATH(p0)
  r3_lc34 = ''
  sv_s = chr(128)
  WRITE(sv_s)
  COPY_FILE(r3_lc17, r3_lc34, (1 <> 0), (0 <> 0), v1)
  -- Æú²ÎÔ­Ê½: 1 | 0
  IF ((v1 <> 0)) THEN
  POST_ERR(v1, '', 0, 0)
  POST_ERR(38100, 'Failed to copy ' + p0, 0, 0)
  WRITE(CR, 'Failed to copy ' + p0)
  ELSE
  POST_ERR(38100, 'Copied File ' + p0 + ' Complete', 0, 0)
  WRITE(CR, 'Copied File ' + p0 + ' Complete')
  DELAY 500
  ENDIF
  RETURN(0)
END DO_COPY

ROUTINE INTTOSTR(p0 : INTEGER) : STRING
VAR
  r4_lc17 : STRING[64]
BEGIN
  CNV_INT_STR(p0, 0, 0, r4_lc17)
  sv_s = KILLBLANKS(r4_lc17)
  -- stmt244 stray sv_s
  RETURN(sv_s)
END INTTOSTR

ROUTINE SET_USERSCREEN : INTEGER
VAR
  r5_lc1 : INTEGER
  r5_lc2 : INTEGER
  r5_lc3 : INTEGER
  r5_lc4 : INTEGER
  r5_lc5 : INTEGER
BEGIN
  GET_DEV_INFO(r5_lc1, r5_lc2, r5_lc3, r5_lc4, r5_lc5, v1)
  v3 = v2_f04[r5_lc2]
  v4 = v2_f08[r5_lc2]
  SELECT r5_lc2 OF
  CASE(1):
  v5 = 1
  CASE(2):
  v5 = 2
  CASE(3):
  v5 = 3
  ELSE:
  v5 = 1
  ENDSELECT
  FORCE_SPMENU(v5, 190, 1)
  RETURN(0)
END SET_USERSCREEN

ROUTINE GET_PANEMAP : INTEGER
VAR
  r6_lc1 : INTEGER
  r6_lc2 : INTEGER
  r6_lc3 : INTEGER
  r6_lc4 : INTEGER
BEGIN
  r6_lc3 = 0
  FOR r6_lc1 = 1 TO 3 DO
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt39 residue '*SYSTEM*', '$UI_CONFIG.$PANEMAP[', ']'
  r6_lc3 = r6_lc3 + r6_lc2
  ENDFOR
  GET_VAR(1, '*SYSTEM*', '$UI_CONFIG.$ENB_WIDE[1]', v6, r6_lc4)
  RETURN(r6_lc3)
  RETURN(0)
END GET_PANEMAP

ROUTINE PANEMAP_CHG : BOOLEAN
VAR
  r7_lc1 : INTEGER
  r7_lc2 : INTEGER
  r7_lc3 : INTEGER
  r7_lc4 : INTEGER
  r7_lc5 : INTEGER
BEGIN
  DELAY 100
  r7_lc3 = 0
  FOR r7_lc1 = 1 TO 3 DO
  sv_s = INTTOSTR(1)
  GET_VAR(0, '', '', 0, 0)
  -- stmt64 residue '*SYSTEM*', '$UI_CONFIG.$PANEMAP[', ']'
  r7_lc3 = r7_lc3 + r7_lc2
  ENDFOR
  IF ((r7_lc3 <> v7)) THEN
  RETURN(TRUE)
  ENDIF
  GET_VAR(1, '*SYSTEM*', '$UI_CONFIG.$ENB_WIDE[1]', r7_lc4, r7_lc5)
  IF ((r7_lc4 <> v6)) THEN
  RETURN(TRUE)
  ENDIF
  RETURN(FALSE)
  RETURN(sv_b)
END PANEMAP_CHG

ROUTINE POP_CONFIRM(p0, p1 : STRING) : INTEGER
VAR
  r8_lc1 : INTEGER
BEGIN
  r8_lc1 = 0
  DELAY 64
  REPEAT
  sv_i = DB_PROMPT(0, p0, p1, 7)
  r8_lc1 = sv_i
  DELAY 64
  UNTIL((r8_lc1 = 1))
  RETURN(0)
END POP_CONFIRM

