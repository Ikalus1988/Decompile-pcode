END CONV_PTYP_L

ROUTINE CONV_ST_PTYP(p0 : STRING) : INTEGER
BEGIN
  IF ((p0 = 'DIN')) THEN
  RETURN(1)
  ENDIF
  IF ((p0 = 'DOUT')) THEN
  RETURN(2)
  ENDIF
  IF ((p0 = 'GIN')) THEN
  RETURN(18)
  ENDIF
  IF ((p0 = 'GOUT')) THEN
  RETURN(19)
  ENDIF
  IF ((p0 = 'AIN')) THEN
  RETURN(3)
  ENDIF
  IF ((p0 = 'AOUT')) THEN
  RETURN(4)
  ENDIF
  IF ((p0 = 'FLAG')) THEN
  RETURN(35)
  ENDIF
  RETURN(0)
  RETURN(0)
END CONV_ST_PTYP

ROUTINE CUTCOMMENT(p0 : STRING; p1 : INTEGER) : STRING
BEGIN
  IF ((sv_i <= p1)) THEN
  -- stmt139 stray p0
  ELSE
  sv_s = sub_str(p0, 1, p1)
  -- stmt141 stray sv_s
  ENDIF
  RETURN(sv_s)
END CUTCOMMENT

ROUTINE WRITE_PORT_CMT(p0, p1, p2 : INTEGER; p3 : STRING) : INTEGER
BEGIN
  IF ((p0 = 0)) THEN
  sv_s = CONV_PTYP_L(p1)
  sv_s = INTTOSTR(p2)
  WRITE(' <USER_MESS port_type="' + sv_s + '" port_no="' + sv_s + '" comment="' + p3 + '"/>', CR)
  -- stmt156 stray XML_FILE
  ENDIF
  RETURN(0)
END WRITE_PORT_CMT

ROUTINE SET_ASG(p0, p1, p2, p3, p4, p5 : INTEGER) : INTEGER
BEGIN
  SELECT p0 OF
  CASE(1):
  CASE(18):
  SET_PORT_ASG(p0, p1, p2, p3, 1, p4, p5, L_STATE)
  CASE(2):
  CASE(19):
  SET_PORT_ASG(p0, p1, p2, p3, 2, p4, p5, L_STATE)
  ELSE:
  ENDSELECT
  RETURN(0)
END SET_ASG

