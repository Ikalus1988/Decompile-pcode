  ENDIF
  IF (UNINIT(BL_LOAD_COMMENT)) THEN
  BL_LOAD_COMMENT = 0
  ENDIF
  IF (UNINIT(BL_ASSIGN_IO)) THEN
  BL_ASSIGN_IO = 0
  ENDIF
  IF (UNINIT(FUNC_TYPE)) THEN
  FUNC_TYPE = (0 - 1)
  ENDIF
  SELECT FUNC_TYPE OF
  CASE(1):
  IF ((BL_LOAD_COMMENT <> 0)) THEN
  FILE_PATH = ''
