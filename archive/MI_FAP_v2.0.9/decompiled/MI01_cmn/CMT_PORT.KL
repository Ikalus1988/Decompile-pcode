ROUTINE CONV_L_PTYP(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 = 1)) THEN
  RETURN(1)
  ENDIF
  IF ((p0 = 2)) THEN
  RETURN(2)
  ENDIF
  IF ((p0 = 3)) THEN
  RETURN(18)
  ENDIF
  IF ((p0 = 4)) THEN
  RETURN(19)
  ENDIF
  RETURN(0)
END CONV_L_PTYP

