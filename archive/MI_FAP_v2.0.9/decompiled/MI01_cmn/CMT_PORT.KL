  sv_i = WRITE_PORT_CMT(L_STATE, 2, r7_lc35, r7_lc34)
  -- stmt114 stray sv_i
  ENDFOR
  FOR r7_lc35 = 1 TO 3 DO
  GET_PORT_CMT(18, r7_lc35, r7_lc34, L_STATE)
  sv_i = WRITE_PORT_CMT(L_STATE, 3, r7_lc35, r7_lc34)
  -- stmt118 stray sv_i
