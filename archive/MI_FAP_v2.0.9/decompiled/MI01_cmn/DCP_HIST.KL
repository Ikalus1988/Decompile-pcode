  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE FEATURE(p0 : STRING) : BOOLEAN FROM MI_LIB

ROUTINE CURR_LANG : STRING
VAR
  r0_lc4 : STRING[64]
  r0_lc5 : INTEGER
BEGIN
  sv_i = index(v1, ' ')
  r0_lc5 = sv_i
  sv_s = sub_str(v1, 1, r0_lc5 - 1)
  r0_lc4 = sv_s
  IF ((r0_lc4 <> 'DEFAULT')) THEN
  -- stmt99 stray r0_lc4
  ELSE
  IF (sv_b AND sv_b) THEN
  SET_LANG('ENGLISH     ', v2)
  -- stmt105 stray 'ENGLISH     '
  ELSE
  IF (sv_b) THEN
  SET_LANG('CHINESE     ', v2)
  -- stmt109 stray 'CHINESE     '
  ELSE
  SET_LANG('ENGLISH     ', v2)
  -- stmt112 stray 'ENGLISH     '
  ENDIF
  ENDIF
  ENDIF
  RETURN(sv_s)
END CURR_LANG

ROUTINE LOAD_TX(p0, p1 : STRING) : INTEGER
VAR
  r1_lc9 : STRING[64]
BEGIN
  r1_lc9 = 'FR:\' + p1
  -- stmt129 residue 'FR:\\'
  IF ((sv_s = 'ENGLISH')) THEN
  ADD_DICT(r1_lc9, p0, 'ENGLISH     ', 4, v2)
  ELSE
  IF ((sv_s = 'CHINESE')) THEN
  ADD_DICT(r1_lc9, p0, 'CHINESE     ', 4, v2)
  ENDIF
  ENDIF
  IF ((v2 <> 0)) THEN
  POST_ERR(38100, 'Failed to load dict ' + p0, 0, 0)
  ELSE
  ENDIF
  RETURN(0)
END LOAD_TX

ROUTINE SET_USERSCREEN : INTEGER
VAR
  r2_lc1 : INTEGER
  r2_lc2 : INTEGER
  r2_lc3 : INTEGER
  r2_lc4 : INTEGER
  r2_lc5 : INTEGER
BEGIN
  GET_DEV_INFO(r2_lc1, r2_lc2, r2_lc3, r2_lc4, r2_lc5, v2)
  v4 = v3_f04[r2_lc2]
  v5 = v3_f08[r2_lc2]
  SELECT r2_lc2 OF
  CASE(1):
  v6 = 1
  CASE(2):
  v6 = 2
  CASE(3):
  v6 = 3
  ELSE:
  v6 = 1
  ENDSELECT
  FORCE_SPMENU(v6, 190, 1)
  RETURN(0)
END SET_USERSCREEN

ROUTINE PARSE_MSG(p0 : STRING) : INTEGER
VAR
  r3_lc33 : STRING[64]
BEGIN
  v7_f04[1] = ''
  v7_f88[1] = ''
  v1 = ''
  -- stmt198 stray '' | v7[1]
  v1 = ''
  -- stmt199 stray '' | v7[1]
  v1 = ''
  -- stmt200 stray '' | v7[1]
  IF ((sv_i > 40)) THEN
  sv_s = sub_str(p0, 1, 40)
  v7_f04[1] = sv_s
  sv_i = str_len(p0)
  sv_s = sub_str(p0, 41, sv_i)
  r3_lc33 = sv_s
  IF ((sv_i > 40)) THEN
  sv_s = sub_str(p0, 41, 40)
  v7_f88[1] = sv_s
  sv_i = str_len(p0)
  sv_s = sub_str(p0, 81, sv_i)
  r3_lc33 = sv_s
  IF ((sv_i > 40)) THEN
  POST_ERR(38100, 'User: Msg lenght too long', 0, 0)
  ELSE
  v1 = ''
  -- stmt213 stray r3_lc33 | v7[1]
  ENDIF
  v7_f88[1] = r3_lc33
  ENDIF
  v7_f04[1] = p0
  ENDIF
  RETURN(0)
END PARSE_MSG

ROUTINE INIT : INTEGER
BEGIN
  FOR v8 = 1 TO 3 DO
  IF (UNINIT(v7_f00[v8])) THEN
  v7_f00[v8] = 0
  ENDIF
  IF (UNINIT(v7_f04[v8])) THEN
  v7_f04[v8] = 'No History Data'
  ENDIF
  IF (UNINIT(v7_f88[v8])) THEN
  v7_f88[v8] = 'No History Data'
  ENDIF
  IF (UNINIT(0)) THEN
  v1 = ''
  -- stmt242 stray 'No History Data' | v7[v8]
  ENDIF
  IF (UNINIT(0)) THEN
  v1 = ''
  -- stmt243 stray 'No History Data' | v7[v8]
  ENDIF
  IF (UNINIT(0)) THEN
  v1 = ''
  -- stmt244 stray 'No History Data' | v7[v8]
  ENDIF
  IF (UNINIT(v9[v8])) THEN
  v9[v8] = ''
  ENDIF
  ENDFOR
  RETURN(0)
END INIT

ROUTINE DCPFAULTREFRESH(p0 : INTEGER; p1 : STRING) : INTEGER
BEGIN
  GET_TIME(v10)
  CNV_TIME_STR(v10, v11)
  sv_i = INIT
  -- stmt8 stray sv_i
  FOR v8 = 20 TO 3 DO
  v7_f00[v8] = v7_f00[v8 - 1]
  v7_f04[v8] = v7_f04[v8 - 1]
  v7_f88[v8] = v7_f88[v8 - 1]
  v1 = ''
  -- stmt15 stray v7[v8 - 1] | v7[v8]
  v1 = ''
  -- stmt16 stray v7[v8 - 1] | v7[v8]
  v1 = ''
  -- stmt17 stray v7[v8 - 1] | v7[v8]
  v9[v8] = ''
  -- stmt18 stray v9[v8 - 1]
  ENDFOR
  sv_i = PARSE_MSG(p1)
  -- stmt22 stray sv_i
  v7_f00[1] = p0
  v9[1] = v11
  v12_f00 = 0
  v12_f04 = 'No DCP Faults Active'
  v12_f88 = ''
  v1 = ''
  -- stmt29 stray '' | v12
  v1 = ''
  -- stmt30 stray '' | v12
  v1 = ''
  -- stmt31 stray '' | v12
  sv_i = LOAD_TX('HIST', 'flhisteg')
  -- stmt41 stray sv_i
  sv_i = INIT
  -- stmt43 stray sv_i
  v13 = 0
  FOR v8 = 1 TO 3 DO
  CNV_INT_STR(v8, 3, 10, v14)
  v15[v13 + 1] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPFaultNum'
  v15[v13 + 2] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPLine1'
  v15[v13 + 3] = 'tree[' + v14 + ']'
  v15[v13 + 4] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPLine2'
  v15[v13 + 5] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPLine3'
  v15[v13 + 6] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPLine4'
  v15[v13 + 7] = '[DCP_HIST]AlmDCPHist[' + v14 + '].DCPLine5'
  v15[v13 + 8] = '[DCP_HIST]DCPTimeHist[' + v14 + ']'
  v16[v8] = 0
  v17 = 2
  v13 = v13 + 8
  ENDFOR
  sv_i = SET_USERSCREEN
  -- stmt63 stray sv_i
  v18 = 1
  DISCTRL_FORM('HIST', 0, v15, v19, v20, v17, v18, v21, v2)
  IF ((v2 <> 0)) THEN
  POST_ERR(v2, '', 0, 0)
  ENDIF
  RETURN(0)
END DCPFAULTREFRESH

BEGIN
END DCP_HIST
