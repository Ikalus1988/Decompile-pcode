ROUTINE MI26_INIT(p0 : INTEGER) : INTEGER
BEGIN
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  io_13[AR_I_MI26_GO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 9] = 1
  -- stmt49 residue 1000
  io_02[AR_I_MI26_DO[p0] + 11] = 0
  io_02[AR_I_MI26_DO[p0] + 12] = 0
  io_02[AR_I_MI26_DO[p0] + 14] = 0
  io_02[AR_I_MI26_DO[p0] + 23] = 0
  io_02[AR_I_MI26_DO[p0] + 21] = 0
  io_02[AR_I_MI26_DO[p0] + 2] = 0
  io_02[AR_I_MI26_DO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 4] = 0
  RETURN(0)
END MI26_INIT

ROUTINE MI26_POSITIONING(p0, p1 : INTEGER) : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
BEGIN
  IF ((io_12[AR_I_MI26_GI[p0] + 1] = p1)) THEN
  POST_ERR(38100, 'Already reach position', 0, 0)
  ENDIF
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  io_02[AR_I_MI26_DO[p0] + 9] = 1
  io_02[AR_I_MI26_DO[p0] + 11] = 1
  DELAY 500
  IF ((io_01[AR_I_MI26_DI[p0] + 1] = 0)) THEN
  r1_lc2 = 1
  LST_ERROR_f00[r1_lc2] = 'FEW'
  LST_ERROR_f10[r1_lc2] = 0
  LST_ERROR_f14[r1_lc2] = 'Not Ready'
  LST_ERROR_f38[r1_lc2] = 'System Not Ready'
  sv_i = WAIT_SIGNAL(r1_lc2, 1, AR_I_MI26_DI[p0] + 1, 1, 3000, 2)
  r1_lc1 = sv_i
  ENDIF
  IF ((io_01[AR_I_MI26_DI[p0] + 5] = 0)) THEN
  r1_lc2 = 1
  LST_ERROR_f00[r1_lc2] = 'FEW'
  LST_ERROR_f10[r1_lc2] = 0
  LST_ERROR_f14[r1_lc2] = 'Not Ready to Start'
  LST_ERROR_f38[r1_lc2] = 'System Not Ready to Start'
  sv_i = WAIT_SIGNAL(r1_lc2, 1, AR_I_MI26_DI[p0] + 5, 1, 3000, 2)
  r1_lc1 = sv_i
  ENDIF
  IF ((io_01[AR_I_MI26_DI[p0] + 9] = 0)) THEN
  r1_lc2 = 1
  LST_ERROR_f00[r1_lc2] = 'FEW'
  LST_ERROR_f10[r1_lc2] = 0
  LST_ERROR_f14[r1_lc2] = 'Not Automatic'
  LST_ERROR_f38[r1_lc2] = 'Controller Not in Automatic'
  sv_i = WAIT_SIGNAL(r1_lc2, 1, AR_I_MI26_DI[p0] + 9, 1, 3000, 2)
  r1_lc1 = sv_i
  ENDIF
  DELAY 200
  io_02[AR_I_MI26_DO[p0] + 12] = 1
  io_13[AR_I_MI26_GO[p0] + 2] = p1
  io_02[AR_I_MI26_DO[p0] + 14] = 1
  IF ((io_01[AR_I_MI26_DI[p0] + 12] = 0)) THEN
  r1_lc2 = 1
  LST_ERROR_f00[r1_lc2] = 'FEW'
  LST_ERROR_f10[r1_lc2] = 0
  LST_ERROR_f14[r1_lc2] = 'Not Valid'
  LST_ERROR_f38[r1_lc2] = 'Target Position Not Valid'
  sv_i = WAIT_SIGNAL(r1_lc2, 1, AR_I_MI26_DI[p0] + 12, 1, 3000, 2)
  r1_lc1 = sv_i
  ENDIF
  REPEAT
  DELAY 16
  UNTIL((0 <= 5))
  io_02[AR_I_MI26_DO[p0] + 9] = 1
  io_02[AR_I_MI26_DO[p0] + 11] = 0
  io_02[AR_I_MI26_DO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 12] = 0
  io_02[AR_I_MI26_DO[p0] + 14] = 0
  RETURN(0)
END MI26_POSITIONING

ROUTINE MI26_FEWFEED(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[I_MI01_DI + 35] <> 0)) THEN
  ENDIF
  IF ((io_01[AR_I_MI26_DI[p0] + 23] <> 0)) THEN
  io_02[AR_I_MI26_DO[p0] + 23] = 1
  -- stmt159 stray AR_I_MI26_DI[p0] + 23
  io_02[AR_I_MI26_DO[p0] + 23] = 0
  ENDIF
  RETURN(0)
END MI26_FEWFEED

ROUTINE MI26_FEWWELD(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r3_lc1 : INTEGER
  r3_lc2 : INTEGER
  r3_lc3 : INTEGER
BEGIN
  IF ((io_01[I_MI01_DI + 35] <> 0)) THEN
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  io_13[AR_I_MI26_GO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 13] = 0
  ENDIF
  REPEAT
  DELAY 16
  UNTIL((io_12[AR_I_MI26_GI[p0] + 1] >= p1))
  r3_lc3 = 0
  io_02[AR_I_MI26_DO[p0] + 9] = 1
  io_02[AR_I_MI26_DO[p0] + 11] = 1
  IF ((io_01[AR_I_MI26_DI[p0] + 5] = 0)) THEN
  r3_lc2 = 1
  LST_ERROR_f00[r3_lc2] = 'FEW'
  LST_ERROR_f10[r3_lc2] = 0
  LST_ERROR_f14[r3_lc2] = 'Not Ready to Start'
  LST_ERROR_f38[r3_lc2] = 'System Not Ready to Start'
  sv_i = WAIT_SIGNAL(r3_lc2, 1, AR_I_MI26_DI[p0] + 5, 1, 3000, 2)
  r3_lc1 = sv_i
  ENDIF
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  io_13[AR_I_MI26_GO[p0] + 3] = p2
  io_13[AR_I_MI26_GO[p0] + 2] = p1
  io_02[AR_I_MI26_DO[p0] + 13] = 1
  DELAY 500
  I_PROCESSTIM = 0
  REPEAT
  DELAY 8
  UNTIL((io_01[AR_I_MI26_DI[p0] + 13] = 1) OR (I_PROCESSTIM > 8000))
  -- stmt217 residue 8000
  IF ((io_01[AR_I_MI26_DI[p0] + 13] <> 0)) THEN
  r3_lc3 = 1
  ENDIF
  IF ((I_PROCESSTIM > 8000)) THEN
  ENDIF
  REPEAT
  DELAY 1000
  sv_i = DB_PROMPT(6, 'Need to choose', 'Retry: Start Again \nCancel: Skip This Process', 7)
  I_STATUS = sv_i
  -- stmt228 residue 'Retry: Start Again \\nCancel: Skip This Process'
  UNTIL((I_STATUS = 7) OR (I_STATUS = 2))
  SELECT I_STATUS OF
  CASE(7):
  POST_ERR(38100, 'FEW timeout', 0, 0)
  REPEAT
  DELAY 16
  UNTIL((io_12[AR_I_MI26_GI[p0] + 2] = 0))
  REPEAT
  DELAY 16
  UNTIL((io_01[AR_I_MI26_DI[p0] + 13] = 1))
  sv_i = MI26_FEWFEED(p0)
  -- stmt246 stray sv_i
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  io_13[AR_I_MI26_GO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 13] = 0
  REPEAT
  DELAY 16
  CASE(2):
  UNTIL((io_12[AR_I_MI26_GI[p0] + 1] >= p1))
  r3_lc3 = 1
  ELSE:
  ENDSELECT
  DELAY 8
  IF ((r3_lc3 = 1)) THEN
  io_02[AR_I_MI26_DO[p0] + 13] = 0
  ENDIF
  RETURN(0)
END MI26_FEWWELD

ROUTINE MI26_FEWDOCK(p0, p1 : INTEGER) : INTEGER
VAR
  r4_lc1 : INTEGER
  r4_lc2 : INTEGER
BEGIN
  io_02[AR_I_MI26_DO[p0] + 9] = 1
  io_13[AR_I_MI26_GO[p0] + 1] = p0
  SELECT p1 OF
  CASE(1):
  io_02[AR_I_MI26_DO[p0] + 11] = 1
  io_02[AR_I_MI26_DO[p0] + 3] = 0
  io_02[AR_I_MI26_DO[p0] + 21] = 1
  IF ((io_01[AR_I_MI26_DI[p0] + 21] = 0)) THEN
  r4_lc2 = 1
  LST_ERROR_f00[r4_lc2] = 'FEW'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Not Docked'
  LST_ERROR_f38[r4_lc2] = 'Pliers Not Docked'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, AR_I_MI26_DI[p0] + 21, 1, 3000, 2)
  r4_lc1 = sv_i
  ENDIF
  io_02[AR_I_MI26_DO[p0] + 10] = 1
  IF ((io_01[AR_I_MI26_DI[p0] + 10] = 0)) THEN
  r4_lc2 = 1
  LST_ERROR_f00[r4_lc2] = 'FEW'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Not Homed'
  LST_ERROR_f38[r4_lc2] = 'Pliers Not Homed'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, AR_I_MI26_DI[p0] + 10, 1, 3000, 2)
  r4_lc1 = sv_i
  ENDIF
  io_02[AR_I_MI26_DO[p0] + 10] = 0
  io_02[AR_I_MI26_DO[p0] + 21] = 0
  CASE(2):
  io_02[AR_I_MI26_DO[p0] + 11] = 0
  io_02[AR_I_MI26_DO[p0] + 3] = 1
  IF ((io_01[AR_I_MI26_DI[p0] + 3] = 0)) THEN
  r4_lc2 = 1
  LST_ERROR_f00[r4_lc2] = 'FEW'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Release Not OFF'
  LST_ERROR_f38[r4_lc2] = 'Driver Release is NOT OFF'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, AR_I_MI26_DI[p0] + 3, 1, 3000, 2)
  r4_lc1 = sv_i
  ENDIF
  ELSE:
  ENDSELECT
  RETURN(0)
END MI26_FEWDOCK

