  sv_i = GETTPEPRMINT(4)
  r1_lc4 = sv_i
  sv_i = MI26_FEWWELD(r1_lc2, r1_lc3, r1_lc4)
  CASE(4):
  sv_i = MI26_FEWFEED(r1_lc2)
  CASE(5):
  sv_i = GETTPEPRMINT(3)
  r1_lc5 = sv_i
  sv_i = MI26_FEWDOCK(r1_lc2, r1_lc5)
  ELSE:
  ENDSELECT
  sv_i = INIT
  -- stmt117 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt119 stray sv_i
  RETURN(0)
END ACTIONSELECT

