ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
  r1_lc5 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc1 = sv_i
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  SELECT r1_lc1 OF
  CASE(1):
  sv_i = MI26_INIT(r1_lc2)
  CASE(2):
