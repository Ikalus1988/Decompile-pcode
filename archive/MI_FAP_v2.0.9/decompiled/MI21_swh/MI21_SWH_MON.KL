-- MI21_SWH_MON.KL (decompiled v3)
PROGRAM MI21_SWH_MON
%COMMENT = 'MI21 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  B_MON_21 : INTEGER
  I_MON : INTEGER
  I_MI21_DI : INTEGER
  I_MI21_DO : INTEGER
  I_MI21_GI : INTEGER
  I_MI21_GO : INTEGER
  R_SYSREADY_TIMEOUT : REAL
  R_WC_TIMEOUT : REAL
  R_FAULT_TIMEOUT : REAL
  R_HEADBACK_TIMEOUT : REAL
  R_WELDINTOL_TIMEOUT : REAL
  I_BNSTYPE : INTEGER
  I_GUNNUM : INTEGER
  I_STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE MI21_SENDBSNUM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI21_INIT(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI21_START(p0, p1 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  IF ((B_MON_21 <> 0)) THEN
  sv_i = MI21_SENDBSNUM(0)
  -- stmt27 stray sv_i
  IF (UNINIT(I_MON)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON < 32)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON > 1024)) THEN
  I_MON = 1024
  ENDIF
  DELAY I_MON
  ELSE
  ENDIF
END MI21_SWH_MON

