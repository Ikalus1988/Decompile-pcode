ROUTINE INIT : INTEGER
BEGIN
  IF (UNINIT(I_MI21_DI)) THEN
  I_MI21_DI = 640
  ENDIF
  IF (UNINIT(I_MI21_DO)) THEN
  I_MI21_DO = 640
  ENDIF
  IF (UNINIT(I_MI21_GI)) THEN
  I_MI21_GI = 40
  ENDIF
  IF (UNINIT(I_MI21_GO)) THEN
  I_MI21_GO = 40
  ENDIF
  RETURN(0)
END INIT

ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc6 : STRING[64]
  r1_lc7 : INTEGER
  r1_lc8 : INTEGER
  r1_lc9 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc7 = sv_i
  SELECT r1_lc7 OF
  CASE(1):
  sv_i = BSN_ENABLE(0)
  -- stmt83 stray sv_i
  B_MON_21 = 1
  sv_i = RUN_MONITOR('MI21_swh_mon')
  CASE(2):
  IF ((io_01[I_MI01_DO + 35] = 0)) THEN
  sv_i = MI21_INIT(0)
  -- stmt90 stray sv_i
  ENDIF
  CASE(3):
  sv_i = GETTPEPRMINT(2)
  r1_lc8 = sv_i
  sv_s = GETTPEPRMSTR(3)
  r1_lc6 = sv_s
  CNV_STR_INT(r1_lc6, r1_lc9)
  sv_i = ROBOTINPROC(1)
  -- stmt98 stray sv_i
  IF (UNINIT(r1_lc9)) THEN
  POST_ERR(38100, 'Stud ID Error', 0, 2)
  ELSE
  IF ((r1_lc9 < 1) OR (r1_lc9 > 0.00472379)) THEN
  POST_ERR(38100, 'Stud ID Out of range', 0, 2)
  ENDIF
  ENDIF
  IF ((io_01[I_MI01_DO + 35] = 0)) THEN
  sv_i = MI21_START(r1_lc8, r1_lc9)
  -- stmt109 stray sv_i
  ELSE
  DELAY 3000
  ENDIF
  sv_i = ROBOTINPROC(2)
  ELSE:
  ENDSELECT
  sv_i = INIT
  -- stmt127 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt129 stray sv_i
  RETURN(0)
END ACTIONSELECT

BEGIN
END MI21_SWH
