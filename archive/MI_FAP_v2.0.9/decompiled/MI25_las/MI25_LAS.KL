ROUTINE ACTION_SELECT : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
  r1_lc5 : INTEGER
  r1_lc6 : INTEGER
  r1_lc7 : INTEGER
  r1_lc8 : INTEGER
  r1_lc9 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc1 = sv_i
  SELECT r1_lc1 OF
  CASE(1):
  sv_i = GETTPEPRMINT(2)
  r1_lc3 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc2 = sv_i
  CASE(1):
  sv_i = MI25_LASER_START(r1_lc2)
  CASE(2):
  sv_i = MI25_LASER_STOP(r1_lc2)
  CASE(3):
  sv_i = MI25_LASER_END(r1_lc2)
  ELSE:
  ENDSELECT
  SELECT sv_i OF
  CASE(2):
  sv_i = GETTPEPRMINT(2)
  r1_lc4 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc2 = sv_i
  CASE(1):
  sv_i = GETTPEPRMINT(4)
  r1_lc6 = sv_i
  sv_i = MI25_TRUMP_INIT(r1_lc2, r1_lc6)
  CASE(2):
  sv_i = GETTPEPRMINT(4)
  r1_lc7 = sv_i
  sv_i = GETTPEPRMINT(5)
  r1_lc8 = sv_i
  sv_i = GETTPEPRMINT(6)
  r1_lc9 = sv_i
  sv_i = MI25_TRUMP_PARAMS(r1_lc2, r1_lc7, r1_lc8, r1_lc9)
  ELSE:
  ENDSELECT
  SELECT sv_i OF
  CASE(3):
  sv_i = GETTPEPRMINT(2)
  r1_lc5 = sv_i
  CASE(1):
  sv_i = MI25_AIR_OPEN(0)
  CASE(2):
  sv_i = MI25_AIR_CLOSE(0)
  ELSE:
  ENDSELECT
  sv_i = MI25_INITVARS
  -- stmt139 stray sv_i
  sv_i = ACTION_SELECT
  -- stmt140 stray sv_i
  RETURN(0)
END ACTION_SELECT

