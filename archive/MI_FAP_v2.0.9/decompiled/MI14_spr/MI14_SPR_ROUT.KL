  -- stmt98 stray sv_i
  RETURN(0)
END MI14_RIVET

ROUTINE MI14_RELOAD(p0, p1 : INTEGER) : INTEGER
BEGIN
  sv_i = MI14_CHECKFORERROR(p0)
  -- stmt111 stray sv_i
  sv_i = MI14_CHECKRIVETREADY(p0)
  -- stmt114 stray sv_i
  sv_i = MI14_CHECKGUNHOME(p0)
  -- stmt117 stray sv_i
  sv_i = MI14_SET_RIVETID(p0, p1)
  -- stmt119 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 33] = 1
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Wait reload'
  LST_ERROR_f38[256] = 'Wait for reload request feedback'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 33, 1, TIMEOUT_RELOAD, 2)
  L_STATE = sv_i
  sv_i = MI14_SET_RIVETID(p0, 0)
  -- stmt128 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 33] = 0
  RETURN(0)
END MI14_RELOAD

ROUTINE MI14_CHECK_DISCONNECT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[AR_I_MI14_DI[p0] + 29] <> 0) AND (io_01[AR_I_MI14_DI[p0] + 30] = 0)) THEN
  ELSE
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Wait Disconnected'
  LST_ERROR_f38[256] = 'Wait for spindle Disconnected'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 29, 1, TIMEOUT_DOCK, 2)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Wait Disconnected'
  LST_ERROR_f38[256] = 'Wait for spindle Disconnected'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 30, 0, TIMEOUT_DOCK, 2)
  L_STATE = sv_i
  ENDIF
  RETURN(0)
END MI14_CHECK_DISCONNECT

ROUTINE MI14_CHECK_CONNECT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[AR_I_MI14_DI[p0] + 29] = 0) AND (io_01[AR_I_MI14_DI[p0] + 30] <> 0)) THEN
  ELSE
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Wait Disconnected'
  LST_ERROR_f38[256] = 'Wait for spindle Disconnected'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 29, 0, TIMEOUT_DOCK, 2)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Wait Disconnected'
  LST_ERROR_f38[256] = 'Wait for spindle Disconnected'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 30, 1, TIMEOUT_DOCK, 2)
  L_STATE = sv_i
  ENDIF
  RETURN(0)
END MI14_CHECK_CONNECT

ROUTINE MI14_DOCK(p0, p1 : INTEGER) : INTEGER
BEGIN
  sv_i = MI14_CHECKRIVETREADY(p0)
  -- stmt192 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 3] = 1
  IF ((io_01[AR_I_MI14_DI[p0] + 3] = 0)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Life Bit Error'
  LST_ERROR_f38[256] = 'Wait for Life Bit Active'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI14_DI[p0] + 3, 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  io_02[AR_I_MI14_DO[p0] + 3] = 0
  SELECT p1 OF
  CASE(1):
  sv_i = MI14_CHECK_DISCONNECT(p0)
  -- stmt207 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 29] = 0
  io_02[AR_I_MI14_DO[p0] + 30] = 1
  sv_i = MI14_CHECK_CONNECT(p0)
  -- stmt212 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 30] = 0
  CASE(2):
  sv_i = MI14_CHECK_CONNECT(p0)
  -- stmt217 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 30] = 0
  io_02[AR_I_MI14_DO[p0] + 29] = 1
  sv_i = MI14_CHECK_DISCONNECT(p0)
  -- stmt222 stray sv_i
  io_02[AR_I_MI14_DO[p0] + 29] = 0
  ELSE:
  ENDSELECT
  RETURN(0)
END MI14_DOCK

