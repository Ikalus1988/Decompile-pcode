  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
BEGIN
  r0_lc1 = p1 MOD 65536
  r0_lc2 = p1 DIV 65536
  io_13[AR_I_MI14_GO[p0] + 3] = r0_lc1
  io_13[AR_I_MI14_GO[p0] + 3 + 1] = r0_lc2
  RETURN(0)
END MI14_SET_RIVETID

ROUTINE MI14_SET_NEXTRIVETID(p0, p1 : INTEGER) : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
BEGIN
  r1_lc1 = p1 MOD 65536
  r1_lc2 = p1 DIV 65536
  io_13[AR_I_MI14_GO[p0] + 5] = r1_lc1
  io_13[AR_I_MI14_GO[p0] + 5 + 1] = r1_lc2
  RETURN(0)
END MI14_SET_NEXTRIVETID

