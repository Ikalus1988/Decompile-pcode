ROUTINE MI14_SENDBSNUM(p0 : INTEGER) : INTEGER
VAR
  r23_lc1 : INTEGER
BEGIN
  FOR r23_lc1 = 1 TO 3 DO
  IF ((io_01[I_MI01_DI + 129 + r23_lc1 - 1] <> 0)) THEN
  io_02[AR_I_MI14_DO[p0] + 161 + r23_lc1 - 1] = 1
  ELSE
  io_02[AR_I_MI14_DO[p0] + 161 + r23_lc1 - 1] = 0
  ENDIF
  ENDFOR
  RETURN(0)
END MI14_SENDBSNUM

