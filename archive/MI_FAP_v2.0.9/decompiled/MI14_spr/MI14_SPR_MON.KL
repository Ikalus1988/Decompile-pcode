ROUTINE LIFEBIT(p0 : INTEGER) : INTEGER
BEGIN
  ERRORONESHOT = 1
  I_PROCESSTIME = 0
  io_02[AR_I_MI14_DO[p0] + 3] = 1
  IF ((ERRORONESHOT <> 0)) THEN
  IF ((I_PROCESSTIME > TIMEOUT_LIFEBIT) AND (io_01[AR_I_MI14_DI[p0] + 3] = 0)) THEN
  POST_ERR(38100, 'Life bit Error', 0, 1)
  ERRORONESHOT = 0
  ELSE
  ERRORONESHOT = 1
  ENDIF
  ENDIF
  IF ((io_0e[153] <> 0) OR (io_01[I_MI01_DI + 5] <> 0) OR (io_0b[1] <> 0)) THEN
  I_PROCESSTIME = 0
  ERRORONESHOT = 1
  ENDIF
  DELAY 8
  IF ((io_01[AR_I_MI14_DI[p0] + 3] <> 0) OR (B_LIFEBIT = 0) OR (B_MON_14 = 0)) THEN
  IF ((B_LIFEBIT = 0) OR (B_MON_14 = 0)) THEN
  ENDIF
  io_02[AR_I_MI14_DO[p0] + 3] = 0
  DELAY TIMEOUT_LIFEBIT
  I_PROCESSTIME = 0
