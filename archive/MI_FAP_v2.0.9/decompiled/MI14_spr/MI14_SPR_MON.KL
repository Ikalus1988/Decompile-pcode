  sv_i = MI14_SENDBSNUM(I_ACT_GUN)
  -- stmt109 stray sv_i
  ENDIF
  IF ((B_LIFEBIT <> 0)) THEN
  sv_i = LIFEBIT(I_ACT_GUN)
  -- stmt113 stray sv_i
  ENDIF
  IF (UNINIT(I_MON)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON < 32)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON > 1024)) THEN
  I_MON = 1024
  ENDIF
  DELAY I_MON
  ELSE
  ENDIF
  ENDIF
  RETURN(0)
END LIFEBIT

