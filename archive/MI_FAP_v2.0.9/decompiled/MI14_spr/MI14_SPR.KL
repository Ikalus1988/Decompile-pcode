  ENDIF
  IF (UNINIT(AR_I_MI14_DO[2])) THEN
  AR_I_MI14_DO[2] = 1448
  ENDIF
  IF (UNINIT(AR_I_MI14_GI[2])) THEN
  AR_I_MI14_GI[2] = 55
  ENDIF
  IF (UNINIT(AR_I_MI14_GO[2])) THEN
