  ENDIF
  ENDFOR
  IF (UNINIT(AR_I_MI14_DI[1])) THEN
  AR_I_MI14_DI[1] = 1136
  ENDIF
  IF (UNINIT(AR_I_MI14_DO[1])) THEN
  AR_I_MI14_DO[1] = 1136
  ENDIF
  IF (UNINIT(AR_I_MI14_GI[1])) THEN
