ROUTINE RETURNINT(p0 : REAL) : INTEGER
BEGIN
  IF ((p0 <= (0 - 1))) THEN
  sv_i = trunc(p0)
  RETURN(65536 + sv_i)
  ELSE
  sv_i = trunc(p0)
  RETURN(sv_i)
  ENDIF
  RETURN(0)
END RETURNINT

ROUTINE RETURNDEC(p0 : REAL) : INTEGER
BEGIN
  IF ((p0 < 0)) THEN
  IF ((sv_i MOD 10000 <> 0)) THEN
  sv_i = trunc(p0 * 10000)
  RETURN(65536 + sv_i MOD 10000)
  ELSE
  RETURN(0)
  ENDIF
  sv_i = trunc(p0 * 10000)
  RETURN(sv_i MOD 10000)
  ENDIF
  RETURN(0)
END RETURNDEC

