BEGIN
  IF ((p0 = 1)) THEN
  B_MON_3D_BSN1 = 0
  B_MON_TCP3D_1 = 0
  ENDIF
  IF ((p0 = 2)) THEN
  B_MON_3D_BSN2 = 0
  B_MON_TCP3D_2 = 0
  ENDIF
  IF ((B_MON_3D_BSN1 = 0) AND (B_MON_3D_BSN2 = 0) AND (B_MON_2D_BSN = 0) AND (B_MON_BTW_BSN = 0)) THEN
  B_MON_09 = 0
  ENDIF
  IF ((B_MON_TCP3D_1 = 0) AND (B_MON_TCP3D_2 = 0)) THEN
  B_MON_TCP3D = 0
  ENDIF
  FOR r15_lc1 = 1 TO 3 DO
  FOR r15_lc2 = 1 TO 3 DO
  r15_lc3 = I_MI09_NEW_DO[p0] + 337 + r15_lc1 - 1 * 8 + r15_lc2 - 1
  io_02[r15_lc3] = 0
  ENDFOR
  ENDFOR
  sv_i = GET_FASTCLOCK
  io_13[I_MI09_NEW_GO[p0] + 5] = sv_i
  io_02[I_MI09_NEW_DO[p0] + 2] = 0
  RETURN(0)
END MI09_COHERIX_3D_RUNMODEOFF

