ROUTINE MI09_COHERIX_3D_RUNMODEON(p0, p1 : INTEGER) : INTEGER
VAR
  r14_lc1 : INTEGER
  r14_lc2 : INTEGER
BEGIN
  I_ACT_TOOL = p0
  I_DSD_BRAND = 3
  B_MON_09 = 1
  B_MON_TCP3D = 1
  IF ((p0 = 1)) THEN
  B_MON_3D_BSN1 = 1
  B_MON_TCP3D_1 = 1
  ENDIF
  IF ((p0 = 2)) THEN
  B_MON_3D_BSN2 = 1
  B_MON_TCP3D_2 = 1
  ENDIF
  sv_i = RUN_MONITOR('MI09_dsd_mon')
  -- stmt173 stray sv_i
  sv_i = RUN_MONITOR('MI09_dsd_tcp3d')
  -- stmt174 stray sv_i
  IF ((io_01[I_MI01_DI + 35] = 0) AND (io_01[I_MI01_DI + 481 + p0 - 1] = 0)) THEN
  IF ((io_01[I_MI09_NEW_DI[p0] + 5] = 0)) THEN
  r14_lc2 = 1
  LST_ERROR_f00[r14_lc2] = 'DSD'
  LST_ERROR_f10[r14_lc2] = 0
  LST_ERROR_f14[r14_lc2] = 'Mode Error'
  LST_ERROR_f38[r14_lc2] = 'Wait for Automatic Mode'
  sv_i = WAIT_SIGNAL(r14_lc2, 1, I_MI09_NEW_DI[p0] + 5, 1, 3000, 2)
  r14_lc1 = sv_i
  ENDIF
  ENDIF
  SET_INT_REG(I_REG_SPEED, 0, I_STATUS)
  io_13[I_MI09_NEW_GO[p0] + 3] = p1
  sv_i = GET_FASTCLOCK
  io_13[I_MI09_NEW_GO[p0] + 5] = sv_i
  DELAY 1000
  io_02[I_MI09_NEW_DO[p0] + 2] = 1
  RETURN(0)
END MI09_COHERIX_3D_RUNMODEON

ROUTINE MI09_COHERIX_3D_RUNMODEOFF(p0 : INTEGER) : INTEGER
VAR
  r15_lc1 : INTEGER
  r15_lc2 : INTEGER
