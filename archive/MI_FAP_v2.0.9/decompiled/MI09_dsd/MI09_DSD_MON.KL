  IF ((B_MON_3D_BSN1 <> 0)) THEN
  sv_i = MI09_COHERIX_3D_SENDBSNUM(1)
  -- stmt42 stray sv_i
  ENDIF
  IF ((B_MON_3D_BSN2 <> 0)) THEN
  sv_i = MI09_COHERIX_3D_SENDBSNUM(2)
  -- stmt46 stray sv_i
  ENDIF
  ELSE:
