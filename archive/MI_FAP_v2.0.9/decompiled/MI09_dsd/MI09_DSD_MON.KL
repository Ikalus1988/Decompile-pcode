  SELECT I_DSD_BRAND OF
  CASE(1):
  IF ((B_MON_BTW_BSN <> 0)) THEN
  sv_i = MI09_SENDBSNUM(I_ACT_TOOL)
  -- stmt32 stray sv_i
  ENDIF
  CASE(2):
  IF ((B_MON_2D_BSN <> 0)) THEN
  sv_i = MI09_COHERIX_2D_SENDBSNUM(I_ACT_TOOL)
  -- stmt37 stray sv_i
  ENDIF
