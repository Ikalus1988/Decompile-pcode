  RETURN(sv_s)
END CURRLANGUAGE

ROUTINE LOAD_TX(p0, p1 : STRING) : INTEGER
VAR
  r2_lc9 : STRING[64]
BEGIN
  r2_lc9 = 'FR:\' + p1
