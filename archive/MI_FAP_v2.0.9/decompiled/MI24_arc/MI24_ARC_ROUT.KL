ROUTINE MI24_TD_CLOSE : INTEGER
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
BEGIN
  io_02[I_DO_CUT_OPEN] = 0
  DELAY 500
  IF ((io_01[I_DI_CUT_OPEN] <> 0)) THEN
  r0_lc2 = 5
  LST_ERROR_f00[r0_lc2] = 'ARC'
  LST_ERROR_f10[r0_lc2] = 0
  LST_ERROR_f14[r0_lc2] = 'TD NOT CLOSE'
  LST_ERROR_f38[r0_lc2] = 'Wait Singal OFF'
  sv_i = WAIT_SIGNAL(r0_lc2, 1, I_DI_CUT_OPEN, 0, 3000, 2)
  r0_lc1 = sv_i
  ENDIF
  RETURN(0)
END MI24_TD_CLOSE

