  ENDIF
  IF (UNINIT(I_DI_MOTOR_ON)) THEN
  I_DI_MOTOR_ON = 2658
  ENDIF
  IF (UNINIT(I_DI_MOTOR_DOWN)) THEN
  I_DI_MOTOR_DOWN = 2657
  ENDIF
  IF (UNINIT(I_DI_CUT_OPEN)) THEN
  I_DI_CUT_OPEN = 2651
  ENDIF
  RETURN(0)
END MI24_INITVARS

ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc1 = sv_i
  SELECT r1_lc1 OF
  CASE(1):
  sv_i = GETTPEPRMINT(2)
  r1_lc3 = sv_i
  CASE(1):
  sv_i = MI24_TD_OPEN(0)
  CASE(2):
  sv_i = MI24_TD_CLOSE(0)
  ELSE:
  ENDSELECT
  SELECT sv_i OF
  CASE(2):
  sv_i = GETTPEPRMINT(2)
  r1_lc4 = sv_i
  CASE(1):
  sv_i = MI24_MOTOR_ON(0)
  CASE(2):
  sv_i = MI24_MOTOR_OFF(0)
  CASE(3):
  sv_i = MI24_MOTOR_UP(0)
  CASE(4):
  sv_i = MI24_MOTOR_DOWN(0)
  ELSE:
  ENDSELECT
  SELECT sv_i OF
  CASE(3):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = MI24_WIRE_FORWARD(r1_lc2)
  ELSE:
  ENDSELECT
  sv_i = MI24_INITVARS
  -- stmt138 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt139 stray sv_i
  RETURN(0)
END ACTIONSELECT

