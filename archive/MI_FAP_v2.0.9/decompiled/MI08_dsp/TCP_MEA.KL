ROUTINE FILECHECKER(p0 : FILE; p1 : INTEGER; p2 : STRING; p3 : INTEGER) : INTEGER
BEGIN
  IF ((sv_i <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  sv_s = chr(128)
  WRITE(sv_s)
  SELECT p1 OF
  CASE(1):
  IF ((sv_i <> 2014)) THEN
  sv_i = IO_STATUS(p0)
  WRITE(CR, 'Error Opening File', CR, 'IO_Status Code : ', sv_i, CR)
  WRITE(CR, p2, ' ', p3)
  ELSE
  IF ((p2 = 'Backup')) THEN
  -- stmt42 stray p0
  sv_i = DEFBACKUP
  -- stmt43 stray sv_i
  sv_i = MSGWRITE(155, (1 <> 0))
  -- 弃参原式: 1
  -- stmt44 stray sv_i
  sv_i = MSGWRITE(156, (1 <> 0))
  -- 弃参原式: 1
  -- stmt45 stray sv_i
  ENDIF
  IF ((p2 = 'Data')) THEN
  sv_i = CHECK_INI(0)
  -- stmt49 stray sv_i
  -- stmt50 stray p0
  sv_i = WRITEDATA
  -- stmt51 stray sv_i
  sv_i = MSG_CLEAR_FU(0)
  -- stmt52 stray sv_i
  WRITE('Initialized')
  DELAY 500
  ENDIF
  ENDIF
  CASE(2):
  sv_i = IO_STATUS(p0)
  WRITE('Error Reading File', CR, 'IO_Status Code : ', sv_i, CR)
  WRITE(CR, p2, ' ', p3)
  CASE(3):
  sv_i = IO_STATUS(p0)
  WRITE('Error Writing File', CR, 'IO_Status Code : ', sv_i, CR)
  WRITE(CR, p2, ' ', p3)
  CASE(4):
  sv_i = IO_STATUS(p0)
  WRITE('Error Closing File', CR, 'IO_Status Code : ', sv_i, CR)
  WRITE(CR, p2, ' ', p3)
  CASE(5):
  sv_i = IO_STATUS(p0)
  WRITE('Error Canceling File', CR, 'IO_Status Code : ', sv_i, CR)
  WRITE(CR, p2, ' ', p3)
  ENDSELECT
  ENDIF
  IF ((p2 <> 'BackUp')) THEN
  ABORT
  ENDIF
  IF ((p2 = 'Data')) THEN
  OPEN FILE p0('RO', 'fr:\BizLink_Data.txt')
  -- stmt81 residue 'fr:\\BizLink_Data.txt'
  ENDIF
  RETURN(0)
END FILECHECKER

