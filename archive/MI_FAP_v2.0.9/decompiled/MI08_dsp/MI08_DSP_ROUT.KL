  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'Wait Glue' + sv_s + ' pump on'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 34, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 37] = 0)) THEN
  r4_lc2 = 2
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'Wait heating ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'Wait Glue' + sv_s + ' heating ready'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 37, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  IF ((I_PURGE_ENB = 1)) THEN
  IF ((io_01[I_MI08_DI[p0] + 10] <> 0)) THEN
  SELECT I_DISPENSER OF
  CASE(1):
  sv_i = MI08_PURGE_SCA(p0, p1 * 1000)
  CASE(2):
  sv_i = MI08_PURGE_DMTS(p0, p1 * 1000)
  ELSE:
  ENDSELECT
  ENDIF
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 10] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 54 + p0 - 1 * 10
  r4_lc2 = 3
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'purge timeout'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' purge timeout'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 10, 0, p1, 2)
  r4_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 9] <> 0)) THEN
  sv_i = MI08_FILL(p0, p1)
  -- stmt69 stray sv_i
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 9] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 55 + p0 - 1 * 10
  r4_lc2 = 4
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'fill timeout'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' fill timeout'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 9, 0, p1, 2)
  r4_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  r4_lc3 = 1
  IF ((io_01[I_MI08_DI[p0] + 1] = 0) OR (io_01[I_MI08_DI[p0] + 5] = 0) OR (io_01[I_MI08_DI[p0] + 8] = 0) OR (r4_lc3 = 0)) THEN
  io_13[I_MI01_GO + 6] = 52 + p0 - 1 * 10
  IF ((io_01[I_MI08_DI[p0] + 1] = 0)) THEN
  r4_lc2 = 5
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'system not ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' system not ready'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 1, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 5] = 0)) THEN
  r4_lc2 = 6
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'system not ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' system not ready'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 5, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 8] = 0)) THEN
  r4_lc2 = 7
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'system not ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' system not ready'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 8, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  IF ((r4_lc3 = 0)) THEN
  r4_lc2 = 8
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'system not ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' system not ready'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 49, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 33] = 0)) THEN
  r4_lc2 = 9
  LST_ERROR_f00[r4_lc2] = 'DSP'
  LST_ERROR_f10[r4_lc2] = 0
  LST_ERROR_f14[r4_lc2] = 'mode incorrect'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r4_lc2] = 'GLUE' + sv_s + ' mode incorrect'
  sv_i = WAIT_SIGNAL(r4_lc2, 1, I_MI08_DI[p0] + 33, 1, p1, 2)
  r4_lc1 = sv_i
  ENDIF
  RETURN(0)
END MI08_INIT

ROUTINE MI08_START(p0, p1, p2, p3 : INTEGER) : INTEGER
VAR
  r5_lc1 : INTEGER
  r5_lc2 : INTEGER
BEGIN
  SET_INT_REG(28, 0, I_STATUS)
  io_13[I_MI08_GO[p0] + 1] = p1
  IF ((io_12[I_MI08_GI[p0] + 1] <> p1)) THEN
  io_13[I_MI01_GO + 6] = 58 + p0 - 1 * 10
  r5_lc2 = 10
  LST_ERROR_f00[r5_lc2] = 'DSP'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'ProgNum echo error'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r5_lc2] = 'GLUE' + sv_s + ' ProgNum echo error'
  sv_i = WAIT_SIGNAL(r5_lc2, 3, I_MI08_GI[p0] + 1, p1, p3, 1)
  r5_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  io_13[I_MI08_GO[p0] + 2] = p2
  IF ((io_12[I_MI08_GI[p0] + 2] <> p2)) THEN
  io_13[I_MI01_GO + 6] = 59 + p0 - 1 * 10
  r5_lc2 = 10
  LST_ERROR_f00[r5_lc2] = 'DSP'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'ParaNum echo error'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r5_lc2] = 'GLUE' + sv_s + ' ParaNum echo error'
  sv_i = WAIT_SIGNAL(r5_lc2, 3, I_MI08_GI[p0] + 2, p2, p3, 1)
  r5_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  io_02[I_MI08_DO[p0] + 1] = 1
  IF ((io_01[I_MI08_DI[p0] + 16] = 0) OR (io_01[I_MI08_DI[p0] + 1] = 0)) THEN
  io_13[I_MI01_GO + 6] = 60 + p0 - 1 * 10
  IF ((io_01[I_MI08_DI[p0] + 16] = 0)) THEN
  r5_lc2 = 11
  LST_ERROR_f00[r5_lc2] = 'DSP'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'not ready for app'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r5_lc2] = 'GLUE' + sv_s + ' not ready for app'
  sv_i = WAIT_SIGNAL(r5_lc2, 1, I_MI08_DI[p0] + 16, 1, p3, 1)
  r5_lc1 = sv_i
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 1] = 0)) THEN
  r5_lc2 = 5
  LST_ERROR_f00[r5_lc2] = 'DSP'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'system not ready'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r5_lc2] = 'GLUE' + sv_s + ' system not ready'
  sv_i = WAIT_SIGNAL(r5_lc2, 1, I_MI08_DI[p0] + 1, 1, p3, 1)
  r5_lc1 = sv_i
  ENDIF
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  RETURN(0)
END MI08_START

ROUTINE MI08_END(p0, p1 : INTEGER) : INTEGER
VAR
  r9_lc1 : INTEGER
  r9_lc2 : INTEGER
BEGIN
  IF (UNINIT(I_TIMEOUT_APP_OK)) THEN
  I_TIMEOUT_APP_OK = 1000
  ENDIF
  io_02[I_MI08_DO[p0] + 1] = 0
  io_02[I_MI08_DO[p0] + 12] = 1
  IF ((I_DISPENSER = 2)) THEN
  DELAY 500
  ENDIF
  IF ((io_01[I_MI08_DI[p0] + 15] = 0)) THEN
  io_13[I_MI01_GO + 6] = 57 + p0 - 1 * 10
  r9_lc2 = 14
  LST_ERROR_f00[r9_lc2] = 'DSP'
  LST_ERROR_f10[r9_lc2] = 0
  LST_ERROR_f14[r9_lc2] = 'cycle end error'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r9_lc2] = 'GLUE' + sv_s + ' cycle end error'
  sv_i = WAIT_SIGNAL(r9_lc2, 1, I_MI08_DI[p0] + 15, 1, p1, 1)
  r9_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  IF ((I_DISPENSER = 2)) THEN
  I_PROCESSTIM = 0
  ENDIF
  REPEAT
  DELAY 8
  UNTIL((io_01[I_MI08_DI[p0] + 7] = 1) OR (I_PROCESSTIM > I_TIMEOUT_APP_OK))
  IF ((I_PROCESSTIM > I_TIMEOUT_APP_OK)) THEN
  SET_INT_REG(28, 1, I_STATUS)
  ENDIF
  io_02[I_MI08_DO[p0] + 12] = 0
  DELAY 300
  io_02[I_MI08_DO[p0] + 11] = 1
  IF ((io_01[I_MI08_DI[p0] + 2] = 0) OR (io_01[I_MI08_DI[p0] + 3] = 0)) THEN
  SET_INT_REG(28, 1, I_STATUS)
  ENDIF
  -- stmt148 residue 1000
  io_13[I_MI08_GO[p0] + 1] = 0
  io_13[I_MI08_GO[p0] + 2] = 0
  RETURN(0)
END MI08_END

BEGIN
END MI08_DSP_ROUT
