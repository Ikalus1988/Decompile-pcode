ROUTINE MI08_SENDBSNUM(p0 : INTEGER) : INTEGER
VAR
  r2_lc1 : INTEGER
  r2_lc2 : INTEGER
  r2_lc3 : INTEGER
  r2_lc4 : INTEGER
BEGIN
  IF ((I_DISPENSER = 1)) THEN
  sv_i = round(64 / 8)
  FOR r2_lc2 = 1 TO 3 DO
  FOR r2_lc1 = 1 TO 3 DO
  r2_lc3 = I_MI01_DI + 129 + r2_lc1 - 1 + r2_lc2 - 1 * 8
  r2_lc4 = I_MI08_DO[p0] + 81 + r2_lc1 - 1 + 8 - r2_lc2 * 4
  sv_i = INTERCONNECT(r2_lc3, r2_lc4)
  -- stmt225 stray sv_i
  ENDFOR
  ENDFOR
  ENDIF
  RETURN(0)
END MI08_SENDBSNUM

ROUTINE MI08_SENDBSNUM_NEW(p0 : INTEGER) : INTEGER
VAR
  r3_lc1 : INTEGER
BEGIN
  FOR r3_lc1 = 1 TO 3 DO
  sv_i = INTERCONNECT((AR_I_NEW_BSN_IN[r3_lc1]), (AR_I_NEW_BSN_OUT[r3_lc1]))
  -- stmt244 stray sv_i
  ENDFOR
  RETURN(0)
END MI08_SENDBSNUM_NEW

ROUTINE MI08_FILL(p0, p1 : INTEGER) : INTEGER
VAR
  r8_lc1 : INTEGER
  r8_lc2 : INTEGER
BEGIN
  io_02[I_MI08_DO[p0] + 5] = 1
  io_02[I_MI08_DO[p0] + 8] = 1
  IF ((io_01[I_MI08_DI[p0] + 13] = 0)) THEN
  io_13[I_MI01_GO + 6] = 55 + p0 - 1 * 10
  r8_lc2 = 13
  LST_ERROR_f00[r8_lc2] = 'DSP'
  LST_ERROR_f10[r8_lc2] = 0
  LST_ERROR_f14[r8_lc2] = 'fill error'
  sv_s = INTTOSTR(p0)
  LST_ERROR_f38[r8_lc2] = 'GLUE' + sv_s + ' fill error'
  sv_i = WAIT_SIGNAL(r8_lc2, 1, I_MI08_DI[p0] + 13, 1, p1, 1)
  r8_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  io_02[I_MI08_DO[p0] + 5] = 0
  RETURN(0)
END MI08_FILL

