ROUTINE MSG_CLEAR_FU : INTEGER
BEGIN
  FORCE_SPMENU(1, 37, 1)
  sv_s = chr(128)
  WRITE(sv_s)
  RETURN(0)
END MSG_CLEAR_FU

ROUTINE MSG_WRITE(p0 : STRING) : INTEGER
BEGIN
  WRITE(p0)
  RETURN(0)
END MSG_WRITE

ROUTINE MSG_WRITE_CR(p0 : STRING) : INTEGER
BEGIN
  WRITE(p0, CR)
  RETURN(0)
END MSG_WRITE_CR

ROUTINE MSG_CR : INTEGER
BEGIN
  WRITE(CR)
  RETURN(0)
END MSG_CR

ROUTINE MSG_CR2 : INTEGER
BEGIN
  WRITE(CR, CR)
  RETURN(0)
END MSG_CR2

