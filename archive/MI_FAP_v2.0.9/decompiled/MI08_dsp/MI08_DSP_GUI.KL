END SHOW_MI08STP

ROUTINE ST_MACHINE(p0 : INTEGER) : INTEGER
BEGIN
  SELECT p0 OF
  CASE(1):
  sv_i = SHOW_MI08STP
  RETURN(sv_i)
  ELSE:
  RETURN(0)
  ENDSELECT
  sv_i = INITLOALVARS
  -- stmt9 stray sv_i
  sv_i = RESET_VALARRAY
  -- stmt11 stray sv_i
  sv_i = LOAD_TX('ADSP', '08adspeg')
  -- stmt15 stray sv_i
  sv_i = USERSCREEN
  -- stmt18 stray sv_i
  v19 = 0
  v22 = 1
  v24 = 1
  REPEAT
  sv_i = ST_MACHINE(v24)
  v24 = sv_i
  DELAY 64
  UNTIL((v24 = 0))
  RETURN(0)
END ST_MACHINE

BEGIN
END MI08_DSP_GUI
