ROUTINE DRYORWETMODE : INTEGER
BEGIN
  IF ((io_02[I_MI01_DI + 8] = 0)) THEN
  IF ((io_01[I_MI01_DI + 35] <> 0)) THEN
  SET_VAR(1, '*system*', '$SLGNSTUP[1].PROC_WET_RUN', 0, I_STATUS)
  ELSE
  SET_VAR(1, '*system*', '$SLGNSTUP[1].PROC_WET_RUN', 1, I_STATUS)
  ENDIF
  ENDIF
  RETURN(0)
END DRYORWETMODE

ROUTINE DRYWETTOPLC : INTEGER
VAR
  r1_lc1 : INTEGER
BEGIN
  IF (UNINIT(DI_WET_MODE)) THEN
  DI_WET_MODE = 448
  ENDIF
  GET_VAR(1, '*system*', '$SLGNSTUP[1].PROC_WET_RUN', r1_lc1, I_STATUS)
  IF ((r1_lc1 <> 0)) THEN
  io_02[DI_WET_MODE] = 1
  io_02[DI_WET_MODE + 16] = 1
  ELSE
  io_02[DI_WET_MODE] = 0
  io_02[DI_WET_MODE + 16] = 0
  ENDIF
  RETURN(0)
END DRYWETTOPLC

ROUTINE TCP_SPD_OUT(p0 : INTEGER) : INTEGER
VAR
  r2_lc1 : INTEGER
  r2_lc2 : INTEGER
  r2_lc3 : REAL
BEGIN
  IF (sv_b) THEN
  GET_REG(29, (r2_lc1 <> 0), r2_lc2, r2_lc3, I_STATUS)
  -- Æú²ÎÔ­Ê½: r2_lc1
  IF ((r2_lc1 <> 0)) THEN
  sv_i = round(r2_lc3 * 2)
  io_13[I_MI08_GO[p0] + 3] = sv_i
  ELSE
  sv_i = round(r2_lc2 * 2)
  io_13[I_MI08_GO[p0] + 3] = sv_i
  ENDIF
  ENDIF
  RETURN(0)
END TCP_SPD_OUT

ROUTINE IO_INTER(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[I_MI08_DI[p0] + 2] <> 0) OR (io_01[I_MI08_DI[p0] + 3] <> 0)) THEN
  io_02[I_MI01_DO + 445 + p0 - 1 * 16] = 1
  ELSE
  io_02[I_MI01_DO + 445 + p0 - 1 * 16] = 0
  ENDIF
  IF (UNINIT(I_SCA_TYPE)) THEN
  I_SCA_TYPE = 1
  ENDIF
  IF ((B_MON_08 <> 0)) THEN
  sv_i = DRYORWETMODE
  -- stmt112 stray sv_i
  IF ((I_DISPENSER = 1)) THEN
  IF ((I_SCA_TYPE = 1)) THEN
  sv_i = MI08_SENDBSNUM(I_ACT_TOOL)
  -- stmt116 stray sv_i
  ENDIF
  IF ((I_SCA_TYPE = 2)) THEN
  sv_i = MI08_SENDBSNUM_NEW(I_ACT_TOOL)
  -- stmt119 stray sv_i
  ENDIF
  ENDIF
  IF (UNINIT(I_MON)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON < 32)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON > 256)) THEN
  I_MON = 256
  ENDIF
  DELAY I_MON
  ELSE
  ENDIF
  RETURN(0)
END IO_INTER

