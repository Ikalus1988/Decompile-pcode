ROUTINE HEARTBEAT : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  FOR r0_lc1 = 1 TO 3 DO
  IF (NOT (UNINIT(AR_I_MI15_DO[r0_lc1]))) THEN
  ENDIF
  ENDFOR
  DELAY INTERVAL * 2
  ENABLE CONDITION[1]
  RETURN(0)
END HEARTBEAT

ROUTINE RESETRIVET : INTEGER
VAR
