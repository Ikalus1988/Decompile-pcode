  io_02[AR_I_MI15_DO[r1_lc1] + 24] = 0
  ENDIF
  ENDIF
  ENDIF
  ENDFOR
  B_MON_15 = 1
  IF (UNINIT(INTERVAL)) THEN
  INTERVAL = 500
  ENDIF
  -- stmt107 stray 150
  PURGE CONDITION[1]
  -- stmt109 stray 150 | 128 | B_MON_15 | 1
  ENABLE CONDITION[1]
