ROUTINE INITAPPVARS : INTEGER
BEGIN
  IF (UNINIT(I_SIMCYCLETIME)) THEN
  I_SIMCYCLETIME = 1500
  ENDIF
  IF (UNINIT(FILLINGCYCLETIME)) THEN
  FILLINGCYCLETIME = 10000
  ENDIF
  IF (UNINIT(GUNMAX)) THEN
  GUNMAX = 1
  ENDIF
  IF (UNINIT(TIMEOUT_PROCESS)) THEN
  TIMEOUT_PROCESS = 5000
  ENDIF
  IF (UNINIT(AR_I_MI15_DI[1])) THEN
  AR_I_MI15_DI[1] = 2320
  ENDIF
  IF (UNINIT(AR_I_MI15_DO[1])) THEN
  AR_I_MI15_DO[1] = 2320
  ENDIF
  IF (UNINIT(AR_I_MI15_GI[1])) THEN
  AR_I_MI15_GI[1] = 130
  ENDIF
  IF (UNINIT(AR_I_MI15_GO[1])) THEN
  AR_I_MI15_GO[1] = 130
  ENDIF
  IF (UNINIT(AR_I_MI15_DI[2])) THEN
  AR_I_MI15_DI[2] = 2480
  ENDIF
  IF (UNINIT(AR_I_MI15_DO[2])) THEN
  AR_I_MI15_DO[2] = 2480
  ENDIF
  IF (UNINIT(AR_I_MI15_GI[2])) THEN
  AR_I_MI15_GI[2] = 135
  ENDIF
  IF (UNINIT(AR_I_MI15_GO[2])) THEN
  AR_I_MI15_GO[2] = 135
  ENDIF
  RETURN(0)
END INITAPPVARS

ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc12 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
  r1_lc5 : INTEGER
  r1_lc6 : INTEGER
  r1_lc7 : INTEGER
  r1_lc8 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc1 = sv_i
  B_MON_15 = 1
  sv_i = RUN_MONITOR('MI15_spr_mon')
  -- stmt101 stray sv_i
  SELECT r1_lc1 OF
  CASE(1):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = MI15_INIT(r1_lc2)
  CASE(2):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc4 = sv_i
  sv_i = GETTPEPRMINT(4)
  r1_lc5 = sv_i
  sv_i = GETTPEPRMINT(5)
  r1_lc3 = sv_i
  sv_i = MI15_RIVET(r1_lc2, r1_lc4, r1_lc5, r1_lc3)
  CASE(3):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc3 = sv_i
  sv_i = MI15_OPENINGPOSITION(r1_lc2, r1_lc3)
  CASE(4):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc6 = sv_i
  sv_i = MI15_GUNSTATE(r1_lc2, r1_lc6)
  CASE(5):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc7 = sv_i
  IF ((r1_lc7 = 1)) THEN
  sv_i = GETTPEPRMINT(4)
  r1_lc8 = sv_i
  sv_i = MI15_PREMAGAZINE(r1_lc2, r1_lc7, r1_lc8)
  -- stmt130 stray sv_i
  ELSE
  sv_i = MI15_PREMAGAZINE(r1_lc2, r1_lc7, 2)
  -- stmt132 stray sv_i
  ENDIF
  CASE(6):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = MI15_FILLMAG(r1_lc2)
  CASE(7):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc4 = sv_i
  sv_i = GETTPEPRMINT(4)
  r1_lc8 = sv_i
  sv_i = MI15_RELOAD(r1_lc2, r1_lc4, r1_lc8)
  CASE(8):
  sv_i = BSN_ENABLE(0)
  -- stmt146 stray sv_i
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  I_ACT_GUN = r1_lc2
  CASE(9):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  sv_i = GETTPEPRMINT(3)
  r1_lc12 = sv_i
  sv_i = MI15_DIECHECK(r1_lc2, r1_lc12)
  ELSE:
  ENDSELECT
  sv_i = INITAPPVARS
  -- stmt166 stray sv_i
  sv_i = INITVARS(0)
  -- stmt167 stray sv_i
  sv_i = ROBOTINPROC(1)
  -- stmt168 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt171 stray sv_i
  sv_i = ROBOTINPROC(2)
  -- stmt172 stray sv_i
  RETURN(0)
END ACTIONSELECT

