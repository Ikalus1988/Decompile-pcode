END MI15_GUNSTATE

ROUTINE MI15_PREMAGAZINE(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r11_lc1 : INTEGER
BEGIN
  sv_i = MI15_CHECKCONTROLLER(p0)
  -- stmt134 stray sv_i
  sv_i = MI15_SYETEMREADY(p0)
  -- stmt136 stray sv_i
  SELECT p1 OF
  CASE(1):
  r11_lc1 = 1
  CASE(2):
  r11_lc1 = 0
  ELSE:
  ENDSELECT
  io_02[AR_I_MI15_DO[p0] + 26] = 0
  io_02[AR_I_MI15_DO[p0] + 25] = r11_lc1
  IF ((p1 = 1)) THEN
  IF ((p2 = 1)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'FittingReady'
  LST_ERROR_f38[256] = 'Wait for Fitting Ready'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 25, 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  RETURN(0)
END MI15_PREMAGAZINE

ROUTINE MI15_FILLMAG(p0 : INTEGER) : INTEGER
BEGIN
  sv_i = MI15_CHECKCONTROLLER(p0)
  -- stmt167 stray sv_i
  sv_i = MI15_SYETEMREADY(p0)
  -- stmt169 stray sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'FittingDone'
  LST_ERROR_f38[256] = 'Wait for Fitting Done'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 25, 0, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  io_02[AR_I_MI15_DO[p0] + 25] = 1
  io_02[AR_I_MI15_DO[p0] + 26] = 1
  IF ((io_01[AR_I_MI15_DI[p0] + 26] = 0)) THEN
  sv_i = MI15_SETTIMER(FILLINGCYCLETIME)
  -- stmt183 stray sv_i
  ENDIF
  REPEAT
  DELAY 32
  UNTIL((io_01[AR_I_MI15_DI[p0] + 26] <> 0) OR (I_TIMER > FILLINGCYCLETIME))
  sv_i = MI15_RESETTIMER
  -- stmt187 stray sv_i
  IF ((I_TIMER > FILLINGCYCLETIME)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'FittingDone'
  LST_ERROR_f38[256] = 'Wait for Fitting Done'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 26, 1, 100, 2)
  L_STATE = sv_i
  ENDIF
  io_02[AR_I_MI15_DO[p0] + 26] = 0
  io_02[AR_I_MI15_DO[p0] + 25] = 0
  RETURN(0)
END MI15_FILLMAG

ROUTINE MI15_RELOAD(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r13_lc1 : INTEGER
  r13_lc2 : INTEGER
BEGIN
  sv_i = MI15_CHECKCONTROLLER(p0)
  -- stmt215 stray sv_i
  sv_i = MI15_SYETEMREADY(p0)
  -- stmt217 stray sv_i
  r13_lc1 = p1 MOD 65536
  r13_lc2 = p1 DIV 65536
  io_13[AR_I_MI15_GO[p0] + 1] = r13_lc1
  io_13[AR_I_MI15_GO[p0] + 2] = r13_lc2
  SELECT p2 OF
  CASE(1):
  IF ((io_01[AR_I_MI15_DI[p0] + 18] = 0) AND (io_01[AR_I_MI15_DI[p0] + 19] = 0)) THEN
  io_02[AR_I_MI15_DO[p0] + 17] = 1
  sv_i = MI15_SETTIMER(TIMEOUT_PROCESS)
  -- stmt229 stray sv_i
  -- stmt230 stray AR_I_MI15_DI[p0] + 18 | 0[p0] + 19
  sv_i = MI15_RESETTIMER
  -- stmt231 stray sv_i
  IF ((I_TIMER > 0)) THEN
  sv_s = INTTOSTR(AR_I_MI15_DI[p0] + 18)
  sv_s = INTTOSTR(AR_I_MI15_DI[p0] + 19)
  POST_ERR(38100, 'WAIT FOR DIN[' + sv_s + '] or DIN[' + sv_s + ']', 0, 0)
  ENDIF
  ELSE
  io_02[AR_I_MI15_DO[p0] + 17] = 0
  ENDIF
  CASE(2):
  POST_ERR(38100, 'USER: Reloading', 0, 0)
  ELSE:
  -- stmt241 residue 3000
  ENDSELECT
  RETURN(0)
END MI15_RELOAD

ROUTINE MI15_SENDBSNUM(p0 : INTEGER) : INTEGER
VAR
  r14_lc1 : INTEGER
BEGIN
  FOR r14_lc1 = 1 TO 3 DO
  IF ((io_01[I_MI01_DI + 129 + r14_lc1 - 1] <> 0)) THEN
  io_02[AR_I_MI15_DO[p0] + 81 + r14_lc1 - 1] = 1
  ELSE
  io_02[AR_I_MI15_DO[p0] + 81 + r14_lc1 - 1] = 0
  ENDIF
  ENDFOR
  RETURN(0)
END MI15_SENDBSNUM

ROUTINE MI15_DIECHECK(p0, p1 : INTEGER) : INTEGER
BEGIN
  sv_i = MI15_CHECKCONTROLLER(p0)
  -- stmt27 stray sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'System Ready'
  LST_ERROR_f38[256] = 'Wait for System Ready'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 11, 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  SELECT p1 OF
  CASE(1):
  CASE(2):
  -- stmt38 residue 1000
  IF ((io_01[AR_I_MI15_DI[p0] + 36] = 0)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Die Check Not Ready'
  LST_ERROR_f38[256] = 'Wait for Die Check Ready'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 36, 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  io_02[AR_I_MI15_DO[p0] + 39] = 1
  sv_i = MI15_SETTIMER(TIMEOUT_PROCESS)
  -- stmt52 stray sv_i
  REPEAT
  DELAY 128
  UNTIL((io_01[AR_I_MI15_DI[p0] + 39 + p0 - 1] <> 0) OR (I_TIMER > 0))
  IF ((I_TIMER > 0)) THEN
  io_02[AR_I_MI15_DO[p0] + 39] = 0
  ENDIF
  REPEAT
  DELAY 128
  sv_i = DB_PROMPT(2, 'RIVET STATUS', 'Please Die status \nYES -> skip          \nNO  -> check manually      ', 4)
  EC_RET = sv_i
  -- stmt63 residue 'Please Die status \\nYES -> skip          \\nNO  -> check manually      '
  UNTIL((EC_RET = 3) OR (EC_RET = 4))
  CASE(3):
  CASE(4):
  REPEAT
  DELAY 128
  sv_i = DB_PROMPT(0, 'Request for Worker CONFIRMATION', 'Please make sure die is OK', 7)
  EC_RET = sv_i
  ELSE:
  UNTIL((EC_RET = 1))
  ENDSELECT
  io_02[AR_I_MI15_DO[p0] + 39] = 0
  RETURN(0)
END MI15_DIECHECK

BEGIN
END MI15_SPR_ROUT
