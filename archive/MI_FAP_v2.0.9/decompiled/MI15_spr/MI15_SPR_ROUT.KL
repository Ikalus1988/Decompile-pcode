  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Home Present'
  LST_ERROR_f38[256] = 'Wait for Gun Home'
  sv_i = WAIT_SIGNAL(256, 1, AR_I_MI15_DI[p0] + 29, 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  CASE(2):
  io_02[AR_I_MI15_DO[p0] + 9] = 0
  io_02[AR_I_MI15_DO[p0] + 10] = 0
  io_02[AR_I_MI15_DO[p0] + 11] = 0
  io_02[AR_I_MI15_DO[p0] + 8] = 0
