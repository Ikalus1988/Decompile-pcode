ROUTINE MI15_CHECK_APP_MODE(p0 : INTEGER) : INTEGER
VAR
  r2_lc1 : INTEGER
BEGIN
  IF ((sv_i = 3)) THEN
  IF ((io_01[I_MI01_DI + 35] <> 0)) THEN
  MI15_APPLMODE = 2
  ELSE
  MI15_APPLMODE = 1
  ENDIF
  IF ((io_01[I_MI01_DI + 35] <> 0)) THEN
  ENDIF
  REPEAT
  DELAY 32
  sv_i = DB_PROMPT(2, 'Application Mode acknowledge', 'YES -> Acknowledge Tryout Mode.\nNO  -> Ignore Tryout Mode.     ', 4)
  r2_lc1 = sv_i
  -- stmt122 residue 'YES -> Acknowledge Tryout Mode.\\nNO  -> Ignore Tryout Mode.     '
  UNTIL((r2_lc1 = 3) OR (r2_lc1 = 4))
  SELECT r2_lc1 OF
  CASE(3):
  MI15_APPLMODE = 2
  CASE(4):
  MI15_APPLMODE = 1
  ELSE:
  ENDSELECT
  ENDIF
  MI15_APPLMODE = 1
  RETURN(MI15_APPLMODE)
  RETURN(0)
END MI15_CHECK_APP_MODE

