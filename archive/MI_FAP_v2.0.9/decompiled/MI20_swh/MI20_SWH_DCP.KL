-- MI20_SWH_DCP.KL (decompiled v3)
PROGRAM MI20_SWH_DCP
%COMMENT = 'MI20 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALARMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[128]
	DCPLINE2: STRING[128]
	DCPLINE3: STRING[128]
	DCPLINE4: STRING[128]
	DCPLINE5: STRING[128]
	ENDSTRUCTURE
VAR
  ALMDCP : ALARMDCP
  ALMDCP_f04 : STRING[64]
  pp00 : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE ERROR_MSG(p0 : INTEGER) : STRING
BEGIN
  SELECT sv_i OF
