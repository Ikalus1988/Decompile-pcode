  r32_lc19 : INTEGER
  r32_lc20 : REAL
BEGIN
  GET_TPE_PRM(p0, r32_lc18, r32_lc19, r32_lc20, r32_lc17, v2)
  sv_i = CHECK_STATUS(v2)
  -- stmt149 stray sv_i
  IF (sv_b) THEN
  SELECT r32_lc18 OF
  CASE(1):
  v9 = r32_lc19
  CASE(2):
  v10 = r32_lc20
  CASE(3):
  v11 = r32_lc17
  ELSE:
  ENDSELECT
  ENDIF
  v9 = 2147483646
  v10 = 2147483646
  v11 = 'MAXINT'
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
  -- 弃参原式: 2
  -- stmt162 stray '' + sv_s + '] invalid data type'
  -- stmt162 residue 'TPE-PRM['
  RETURN(0)
END GETTPEPARAM

BEGIN
END LIB_MISC
