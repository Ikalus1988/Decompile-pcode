ROUTINE ISVIRTUALEDIT : BOOLEAN
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
BEGIN
  GET_VAR(r1_lc1, '*SYSTEM*', '$VIRTUALEDIT', r1_lc3, r1_lc2)
  IF ((r1_lc3 <> 1)) THEN
  RETURN(FALSE)
  ELSE
  RETURN(TRUE)
  ENDIF
  RETURN(sv_b)
END ISVIRTUALEDIT

