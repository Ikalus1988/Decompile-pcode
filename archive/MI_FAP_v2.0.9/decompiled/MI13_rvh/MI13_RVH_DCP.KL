PROGRAM MI13_RVH_DCP
%COMMENT = 'MI13 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALARMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[128]
	DCPLINE2: STRING[128]
	DCPLINE3: STRING[128]
	DCPLINE4: STRING[128]
	DCPLINE5: STRING[128]
