  POST_ERR(38100, 'Warning: Magazine(s) will be empty ', 0, 0)
  M13_PREWARNING = 1
  ENDIF
  IF ((io_01[67 + AR_M13_RC_DI[GUNCFG_LST[r1_lc1]]] <> 0)) THEN
  IF ((B_ONESHOT <> 0)) THEN
  B_ONESHOT = 0
  POST_ERR(38100, 'Warning: Magazine(s) empty ', 0, 0)
  ENDIF
  M13_PREWARNING = 1
  ELSE
  B_ONESHOT = 1
  ENDIF
  ENDIF
  ENDFOR
  RETURN(0)
END MI13_RVHWARNING

