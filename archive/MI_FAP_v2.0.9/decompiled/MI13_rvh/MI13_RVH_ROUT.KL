ROUTINE MI13_PRESERVICE(p0 : INTEGER) : INTEGER
BEGIN
  IF ((I_COUNTER >= I_PREWARNCOUNTER)) THEN
  POST_ERR(38100, 'Warning: Magazine(s) will be empty ', 0, 0)
  M13_PREWARNING = 1
  ENDIF
  IF ((io_01[67 + AR_M13_RC_DI[GUNCFG_LST[p0]]] <> 0)) THEN
  POST_ERR(38100, 'Warning: Magazine(s) empty ', 0, 0)
  M13_PREWARNING = 1
  ENDIF
  RETURN(0)
END MI13_PRESERVICE

