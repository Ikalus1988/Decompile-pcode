  sv_i = DB_PROMPT(0, 'Request for worker confirmation', 'Press \"OK\" if the rivet from last process has been removed', 7)
  L_STATE = sv_i
  -- stmt108 residue 'Press \\"OK\\" if the rivet from last process has been removed'
  DELAY 64
  UNTIL((L_STATE = 1))
  RETURN(0)
END MANUAL_REQOPERATOR

