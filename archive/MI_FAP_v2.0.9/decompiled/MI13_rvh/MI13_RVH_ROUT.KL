ROUTINE PAUSESTEP : INTEGER
VAR
  r0_lc1 : INTEGER
BEGIN
  GET_VAR(ENTRY, '*SYSTEM*', '$SSR.$SINGLESTEP', r0_lc1, L_STATE)
  IF ((r0_lc1 = 1)) THEN
  sv_i = CTRLACTPROGTPE('PAUSE')
  sv_i = CHECK_STATUS(sv_i)
  -- stmt87 stray sv_i
  ENDIF
  RETURN(0)
END PAUSESTEP

