  sv_i = DB_PROMPT(2, 'Application Mode acknowledge', 'YES -> Acknowledge Tryout Mode.\nNO  -> Ignore Tryout Mode.     ', 4)
  r21_lc1 = sv_i
  -- stmt180 residue 'YES -> Acknowledge Tryout Mode.\\nNO  -> Ignore Tryout Mode.     '
  UNTIL((r21_lc1 = 3) OR (r21_lc1 = 4))
  SELECT r21_lc1 OF
  CASE(3):
  M13_APPLMODE = 2
  CASE(4):
  M13_APPLMODE = 1
  ELSE:
  ENDSELECT
  ENDIF
  M13_APPLMODE = 1
  RETURN(M13_APPLMODE)
  RETURN(0)
END MI13_CHECK_APP_MODE

ROUTINE MI13_STARTPROCESS(p0 : INTEGER) : INTEGER
BEGIN
  IF ((B_FAIL_START_PROC <> 0)) THEN
  sv_i = MI13_SETTIMER(TIMEOUT_PROCESS)
  -- stmt211 stray sv_i
  -- stmt212 stray 2 + AR_M13_RC_DI[GUNCFG_LST[p0]]
  IF ((io_01[2 + AR_M13_RC_DI[GUNCFG_LST[p0]]] <> 0)) THEN
  B_FAIL_START_PROC = 0
  I_COUNTER = I_COUNTER + 1
  ENDIF
  IF ((I_TIMER > 0)) THEN
  IF ((B_FAIL_START_PROC = 0)) THEN
  B_FAIL_START_PROC = 1
  ENDIF
  ENDIF
  ELSE
  IF ((io_01[AR_M13_RC_DI[GUNCFG_LST[p0]] + 1] <> 0) AND (io_01[AR_M13_RC_DI[GUNCFG_LST[p0]] + 8] <> 0)) THEN
  io_02[AR_M13_RC_DO[GUNCFG_LST[p0]] + 1] = 1
  sv_i = CHECKGUNNOTHOME(p0)
  -- stmt236 stray sv_i
  sv_i = MI13_SETTIMER(TIMEOUT_PROCESS)
  -- stmt238 stray sv_i
  -- stmt239 stray 2 + AR_M13_RC_DI[GUNCFG_LST[p0]]
  IF ((io_01[2 + AR_M13_RC_DI[GUNCFG_LST[p0]]] <> 0)) THEN
  I_COUNTER = I_COUNTER + 1
  ENDIF
  IF ((I_TIMER > 0)) THEN
  IF ((B_FAIL_START_PROC = 0)) THEN
  B_FAIL_START_PROC = 1
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  RETURN(0)
END MI13_STARTPROCESS

ROUTINE MI13_STATUSPROCESS(p0 : INTEGER) : INTEGER
BEGIN
  IF ((B_FAIL_START_PROC <> 0)) THEN
  sv_i = MANUAL_STATUSREPEAT(p0)
  -- stmt16 stray sv_i
  ELSE
  B_SKIPPROC_NOSTART = 0
  ENDIF
  RETURN(0)
END MI13_STATUSPROCESS

ROUTINE MI13_COUPLE(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[21 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 0)) THEN
  sv_i = MI13_SET_GUN_CODE(p0)
  L_STATE = sv_i
  io_02[20 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  io_02[21 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  DELAY 50
  -- stmt41 residue 2000
  IF ((io_01[21 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 0)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Docking not completed'
  LST_ERROR_f38[256] = 'Waiting until tool connect is high'
  sv_i = WAIT_SIGNAL(256, 1, 21 + AR_M13_RC_DI[GUNCFG_LST[p0]], 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  B_ISDOCKED[p0] = 1
  ELSE
  POST_ERR(38100, 'Gun has already been connected', 0, 0)
  ENDIF
  RETURN(0)
END MI13_COUPLE

ROUTINE MI13_DECOUPLE(p0 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[21 + AR_M13_RC_DI[GUNCFG_LST[p0]]] <> 0) AND (io_01[3 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 0)) THEN
  io_02[20 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  io_02[21 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  DELAY 50
  -- stmt110 residue 1000
  IF ((io_01[20 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 0)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Docking not completed'
  LST_ERROR_f38[256] = 'Waiting until tool disconnect is high'
  sv_i = WAIT_SIGNAL(256, 1, 20 + AR_M13_RC_DI[GUNCFG_LST[p0]], 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  sv_i = MI13_SET_GUN_CODE(0)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Gun still connected'
  LST_ERROR_f38[256] = 'Gun connected still present'
  sv_i = WAIT_SIGNAL(256, 1, 21 + AR_M13_RC_DI[GUNCFG_LST[p0]], 0, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  B_ISDOCKED[p0] = 0
  ELSE
  POST_ERR(38100, 'Gun has already been connected', 0, 0)
  ENDIF
  RETURN(0)
END MI13_DECOUPLE

