END MI13_INIT

ROUTINE MI13_RIVET(p0, p1, p2, p3 : INTEGER) : INTEGER
VAR
  r27_lc1 : INTEGER
BEGIN
  L_REPEATCOUNTER = 0
  sv_i = MI13_IO_INIT(p0)
  -- stmt246 stray sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Rivet finish active'
  LST_ERROR_f38[256] = 'Syetem: (riveting ended) still present'
  sv_i = WAIT_SIGNAL(256, 1, 2 + AR_M13_RC_DI[GUNCFG_LST[p0]], 0, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  sv_i = MI13_CHECKFORERROR(p0)
  -- stmt0 stray sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Controller not ready'
  LST_ERROR_f38[256] = 'Wait for rivet controller is ready'
  sv_i = WAIT_SIGNAL(256, 1, 8 + AR_M13_RC_DI[GUNCFG_LST[p0]], 1, TIMEOUT_RIVET, 2)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Ready to start error'
  LST_ERROR_f38[256] = 'Wait for ready to start from controller'
  sv_i = WAIT_SIGNAL(256, 1, 1 + AR_M13_RC_DI[GUNCFG_LST[p0]], 1, TIMEOUT_RIVET, 2)
  L_STATE = sv_i
  sv_i = CHECKGUNHOME(p0)
  -- stmt27 stray sv_i
  sv_i = MI13_SET_RIVETID(p0, p1)
  L_STATE = sv_i
  sv_i = MI13_SET_NEXTRIVETID(p0, p2)
  L_STATE = sv_i
  DELAY 200
  io_02[1 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  io_02[9 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  sv_i = MI13_POS_CALC(p0, p3)
  r27_lc1 = sv_i
  sv_i = MI13_SET_TARGET_POS(p0, r27_lc1)
  L_STATE = sv_i
  io_02[5 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  B_FAIL_START_PROC = 0
  B_SKIPPROC_NOSTART = 0
  sv_i = MI13_CHECK_APP_MODE(p0)
  SELECT sv_i OF
  CASE(1):
  B_NOPROCESS = 0
  CASE(2):
  B_NOPROCESS = 1
  CASE(3):
  ABORT
  ELSE:
  ENDSELECT
  IF ((B_NOPROCESS <> 0)) THEN
  io_02[5 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 1
  sv_i = MI13_SETPOS(p0, p3)
  -- stmt85 stray sv_i
  sv_i = MI13_CTRLPOS(p0, p3)
  -- stmt88 stray sv_i
  io_02[9 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  sv_i = MI13_SET_RIVETID(p0, 0)
  L_STATE = sv_i
  ENDIF
  REPEAT
  sv_i = MI13_STARTPROCESS(p0)
  -- stmt102 stray sv_i
  sv_i = MI13_STATUSPROCESS(p0)
  -- stmt106 stray sv_i
  DELAY 16
  UNTIL((B_FAIL_START_PROC = 0))
  IF ((B_SKIPPROC_NOSTART <> 0)) THEN
  IF ((io_01[AR_M13_RC_DI[GUNCFG_LST[p0]] + 2] = 0)) THEN
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Riveting end not present'
  LST_ERROR_f38[256] = 'Waiting for process finished'
  sv_i = WAIT_SIGNAL(256, 1, 2 + AR_M13_RC_DI[GUNCFG_LST[p0]], 1, TIMEOUT_PROCESS, 2)
  L_STATE = sv_i
  ENDIF
  I_COUNTER = I_COUNTER + 1
  ENDIF
  IF ((B_FAIL_START_PROC = 0) OR (B_SKIPPROC_NOSTART <> 0)) THEN
  io_02[1 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  io_02[5 + AR_M13_RC_DO[GUNCFG_LST[p0]]] = 0
  sv_i = MI13_SET_RIVETID(p0, 0)
  L_STATE = sv_i
  sv_i = CHECKGUNHOME(p0)
  -- stmt156 stray sv_i
  ENDIF
  RETURN(0)
END MI13_RIVET

