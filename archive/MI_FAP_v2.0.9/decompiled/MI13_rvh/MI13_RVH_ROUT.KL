  LST_ERROR_f38[256] = 'Param. greater than the max opening Pos'
  sv_i = MSG_WRITE(256, 3)
  -- stmt253 stray sv_i
  ABORT
  ELSE
  ENDIF
  ENDIF
  RETURN(r15_lc2)
  RETURN(0)
END MI13_POS_CALC

