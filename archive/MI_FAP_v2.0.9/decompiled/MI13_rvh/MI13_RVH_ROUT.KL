  ENDIF
  LST_ERROR_f00[256] = 'SPR'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Rivet gun not in Pos'
  LST_ERROR_f38[256] = 'Waiting until gun in target position'
