  -- stmt10 stray sv_i
  REPEAT
  DELAY 8
  UNTIL((io_01[66 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 1) OR (io_01[3 + AR_M13_RC_DI[GUNCFG_LST[p0]]] = 1) OR (I_TIMER > 0))
  IF ((io_01[3 + AR_M13_RC_DI[GUNCFG_LST[p0]]] <> 0) OR (I_TIMER > 0)) THEN
  io_13[I_MI01_GO + 6] = 208
  L_STATE = 0
  ENDIF
  REPEAT
  sv_i = DB_PROMPT(2, 'Load EPF Error', 'YES: Acknowledge and repeat.\nNO: Process was OK.', 3)
  L_STATE = sv_i
