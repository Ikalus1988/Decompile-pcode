ROUTINE GET_PARM(p0, p1, p2 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE READ_DATA(p0 : SIGNAL_DEF) : INTEGER FROM MI_LIB
ROUTINE TP_CLS(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE TIMER_START(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE TIMER_STOP(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE WRITE_DATA(p0 : INTEGER; p1 : SIGNAL_DEF) : INTEGER FROM MI_LIB
ROUTINE WAITDATA(p0 : SIGNAL_DEF; p1 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE READ_OFS_DAT(p0, p1 : SIGNAL_DEF) : REAL
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
  r0_lc3 : REAL
  r0_lc4 : REAL
BEGIN
  sv_i = READ_DATA(p0)
  r0_lc1 = sv_i
  sv_i = READ_DATA(p1)
  r0_lc2 = sv_i
  r0_lc3 = r0_lc2 / 10000
  r0_lc4 = r0_lc1 + r0_lc3
  RETURN(r0_lc4)
  v2 = v1
  v3 = 'Modification Data : 2020-01-16'
  SELECT v4 OF
  CASE(28):
  IF (UNINIT(v5)) THEN
  sv_i = TP_CLS(0)
  -- stmt101 stray sv_i
  WRITE('   ###  Set The Max Offset For X(mm)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
  DELAY 0
  -- stmt104 stray v5
  ENDIF
  IF (UNINIT(v6)) THEN
  sv_i = TP_CLS(0)
  -- stmt107 stray sv_i
  WRITE('   ###  Set The Max Offset For Y(mm)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
  DELAY 0
  -- stmt110 stray v6
  ENDIF
  IF (UNINIT(v7)) THEN
  sv_i = TP_CLS(0)
  -- stmt113 stray sv_i
  WRITE('   ###  Set The Max Offset For Z(mm)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
