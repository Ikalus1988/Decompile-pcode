  ENDIF
  IF (UNINIT(v8)) THEN
  sv_i = TP_CLS(0)
  -- stmt119 stray sv_i
  WRITE('   ###  Set The Max Offset For W(deg)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
  DELAY 0
  -- stmt122 stray v8
  ENDIF
  IF (UNINIT(v9)) THEN
  sv_i = TP_CLS(0)
  -- stmt125 stray sv_i
  WRITE('   ###  Set The Max Offset For P(deg)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
  DELAY 0
  -- stmt128 stray v9
  ENDIF
  IF (UNINIT(v10)) THEN
  sv_i = TP_CLS(0)
  -- stmt131 stray sv_i
  WRITE('   ###  Set The Max Offset For R(deg)  ###', CR, CR, CR, CR)
  WRITE(CR, CR, CR, '  Plsase input value =')
  DELAY 0
  -- stmt134 stray v10
  sv_i = TP_CLS(0)
  -- stmt135 stray sv_i
  WRITE('     This step occurs only once', CR)
  WRITE(' when the program is loaded.', CR)
  WRITE('     If you want to change ', CR)
  WRITE(' this value again later.', CR, CR)
  WRITE('     1,Go to then selection screen ,', CR)
  WRITE('       Double click on the VS_APPCOR. ', CR)
  WRITE('     2,Press  DATA - KAREL_Vars.', CR)
  WRITE('     3,Find  MAX_OFST_XYZWPR and modified.', CR)
  WRITE('                                NEXT ', CR)
  WRITE('Press f5 again', CR)
  -- stmt146 stray 134
  sv_i = TP_CLS(0)
  -- stmt147 stray sv_i
  ENDIF
  sv_i = GET_PARM(1, v11, v12)
  -- stmt149 stray sv_i
  sv_i = GET_PARM(2, v13, v12)
  -- stmt150 stray sv_i
  SET_INT_REG(v13, 0, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  IF ((v14 <> 0)) THEN
  SET_INT_REG(v13, v14, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  ENDIF
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt170 stray v15_f04 | v0_f1c[1]
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt170 stray v16_f04 | v0_f58[1]
  sv_p = curpos(0, 0)
  v17 = sv_p
  WRITE('Waiting For Read Offset Data', CR)
  v18 = v18 + 1
  sv_i = WRITE_DATA(29, v19)
  -- stmt174 stray sv_i
  DELAY 100
  sv_i = WRITE_DATA(v18, v20)
  -- stmt176 stray sv_i
  ENABLE CONDITION[1]
  sv_i = TIMER_START(0)
  -- stmt179 stray sv_i
  sv_i = WAITDATA(v21, v18)
  -- stmt180 stray sv_i
  sv_i = READ_DATA(v22)
  v23 = sv_i
  IF ((v23 <> 1)) THEN
  sv_i = READ_DATA(v24)
  v14 = sv_i
  SET_INT_REG(v13, v14, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  -- stmt188 stray 1
  ENDIF
  sv_i = TIMER_STOP(0)
  -- stmt191 stray sv_i
  -- stmt192 stray 1
  SET_INT_REG(v13, 0, v12)
  sv_r = READ_OFS_DAT(v25, v26)
  v27_f00 = sv_r
  sv_r = READ_OFS_DAT(v28, v29)
  v27_f04 = sv_r
  sv_r = READ_OFS_DAT(v30, v31)
  v27_f08 = sv_r
  sv_r = READ_OFS_DAT(v32, v33)
  v27_f0c = sv_r
  sv_r = READ_OFS_DAT(v34, v35)
  v27_f10 = sv_r
  sv_r = READ_OFS_DAT(v36, v37)
  v27_f14 = sv_r
  WRITE('Reading Offset Data Successful', CR)
  DELAY 0
  DELAY 0
  DELAY 0
  WRITE('  X=', '   Y=', '   Z=', CR)
  -- stmt201 stray v27_f00 | 8 | 3 | v27_f04 | 8 | 3 | v27_f08 | 8 | 3
  DELAY 0
  DELAY 0
  DELAY 0
  WRITE('  W=', '   P=', '   R=', CR)
  -- stmt202 stray v27_f0c | 8 | 3 | v27_f10 | 8 | 3 | v27_f14 | 8 | 3
  v17_f08 = v27_f00
  v17_f0c = v27_f04
  v17_f10 = v27_f08
  v17_f14 = v27_f0c
  v17_f18 = v27_f10
  v17_f1c = v27_f14
  IF ((v27_f08 <> 0) OR (0 > v7)) THEN
  SET_INT_REG(v13, 15, v12)
  v14 = 15
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  WRITE('            *** ERROR ***              ', CR)
  WRITE('        XYZ correction is too large', CR)
  ELSE
  IF ((v27_f14 <> 0) OR (0 > v10)) THEN
  SET_INT_REG(v13, 16, v12)
  v14 = 16
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  WRITE('            *** ERROR ***              ', CR)
  WRITE('        WPR correction is too large', CR)
  ELSE
  SET_POS_REG(v11, v17, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  ENDIF
  ENDIF
  CASE(20):
  sv_i = GET_PARM(1, v13, v12)
  -- stmt230 stray sv_i
  IF ((v14 <> 0)) THEN
