  ENDIF
  SET_INT_REG(v13, 0, v12)
  v18 = v18 + 1
  sv_i = WRITE_DATA(21, v19)
  -- stmt241 stray sv_i
  DELAY 100
  sv_i = WRITE_DATA(v18, v20)
  -- stmt243 stray sv_i
  ENABLE CONDITION[1]
  sv_i = TIMER_START(0)
  -- stmt245 stray sv_i
  sv_i = WAITDATA(v21, v18)
  -- stmt246 stray sv_i
  sv_i = READ_DATA(v22)
  v23 = sv_i
  IF ((v23 <> 0)) THEN
  sv_i = READ_DATA(v24)
  v14 = sv_i
  ENDIF
  sv_i = TIMER_STOP(0)
  -- stmt251 stray sv_i
  -- stmt252 stray 1
  WRITE('Send Calib Successful', CR)
  CASE(26):
  sv_i = GET_PARM(1, v13, v12)
  -- stmt255 stray sv_i
  IF ((v14 <> 0)) THEN
  SET_INT_REG(v13, v14, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  ENDIF
  SET_INT_REG(v13, 0, v12)
  v18 = v18 + 1
  sv_i = WRITE_DATA(27, v19)
  -- stmt9 stray sv_i
  DELAY 100
  sv_i = WRITE_DATA(v18, v20)
  -- stmt11 stray sv_i
  ENABLE CONDITION[1]
  sv_i = TIMER_START(0)
  -- stmt14 stray sv_i
  sv_i = WAITDATA(v21, v18)
  -- stmt15 stray sv_i
  sv_i = READ_DATA(v22)
  v23 = sv_i
  IF ((v23 <> 0)) THEN
  sv_i = READ_DATA(v24)
  v14 = sv_i
  ENDIF
  sv_i = TIMER_STOP(0)
  -- stmt20 stray sv_i
  -- stmt21 stray 1
  WRITE('Send Reference Successful', CR)
  ENDSELECT
  IF ((v14 <> 0)) THEN
  SET_INT_REG(v13, v14, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  ENDIF
  IF ((v38 <> 0)) THEN
  SET_INT_REG(v13, 14, v12)
  IF ((v12 <> 0)) THEN
  POST_ERR(v12, '', 0, 2)
  ENDIF
  ENDIF
  RETURN(sv_r)
END READ_OFS_DAT

BEGIN
END VS_APPCOR
