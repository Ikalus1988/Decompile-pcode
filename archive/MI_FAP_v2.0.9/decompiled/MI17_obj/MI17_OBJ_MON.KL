-- MI17_OBJ_MON.KL (decompiled v3)
PROGRAM MI17_OBJ_MON
%COMMENT = 'MI17 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  B_MON_17 : INTEGER
  I_MON : INTEGER
  I_MI17_DI : INTEGER
  I_MI17_DO : INTEGER
  I_MI17_GI : INTEGER
  I_MI17_GO : INTEGER
  I_STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE INTERCONNECT(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE MI17_SENDBSNUM(p0 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  IF ((B_MON_17 <> 0)) THEN
  sv_i = MI17_SENDBSNUM(0)
  -- stmt29 stray sv_i
  IF (UNINIT(I_MON)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON < 32)) THEN
  I_MON = 32
  ENDIF
  IF ((I_MON > 256)) THEN
  I_MON = 256
  ENDIF
  DELAY I_MON
  ELSE
  ENDIF
END MI17_OBJ_MON

