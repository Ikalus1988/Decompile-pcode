ROUTINE WRITE_DATA(p0 : INTEGER; p1 : SIGNAL_DEF) : INTEGER
VAR
  r1_lc33 : STRING[64]
  r1_lc34 : STRING[64]
  r1_lc35 : INTEGER
  r1_lc36 : INTEGER
  r1_lc37 : INTEGER
BEGIN
  sv_i = GET_SIGNAL
  -- stmt82 stray sv_i
  FOR r1_lc36 = 1 TO 3 DO
  SET_PORT_VAL(2, p1.SIG_START + r1_lc36 - 1, 0, r1_lc37)
  ENDFOR
  CNV_INT_STR(p0, 0, 2, r1_lc33)
  sv_i = str_len(r1_lc33)
  r1_lc35 = sv_i - 1
  sv_s = sub_str(r1_lc33, 2, r1_lc35)
  r1_lc33 = sv_s
  REPEAT
  sv_i = str_len(r1_lc33)
  r1_lc35 = sv_i
  IF ((r1_lc35 < p1.SIG_LEN)) THEN
  r1_lc33 = '0' + r1_lc33
  ENDIF
  UNTIL((r1_lc35 = p1.SIG_LEN))
  FOR r1_lc36 = 1 TO 3 DO
  sv_s = sub_str(r1_lc33, p1.SIG_LEN - r1_lc36 + 1, 1)
  r1_lc34 = sv_s
  IF ((r1_lc34 = '0')) THEN
  SET_PORT_VAL(2, p1.SIG_START + r1_lc36 - 1, 0, r1_lc37)
  ELSE
  IF ((r1_lc34 = '1')) THEN
  SET_PORT_VAL(2, p1.SIG_START + r1_lc36 - 1, 1, r1_lc37)
  ENDIF
  ENDIF
  ENDFOR
  RETURN(0)
END WRITE_DATA

ROUTINE READ_DATA(p0 : SIGNAL_DEF) : INTEGER
VAR
  r2_lc17 : ARRAY[64] OF INTEGER
  r2_lc18 : INTEGER
  r2_lc19 : INTEGER
  r2_lc20 : INTEGER
  r2_lc21 : INTEGER
BEGIN
  sv_i = GET_SIGNAL
  -- stmt122 stray sv_i
  r2_lc17[1] = 1
  r2_lc17[2] = 2
  r2_lc17[3] = 4
  r2_lc17[4] = 8
  r2_lc17[5] = 16
  r2_lc17[6] = 32
  r2_lc17[7] = 64
  r2_lc17[8] = 128
  r2_lc17[9] = 256
  r2_lc17[10] = 512
  r2_lc17[11] = 1024
  r2_lc17[12] = 2048
  r2_lc17[13] = 4096
  r2_lc17[14] = 8192
  r2_lc17[15] = 16384
  r2_lc17[16] = (0 - 32768)
  r2_lc20 = 0
  FOR r2_lc19 = 1 TO 3 DO
  GET_PORT_VAL(1, p0.SIG_START + r2_lc19 - 1, r2_lc18, r2_lc21)
  r2_lc20 = r2_lc20 + r2_lc18 * r2_lc17[r2_lc19]
  ENDFOR
  RETURN(r2_lc20)
  RETURN(0)
END READ_DATA

