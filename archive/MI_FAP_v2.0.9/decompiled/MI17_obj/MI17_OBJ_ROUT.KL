ROUTINE INTERCONNECT(p0, p1 : INTEGER) : INTEGER
BEGIN
  IF ((io_01[p0] <> 0)) THEN
  io_02[p1] = 1
  ELSE
  io_02[p1] = 0
  ENDIF
  RETURN(0)
END INTERCONNECT

ROUTINE MI17_SENDBSNUM : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
BEGIN
  sv_i = round(64 / 8)
  FOR r1_lc2 = 1 TO 3 DO
  FOR r1_lc1 = 1 TO 3 DO
  r1_lc3 = I_MI01_DI + 129 + r1_lc1 - 1 + r1_lc2 - 1 * 8
  r1_lc4 = I_MI17_DO + 233 + r1_lc1 - 1 + r1_lc2 - 1 * 4
  sv_i = INTERCONNECT(r1_lc3, r1_lc4)
  -- stmt57 stray sv_i
  ENDFOR
  ENDFOR
  RETURN(0)
END MI17_SENDBSNUM

BEGIN
