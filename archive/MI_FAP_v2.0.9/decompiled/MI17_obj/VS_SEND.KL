-- VS_SEND.KL (decompiled v3)
PROGRAM VS_SEND
%COMMENT = 'Vs Send Pos V1.8'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	SIGNAL_DEF = STRUCTURE
	SIG_START: INTEGER
	SIG_LEN: INTEGER
	ENDSTRUCTURE
	UFRAME_DAT = STRUCTURE
	UFRAME_NO: INTEGER
	UFRAME_POS: INTEGER
	ENDSTRUCTURE
	UTOOL_DAT = STRUCTURE
	UTOOL_NO: INTEGER
	UTOOL_POS: INTEGER
	ENDSTRUCTURE
	POS_DAT = STRUCTURE
	INT_VAL: INTEGER
	DECI_VAL: INTEGER
	ENDSTRUCTURE
VAR
  v1 : INTEGER
  v2 : STRING[64]
  v3 : STRING[64]
  v4 : STRING[64]
  v5 : INTEGER
  v6 : INTEGER
  v7 : ARRAY[64] OF INTEGER
  v8 : ARRAY[64] OF INTEGER
  v9 : ARRAY[64] OF INTEGER
