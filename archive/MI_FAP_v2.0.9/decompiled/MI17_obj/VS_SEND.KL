  v0_f58 : ARRAY[64] OF INTEGER
  v20_f08 : REAL
  v20_f0c : REAL
  v20_f10 : REAL
  v20_f14 : REAL
  v20_f18 : REAL
  v20_f1c : REAL
  v21_f00 : INTEGER
  v21_f04 : INTEGER
  v22_f00 : INTEGER
  v22_f04 : INTEGER
  v23_f00 : INTEGER
  v23_f04 : INTEGER
  v24_f00 : INTEGER
  v24_f04 : INTEGER
  v25_f00 : INTEGER
  v25_f04 : INTEGER
  v26_f00 : INTEGER
  v26_f04 : INTEGER
  v5_f00 : INTEGER
  v5_f04 : INTEGER
  v6_f00 : INTEGER
  v6_f04 : INTEGER
