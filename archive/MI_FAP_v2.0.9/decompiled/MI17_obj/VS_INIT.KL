ROUTINE GET_PARM(p0, p1, p2 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE WRITE_DATA(p0 : INTEGER; p1 : SIGNAL_DEF) : INTEGER FROM MI_LIB
ROUTINE READ_DATA(p0 : SIGNAL_DEF) : INTEGER FROM MI_LIB

ROUTINE TP_CLS : INTEGER
BEGIN
  sv_s = chr(137)
  sv_s = chr(128)
  WRITE(sv_s, sv_s)
  sv_s = chr(137)
  sv_s = chr(128)
  WRITE(sv_s, sv_s)
  sv_s = chr(137)
  sv_s = chr(128)
  WRITE(sv_s, sv_s)
  FORCE_SPMENU(1, 37, 1)
  RETURN(0)
END TP_CLS

ROUTINE TIMER_START : INTEGER
BEGIN
  v1 = 0
  RETURN(0)
END TIMER_START

ROUTINE TIMER_STOP : INTEGER
BEGIN
  v1 = 0
  RETURN(0)
END TIMER_STOP

ROUTINE WAITDATA(p0 : SIGNAL_DEF; p1 : INTEGER) : INTEGER
VAR
  r3_lc1 : INTEGER
BEGIN
  DELAY 8
  sv_i = READ_DATA(p0)
  r3_lc1 = sv_i
  IF ((r3_lc1 = p1) OR (v2 = 1)) THEN
  PURGE CONDITION[1]
  -- stmt73 stray 1 | v1 | v3 | 1 | 14
  v4 = 0
  v5 = 0
  v7 = v6
  v8 = 'Modification Data : 2020-01-17'
  sv_s = chr(137)
  sv_s = chr(128)
  WRITE(sv_s, sv_s)
  WRITE('Vision Initialization', CR)
  sv_i = GET_PARM(1, v9, v10)
  -- stmt91 stray sv_i
  v3 = 8000
  v11 = 1
  v2 = 0
  sv_i = WRITE_DATA(0, v12)
  -- stmt98 stray sv_i
  sv_i = WRITE_DATA(0, v13)
  -- stmt99 stray sv_i
  sv_i = WRITE_DATA(0, v14)
  -- stmt100 stray sv_i
  sv_i = WRITE_DATA(v9, v15)
  -- stmt101 stray sv_i
  sv_i = WRITE_DATA(0, v16)
  -- stmt102 stray sv_i
  sv_i = WRITE_DATA(0, v17)
  -- stmt103 stray sv_i
  sv_i = WRITE_DATA(0, v18)
  -- stmt104 stray sv_i
  sv_i = WRITE_DATA(0, v19)
  -- stmt105 stray sv_i
  sv_i = WRITE_DATA(0, v20)
  -- stmt106 stray sv_i
  sv_i = WRITE_DATA(0, v21)
  -- stmt107 stray sv_i
  sv_i = WRITE_DATA(0, v22)
  -- stmt108 stray sv_i
  sv_i = WRITE_DATA(0, v23)
  -- stmt109 stray sv_i
  sv_i = WRITE_DATA(0, v24)
  -- stmt110 stray sv_i
  sv_i = WRITE_DATA(0, v25)
  -- stmt111 stray sv_i
  sv_i = WRITE_DATA(0, v26)
  -- stmt112 stray sv_i
  sv_i = WRITE_DATA(0, v27)
  -- stmt113 stray sv_i
  sv_i = WRITE_DATA(v5, v28)
  -- stmt114 stray sv_i
  ENABLE CONDITION[1]
  sv_i = TIMER_START
  -- stmt117 stray sv_i
  sv_i = WAITDATA(v29, v5)
  -- stmt118 stray sv_i
  sv_i = TIMER_STOP
  -- stmt123 stray sv_i
  -- stmt124 stray 1
  WRITE('Initialization Complete', CR)
  ENDIF
  RETURN(0)
END WAITDATA

BEGIN
END VS_INIT
