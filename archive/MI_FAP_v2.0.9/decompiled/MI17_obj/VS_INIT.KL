-- VS_INIT.KL (decompiled v3)
PROGRAM VS_INIT
%COMMENT = 'Vs Init V1.6'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	SIGNAL_DEF = STRUCTURE
	SIG_START: INTEGER
