  I_DI_UNLOCKED = I_TCH_RS_DI + 8
  I_DI_DOCKED = I_TCH_RS_DI + 5
  I_DI_SAFETY = I_TCH_RS_DI + 1
  I_GI_TOOLCOD = I_TCH_RS_GI + 1
