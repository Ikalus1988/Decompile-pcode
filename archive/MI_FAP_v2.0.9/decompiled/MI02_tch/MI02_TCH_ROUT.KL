  sv_i = MI02_GIMSGOUT(I_GI_TOOLCOD, p0, TIMEOUT_TCHCHECK, 111, 1, 'Current ToolNum Incorrect')
  -- stmt9 stray sv_i
  ENDIF
  ENDIF
  RETURN(0)
END TOOLNUMBER

ROUTINE CHECKTOOL(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 = 1)) THEN
