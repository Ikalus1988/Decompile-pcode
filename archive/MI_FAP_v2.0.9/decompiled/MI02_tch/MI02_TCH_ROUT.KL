ROUTINE TCH_TOOLCHANGE(p0 : INTEGER) : INTEGER
VAR
  r20_lc1 : INTEGER
  r20_lc2 : INTEGER
  r20_lc3 : INTEGER
BEGIN
  sv_i = INIT_VARS
  -- stmt95 stray sv_i
  I_TOOLNO = p0
  r20_lc3 = 0
  IF ((B_IS_STABLI <> 0)) THEN
  IF ((io_12[I_GI_TOOLCOD] <> I_TOOLNO)) THEN
  r20_lc3 = 1
