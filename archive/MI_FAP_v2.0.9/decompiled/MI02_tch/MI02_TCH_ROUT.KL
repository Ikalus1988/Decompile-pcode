  sv_i = MI02_DIMSGOUT(I_DI_LOCKED, 0, TIMEOUT_TCHCHECK, 114, 1, 'Tool Unlock Error')
  -- stmt30 stray sv_i
  sv_i = MI02_DIMSGOUT(I_DI_UNLOCKED, 1, TIMEOUT_TCHCHECK, 114, 1, 'Tool Unlock Error')
  -- stmt31 stray sv_i
  ENDIF
  ENDIF
  IF ((p0 = 2)) THEN
  IF ((io_01[I_DI_LOCKED] = 0) OR (io_01[I_DI_UNLOCKED] <> 0)) THEN
  sv_i = MI02_DIMSGOUT(I_DI_LOCKED, 1, TIMEOUT_TCHCHECK, 113, 1, 'Tool Lock Error')
  -- stmt45 stray sv_i
  sv_i = MI02_DIMSGOUT(I_DI_UNLOCKED, 0, TIMEOUT_TCHCHECK, 113, 1, 'Tool Lock Error')
  -- stmt46 stray sv_i
  ENDIF
  IF ((B_IS_STABLI <> 0)) THEN
  IF ((io_01[I_DI_STB_AIRPRESSURE] = 0)) THEN
  sv_i = MI02_DIMSGOUT(I_DI_STB_AIRPRESSURE, 1, TIMEOUT_TCHCHECK, 113, 1, 'Air Pressure Error')
  -- stmt58 stray sv_i
  ENDIF
  ENDIF
  ENDIF
  RETURN(0)
END CHECKTOOL

