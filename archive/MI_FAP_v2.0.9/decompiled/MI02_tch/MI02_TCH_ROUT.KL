  -- stmt119 stray sv_i
  ENDIF
  ENDIF
  RETURN(0)
END MOUNTEDTOOL

ROUTINE CALCULATESTATION(p0 : INTEGER) : INTEGER
VAR
  r9_lc5 : ARRAY[64] OF INTEGER
BEGIN
  IF ((p0 MOD 2 = 0) AND (p0 <> 0)) THEN
  r9_lc5[1] = 0
  r9_lc5[2] = 1
  r9_lc5[3] = p0 DIV 2 - 1
  r9_lc5[4] = 0
  IF ((I_TOOLSTAND = 2)) THEN
  IF ((p0 = 4)) THEN
  r9_lc5[3] = p0 DIV 2 - 4
  ENDIF
  r9_lc5[4] = 8
  ENDIF
  ELSE
  r9_lc5[1] = 1
  r9_lc5[2] = 0
  r9_lc5[3] = p0 DIV 2
  r9_lc5[4] = 0
  IF ((I_TOOLSTAND = 2)) THEN
  IF ((p0 = 3)) THEN
  r9_lc5[3] = p0 DIV 2 - 3
  ENDIF
  r9_lc5[4] = 8
  ENDIF
  ENDIF
  -- stmt170 stray r9_lc5
  RETURN(0)
END CALCULATESTATION

ROUTINE CHECKNOMATCH(p0 : INTEGER; p1 : ARRAY OF INTEGER) : INTEGER
BEGIN
  IF ((io_01[I_TCH_CN_DI + p1[3] * 8 + p1[1] * 4 + p1[2] * 8] = io_01[I_TCH_CN_DI + p1[3] * 8 + p1[1] * 4 + p1[2] * 8 - 1])) THEN
  ELSE
  LST_ERROR_f00[256] = 'Tool Changer'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Sensor mismatch'
  LST_ERROR_f38[256] = 'Missmatch between configured sensors'
  sv_i = MSG_WRITE(256, 2)
  -- stmt197 stray sv_i
  ENDIF
  RETURN(0)
END CHECKNOMATCH

ROUTINE CHECKSTATION(p0, p1 : INTEGER; p2 : ARRAY OF INTEGER) : INTEGER
BEGIN
  IF ((p1 = 2)) THEN
  IF ((io_01[I_TCH_CN_DI + p2[3] * 8 + p2[1] * 4 + p2[2] * 8 - 1] <> 0)) THEN
  LST_ERROR_f00[256] = 'Tool Changer'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'No free'
  LST_ERROR_f38[256] = 'STATION not free'
  sv_i = WAIT_SIGNAL(256, 1, I_TCH_CN_DI + p2[3] * 8 + p2[1] * 4 + p2[2] * 8 - 1, 0, TIMEOUT_TCHCHECK, 2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  IF ((p1 = 1)) THEN
  IF ((io_01[I_TCH_CN_DI + p2[3] * 8 + p2[1] * 4 + p2[2] * 8 - 1] = 0)) THEN
  LST_ERROR_f00[256] = 'Tool Changer'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'No occupied'
  LST_ERROR_f38[256] = 'STATION not occupied'
  sv_i = WAIT_SIGNAL(256, 1, I_TCH_CN_DI + p2[3] * 8 + p2[1] * 4 + p2[2] * 8 - 1, 1, TIMEOUT_TCHCHECK, 2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  RETURN(0)
END CHECKSTATION

