  ELSE
  IF ((I_TOOLNO = 4)) THEN
  IF (NOT (sv_b)) THEN
  sv_s = INTTOSTR(I_TCH_RS_DI + 6)
  POST_ERR(38100, 'DI[' + sv_s + '] not assign', 0, 2)
  ELSE
  IF ((io_01[I_TCH_RS_DI + 6] = 0)) THEN
  r20_lc3 = 1
  ENDIF
  ENDIF
  IF ((io_12[I_GI_TOOLCOD] <> I_TOOLNO)) THEN
  r20_lc3 = 1
  ENDIF
  ENDIF
  ENDIF
  IF ((r20_lc3 <> 0)) THEN
  IF ((B_IS_STABLI = 0)) THEN
  IF (NOT (sv_b)) THEN
  sv_s = INTTOSTR(I_TCH_RS_DI + 6)
  POST_ERR(38100, 'DI[' + sv_s + '] not assign', 0, 2)
  ELSE
  IF ((io_01[I_TCH_RS_DI + 6] = 1)) THEN
  r20_lc1 = 4
  ELSE
  r20_lc1 = io_12[I_GI_TOOLCOD]
  ENDIF
  ENDIF
  r20_lc1 = io_12[I_GI_TOOLCOD]
  ENDIF
  IF ((r20_lc1 <> 0)) THEN
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
