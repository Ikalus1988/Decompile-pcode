  sv_s = INTTOSTR(r20_lc1)
  PROG_NAME = 'T_' + sv_s + '_UNDOCK'
  IF (NOT (sv_b)) THEN
  POST_ERR(38100, 'TP Program not exist: ' + PROG_NAME, 0, 2)
  ENDIF
  CALL_PROG(PROG_NAME, 1)
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
  -- 弃参原式: 0
  -- stmt147 stray '' + sv_s
  -- stmt147 residue 'MoveEnd(PRG): Place TOOL #'
  ELSE
  POST_ERR(38100, 'No tool exist', 0, 0)
  ENDIF
  r20_lc2 = I_TOOLNO
  IF ((r20_lc2 <> 0)) THEN
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
  -- 弃参原式: 0
  -- stmt154 stray '' + sv_s
  -- stmt154 residue 'MoveTo(PRG): Pick TOOL #'
  sv_s = INTTOSTR(r20_lc2)
  PROG_NAME = 'T_' + sv_s + '_DOCK'
  IF (NOT (sv_b)) THEN
  POST_ERR(38100, 'TP Program not exist: ' + PROG_NAME, 0, 2)
  ENDIF
  CALL_PROG(PROG_NAME, 1)
  sv_s = INTTOSTR(38100)
  POST_ERR(0, '', 0, 0)
  -- 弃参原式: 0
  -- stmt164 stray '' + sv_s
  -- stmt164 residue 'MoveEnd(PRG): Pick TOOL #'
  ENDIF
  POST_ERR(38100, 'The tool has been selected', 0, 0)
  ENDIF
  RETURN(0)
END TCH_TOOLCHANGE

