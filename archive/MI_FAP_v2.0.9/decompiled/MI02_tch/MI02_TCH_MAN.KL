ROUTINE RESETREDMSG : INTEGER
BEGIN
  ST_MANSMESS = ''
  RETURN(0)
END RESETREDMSG

ROUTINE ISVIRTUALEDIT : BOOLEAN
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
BEGIN
  GET_VAR(r1_lc1, '*SYSTEM*', '$VIRTUALEDIT', r1_lc2, L_STATE)
  IF ((r1_lc2 <> 1)) THEN
  RETURN(FALSE)
  ELSE
  RETURN(TRUE)
  ENDIF
  RETURN(sv_b)
END ISVIRTUALEDIT

ROUTINE SETTIMER(p0 : INTEGER) : INTEGER
BEGIN
  I_TIMER = p0 * (0 - 1)
  RETURN(0)
END SETTIMER

ROUTINE RESETTIMER : INTEGER
BEGIN
  RETURN(0)
END RESETTIMER

