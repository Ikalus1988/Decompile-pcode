ROUTINE INITLOCALVARS : INTEGER
BEGIN
  IF (UNINIT(I_MI19_DI)) THEN
  I_MI19_DI = 2104
  ENDIF
  IF (UNINIT(I_MI19_DO)) THEN
  I_MI19_DO = 2104
  ENDIF
  IF (UNINIT(I_MI19_GI)) THEN
  I_MI19_GI = 180
  ENDIF
  IF (UNINIT(I_MI19_GO)) THEN
  I_MI19_GO = 180
  ENDIF
  IF (UNINIT(I_TOX_MODE)) THEN
  I_TOX_MODE = 1
  ENDIF
  RETURN(0)
END INITLOCALVARS

ROUTINE ACTIONSELECT : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
BEGIN
  sv_i = GETTPEPRMINT(1)
  r1_lc1 = sv_i
  SELECT r1_lc1 OF
  CASE(1):
  IF ((I_TOX_MODE = 2)) THEN
  sv_i = MI19_INIT(0)
  -- stmt84 stray sv_i
  ELSE
  sv_i = MI19_SERVO_INIT(0)
  -- stmt86 stray sv_i
  ENDIF
  CASE(2):
  sv_i = GETTPEPRMINT(2)
  r1_lc2 = sv_i
  IF ((io_01[I_MI01_DO + 35] = 0)) THEN
  IF ((I_TOX_MODE = 2)) THEN
  sv_i = MI19_LOAD(r1_lc2)
  -- stmt93 stray sv_i
  ELSE
  sv_i = MI19_SERVO_LOAD(r1_lc2)
  -- stmt95 stray sv_i
  ENDIF
  ENDIF
  CASE(3):
  sv_i = GETTPEPRMINT(2)
  r1_lc3 = sv_i
  sv_i = ROBOTINPROC(1)
  -- stmt101 stray sv_i
  IF ((io_01[I_MI01_DO + 35] = 0)) THEN
  IF ((I_TOX_MODE = 2)) THEN
  sv_i = MI19_TOXSTART(r1_lc3)
  -- stmt104 stray sv_i
  ELSE
  sv_i = MI19_SERVO_TOXSTART(r1_lc3)
  -- stmt106 stray sv_i
  ENDIF
  ENDIF
  CASE(4):
  IF ((io_01[I_MI01_DO + 35] = 0)) THEN
  IF ((I_TOX_MODE = 2)) THEN
  sv_i = MI19_TOXEND(0)
  -- stmt113 stray sv_i
  ELSE
  sv_i = MI19_SERVO_TOXEND(0)
  -- stmt115 stray sv_i
  ENDIF
  ENDIF
  sv_i = ROBOTINPROC(2)
  ELSE:
  ENDSELECT
  sv_i = INITLOCALVARS
  -- stmt131 stray sv_i
  sv_i = ACTIONSELECT
  -- stmt133 stray sv_i
  RETURN(0)
END ACTIONSELECT

