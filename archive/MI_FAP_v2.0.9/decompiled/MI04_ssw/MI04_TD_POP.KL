-- MI04_TD_POP.KL (decompiled v3)
PROGRAM MI04_TD_POP
%COMMENT = 'MI04 2.0.9'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  R_NUM : INTEGER
  POP_INTERVAL : INTEGER
  I_STATUS : INTEGER
  STATUS : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


BEGIN
  IF (UNINIT(R_NUM)) THEN
  R_NUM = 100
  ENDIF
  IF (UNINIT(POP_INTERVAL)) THEN
  POP_INTERVAL = 1024
  ENDIF
  I_STATUS = 0
  REPEAT
  sv_i = DB_PROMPT(2, 'Tipwear check NOK', 'Re-dress?', 3)
  I_STATUS = sv_i
  DELAY POP_INTERVAL
  UNTIL((I_STATUS <> 0))
  SELECT I_STATUS OF
  CASE(3):
  SET_INT_REG(R_NUM, 1, STATUS)
  CASE(4):
  SET_INT_REG(R_NUM, 0, STATUS)
  ELSE:
  ENDSELECT
END MI04_TD_POP

