ROUTINE VG_CHKOFFSET : INTEGER
VAR
  r5_lc1 : INTEGER
BEGIN
  r5_lc1 = 0
  IF ((VGSTATUS_f80_f14_f00 = 0) AND (VGSTATUS_f80_f14_f04 = 0) AND (VGSTATUS_f80_f14_f08 = 0) AND (VGSTATUS_f80_f14_f0c = 0) AND (VGSTATUS_f80_f14_f10 = 0) AND (VGSTATUS_f80_f14_f14 = 0)) THEN
  r5_lc1 = 2
  RETURN(r5_lc1)
  ENDIF
  IF (UNINIT(VGSTATUS_fac_f00) OR UNINIT(VGSTATUS_fac_f04) OR UNINIT(VGSTATUS_fac_f08) OR UNINIT(VGSTATUS_fac_f0c) OR UNINIT(VGSTATUS_fac_f10) OR UNINIT(VGSTATUS_fac_f14)) THEN
  VGSTATUS_fac_f00 = 0
  VGSTATUS_fac_f04 = 0
  VGSTATUS_fac_f08 = 0
  VGSTATUS_fac_f0c = 0
  VGSTATUS_fac_f10 = 0
  VGSTATUS_fac_f14 = 0
  ENDIF
  IF ((VGSTATUS_f80_f14_f00 = VGSTATUS_fac_f00) AND (VGSTATUS_f80_f14_f04 = VGSTATUS_fac_f04) AND (VGSTATUS_f80_f14_f08 = VGSTATUS_fac_f08) AND (VGSTATUS_f80_f14_f0c = VGSTATUS_fac_f0c) AND (VGSTATUS_f80_f14_f10 = VGSTATUS_fac_f10) AND 
(VGSTATUS_f80_f14_f14 = VGSTATUS_fac_f14)) THEN
  r5_lc1 = 3
  RETURN(r5_lc1)
  ENDIF
  IF ((VGSTATUS_f80_f14_f00 > VGCONFIG_f0c_f00) OR (VGSTATUS_f80_f14_f00 < VGCONFIG_f24_f00)) THEN
  r5_lc1 = 1
  ENDIF
  IF ((VGSTATUS_f80_f14_f04 > VGCONFIG_f0c_f04) OR (VGSTATUS_f80_f14_f04 < VGCONFIG_f24_f04)) THEN
  r5_lc1 = 1
  ENDIF
  IF ((VGSTATUS_f80_f14_f08 > VGCONFIG_f0c_f08) OR (VGSTATUS_f80_f14_f08 < VGCONFIG_f24_f08)) THEN
  r5_lc1 = 1
  ENDIF
  IF ((VGSTATUS_f80_f14_f0c > VGCONFIG_f0c_f0c) OR (VGSTATUS_f80_f14_f0c < VGCONFIG_f24_f0c)) THEN
  r5_lc1 = 1
  ENDIF
  IF ((VGSTATUS_f80_f14_f10 > VGCONFIG_f0c_f10) OR (VGSTATUS_f80_f14_f10 < VGCONFIG_f24_f10)) THEN
  r5_lc1 = 1
  ENDIF
  IF ((VGSTATUS_f80_f14_f14 > VGCONFIG_f0c_f14) OR (VGSTATUS_f80_f14_f14 < VGCONFIG_f24_f14)) THEN
  r5_lc1 = 1
  ENDIF
  VGSTATUS_fac_f00 = VGSTATUS_f80_f14_f00
  VGSTATUS_fac_f04 = VGSTATUS_f80_f14_f04
  VGSTATUS_fac_f08 = VGSTATUS_f80_f14_f08
  VGSTATUS_fac_f0c = VGSTATUS_f80_f14_f0c
  VGSTATUS_fac_f10 = VGSTATUS_f80_f14_f10
  VGSTATUS_fac_f14 = VGSTATUS_f80_f14_f14
  RETURN(r5_lc1)
  RETURN(0)
END VG_CHKOFFSET

