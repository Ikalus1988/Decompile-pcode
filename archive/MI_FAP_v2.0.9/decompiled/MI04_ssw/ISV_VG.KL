BEGIN
  WRITE(CR, '----------', CR)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  IF ((VGCONFIG_f9c <> 0)) THEN
  GET_PORT_VAL(35, VGCONFIG_f04, r7_lc11, STATUS)
  IF ((r7_lc11 <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  sv_s = chr(128)
  sv_s = chr(137)
