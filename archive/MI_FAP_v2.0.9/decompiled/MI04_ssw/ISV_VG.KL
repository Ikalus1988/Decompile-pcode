ROUTINE ISV2_GIN(p0, p1 : INTEGER) : INTEGER
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
  r0_lc3 : INTEGER
BEGIN
  r0_lc1 = 0
  IF ((p0 > 0) AND (p1 > 0)) THEN
  r0_lc2 = 1
  FOR r0_lc3 = 1 TO 3 DO
  IF ((io_01[p0 + r0_lc3 - 1] <> 0)) THEN
  r0_lc1 = r0_lc1 + r0_lc2
  ENDIF
  r0_lc2 = r0_lc2 * 2
  ENDFOR
  ENDIF
  RETURN(r0_lc1)
  RETURN(0)
END ISV2_GIN

ROUTINE VG_MSG(p0, p1, p2, p3 : INTEGER) : INTEGER
BEGIN
  IF ((p0 > 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  ENDIF
  SELECT p0 OF
  CASE(1):
  ELSE:
  ENDSELECT
  SELECT p1 OF
  CASE(1):
  ELSE:
  ENDSELECT
  RETURN(0)
END VG_MSG

ROUTINE SOCKET_INIT : INTEGER
VAR
  r2_lc2 : STRING[64]
  r2_lc4 : STRING[64]
  r2_lc5 : INTEGER
  r2_lc6 : INTEGER
  r2_lc7 : INTEGER
BEGIN
  r2_lc5 = 0
  r2_lc6 = 0
  CNV_INT_STR(VGCONFIG_f00, 1, 0, r2_lc2)
  sv_s = sub_str(r2_lc2, 2, 1)
  r2_lc4 = 'C' + sv_s + ':'
  WRITE(CR)
  -- stmt127 stray FILEVG
  sv_i = IO_STATUS(FILEVG)
  r2_lc7 = sv_i
  IF ((r2_lc7 <> 0)) THEN
  r2_lc5 = r2_lc5 + 1
  -- stmt132 stray FILEVG
  CLR_IO_STAT(FILEVG)
  IF ((r2_lc7 > 67000) AND (r2_lc7 < 68000)) THEN
  MSG_DISCO(r2_lc4, r2_lc6)
  MSG_CONNECT(r2_lc4, r2_lc6)
  IF ((r2_lc6 <> 0)) THEN
  WRITE('ISV_VG: Socket connect failed', r2_lc6, CR)
  IF ((r2_lc5 >= 3)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Check ethernet connection', CR)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'OK')
  -- stmt144 stray 129
  DELAY 100
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  FORCE_SPMENU(1, 64, 1)
  ENDIF
  ELSE
  WRITE('ISV_VG: Socket connect success', CR)
  ENDIF
  ENDIF
  ENDIF
  IF ((r2_lc6 = 0)) THEN
  OPEN FILE FILEVG('RW', r2_lc4)
  sv_i = IO_STATUS(FILEVG)
  r2_lc7 = sv_i
  IF ((r2_lc7 <> 0)) THEN
  WRITE('ISV_VG: Open channel failed', r2_lc7, CR)
  IF ((r2_lc5 >= 3)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Check server status', CR)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'OK')
  -- stmt163 stray 129
  DELAY 100
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s)
  FORCE_SPMENU(1, 64, 1)
  ENDIF
  ELSE
  WRITE('ISV_VG: Open channel success', CR)
  ENDIF
  ENDIF
  RETURN(0)
END SOCKET_INIT

