  ENDIF
  REPEAT
  DELAY 32
  UNTIL((io_01[AR_I_MI04_FRES_RO_DI[p0] + 7] = 1) OR (I_PROCESSTIM > 3000))
  -- stmt83 residue 3000
  IF ((I_PROCESSTIM > 3000)) THEN
  io_13[I_MI01_GO + 6] = 150
  sv_s = INTTOSTR(AR_I_MI04_FRES_RO_DI[p0] + 7)
  POST_ERR(38100, 'TD Motor OFF' + ': Wait DI[' + sv_s + ']=1', 0, 0)
  -- stmt89 residue 1000
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_RO_DI[p0] + 7, 1, 3000, 150, 1, 'TD Motor OFF')
  -- stmt90 stray sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  CASE(2):
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 9] = 0
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 10] = 0
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 11] = 0
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 13] = 0
  B_FRES_HSPD = 0
  ELSE:
  ENDSELECT
  RETURN(0)
END FRES_MOTOR_HIGHSPEED

ROUTINE FRES_CHECKCAPVAL(p0, p1, p2, p3 : INTEGER) : INTEGER
VAR
  r18_lc1 : INTEGER
  r18_lc2 : INTEGER
BEGIN
  SELECT p1 OF
