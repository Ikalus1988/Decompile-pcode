  r18_lc2 = AR_I_MI04_FRES_RO_DI[p0] + 5
  CASE(2):
  r18_lc2 = AR_I_MI04_FRES_RO_DI[p0] + 6
  ELSE:
  ENDSELECT
  SELECT p2 OF
  CASE(1):
  REPEAT
  IF ((io_01[r18_lc2] <> 0)) THEN
  r18_lc1 = 1
  ELSE
  r18_lc1 = 0
  ENDIF
  DELAY 8
  UNTIL((r18_lc1 = 1) OR (I_PROCESSTIM > 3000))
  CASE(2):
  -- stmt138 residue 3000
  REPEAT
  IF ((io_01[r18_lc2] = 0)) THEN
  r18_lc1 = 0
  ELSE
  r18_lc1 = 1
  ENDIF
  DELAY 8
  UNTIL((r18_lc1 = 0) OR (I_PROCESSTIM > 3000))
  ELSE:
  -- stmt148 residue 3000
  ENDSELECT
  SET_INT_REG(p3, r18_lc1, I_STATUS)
  RETURN(0)
END FRES_CHECKCAPVAL

ROUTINE FRES_CHECK_CAP(p0, p1, p2, p3 : INTEGER) : INTEGER
VAR
  r19_lc1 : INTEGER
  r19_lc2 : INTEGER
BEGIN
  I_PROCESSTIM = 0
  sv_i = FRES_CHECKCAPVAL(p0, p1, p2, p3)
  -- stmt171 stray sv_i
  IF ((I_PROCESSTIM > 3000)) THEN
  ENDIF
  REPEAT
  IF ((p2 = 1)) THEN
  io_13[I_MI01_GO + 6] = 158
  ELSE
  io_13[I_MI01_GO + 6] = 157
  ENDIF
  r19_lc1 = 0
  REPEAT
  sv_i = DB_PROMPT(2, 'Last process NOK', 'YES: Re-teach position and continue.\nNO: Retry process.', 3)
  r19_lc1 = sv_i
  -- stmt184 residue 'YES: Re-teach position and continue.\\nNO: Retry process.'
  DELAY 64
  UNTIL((r19_lc1 <> 0))
  SELECT r19_lc1 OF
  CASE(3):
  I_PROCESSTIM = 0
  sv_i = FRES_CHECKCAPVAL(p0, p1, p2, p3)
  -- stmt195 stray sv_i
  IF ((I_PROCESSTIM > 3000)) THEN
  r19_lc2 = 0
  ELSE
  r19_lc2 = 1
  ENDIF
  CASE(4):
  SET_INT_REG(p3, (0 - 1), I_STATUS)
  r19_lc2 = 1
  ELSE:
  ENDSELECT
  UNTIL((r19_lc2 = 1))
  io_13[I_MI01_GO + 6] = 0
  RETURN(0)
END FRES_CHECK_CAP

