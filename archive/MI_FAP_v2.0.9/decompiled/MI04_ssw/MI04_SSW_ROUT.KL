ROUTINE MI04_SENDBSNUM : INTEGER
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
BEGIN
  IF (UNINIT(I_BNSTYPE)) THEN
  I_BNSTYPE = 1
  ENDIF
  IF ((I_BNSTYPE = 1)) THEN
  r0_lc2 = 80
  ELSE
  r0_lc2 = 64
  ENDIF
  FOR r0_lc1 = 1 TO 3 DO
  IF ((io_01[I_MI01_DI + 129 + r0_lc1 - 1] <> 0)) THEN
  io_02[I_MI04_DO + I_DO_ASCII_0_BIT0 + r0_lc1 - 1] = 1
  ELSE
  io_02[I_MI04_DO + I_DO_ASCII_0_BIT0 + r0_lc1 - 1] = 0
  ENDIF
  ENDFOR
  RETURN(0)
END MI04_SENDBSNUM

ROUTINE MI04_RESETTIME : INTEGER
BEGIN
  I_PROCESSTIM = 0
  ERRORONESHOT = 0
  ENABLE CONDITION[1]
  RETURN(0)
END MI04_RESETTIME

ROUTINE MI04_DIMSGOUT(p0, p1, p2, p3, p4 : INTEGER; p5 : STRING) : INTEGER
VAR
  r2_lc1 : INTEGER
BEGIN
  PURGE CONDITION[1]
  -- stmt98 stray 1 | I_MI01_DI + 5 | 153 | 1
  ENABLE CONDITION[1]
  ERRORONESHOT = 0
  IF ((p1 = 1)) THEN
  r2_lc1 = 1
  ELSE
  r2_lc1 = 0
  ENDIF
  I_PROCESSTIM = 0
  REPEAT
  DELAY 16
  IF ((I_PROCESSTIM > p2) AND (ERRORONESHOT = 0)) THEN
  io_13[I_MI01_GO + 6] = p3
  ERRORONESHOT = 1
  sv_s = INTTOSTR(38100)
  sv_s = INTTOSTR(p1)
  POST_ERR(0, '', 0, 0)
  -- 弃参原式: p4
  -- stmt118 stray '' + sv_s + ']=' + sv_s
  -- stmt118 residue ': Wait DI['
  ENDIF
  UNTIL((r2_lc1 = io_01[p0]))
  io_13[I_MI01_GO + 6] = 0
  PURGE CONDITION[1]
  RETURN(0)
END MI04_DIMSGOUT

ROUTINE MI04_FLOWOK(p0 : INTEGER) : INTEGER
VAR
  r3_lc3 : INTEGER
  r3_lc4 : INTEGER
  r3_lc5 : INTEGER
BEGIN
  IF ((I_TD_TYPE = 2)) THEN
  r3_lc3 = AR_I_MI04_TD_DI[p0]
  r3_lc4 = AR_I_MI04_TD_DO[p0]
  ELSE
  r3_lc3 = I_MI04_SW_DI
  r3_lc4 = I_MI04_SW_DO
  ENDIF
  IF (UNINIT(ERRORONE[1])) THEN
  ERRORONE[1] = 1
  ENDIF
  IF (UNINIT(ERRORONE[2])) THEN
  ERRORONE[2] = 1
  ENDIF
  IF (UNINIT(ERRORONE[3])) THEN
  ERRORONE[3] = 1
  ENDIF
  IF (UNINIT(I_PRO_TIME)) THEN
  I_PRO_TIME = 0
  ENDIF
  IF (UNINIT(I_RESET_FLOW_DELAY)) THEN
  I_RESET_FLOW_DELAY = 3000
  ENDIF
  IF (UNINIT(B_VALVEOPENSTARTED)) THEN
  B_VALVEOPENSTARTED = 0
  ENDIF
  IF ((io_01[r3_lc3 + 2] = 0) AND (io_23[31] = 0) AND (io_23[32] = 0)) THEN
  io_02[r3_lc4 + 1] = 0
  io_02[r3_lc4 + 2] = 1
  IF ((ERRORONE[1] = 1)) THEN
  ERRORONE[1] = 0
  POST_ERR(38100, 'Water valve is closed', 0, 0)
  ENDIF
  IF ((ERRORONE[3] = 1)) THEN
  ERRORONE[3] = 0
  sv_s = INTTOSTR(r3_lc3 + 2)
  sv_s = INTTOSTR(1)
  POST_ERR(38100, 'Flow Check NOK' + ': Wait DI[' + sv_s + ']=' + sv_s, 0, 1)
  ENDIF
  io_13[I_MI01_GO + 6] = 10
  io_02[I_MI01_DO + 44] = 0
  ENDIF
  r3_lc5 = 0
  IF ((io_02[I_MI01_DO + 52] = 0)) THEN
  IF ((io_01[I_MI01_DI + 5] <> 0) OR (io_0b[1] <> 0) OR (io_0e[153] <> 0) OR (io_02[I_MI04_DO + I_DO_ACKNOWLEDGE] <> 0) AND (io_23[31] = 0)) THEN
  r3_lc5 = 1
  ENDIF
  ENDIF
  IF ((B_VALVEOPENSTARTED <> 0)) THEN
  IF ((io_01[I_MI01_DI + 5] = 1) AND (io_02[r3_lc4 + 1] = 0) AND (io_02[r3_lc4 + 2] = 1)) THEN
  r3_lc5 = 1
  ENDIF
  ENDIF
  IF ((r3_lc5 <> 0)) THEN
  io_02[r3_lc4 + 1] = 1
  io_02[r3_lc4 + 2] = 0
  io_13[I_MI01_GO + 6] = 0
  I_WATEROK = 0
  I_PRO_TIME = 0
  IF ((ERRORONE[2] = 1)) THEN
  io_23[32] = 1
  ERRORONE[2] = 0
  POST_ERR(38100, 'Water valve is opened', 0, 0)
  ENDIF
  I_RESET_TIME = 0
  ENDIF
  REPEAT
  DELAY 8
  UNTIL((io_01[r3_lc3 + 2] = 1) OR (I_RESET_TIME > I_RESET_FLOW_DELAY))
  IF ((I_RESET_TIME > I_RESET_FLOW_DELAY)) THEN
  POST_ERR(38100, 'Cannot detect FLOW OK', 0, 0)
  io_02[r3_lc4 + 1] = 0
  io_02[r3_lc4 + 2] = 1
  io_13[I_MI01_GO + 6] = 10
  io_02[I_MI01_DO + 44] = 0
  ENDIF
  ERRORONE[2] = 1
  IF (UNINIT(I_WATEROK)) THEN
  I_WATEROK = 0
  ENDIF
  IF ((io_01[r3_lc3 + 2] <> 0)) THEN
  IF ((I_WATEROK <= I_RESET_FLOW_DELAY)) THEN
  ELSE
  I_WATEROK = 0
  io_02[I_MI01_DO + 44] = 1
  ENDIF
  ENDIF
  IF ((io_01[r3_lc3 + 2] = 0) AND (io_23[32] <> 0) AND (I_PRO_TIME <= I_RESET_FLOW_DELAY)) THEN
  ENDIF
  IF ((I_PRO_TIME > I_RESET_FLOW_DELAY)) THEN
  I_PRO_TIME = 0
  io_23[32] = 0
  ERRORONE[1] = 1
  IF ((io_02[I_MI04_DO + I_DO_ACKNOWLEDGE] = 0)) THEN
  ERRORONE[2] = 1
  ENDIF
  ERRORONE[3] = 1
  ENDIF
  RETURN(0)
END MI04_FLOWOK

ROUTINE MI04_TIPDRES(p0, p1 : INTEGER) : INTEGER
BEGIN
  SELECT p1 OF
  CASE(1):
  io_02[AR_I_MI04_TD_DO[p0] + 6] = 1
  B_TD_CHK = 1
  B_BLINK_CHK = 1
  I_BLINK_DI = AR_I_MI04_TD_DI[p0] + 4
  SET_VAR(1, 'MI04_ssw_chk2', 'i_tipdressno', p0, I_STATUS)
  sv_i = RUN_MONITOR('MI04_ssw_chk')
  -- stmt11 stray sv_i
  sv_i = RUN_MONITOR('MI04_ssw_chk2')
  -- stmt12 stray sv_i
  sv_i = DIMSGOUT(I_BLINK_DI, 1, 1000, 1, 'Wait blink')
  -- stmt13 stray sv_i
  sv_i = DIMSGOUT(I_BLINK_DI, 0, 1000, 1, 'Wait blink')
  -- stmt14 stray sv_i
  sv_i = DIMSGOUT(I_BLINK_DI, 1, 1000, 1, 'Wait blink')
  CASE(2):
  io_02[AR_I_MI04_TD_DO[p0] + 6] = 0
  B_BLINK_CHK = 0
  ELSE:
  ENDSELECT
  RETURN(0)
END MI04_TIPDRES

ROUTINE CAPCHANGEPRE(p0 : INTEGER; p1 : REAL) : INTEGER
VAR
  r5_lc1 : INTEGER
  r5_lc2 : INTEGER
BEGIN
  IF ((io_01[AR_I_MI04_TD_DI[p0] + 7] = 0)) THEN
  r5_lc2 = 1
  LST_ERROR_f00[r5_lc2] = 'SSW'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'NO CAP'
  LST_ERROR_f38[r5_lc2] = 'NO upper electrode cap of spring clip'
  sv_i = WAIT_SIGNAL(r5_lc2, 1, AR_I_MI04_TD_DI[p0] + 7, 1, 3000, 2)
  r5_lc1 = sv_i
  ENDIF
  IF ((io_01[AR_I_MI04_TD_DI[p0] + 8] = 0)) THEN
  r5_lc2 = 2
  LST_ERROR_f00[r5_lc2] = 'SSW'
  LST_ERROR_f10[r5_lc2] = 0
  LST_ERROR_f14[r5_lc2] = 'NO CAP'
  LST_ERROR_f38[r5_lc2] = 'NO lower electrode cap of spring clip'
  sv_i = WAIT_SIGNAL(r5_lc2, 1, AR_I_MI04_TD_DI[p0] + 8, 1, 3000, 2)
  r5_lc1 = sv_i
  ENDIF
  io_02[AR_I_MI04_TD_DO[p0] + 4] = 1
  sv_i = round(p1 * 1000)
  DELAY sv_i
  io_02[AR_I_MI04_TD_DO[p0] + 4] = 0
  RETURN(0)
END CAPCHANGEPRE

