ROUTINE FRES_MOTOR_HIGHSPEED(p0, p1 : INTEGER) : INTEGER
BEGIN
  SELECT p1 OF
  CASE(1):
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 9] = 1
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 10] = 1
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 11] = 1
  io_02[AR_I_MI04_FRES_RO_DO[p0] + 13] = 1
  B_FRES_HSPD = 1
  SET_VAR(1, 'MI04_ssw_chk2', 'i_tipdressno', p0, I_STATUS)
  sv_i = RUN_MONITOR('MI04_ssw_chk2')
  -- stmt76 stray sv_i
  IF ((io_01[AR_I_MI04_FRES_RO_DI[p0] + 7] = 0)) THEN
