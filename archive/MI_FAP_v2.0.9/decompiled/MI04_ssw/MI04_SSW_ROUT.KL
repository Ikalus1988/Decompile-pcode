  -- stmt166 stray sv_i
  IF ((I_PROCESSTIM > 3000)) THEN
  r8_lc3 = 0
  ELSE
  r8_lc3 = 1
  ENDIF
  CASE(4):
  SET_INT_REG(p2, (0 - 1), I_STATUS)
  r8_lc3 = 1
  ELSE:
  ENDSELECT
  UNTIL((r8_lc3 = 1))
  io_13[I_MI01_GO + 6] = 0
  RETURN(0)
END CHECKCAPUNIT

ROUTINE VALVECONTROL(p0, p1 : INTEGER) : INTEGER
VAR
  r9_lc1 : INTEGER
  r9_lc2 : INTEGER
  r9_lc3 : INTEGER
  r9_lc4 : INTEGER
BEGIN
  IF ((I_TD_TYPE = 2)) THEN
  r9_lc3 = AR_I_MI04_TD_DI[p0]
  r9_lc4 = AR_I_MI04_TD_DO[p0]
  ELSE
  r9_lc3 = I_MI04_SW_DI
  r9_lc4 = I_MI04_SW_DO
  ENDIF
  SELECT p1 OF
  CASE(1):
  SET_VAR(1, 'MI04_SSW_MON', 'i_tipdressno', p0, I_STATUS)
  IF ((io_01[r9_lc3 + 2] <> 0)) THEN
  io_02[r9_lc4 + 1] = 1
  io_02[r9_lc4 + 2] = 0
  io_23[31] = 0
  B_FLOWCHK = 1
  ELSE
  io_02[r9_lc4 + 2] = 1
  io_02[r9_lc4 + 1] = 0
  DELAY 100
  io_02[r9_lc4 + 1] = 1
  io_02[r9_lc4 + 2] = 0
  DELAY I_VALVEDELAY
  io_23[31] = 0
  B_FLOWCHK = 1
  ENDIF
  B_VALVEOPENSTARTED = 1
  CASE(2):
  io_02[r9_lc4 + 2] = 1
  io_02[r9_lc4 + 1] = 0
  B_FLOWCHK = 0
  B_VALVEOPENSTARTED = 0
  io_23[31] = 1
  IF ((io_01[r9_lc3 + 2] <> 0)) THEN
  r9_lc2 = 5
  LST_ERROR_f00[r9_lc2] = 'SSW'
  LST_ERROR_f10[r9_lc2] = 0
  LST_ERROR_f14[r9_lc2] = 'Discharge Error'
  LST_ERROR_f38[r9_lc2] = 'Discharge is NOT OFF'
  sv_i = WAIT_SIGNAL(r9_lc2, 1, r9_lc3 + 2, 0, 5000, 2)
  r9_lc1 = sv_i
  ENDIF
  ELSE:
  ENDSELECT
  RETURN(0)
END VALVECONTROL

ROUTINE SWIMMOTION(p0 : INTEGER) : INTEGER
BEGIN
  SELECT p0 OF
  CASE(1):
  IF ((io_01[I_MI04_SW_DI + 3] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 3, 1, 3000, 1, 'TD Breaker OFF')
  -- stmt6 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 4] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 4, 1, 3000, 1, 'Swim Breaker OFF')
  -- stmt16 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 10] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 10, 1, 3000, 1, 'SP21VR OFF')
  -- stmt26 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 8] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 8, 1, 3000, 1, 'SE21R OFF')
  -- stmt36 stray sv_i
  ENDIF
  io_02[I_MI04_SW_DO + 4] = 1
  IF ((io_01[I_MI04_SW_DI + 11] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 11, 1, 3000, 1, 'Contactor OFF')
  -- stmt48 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 9] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 9, 1, 3000, 1, 'SP21RV OFF')
  -- stmt59 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 7] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 7, 1, 3000, 1, 'SE21V OFF')
  -- stmt69 stray sv_i
  ENDIF
  io_02[I_MI04_SW_DO + 4] = 0
  IF ((io_01[I_MI04_SW_DI + 11] <> 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 11, 0, 3000, 1, 'Contactor ON')
  -- stmt81 stray sv_i
  ENDIF
  DELAY 2000
  io_02[I_MI04_SW_DO + 3] = 1
  IF ((io_01[I_MI04_SW_DI + 12] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 12, 1, 3000, 1, 'Contactor OFF')
  -- stmt95 stray sv_i
  ENDIF
  B_BLINK_CHK = 1
  I_BLINK_DI = I_MI04_SW_DI + 5
  sv_i = RUN_MONITOR('MI04_ssw_chk')
  CASE(2):
  io_02[I_MI04_SW_DO + 4] = 1
  B_BLINK_CHK = 0
  IF ((io_01[I_MI04_SW_DI + 10] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 10, 1, 3000, 1, 'SP21VR OFF')
  -- stmt120 stray sv_i
  ENDIF
  IF ((io_01[I_MI04_SW_DI + 8] = 0)) THEN
  sv_i = DIMSGOUT(I_MI04_SW_DI + 8, 1, 3000, 1, 'SE21R OFF')
  -- stmt130 stray sv_i
  ENDIF
  io_02[I_MI04_SW_DO + 4] = 0
  io_02[I_MI04_SW_DO + 3] = 0
  ELSE:
  ENDSELECT
  RETURN(0)
END SWIMMOTION

ROUTINE TS_CHECKWEAR(p0, p1 : INTEGER) : INTEGER
VAR
  r11_lc1 : INTEGER
  r11_lc10 : REAL
  r11_lc11 : INTEGER
  r11_lc12 : INTEGER
  r11_lc13 : INTEGER
  r11_lc14 : INTEGER
  r11_lc15 : REAL
  r11_lc16 : INTEGER
  r11_lc17 : INTEGER
  r11_lc2 : INTEGER
  r11_lc3 : INTEGER
  r11_lc4 : INTEGER
  r11_lc5 : REAL
  r11_lc6 : REAL
  r11_lc7 : REAL
  r11_lc8 : REAL
  r11_lc9 : REAL
BEGIN
  IF ((p0 = 2)) THEN
  SET_INT_REG(31, 0, I_STATUS)
  ENDIF
  SELECT p0 OF
  CASE(1):
  CASE(1):
  GET_VAR(1, '*SYSTEM*', '$SGGUN1.$SETUP.$WRDWN_TIP', r11_lc1, I_STATUS)
  GET_VAR(1, '*SYSTEM*', '$SGGUN1.$SETUP.$WRDWN_RBT', r11_lc2, I_STATUS)
  r11_lc7 = r11_lc1 + r11_lc2
  r11_lc5 = r11_lc7
  SET_REAL_REG(33, r11_lc7, I_STATUS)
  CASE(2):
  GET_VAR(1, '*SYSTEM*', '$SGGUN2.$SETUP.$WRDWN_TIP', r11_lc3, I_STATUS)
  GET_VAR(1, '*SYSTEM*', '$SGGUN2.$SETUP.$WRDWN_RBT', r11_lc4, I_STATUS)
  r11_lc9 = r11_lc3 + r11_lc4
  r11_lc5 = r11_lc9
  SET_REAL_REG(35, r11_lc9, I_STATUS)
  ELSE:
  ENDSELECT
  IF ((r11_lc5 > 3)) THEN
  r11_lc12 = 0
  POST_ERR(38100, 'Caps Not Changed', 0, 1)
  ENDIF
  REPEAT
  IF ((io_01[I_MI01_DI + 5] <> 0) OR (io_0b[1] <> 0) OR (io_0e[153] <> 0)) THEN
  r11_lc12 = 1
  ENDIF
  DELAY 100
  UNTIL((r11_lc12 <> 0))
  io_23[11] = 1
  SELECT sv_i OF
  CASE(2):
  GET_REG(37, (r11_lc13 <> 0), r11_lc14, r11_lc15, I_STATUS)
  -- 弃参原式: r11_lc13
  IF ((r11_lc13 <> 0)) THEN
  sv_i = round(r11_lc15)
  r11_lc11 = sv_i
  ELSE
  r11_lc11 = r11_lc14
  ENDIF
  CASE(1):
  GET_REG(33, (r11_lc13 <> 0), r11_lc14, r11_lc15, I_STATUS)
  -- 弃参原式: r11_lc13
  IF ((r11_lc13 <> 0)) THEN
  r11_lc6 = r11_lc15
  ELSE
  r11_lc6 = r11_lc14 * 1
  ENDIF
  IF ((r11_lc11 = 0)) THEN
  SET_REAL_REG(32, r11_lc6, I_STATUS)
  ENDIF
  GET_VAR(1, '*SYSTEM*', '$SGGUN1.$SETUP.$WRDWN_TIP', r11_lc1, I_STATUS)
  GET_VAR(1, '*SYSTEM*', '$SGGUN1.$SETUP.$WRDWN_RBT', r11_lc2, I_STATUS)
  r11_lc7 = r11_lc1 + r11_lc2
  r11_lc5 = r11_lc7
  r11_lc10 = r11_lc7 - r11_lc6
  SET_REAL_REG(33, r11_lc7, I_STATUS)
  SET_REAL_REG(36, r11_lc10, I_STATUS)
  CASE(2):
  GET_REG(35, (r11_lc13 <> 0), r11_lc14, r11_lc15, I_STATUS)
  -- 弃参原式: r11_lc13
  IF ((r11_lc13 <> 0)) THEN
  r11_lc8 = r11_lc15
  ELSE
  r11_lc8 = r11_lc14 * 1
  ENDIF
  IF ((r11_lc11 = 0)) THEN
  SET_REAL_REG(34, r11_lc8, I_STATUS)
  ENDIF
  GET_VAR(1, '*SYSTEM*', '$SGGUN2.$SETUP.$WRDWN_TIP', r11_lc3, I_STATUS)
  GET_VAR(1, '*SYSTEM*', '$SGGUN2.$SETUP.$WRDWN_RBT', r11_lc4, I_STATUS)
  r11_lc9 = r11_lc3 + r11_lc4
  r11_lc5 = r11_lc9
  r11_lc10 = r11_lc9 - r11_lc8
  SET_REAL_REG(35, r11_lc9, I_STATUS)
  SET_REAL_REG(36, r11_lc10, I_STATUS)
  ELSE:
  ENDSELECT
  IF ((io_23[33] = 0)) THEN
  IF ((r11_lc10 < 0.1)) THEN
  IF ((r11_lc11 >= 3) OR (r11_lc10 > 1)) THEN
  r11_lc12 = 0
  io_13[I_MI01_GO + 6] = 14
  POST_ERR(38100, 'TipWear Out Of Range', 0, 1)
  ENDIF
  REPEAT
  IF ((io_01[I_MI01_DI + 5] <> 0) OR (io_0b[1] <> 0) OR (io_0e[153] <> 0)) THEN
  r11_lc12 = 1
  ENDIF
  DELAY 100
  UNTIL((r11_lc12 <> 0))
  CALL_PROG('MI04_TD_POP', 1)
  GET_VAR(1, 'MI04_TD_POP', 'r_num', r11_lc16, I_STATUS)
  GET_REG(r11_lc16, (r11_lc13 <> 0), r11_lc14, r11_lc15, I_STATUS)
  -- 弃参原式: r11_lc13
  IF ((r11_lc13 <> 0)) THEN
  sv_i = round(r11_lc15)
  r11_lc17 = sv_i
  ELSE
  r11_lc17 = r11_lc14
  ENDIF
  IF ((r11_lc17 = 1)) THEN
  SET_INT_REG(31, 1, I_STATUS)
  ELSE
  SET_INT_REG(31, 0, I_STATUS)
  ENDIF
  io_13[I_MI01_GO + 6] = 0
  SET_INT_REG(31, 1, I_STATUS)
  ENDIF
  ENDIF
  RETURN(0)
END TS_CHECKWEAR

ROUTINE TS_RESET_TD(p0, p1 : INTEGER) : INTEGER
VAR
  r12_lc1 : INTEGER
  r12_lc2 : INTEGER
BEGIN
  SELECT p1 OF
  CASE(0):
  CASE(1):
  io_13[I_MI04_GO + 1] = 0
  io_13[I_MI04_GO + 1 + 1] = 0
  io_02[I_MI04_DO + I_DO_SPOT_NUM_BIT0] = 1
  CASE(2):
  io_13[I_MI04_GO + 1] = 0
  io_13[I_MI04_GO + 1 + 1] = 0
  io_02[I_MI04_DO + I_DO_SPOT_NUM_BIT0 + 1] = 1
  ELSE:
  ENDSELECT
  SELECT p0 OF
  CASE(1):
  -- stmt86 residue 1000
  DELAY 200
  IF ((io_01[I_MI04_DI + I_DI_MILLING_DEMAND] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 15
  r12_lc2 = 17
  LST_ERROR_f00[r12_lc2] = 'SSW'
  LST_ERROR_f10[r12_lc2] = 0
  LST_ERROR_f14[r12_lc2] = 'TD Rsq Nof off'
  LST_ERROR_f38[r12_lc2] = 'TipDress Request Not Off'
  sv_i = WAIT_SIGNAL(r12_lc2, 1, I_MI04_DI + I_DI_MILLING_DEMAND, 0, 3000, 2)
  r12_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  io_02[I_MI04_DO + I_DO_MILLING_COMPLETED] = 0
  CASE(2):
  -- stmt104 residue 1000
  IF ((io_01[I_MI04_DI + I_DI_MILLING_DEMAND] = 0) OR (io_01[I_MI04_DI + I_DI_REQELECCHG] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 16
  r12_lc2 = 18
  LST_ERROR_f00[r12_lc2] = 'SSW'
  LST_ERROR_f10[r12_lc2] = 0
  LST_ERROR_f14[r12_lc2] = 'TC REQ Not Off'
  LST_ERROR_f38[r12_lc2] = 'TipChg Request Not Off'
  sv_i = WAIT_SIGNAL(r12_lc2, 1, I_MI04_DI + I_DI_MILLING_DEMAND, 1, 3000, 2)
  r12_lc1 = sv_i
  sv_i = WAIT_SIGNAL(r12_lc2, 1, I_MI04_DI + I_DI_REQELECCHG, 0, 3000, 2)
  r12_lc1 = sv_i
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  DELAY 500
  io_02[I_MI04_DO + I_DO_COUNTER_RESET] = 0
  ELSE:
  ENDSELECT
  RETURN(0)
END TS_RESET_TD

ROUTINE TS_RESET_TD_BOSCH(p0, p1 : INTEGER) : INTEGER
