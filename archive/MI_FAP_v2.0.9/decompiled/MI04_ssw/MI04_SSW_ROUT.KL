  r7_lc1 = 0
  ELSE
  r7_lc1 = 1
  ENDIF
  DELAY 8
  UNTIL((r7_lc1 = 0) OR (I_PROCESSTIM > 3000))
  ELSE:
  -- stmt122 residue 3000
  ENDSELECT
  SET_INT_REG(p2, r7_lc1, I_STATUS)
  RETURN(0)
END CHECKCAPVAL

ROUTINE CHECKCAPUNIT(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r8_lc2 : INTEGER
  r8_lc3 : INTEGER
BEGIN
  I_PROCESSTIM = 0
  sv_i = CHECKCAPVAL(p0, p1, p2)
  -- stmt146 stray sv_i
  IF ((I_PROCESSTIM > 3000)) THEN
  ENDIF
  REPEAT
  io_13[I_MI01_GO + 6] = 157
  r8_lc2 = 0
  REPEAT
  sv_i = DB_PROMPT(2, 'Last process NOK', 'YES: Re-teach position and continue.\nNO: Retry process.', 3)
  r8_lc2 = sv_i
  -- stmt155 residue 'YES: Re-teach position and continue.\\nNO: Retry process.'
  DELAY 64
  UNTIL((r8_lc2 <> 0))
  SELECT r8_lc2 OF
  CASE(3):
  I_PROCESSTIM = 0
