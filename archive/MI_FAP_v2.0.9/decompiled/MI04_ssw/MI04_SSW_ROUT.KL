  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_RO_DI[p0] + 2, 1, 3000, 159, 1, 'MagLowFault')
  -- stmt11 stray sv_i
  ENDIF
  RETURN(0)
END FRES_CHECK_BOX

