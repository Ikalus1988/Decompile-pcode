ROUTINE FRES_SWING_CONTROL(p0, p1, p2 : INTEGER) : INTEGER
BEGIN
  IF ((p1 = 3)) THEN
  B_FRES_SWING_OVLD = 1
  SET_VAR(1, 'MI04_ssw_chk2', 'i_tipdressno', p0, I_STATUS)
  sv_i = RUN_MONITOR('MI04_ssw_chk2')
  -- stmt6 stray sv_i
  ENDIF
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 9] = 0
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 11] = 0
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 12] = 0
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 13] = 0
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 14] = 0
  SELECT p1 OF
  CASE(3):
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 8] = 1) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 7] = 0)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 8, 1, 3000, 154, 1, 'CylinderNotBW')
  -- stmt19 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 7, 0, 3000, 154, 1, 'CylinderNotBW')
  -- stmt20 stray sv_i
  ENDIF
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 11] = 1
  DELAY p2
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 6] = 0) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 5] = 1)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 6, 0, 3000, 155, 1, 'Dump Not Adv')
  -- stmt28 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 5, 1, 3000, 155, 1, 'Dump Not Adv')
  -- stmt29 stray sv_i
  ENDIF
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 11] = 0
  IF ((B_FRES_SWING_COMPENSATOR <> 0)) THEN
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 14] = 1
  DELAY 3000
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 8] = 0) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 7] = 1)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 8, 0, 3000, 153, 1, 'CylinderNotFW')
  -- stmt38 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 7, 1, 3000, 153, 1, 'CylinderNotFW')
  -- stmt39 stray sv_i
  ENDIF
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 8] = 1) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 7] = 0)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 8, 1, 3000, 154, 1, 'CylinderNotBW')
  -- stmt44 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 7, 0, 3000, 154, 1, 'CylinderNotBW')
  -- stmt45 stray sv_i
  ENDIF
  ENDIF
  CASE(4):
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 14] = 0
  DELAY p2
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 8] = 1) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 7] = 0)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 8, 1, 3000, 154, 1, 'CylinderNotBW')
  -- stmt55 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 7, 0, 3000, 154, 1, 'CylinderNotBW')
  -- stmt56 stray sv_i
  ENDIF
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 12] = 1
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 8] = 1) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 7] = 0)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 8, 1, 3000, 154, 1, 'CylinderNotBW')
  -- stmt63 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 7, 0, 3000, 154, 1, 'CylinderNotBW')
  -- stmt64 stray sv_i
  ENDIF
  IF ((io_01[AR_I_MI04_FRES_PD_DI[p0] + 6] = 1) AND (io_01[AR_I_MI04_FRES_PD_DI[p0] + 5] = 0)) THEN
  ELSE
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 6, 1, 3000, 156, 1, 'Dump Not Ret')
  -- stmt69 stray sv_i
  sv_i = MI04_DIMSGOUT(AR_I_MI04_FRES_PD_DI[p0] + 5, 0, 3000, 156, 1, 'Dump Not Ret')
  -- stmt70 stray sv_i
  ENDIF
  io_02[AR_I_MI04_FRES_PD_DO[p0] + 12] = 0
  ELSE:
  ENDSELECT
  IF ((p1 = 4)) THEN
  B_FRES_SWING_OVLD = 0
  ENDIF
  RETURN(0)
END FRES_SWING_CONTROL

