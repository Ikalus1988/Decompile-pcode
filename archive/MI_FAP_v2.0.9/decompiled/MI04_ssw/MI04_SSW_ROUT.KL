  ELSE:
  ENDSELECT
  SELECT p0 OF
  CASE(1):
  -- stmt159 residue 2000
  DELAY 200
  IF ((io_01[I_MI04_DI + 24] = 0) OR (io_01[I_MI04_DI + 23] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 15
  r13_lc2 = 17
  LST_ERROR_f00[r13_lc2] = 'SSW'
  LST_ERROR_f10[r13_lc2] = 0
  LST_ERROR_f14[r13_lc2] = 'ACK Tip Dress'
