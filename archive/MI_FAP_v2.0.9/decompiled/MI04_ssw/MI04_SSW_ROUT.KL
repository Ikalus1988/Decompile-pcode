  ENDIF
  io_02[I_MI04_DO + 24] = 0
  CASE(2):
  -- stmt179 residue 2000
  IF ((io_01[I_MI04_DI + 20] = 0) OR (io_01[I_MI04_DI + 18] <> 0)) THEN
  io_13[I_MI01_GO + 6] = 16
  r13_lc2 = 18
  LST_ERROR_f00[r13_lc2] = 'SSW'
  LST_ERROR_f10[r13_lc2] = 0
