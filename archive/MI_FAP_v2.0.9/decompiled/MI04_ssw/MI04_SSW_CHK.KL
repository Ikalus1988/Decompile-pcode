  I_PROCESSTIM = 0
  RETURN(0)
END ACTION_ON

ROUTINE CHECK_BLINK : INTEGER
BEGIN
  REPEAT
  DELAY 8
  UNTIL((I_PROCESSTIM > I_TIMEOUT) OR (B_BLINK_CHK = 0))
