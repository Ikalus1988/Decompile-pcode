  POST_ERR(38100, 'Reset rotatary alarm', 0, 0)
  ENDIF
  B_ERRORONE = 1
  B_ROTATE_FAILED = 0
  I_PROCESSTIM = 0
  IF (UNINIT(I_TIMEOUT)) THEN
  I_TIMEOUT = 1000
  ENDIF
