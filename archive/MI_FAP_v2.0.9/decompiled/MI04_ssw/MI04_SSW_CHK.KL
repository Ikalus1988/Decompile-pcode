  sv_i = CHECK_BLINK
  -- stmt140 stray sv_i
  DELAY 8
  ELSE
  B_ERRORONE = 1
  IF ((B_ROTATE_FAILED <> 0)) THEN
  sv_i = KEEP_ALARM
  -- stmt151 stray sv_i
  DELAY 256
  ELSE
  ENDIF
  ENDIF
  RETURN(0)
END KEEP_ALARM

