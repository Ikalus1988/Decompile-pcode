  B_ERRORONE = 1
  sv_i = ACTION_ON
  -- stmt85 stray sv_i
  ENDIF
  ENDIF
  ELSE
  IF ((io_13[I_MI01_GO + 6] = 150)) THEN
  io_13[I_MI01_GO + 6] = 0
  ENDIF
  ENDIF
  RETURN(0)
END CHECK_BLINK

ROUTINE KEEP_ALARM : INTEGER
BEGIN
  IF ((B_ERRORONE <> 0)) THEN
  B_ERRORONE = 0
  POST_ERR(38100, 'RD rotatary detection failed', 0, 1)
  ENDIF
  IF ((io_01[I_MI01_DI + 5] <> 0)) THEN
