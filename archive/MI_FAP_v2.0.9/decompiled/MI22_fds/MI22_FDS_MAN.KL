ROUTINE RESETREDMSG : INTEGER
BEGIN
  ST_MANSMESS = ''
  RETURN(0)
END RESETREDMSG

ROUTINE ISVIRTUALEDIT : BOOLEAN
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
BEGIN
  GET_VAR(r1_lc1, '*SYSTEM*', '$VIRTUALEDIT', r1_lc3, r1_lc2)
  IF ((r1_lc3 <> 1)) THEN
  RETURN(FALSE)
  ELSE
  RETURN(TRUE)
  ENDIF
  RETURN(sv_b)
END ISVIRTUALEDIT

ROUTINE CHECKGUNNO_FROMMAN(p0 : INTEGER) : INTEGER
BEGIN
  sv_i = RESETREDMSG
  -- stmt102 stray sv_i
  IF ((p0 <= 0)) THEN
  sv_i = RESETREDMSG
  -- stmt105 stray sv_i
  ST_MANSMESS = 'GunNo <= 0! System configuration invalid'
  RETURN(1)
  ELSE
  IF ((p0 > GUN_COUNT)) THEN
  sv_i = RESETREDMSG
  -- stmt111 stray sv_i
  ST_MANSMESS = 'GunNo > Max. GunNo! System configuration invalid'
  RETURN(1)
  ELSE
  RETURN(0)
  ENDIF
  ENDIF
  RETURN(0)
END CHECKGUNNO_FROMMAN

