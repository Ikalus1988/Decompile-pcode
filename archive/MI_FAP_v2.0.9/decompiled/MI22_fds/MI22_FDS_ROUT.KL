ROUTINE MI22_CHECK_APP_MODE(p0 : INTEGER) : INTEGER
VAR
  r12_lc1 : INTEGER
BEGIN
  IF ((sv_i = 3)) THEN
  IF ((io_01[35] <> 0)) THEN
  M22_APPLMODE = 2
  ELSE
  M22_APPLMODE = 1
  ENDIF
  IF ((io_01[35] <> 0)) THEN
  ENDIF
  REPEAT
  DELAY 32
  sv_i = DB_PROMPT(2, 'Application Mode acknowledge', 'YES -> Acknowledge Tryout Mode.\nNO  -> Ignore Tryout Mode.     ', 4)
  r12_lc1 = sv_i
  -- stmt205 residue 'YES -> Acknowledge Tryout Mode.\\nNO  -> Ignore Tryout Mode.     '
  UNTIL((r12_lc1 = 3) OR (r12_lc1 = 4))
  SELECT r12_lc1 OF
  CASE(3):
  M22_APPLMODE = 2
  CASE(4):
  M22_APPLMODE = 1
  ELSE:
  ENDSELECT
  ENDIF
  M22_APPLMODE = 1
  RETURN(M22_APPLMODE)
  RETURN(0)
END MI22_CHECK_APP_MODE

