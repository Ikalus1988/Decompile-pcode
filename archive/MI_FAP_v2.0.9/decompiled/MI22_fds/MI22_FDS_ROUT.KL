  ENDIF
  ENDIF
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 5] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 6] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] = 0)) THEN
  M22_B_PROCESS_NIO = 0
  M22_B_PROCESS_IO = 1
  ENDIF
  IF ((M22_B_PROCESS_IO = 0) OR (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] <> 0)) THEN
  M22_B_PROCESS_NIO = 1
  M22_B_PROCESS_IO = 0
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_QUERRYVALIDRESULTS

