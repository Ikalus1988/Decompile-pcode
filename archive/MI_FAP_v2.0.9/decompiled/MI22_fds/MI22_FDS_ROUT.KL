  L_STATE = sv_i
  I_GUNNO_EXT = p2
  I_TYPEID_EXT = p1
  I_FLSNO_EXT = p0
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Downholder not retracted'
  LST_ERROR_f38[256] = 'Waiting for Downholder retract of Gun'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 9, 1, TIMEOUTFLSSYS, 2)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process still active'
  LST_ERROR_f38[256] = 'Waiting until FDS process finished is low'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 4, 0, TIMEOUTFLSSYS, 2)
  L_STATE = sv_i
  M22_B_PROCESS_NIO = 0
  M22_B_PROCESS_IO = 0
  M22_B_NIO_ABORT = 0
  M22_B_NIO_REPEAT = 0
  M22_B_FAIL_START_PROC = 0
  M22_B_SKIPPROC_NOSTART = 0
  sv_i = MI22_CHECKGUNNO(p2)
  L_STATE = sv_i
  IF (sv_b) THEN
  L_STATE = 0
  ELSE
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Docking process failed'
  LST_ERROR_f38[256] = 'Gun is still undocked'
  sv_i = MSG_WRITE(256, 4)
  -- stmt16 stray sv_i
  ENDIF
  sv_i = MI22_CHECK_APP_MODE(p2)
  SELECT sv_i OF
  CASE(1):
  M22_B_NOPROCESS = 0
  CASE(2):
  M22_B_NOPROCESS = 1
  ELSE:
  ENDSELECT
  IF ((M22_B_NOPROCESS <> 0)) THEN
  ENDIF
  sv_i = MI22_CHECKFORERROR(p2)
  L_STATE = sv_i
  sv_i = MI22_AUTOMODE(p2)
  L_STATE = sv_i
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 21] <> 0)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Feeding still active'
  LST_ERROR_f38[256] = 'Waiting until Feeding process end'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 21, 1, TIMEOUTFLSCHECK, 1)
  L_STATE = sv_i
  ENDIF
  sv_i = MI22_QUERY_SYSREADY(p2)
  L_STATE = sv_i
  sv_i = MI22_QUERY_JOINTPOINTOK(p2)
  L_STATE = sv_i
  REPEAT
  sv_i = MI22_STARTPROCESS(p2)
  L_STATE = sv_i
  IF ((L_STATE = -2)) THEN
  r32_lc2 = 1
  ELSE
  r32_lc2 = 0
  sv_i = MI22_WAITFORPROCESS(p2)
  L_STATE = sv_i
  sv_i = MI22_STATUSPROCESS(p2)
  L_STATE = sv_i
  ENDIF
  DELAY 128
  UNTIL((M22_B_NIO_REPEAT = 0) OR (M22_B_FAIL_START_PROC = 0) OR (r32_lc2 <> 0))
  IF ((r32_lc2 = 0)) THEN
  IF ((M22_B_SKIPPROC_NOSTART = 0)) THEN
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 6] = 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 7] = 0)) THEN
  FOR r32_lc1 = 1 TO 3 DO
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 6] = 0)) THEN
  DELAY 1000
  ENDIF
  ENDFOR
  ENDIF
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 7] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 6] = 0)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process NOK'
  LST_ERROR_f38[256] = 'FDS process was NOK at process point'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 3, 1, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  ENDIF
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process still active'
  LST_ERROR_f38[256] = 'Waiting until FDS process finished is low'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 4, 0, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process not completed'
  LST_ERROR_f38[256] = 'Waiting for move approval to activate'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p2]] + 5, 1, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  sv_i = MI22_CHECKFORERROR(p2)
  L_STATE = sv_i
  sv_i = MI22_QUERRYVALIDRESULTS(p2)
  L_STATE = sv_i
  sv_i = MI22_STATUSREPEAT(p2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  IF ((M22_B_NIO_REPEAT = 0) OR (M22_B_SKIPPROC_NOSTART <> 0) OR (r32_lc2 <> 0)) THEN
  io_02[AR_M22_CN_DO[GUNCFG_LST_f00[p2]] + 2] = 0
  sv_i = MI22_SETWORKPARAMETERS(p2, 0, 0)
  L_STATE = sv_i
  sv_i = MI22_PREPAREPOINT(p2, 0, 0)
  L_STATE = sv_i
  I_GUNNO_EXT = 0
  I_TYPEID_EXT = 0
  I_FLSNO_EXT = 0
  ENDIF
  RETURN(0)
END MI22_DRILL

ROUTINE MI22_PREPARESCREW(p0, p1, p2 : INTEGER) : INTEGER
BEGIN
  sv_i = MI22_IO_INIT(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKGUNNO(p0)
  L_STATE = sv_i
  sv_i = MI22_AUTOMODE(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKSERVICEREQ(p0)
  -- stmt152 stray sv_i
  sv_i = MI22_CHECKSYSREADY(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKFORERROR(p0)
  L_STATE = sv_i
  sv_i = MI22_PREPAREPOINT(p0, p1, p2)
  L_STATE = sv_i
  I_GUNNO_EXT = p0
  I_TYPEID_EXT = p2
  I_FLSNO_EXT = p1
  sv_i = MI22_CHECK_APP_MODE(p0)
  SELECT sv_i OF
  CASE(1):
  M22_B_NOPROCESS = 0
  CASE(2):
  M22_B_NOPROCESS = 1
  ELSE:
  ENDSELECT
  IF ((M22_B_NOPROCESS <> 0)) THEN
  ENDIF
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 25] = 0)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Code number NOK'
  LST_ERROR_f38[256] = 'Waiting until accepts process code'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 25, 1, TIMEOUTFLSSYS, 1)
  L_STATE = sv_i
  ENDIF
  sv_i = MI22_PREPAREPOINT(p0, 0, 0)
  L_STATE = sv_i
  RETURN(0)
END MI22_PREPARESCREW

ROUTINE MI22_ADJUST(p0 : INTEGER) : INTEGER
BEGIN
  sv_i = MI22_IO_INIT(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKGUNNO(p0)
  L_STATE = sv_i
  io_02[AR_M22_CN_DO[GUNCFG_LST_f00[p0]] + 19] = 0
  sv_i = MI22_AUTOMODE(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKSERVICEREQ(p0)
  -- stmt220 stray sv_i
  sv_i = MI22_CHECKSYSREADY(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKFORERROR(p0)
  L_STATE = sv_i
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Downholder not retracted'
  LST_ERROR_f38[256] = 'Waiting for Downholder retract of Gun'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 9, 1, TIMEOUTFLSSYS, 2)
  L_STATE = sv_i
  sv_i = MI22_CHECKSYSREADY(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKFORERROR(p0)
  L_STATE = sv_i
  IF ((sv_i = 3)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Robot in automatic'
  LST_ERROR_f38[256] = 'Please change to a permissible mode'
  sv_i = MSG_WRITE(256, 4)
  -- stmt245 stray sv_i
  ENDIF
  sv_i = MI22_EJECTSCREW(p0)
  -- stmt249 stray sv_i
  sv_i = MI22_ADJUSTSCREW(p0)
  L_STATE = sv_i
  RETURN(0)
END MI22_ADJUST

BEGIN
END MI22_FDS_ROUT
