  LST_ERROR_f38[256] = 'Waiting until accepts process code'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 25, 1, TIMEOUTFLSSYS, 2)
  L_STATE = sv_i
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_QUERY_JOINTPOINTOK

ROUTINE MI22_STARTPROCESS(p0 : INTEGER) : INTEGER
VAR
  r20_lc1 : INTEGER
BEGIN
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 3] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 2] <> 0)) THEN
  io_02[AR_M22_CN_DO[GUNCFG_LST_f00[p0]] + 2] = 0
  M22_B_FAIL_START_PROC = 0
  ENDIF
  I_PROCESSTIM = 0
  r20_lc1 = 0
  REPEAT
  DELAY 8
  UNTIL((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4] = 1) OR (I_PROCESSTIM > 8000))
  -- stmt238 residue 8000
  IF ((I_PROCESSTIM > 8000)) THEN
  sv_i = DB_PROMPT(1, 'Process Failed', 'Please press OK to retry;\nPlease press CANCEL to skip.', 1)
  L_STATE = sv_i
  -- stmt240 residue 'Please press OK to retry;\\nPlease press CANCEL to skip.'
  IF ((L_STATE = 1)) THEN
  POST_ERR(38100, 'Process Retry', 0, 0)
  DELAY TIMEOUTFLSCHECK
  DELAY 4000
  sv_s = INTTOSTR(AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4)
  POST_ERR(38100, 'WAIT FOR DI[' + sv_s + ']', 0, 0)
  ELSE
  POST_ERR(38100, 'Process Skipped', 0, 0)
  DELAY TIMEOUTFLSCHECK
  r20_lc1 = 1
  M22_B_SKIPPROC_NOSTART = 1
  ENDIF
  ENDIF
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4] = 1) OR (r20_lc1 = 1)) THEN
  IF ((r20_lc1 <> 0)) THEN
  RETURN(-2)
  ENDIF
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process still active'
  LST_ERROR_f38[256] = 'Waiting until FDS process finished is low'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4, 0, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  sv_i = MI22_SETTIMER(TIMEOUTFLSCHECK)
  -- stmt18 stray sv_i
  -- stmt19 stray AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 5 | I_CLOCK_MS
  IF ((I_TIMERAPPL > I_CLOCK_MS)) THEN
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 3] = 0)) THEN
  IF ((M22_B_FAIL_START_PROC = 0)) THEN
  M22_B_FAIL_START_PROC = 1
  ENDIF
  ENDIF
  ENDIF
  sv_i = MI22_RESETTIMER
  -- stmt30 stray sv_i
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_STARTPROCESS

ROUTINE MI22_WAITFORPROCESS(p0 : INTEGER) : INTEGER
BEGIN
  IF ((M22_B_FAIL_START_PROC = 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4] = 0)) THEN
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 3] = 0)) THEN
  IF ((M22_B_FAIL_START_PROC = 0)) THEN
  sv_i = MI22_GETCOUNTMESSAGES(p0)
  L_STATE = sv_i
  M22_B_FAIL_START_PROC = 1
  ENDIF
  ELSE
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Process still active'
  LST_ERROR_f38[256] = 'Waiting until FDS process finished is low'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 4, 0, TIMEOUTFLSSYS, 2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_WAITFORPROCESS

ROUTINE MI22_STATUSPROCESS(p0 : INTEGER) : INTEGER
BEGIN
  IF ((M22_B_FAIL_START_PROC <> 0)) THEN
  sv_i = MANUAL_STATUSREPEAT(p0)
  -- stmt77 stray sv_i
  ELSE
  M22_B_SKIPPROC_NOSTART = 0
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_STATUSPROCESS

ROUTINE MI22_QUERRYVALIDRESULTS(p0 : INTEGER) : INTEGER
VAR
  r23_lc1 : INTEGER
BEGIN
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 6] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] <> 0) OR (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 6] = 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] = 0)) THEN
  LST_ERROR_f00[256] = 'FDS'
