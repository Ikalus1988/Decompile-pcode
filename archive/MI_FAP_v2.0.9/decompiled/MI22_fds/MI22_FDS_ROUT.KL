  L_STATE = sv_i
  io_02[AR_M22_CN_DO[GUNCFG_LST_f00[p2]] + 2] = 0
  L_REPEATCOUNTER = 0
  IF ((M22_COND_ENBL = 0)) THEN
  M22_COND_ENBL = 1
  ENDIF
  sv_i = MI22_AUTOMODE(p2)
  L_STATE = sv_i
