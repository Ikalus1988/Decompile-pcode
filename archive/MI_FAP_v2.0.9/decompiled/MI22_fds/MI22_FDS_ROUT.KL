ROUTINE MI22_INIT(p0 : INTEGER) : INTEGER
BEGIN
  sv_i = MI22_CHECKGUNNO(p0)
  L_STATE = sv_i
  IF ((io_12[AR_M22_CN_GI[GUNCFG_LST_f00[p0]] + 1] > 0) AND (io_12[AR_M22_CN_GI[GUNCFG_LST_f00[p0]] + 1] <> p0)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Invalid Gun number'
  LST_ERROR_f38[256] = 'Waiting for equal value of tool code'
  sv_i = MSG_WRITE(256, 4)
  -- stmt141 stray sv_i
  ENDIF
  sv_i = MI22_SETWORKPARAMETERS(p0, 0, 0)
  L_STATE = sv_i
  sv_i = MI22_IO_INIT(p0)
  L_STATE = sv_i
  IF (UNINIT(M22_COND_ENBL)) THEN
  M22_COND_ENBL = 1
  ENDIF
  IF ((M22_COND_ENBL = 0)) THEN
  M22_COND_ENBL = 1
  ENDIF
  sv_i = MI22_AUTOMODE(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECK_APP_MODE(p0)
  SELECT sv_i OF
  CASE(1):
  M22_B_NOPROCESS = 0
  CASE(2):
  M22_B_NOPROCESS = 1
  ELSE:
  ENDSELECT
  IF ((M22_B_NOPROCESS <> 0)) THEN
  ENDIF
  sv_i = MI22_CHECKSERVICEREQ(p0)
  -- stmt175 stray sv_i
  sv_i = MI22_CHECKFORERROR(p0)
  L_STATE = sv_i
  sv_i = MI22_CHECKSYSREADY(p0)
  L_STATE = sv_i
  RETURN(0)
END MI22_INIT

ROUTINE MI22_DRILL(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r32_lc1 : INTEGER
  r32_lc2 : INTEGER
BEGIN
  sv_i = MI22_CHECKGUNNO(p2)
  L_STATE = sv_i
