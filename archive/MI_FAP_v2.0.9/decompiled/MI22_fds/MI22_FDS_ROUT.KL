  IF ((r23_lc1 = 0)) THEN
  IF (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 6] <> 0) OR (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] <> 0) AND (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 6] = 0) OR (io_01[AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 7] = 0) THEN
    r23_lc1 = 1
  ELSE
    r23_lc1 = 0
