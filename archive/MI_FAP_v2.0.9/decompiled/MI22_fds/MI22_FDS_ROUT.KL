ROUTINE MANUAL_REQOPERATOR : INTEGER
BEGIN
  L_STATE = 0
  DELAY 64
  REPEAT
  sv_i = DB_PROMPT(0, 'Request for worker confirmation', 'Press \"OK\" if the screw from last process has been removed', 7)
  L_STATE = sv_i
  -- stmt84 residue 'Press \\"OK\\" if the screw from last process has been removed'
  DELAY 64
  UNTIL((L_STATE = 1))
  RETURN(0)
END MANUAL_REQOPERATOR

ROUTINE EXITFORM : INTEGER
VAR
  r4_lc1 : INTEGER
BEGIN
  IF (UNINIT(r4_lc1)) THEN
  r4_lc1 = 1
  ENDIF
  FORCE_MENU(r4_lc1, 252)
  RETURN(0)
END EXITFORM

ROUTINE MANUAL_STATUSREPEAT(p0 : INTEGER) : INTEGER
BEGIN
  L_STATE = 0
  REPEAT
  sv_i = DB_PROMPT(2, 'Last process NOK', 'YES: Acknowledge and repeat.\nNO: Process was OK.', 3)
  L_STATE = sv_i
  -- stmt106 residue 'YES: Acknowledge and repeat.\\nNO: Process was OK.'
  DELAY 64
  UNTIL((L_STATE <> 0))
  SELECT L_STATE OF
  CASE(3):
  io_02[AR_M22_CN_DO[GUNCFG_LST_f00[p0]] + 2] = 0
  L_REPEATCOUNTER = L_REPEATCOUNTER + 1
  sv_i = EXITFORM
  -- stmt120 stray sv_i
  sv_i = MANUAL_REQOPERATOR
  -- stmt121 stray sv_i
  M22_B_NIO_REPEAT = 1
  M22_B_SKIPPROC_NOSTART = 0
  CASE(4):
  M22_B_NIO_ABORT = 1
  M22_B_PROCESS_NIO = 0
  M22_B_PROCESS_IO = 1
  M22_B_NIO_REPEAT = 0
  sv_i = EXITFORM
  -- stmt134 stray sv_i
  sv_i = MANUAL_REQOPERATOR
  ELSE:
  M22_B_NIO_ABORT = 1
  M22_B_PROCESS_NIO = 1
  M22_B_PROCESS_IO = 0
  M22_B_NIO_REPEAT = 0
  sv_i = EXITFORM
  -- stmt156 stray sv_i
  sv_i = MANUAL_REQOPERATOR
  -- stmt157 stray sv_i
  ENDSELECT
  RETURN(0)
END MANUAL_STATUSREPEAT

