  L_STATE = sv_i
  ELSE
  IF ((p1 = 1)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Docking not completed'
  LST_ERROR_f38[256] = 'Waiting until tool connect is high'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 12, 1, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  ENDIF
  IF ((p1 = 0)) THEN
  LST_ERROR_f00[256] = 'FDS'
  LST_ERROR_f10[256] = 0
  LST_ERROR_f14[256] = 'Docking not completed'
  LST_ERROR_f38[256] = 'Waiting until tool disconnect is high'
  sv_i = WAIT_SIGNAL(256, 1, AR_M22_CN_DI[GUNCFG_LST_f00[p0]] + 11, 1, TIMEOUTFLSCHECK, 2)
  L_STATE = sv_i
  ENDIF
  ENDIF
  RETURN(0)
  RETURN(0)
END MI22_REQUESTTOOLCHANGE

