  I_TYPEID_EXT = 0
  ENDIF
  IF (UNINIT(I_FLSNO_EXT)) THEN
  I_FLSNO_EXT = 0
  ENDIF
  RETURN(0)
END INIT_VARS

ROUTINE MI22_SYSCOND : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
BEGIN
  FOR I_MON_GUNNO = 1 TO 3 DO
  IF (NOT (UNINIT(AR_M22_CN_DI[GUNCFG_LST_f00[I_MON_GUNNO]]))) THEN
  IF ((AR_M22_CN_DI[GUNCFG_LST_f00[I_MON_GUNNO]] <> 0)) THEN
  r1_lc3 = 1
  sv_b = MI22_CHECKGUNDOCKING(I_MON_GUNNO)
  IF sv_b THEN
    r1_lc4 = 1
  ELSE
    r1_lc4 = 0
  ENDIF
  IF ((r1_lc4 = 1)) THEN
  sv_i = MI22_CHECKGUNNO(I_MON_GUNNO)
  r1_lc2 = sv_i
  r1_lc3 = io_01[AR_M22_CN_DI[GUNCFG_LST_f00[I_MON_GUNNO]] + 5]
  ENDIF
  GET_VAR(r1_lc1, '*SYSTEM*', '$MOR_GRP[1].$ROB_MOVE', B_ROBMOVE, r1_lc2)
  IF ((r1_lc2 <> 0)) THEN
  B_ROBMOVE = 1
  ENDIF
  IF ((r1_lc3 = 0) AND (B_ROBMOVE <> 0) AND (M22_B_APPLSTART = 0)) THEN
  POST_ERR(38100, 'Downholder extended during robot movement', 0, 1)
  sv_i = HOLDMOTION(0)
  -- stmt148 stray sv_i
  B_FLAG = 1
  ENDIF
  IF ((io_01[AR_M22_CN_DI[GUNCFG_LST_f00[I_MON_GUNNO]] + 5] = 0) AND (B_FLAG <> 0)) THEN
  sv_i = UNHOLDMOTION(0)
  -- stmt153 stray sv_i
  B_FLAG = 0
  ENDIF
  ENDIF
  ENDIF
  ENDFOR
  RETURN(0)
END MI22_SYSCOND

