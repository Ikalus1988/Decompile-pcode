ROUTINE MAN_QUITERROR : INTEGER
BEGIN
  sv_i = MI22_QUITERROR_MAN(0)
  -- stmt12 stray sv_i
  B_MAN_QUITERROR = 0
  ENABLE CONDITION[1]
  sv_i = INIT_VARS
  -- stmt22 stray sv_i
  M22_COND_ENBL = 1
  B_ROBMOVE = 0
  B_FLAG = 0
  B_MAN_FLS = 0
  B_MAN_FEED = 0
  B_MAN_EJECT = 0
  B_MAN_COUPLE = 0
  B_MAN_DECOUPLE = 0
  B_MAN_MANMODE = 0
  B_MAN_DOWNHOLDER = 0
  B_MAN_QUITERROR = 0
  B_AUTOMODE = 0
  B_SYSREADY = 0
  PURGE CONDITION[1]
  -- stmt41 stray 22 | B_MAN_FLS | 1 | B_MAN_FEED | 1 | B_MAN_EJECT | 1 | B_MAN_COUPLE | 1 | B_MAN_DECOUPLE | 1 | B_MAN_MANMODE | 1 | B_MAN_DOWNHOLDER | 1 | B_MAN_QUITERROR | 1
