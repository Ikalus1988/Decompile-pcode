  IF (UNINIT(AR_M22_CN_DI[1])) THEN
  AR_M22_CN_DI[1] = 1312
  ENDIF
  IF (UNINIT(AR_M22_CN_DO[1])) THEN
  AR_M22_CN_DO[1] = 1312
  ENDIF
  IF (UNINIT(AR_M22_CN_GI[1])) THEN
  AR_M22_CN_GI[1] = 100
  ENDIF
  IF (UNINIT(AR_M22_CN_GO[1])) THEN
  AR_M22_CN_GO[1] = 100
  ENDIF
  RETURN(0)
END INITAPPVARS

