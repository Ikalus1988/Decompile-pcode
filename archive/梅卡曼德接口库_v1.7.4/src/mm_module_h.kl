TYPE
Rcv_Pose 		FROM  MM_MODULE_H = STRUCTURE
	Pose:XYZWPR
	Label:INTEGER
	Speed:INTEGER
ENDSTRUCTURE
Rcv_Jps 		FROM  MM_MODULE_H = STRUCTURE
	Jps:JOINTPOS
	Label:INTEGER
	Speed:INTEGER
ENDSTRUCTURE
Rcvvis2_Pose 	FROM  MM_MODULE_H = STRUCTURE
	Pose:XYZWPR
	Label:REAL
ENDSTRUCTURE
Rcvviz2_Pose 	FROM  MM_MODULE_H = STRUCTURE
	Pose:XYZWPR
	MoveType:INTEGER
    ToolNum:INTEGER
	Speed:INTEGER
	IsVisPt:BOOLEAN
ENDSTRUCTURE
Rcvviz2_Jps 	FROM  MM_MODULE_H = STRUCTURE
	Jps:JOINTPOS
	MoveType:INTEGER
    ToolNum:INTEGER
	Speed:INTEGER
	IsVisPt:BOOLEAN
ENDSTRUCTURE
Viz_UData 		FROM  MM_MODULE_H = STRUCTURE
	UserDataNum:INTEGER
	UsrData:ARRAY[50] OF REAL
ENDSTRUCTURE
Plan_Results 	FROM  MM_MODULE_H = STRUCTURE 
	Label:ARRAY[10] OF INTEGER
	TotalGrabNum:INTEGER
	CurGrabNum:INTEGER
	EdgeNum:INTEGER
	TCPoffset:ARRAY[3] OF REAL
	Direction:INTEGER
	BoxSize:ARRAY[3] OF REAL
ENDSTRUCTURE 

