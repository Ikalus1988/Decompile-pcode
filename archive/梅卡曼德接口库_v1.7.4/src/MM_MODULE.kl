        CASE (5002):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:DYNAMIC_SET_DATA_FAILED=5002 ',CR)
        CASE (5101):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DYNAMIC_SET_FLOAT_OK=5101 ',CR)
        CASE (5102):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DYNAMIC_SET_INT_OK=5102 ',CR)
        CASE (5103):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DYNAMIC_GET_FLOAT_OK=5103 ',CR)
        CASE (5104):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DYNAMIC_GET_INT_OK=5104 ',CR)
        CASE (7001):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:CALIBRATION_PARAMS_ERROR=7001 ',CR)
        CASE (7002):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:CALIBRATION_NO_POINT=7002 ',CR)
        CASE (7003):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:CALIBRATION_NOT_REACH_POINT=7003 ',CR)
        CASE (7100):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CALIBRATION_MOVE_FINISHED=7100 ',CR)
        CASE (7101):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CALIBRATION_SEND_POINT_OK=7101 ',CR)
    ELSE:
        WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:Unknow Status! Please Check',CR)
    ENDSELECT
END  Check_Status

ROUTINE Post_IPCErr--(Status:INTEGER)  FROM  MM_MODULE
VAR
Status_Str:STRING[5]
BEGIN
	CNV_INT_STR(Status,4,10,Status_Str)
	POST_ERR(ErrCode,'MM:IPC error,status code:'+ Status_Str, 0, ERR_ABORT)
END Post_IPCErr

ROUTINE Chk_Pr_Type--(pr_no,grp_no,pr_type,pr_type_1,pr_type_2:INTEGER) FROM  MM_MODULE
--1:POSITION
--2:XYZWPR
--6:XYZWPREXT
--9:JOINTPOS
VAR
num_axes:INTEGER

BEGIN
	pr_type=0
	POS_REG_TYPE(pr_no,grp_no,pr_type,num_axes,Status)
	IF pr_type_1 = pr_type_2 THEN 
		IF pr_type<>pr_type_1 THEN
			POST_ERR(ErrCode,'MM:PReg_Type_Error', 0, ERR_ABORT)
		ENDIF
	else
		IF (pr_type<>pr_type_1) AND (pr_type<>pr_type_2) THEN
			POST_ERR(ErrCode,'MM:PReg_Type_Error', 0, ERR_ABORT)
		ENDIF
	ENDIF
END Chk_Pr_Type