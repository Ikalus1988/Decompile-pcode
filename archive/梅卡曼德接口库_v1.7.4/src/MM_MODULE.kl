        CASE (2022):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_NOT_RUN_YET=2022 ',CR)
        CASE (2023):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_PROJECT_IS_BROKEN=2023 ',CR)
