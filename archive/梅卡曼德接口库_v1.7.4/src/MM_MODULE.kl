--------------------------------------------------------------------------------
ROUTINE Set_DoList
BEGIN
    FOR i=1 TO Do_Num DO
        IF Do_Port[i]>0 THEN
        SET_PORT_VAL (io_dout, Do_Port[i], 1, Status)
            IF Status <> 0 THEN
                POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
            ENDIF
        ENDIF
    ENDFOR
END Set_DoList
