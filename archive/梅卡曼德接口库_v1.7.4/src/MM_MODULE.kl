        CASE (4100):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:ROBOT_SERVICE_REGISTERED=4100 ',CR)
        CASE (4101):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CONNECT_ROBOT_SUCCESS=4101 ',CR)
        CASE (4102):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DISCONNECT_ROBOT_SUCCESS=4102 ',CR)
