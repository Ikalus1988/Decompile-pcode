        CASE (2108):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:SET_VIZ_PROP_OK=2108 ',CR)
        CASE (2109):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:GET_VIZ_PROP_OK=2109 ',CR)
        CASE (3001):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:CENTER_INVALID_COMMAND=3001 ',CR)
