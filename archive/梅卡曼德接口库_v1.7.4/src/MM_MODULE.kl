--------------------------------------------------------------------------------
-- Calibration
--------------------------------------------------------------------------------
ROUTINE Calibration

BEGIN
-- Get  Tp  Parameter
    Get_Arg(1, 1, Move_Type, Real_Value, Str_Value) 
    Get_Arg(2, 1, PosJps, Real_Value, Str_Value) 
    Get_Arg(3, 1, WaitTime, Real_Value, Str_Value) 
    Get_Arg(4, 1, AxisNum, Real_Value, Str_Value) 
    Get_Arg(5, 2, Int_Value,AxisVal, Str_Value)
    Get_Arg(6, 1, Reg_CalibPos, Real_Value, Str_Value)
    WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MMIND Calibration Start! ',CR)
--Data
    FOR i=1 TO 9 DO
        RelSend[i] = 0
        RelRcv[i] = 0
    ENDFOR
    Cur_Jps = CURJPOS(0,0)
    CNV_JPOS_REL(Cur_Jps, RelSend, Status)
    IF Status <> 0 THEN
         POST_ERR(ErrCode, 'MM:Robot_Internal_Error1', 0, ERR_ABORT) 
    ENDIF
    ReadFLPos
 --Get  PR Config
     Pr_Calib=GET_POS_REG(Reg_CalibPos,Status)
     IF Status <> 0 THEN
         POST_ERR(ErrCode, 'MM:Robot_Internal_Error2', 0, ERR_ABORT) 
     ENDIF
     P_CalibPos.Config_Data=Pr_Calib.Config_Data
--Send
    Open_Socket
    OPEN FILE Sock_Send('RW',C_Tag_S)
    WRITE Sock_Send(CMD_CALIB,0)
    WRITE Sock_Send(Cur_Pos.X,Cur_Pos.Y,Cur_Pos.Z,Cur_Pos.W,Cur_Pos.P ,Cur_Pos.R)
    WRITE Sock_Send(RelSend[1], RelSend[2], RelSend[3], RelSend[4], RelSend[5], RelSend[6], CR)
    CLOSE FILE Sock_Send  
L1::
--Receive    
    SET_FILE_ATR(Sock_Rcv,ATR_UF)
    OPEN FILE Sock_Rcv('RW',C_Tag_S)
    READ Sock_Rcv(MM_CMD,MM_Status,MM_CStatus)
    READ Sock_Rcv(P_CalibPos.X,P_CalibPos.Y,P_CalibPos.Z,P_CalibPos.W,P_CalibPos.P,P_CalibPos.R)
    READ Sock_Rcv(RelRcv[1],RelRcv[2],RelRcv[3],RelRcv[4],RelRcv[5],RelRcv[6])
    FOR i=1 TO 150 DO
        READ Sock_Rcv(Null)
    ENDFOR
    CLOSE FILE Sock_Rcv
    IF UNINIT(MM_CMD) OR (MM_CMD <> CMD_CALIB) THEN
        POST_ERR(ErrCode,'MM:Robot_CMD_Error', 0, ERR_ABORT)
    ENDIF
    Check_Status(MM_Status)
    IF MM_Status <> CALIB_OK THEN
        Post_IPCErr(MM_Status)
    ENDIF 
--Data
    IF AxisNum=7 THEN
        RelRcv[7]=AxisVal
        P_CalibPos.EXT1 = AxisVal
    ENDIF
    CNV_REL_JPOS(RelRcv,P_CalibJps,Status)
    IF Status <> 0 THEN 
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error3', 0, ERR_ABORT)
    ENDIF
    IF Move_Type=1 THEN
        $MOTYPE=LINEAR
        MOVE TO P_CalibPos
    ELSE
    IF Move_Type=2 THEN   
        IF PosJps=1 THEN
            $MOTYPE=JOINT
            MOVE TO P_CalibPos
        ELSE
        IF PosJps=2 THEN
            $MOTYPE=JOINT
            MOVE TO P_CalibJps
        ELSE
            POST_ERR(ErrCode,'MM:Robot_Argument_Error1', 0, ERR_ABORT)
        ENDIF
        ENDIF
    ELSE    
        POST_ERR(ErrCode,'MM:Robot_Argument_Error2', 0, ERR_ABORT)
    ENDIF  
    ENDIF
    
    IF MM_CStatus=1 THEN
        WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MMIND Calibration Finished! ',CR)
        GOTO L2
    ENDIF
    DELAY WaitTime*1000
--Send
    Cur_Jps = CURJPOS(0,0)
    CNV_JPOS_REL(Cur_Jps, RelSend, Status)
    IF Status <> 0 THEN
         POST_ERR(ErrCode, 'MM:Robot_Internal_Error4', 0, ERR_ABORT) 
    ENDIF
    ReadFLPos
    SET_FILE_ATR(Sock_Send,ATR_UF)
    OPEN FILE Sock_Send('RW',C_Tag_S)
    WRITE Sock_Send(CMD_CALIB,1)
    WRITE Sock_Send(Cur_Pos.X,Cur_Pos.Y,Cur_Pos.Z,Cur_Pos.W,Cur_Pos.P ,Cur_Pos.R)
    WRITE Sock_Send(RelSend[1], RelSend[2], RelSend[3], RelSend[4], RelSend[5], RelSend[6], CR)
    CLOSE FILE Sock_Send    
    GOTO L1    
L2::
    MSG_DISCO(C_Tag_S,Status)
END Calibration
--------------------------------------------------------------------------------
-- Function
--------------------------------------------------------------------------------
ROUTINE Get_Arg--(DataNum:INTEGER;DataType:INTEGER;Int:INTEGER;Rel:REAL;Str:STRING) FROM  MM_MODULE
BEGIN
    GET_TPE_PRM(DataNum, Data_Type, Int, Rel, Str, Status)
    IF (Status <> 0) THEN
    	POST_ERR(ErrCode,'MM:Robot_Argument_Error1', 0, ERR_ABORT)
    else
        IF (DataType<>2) THEN       	
        	IF (Data_Type <> DataType) THEN       
        		POST_ERR(ErrCode,'MM:Robot_Argument_Error2', 0, ERR_ABORT)
        	ENDIF
        else
	    	IF (Data_Type <> 2) THEN
	    		IF (Data_Type = 1) THEN
	    			Rel = Int
	    		else
	    			POST_ERR(ErrCode,'MM:Robot_Argument_Error3', 0, ERR_ABORT)
	    		ENDIF
	    	ENDIF        	
        ENDIF     
    ENDIF		
END Get_Arg

ROUTINE Set_IntReg--(RegNo:INTEGER; Int:INTEGER) FROM  MM_MODULE
BEGIN
    SET_INT_REG(RegNo, Int, Status)
    IF Status <> 0 THEN
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
    ENDIF		
END Set_IntReg

ROUTINE Set_RealReg--(RegNo:INTEGER;Rel:REAL) FROM  MM_MODULE
BEGIN
    SET_REAL_REG(RegNo, Rel, Status)
    IF Status <> 0 THEN
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
    ENDIF		
END Set_RealReg

ROUTINE Open_Socket--FROM  MM_MODULE
BEGIN
    MSG_DISCO(C_Tag_S,Status)
    SET_FILE_ATR(Sock_Send,ATR_UF)
    SET_FILE_ATR(Sock_Rcv,ATR_UF)
    MSG_CONNECT(C_Tag_S,Status)
    IF (Status<>0) AND (Status<>67215) THEN
        POST_ERR(ErrCode, 'MM:Robot_Socket_Closed', 0, ERR_ABORT)  
    ENDIF
END Open_Socket

ROUTINE ReadFLPos--FROM  MM_MODULE
BEGIN
    $UFRAME=$MOR_GRP[1].$NILPOS
    $UTOOL=$MOR_GRP[1].$NILPOS
    Cur_Pos = CURPOS(0,0)
END ReadFLPos

ROUTINE Check_Status--(Status:INTEGER)  FROM  MM_MODULE
BEGIN
    SELECT Status OF 
        CASE (1001):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_NOT_REGISTERED=1001 ',CR)
        CASE (1002):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_NO_POSES=1002 ',CR)
        CASE (1003):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_NO_CLOUD=1003 ',CR)
        CASE (1004):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_SET_PROPERTY_FAILED=1004 ',CR)
        CASE (1005):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_POINT_TYPE_ERROR=1005 ',CR)
        CASE (1006):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_POINT_ERROR=1006 ',CR)
        CASE (1007):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_IN_CALCULATING=1007 ',CR)
        CASE (1008):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_ALREADY_FINISHED=1008 ',CR)
        CASE (1009):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_POSES_MOTION_PARAMS_UNEQUAL=1009 ',CR)
        CASE (1010):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_POSES_LABELS_UNEQUAL=1010 ',CR)
        CASE (1011):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_PROJECT_NOT_FOUND=1011 ',CR)
        CASE (1012):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_INVALID_MODEL_CODE=1012 ',CR)
        CASE (1013):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_MODEL_NOT_FOUND=1013 ',CR)
        CASE (1014):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_SWITCH_MODEL_FAILED=1014 ',CR)
        CASE (1017):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_LABEL_MAPPING_ERROR=1017 ',CR)
        CASE (1018):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_POSE_COUNT_ERROR=1018 ',CR)
        CASE (1019):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VISION_RUN_TIMEOUT=1019 ',CR)
        CASE (1100):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:VISION_HAS_POSES=1100 ',CR)
        CASE (1101):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:VISION_IS_READY=1101 ',CR)
        CASE (1102):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:VISION_TRIGGERED_OK=1102 ',CR)
        CASE (1103):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:VISION_HAS_PLAN_RESULTS=1103 ',CR)
        CASE (1107):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:VISION_SET_MODEL_OK=1107 ',CR)
        CASE (1108):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:DYNAMIC_SET_BOXSIZE_OK=1108 ',CR)
        CASE (2001):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_NOT_REGISTERED=2001 ',CR)
        CASE (2002):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_IS_RUNNING=2002 ',CR)
        CASE (2003):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_NO_VISION_POSE=2003 ',CR)
        CASE (2004):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_VISION_POSE_NOT_REACHABLE=2004 ',CR)
        CASE (2005):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:VIZ_SELECT_JPS_ERROR=2005 ',CR)
