        CASE (3100):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CENTER_CLIENT_CONNECTED=3100 ',CR)
        CASE (3101):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CENTER_CONNECT_TO_SERVER=3101 ',CR)
        CASE (3102):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_green), 'MM:CENTER_WAIT_FOR_CLIENT=3102 ',CR)
        CASE (4001):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:ROBOT_INVALID_ROBOT_TYPE=4001 ',CR)
        CASE (4002):WRITE TPDISPLAY(CHR(cc_fgcolor), CHR(cc_red), 'MM:ROBOT_EULER_NOT_SUPPORTED=4002 ',CR)
