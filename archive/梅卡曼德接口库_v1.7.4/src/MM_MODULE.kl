--Check return status
    Check_Status(MM_Status)
    Set_IntReg(Reg_Status, MM_Status) 
    MSG_DISCO(C_Tag_S,Status)
END Set_VizProp
--------------------------------------------------------------------------------
-- Get_Jps
--------------------------------------------------------------------------------
ROUTINE Get_Jps
BEGIN
-- Get  TP  Parameter
    Get_Arg(1, 1, Serial, Real_Value, Str_Value)
    Get_Arg(2, 1, Pr_Num, Real_Value, Str_Value)
    Get_Arg(3, 1, Reg_Label, Real_Value, Str_Value)
    Get_Arg(4, 1, Reg_Speed, Real_Value, Str_Value)
--Check If All Data 0
    CNV_JPOS_REL(MM_Jps[Serial].Jps,Rel_Jps,Status)
    IF Status <> 0 THEN 
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error1', 0, ERR_ABORT)
    ENDIF
    IF ((Rel_Jps[1]=0)AND(Rel_Jps[2]=0)AND(Rel_Jps[3]=0)AND(Rel_Jps[4]=0)AND(Rel_Jps[5]=0)AND(Rel_Jps[6]=0)) THEN 
    	POST_ERR(ErrCode, 'MM:Robot_Internal_Error2', 0, ERR_ABORT)
    ENDIF
--Trans Jps
    SET_JPOS_REG(Pr_Num, MM_Jps[Serial].Jps, Status)
    IF Status <> 0 THEN
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error3', 0, ERR_ABORT)
    ENDIF
--Trans Label&Speed
    Set_IntReg(Reg_Label, MM_Jps[Serial].Label)
    Set_IntReg(Reg_Speed, MM_Jps[Serial].Speed)
--Clear Pose Data
    FOR i=1 TO 9 DO
    	Rel_Jps[i]=0
    ENDFOR
    CNV_REL_JPOS(Rel_Jps,MM_Jps[Serial].Jps,Status)
    IF Status <> 0 THEN
        POST_ERR(ErrCode, 'MM:Robot_Internal_Error4', 0, ERR_ABORT)
    ENDIF
    MM_Jps[Serial].Label = 0
    MM_Jps[Serial].Speed = 0       
END Get_Jps

