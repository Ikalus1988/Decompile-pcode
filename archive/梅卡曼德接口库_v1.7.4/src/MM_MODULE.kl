    ENDIF
--Check return status
    Check_Status(MM_Status)
    IF MM_Status <> SET_BCH_OK THEN
        Post_IPCErr(MM_Status)
    ENDIF 
    MSG_DISCO(C_Tag_S,Status)
END Set_Branch
