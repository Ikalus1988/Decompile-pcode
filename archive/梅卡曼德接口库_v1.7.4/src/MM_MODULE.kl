ROUTINE Set_Branch
BEGIN
-- Get  Tp  Parameter
    Get_Arg(1, 1, Branch_Num, Real_Value, Str_Value) 
    Get_Arg(2, 1, Export_Num, Real_Value, Str_Value) 
