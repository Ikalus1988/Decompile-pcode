PROGRAM  MM_GET_POS
%CMOSVARS
%ALPHABETIZE
%COMMENT = 'MM_Get_Pos'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%INCLUDE KLEVCCDF
%INCLUDE mm_module_h
--------------------------------------------------------------------------------
-- Get_Pos
--------------------------------------------------------------------------------
ROUTINE Get_Pose
BEGIN
-- Get  TP  Parameter
    Get_Arg(1, 1, Serial, Real_Value, Str_Value)
    Get_Arg(2, 1, Pr_Num, Real_Value, Str_Value)
    Get_Arg(3, 1, Reg_Label, Real_Value, Str_Value)
    Get_Arg(4, 1, Reg_Speed, Real_Value, Str_Value)
--Check If All Data 0
    MM_Pose[Serial].Pose.Config_Data=$MOR_GRP[1].$NILPOS.Config_Data
    IF (MM_Pose[Serial].Pose >=< $MOR_GRP[1].$NILPOS)THEN
    	POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
    ENDIF
--Get PR TYPE    
	Chk_Pr_Type(Pr_Num,1,pr_type,PR_XYZWPR,PR_XYZWPREXT)
	IF pr_type=PR_XYZWPR THEN	--no 7th axis
	--Get PR Config
	    Pr_Pos=GET_POS_REG(Pr_Num, Status)
	    IF Status <> 0 THEN
	        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
	    ENDIF
	--Trans Pose
	    MM_Pose[Serial].Pose.Config_Data=Pr_Pos.Config_Data
	    SET_POS_REG(Pr_Num, MM_Pose[Serial].Pose, Status)
	    IF Status <> 0 THEN
	        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
	    ENDIF
	ENDIF
	IF pr_type=PR_XYZWPREXT THEN	--has 7th axis
	--Get PR Config
	    Pr_EPos=GET_POS_REG(Pr_Num, Status)
	    IF Status <> 0 THEN
	        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
	    ENDIF
	--Trans Pose
	    Pr_EPos.x = MM_Pose[Serial].Pose.x
	    Pr_EPos.y = MM_Pose[Serial].Pose.y
	    Pr_EPos.z = MM_Pose[Serial].Pose.z
	    Pr_EPos.w = MM_Pose[Serial].Pose.w
	    Pr_EPos.p = MM_Pose[Serial].Pose.p
	    Pr_EPos.r = MM_Pose[Serial].Pose.r
	    SET_EPOS_REG(Pr_Num, Pr_EPos, Status)
	    IF Status <> 0 THEN
	        POST_ERR(ErrCode, 'MM:Robot_Internal_Error', 0, ERR_ABORT)
	    ENDIF		
	ENDIF
--Trans Label&Speed
    Set_IntReg(Reg_Label, MM_Pose[Serial].Label)
    Set_IntReg(Reg_Speed, MM_Pose[Serial].Speed)
--Clear Pose Data    
    MM_Pose[Serial].Pose = $MOR_GRP[1].$NILPOS
    MM_Pose[Serial].Label = 0
    MM_Pose[Serial].Speed = 0
END Get_Pose
--------------------------------------------------------------------------------
-- Main Program
--------------------------------------------------------------------------------
BEGIN
    Get_Pose
END MM_GET_POS