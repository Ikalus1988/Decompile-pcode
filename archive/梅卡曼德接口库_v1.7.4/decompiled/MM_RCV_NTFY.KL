  REG_LST_DATA : INTEGER
  REG_POS_NUM : INTEGER
  REG_VPOS_NUM : INTEGER
  REG_STATUS : INTEGER
  REG_NOTIFY : INTEGER
  REG_VIZ_PROP : INTEGER
  JPS_POS : INTEGER
  SERIAL : INTEGER
  PR_NUM : INTEGER
  REG_LABEL : INTEGER
  REG_SPEED : INTEGER
  REG_MOVETYPE : INTEGER
  REG_TOOLNUM : INTEGER
  REG_PLANRES : INTEGER
  REG_USERDATA : INTEGER
  MODEL_NUM : INTEGER
  BRANCH_NUM : INTEGER
