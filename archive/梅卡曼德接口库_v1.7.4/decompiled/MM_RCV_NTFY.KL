	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	RCV_POSE = STRUCTURE
	POSE: T_POS
	LABEL: INTEGER
	SPEED: INTEGER
	ENDSTRUCTURE
	RCV_JPS = STRUCTURE
	JPS: INTEGER
	LABEL: INTEGER
	SPEED: INTEGER
	ENDSTRUCTURE
	RCVVIS2_POSE = STRUCTURE
	POSE: T_POS
	LABEL: INTEGER
	ENDSTRUCTURE
	RCVVIZ2_POSE = STRUCTURE
	POSE: T_POS
	MOVETYPE: INTEGER
