  TIME_OUT : INTEGER
  HOST_CFG : STRING[15]
  C_STATUS : INTEGER
  C_TAG_L : STRING[1]
  IP_ADDR_L : STRING[15]
  SVR_PORT_L : INTEGER
  TIME_OUT_L : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE CHECK_STATUS(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE POST_IPCERR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE CHK_PR_TYPE(p0, p1, p2, p3, p4 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE GET_ARG(p0, p1, p2 : INTEGER; p3 : REAL; p4 : STRING) : INTEGER FROM MI_LIB
ROUTINE SET_INTREG(p0, p1 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE SET_REALREG(p0 : INTEGER; p1 : REAL) : INTEGER FROM MI_LIB
ROUTINE OPEN_SOCKET(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE READFLPOS(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE RECV_NOTIFY : INTEGER
VAR
  n_bytes : INTEGER
  tim_acc : INTEGER
BEGIN
  sv_i = GET_ARG(1, 1, v1, v2, v3)
  -- stmt19 stray sv_i
  sv_i = SET_INTREG(v1, 0)
  -- stmt20 stray sv_i
  sv_i = OPEN_SOCKET(0)
  -- stmt22 stray sv_i
  OPEN FILE v4('RW', v5)
  tim_acc = 0
  BYTES_AHEAD(v4, n_bytes, v6)
  IF ((n_bytes <> 0)) THEN
  PAUSE
  PAUSE
  -- stmt28 stray v4 | v7 | v6
  IF (UNINIT(v7) OR (v7 <> 601)) THEN
  POST_ERR(38000, 'MM:Robot_CMD_Error', 0, 2)
  ENDIF
  sv_i = SET_INTREG(v1, v6)
  -- stmt32 stray sv_i
  ELSE
  ENDIF
  DELAY 10
  tim_acc = tim_acc + 10
  IF ((tim_acc > 5000)) THEN
  sv_i = SET_INTREG(v1, 0)
  -- stmt38 stray sv_i
  ENDIF
  -- stmt40 stray v4
  MSG_DISCO(v5, v8)
  sv_i = RECV_NOTIFY
  -- stmt47 stray sv_i
  RETURN(0)
END RECV_NOTIFY

BEGIN
END MM_RCV_NTFY
