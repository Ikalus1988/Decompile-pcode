ROUTINE GET_ARG(p0, p1, p2 : INTEGER; p3 : REAL; p4 : STRING) : INTEGER
BEGIN
  GET_TPE_PRM(p0, v86, p2, p3, p4, v16)
  IF ((v16 <> 0)) THEN
  POST_ERR(38000, 'MM:Robot_Argument_Error1', 0, 2)
  ELSE
  IF ((p1 <> 2)) THEN
  IF ((v86 <> p1)) THEN
  POST_ERR(38000, 'MM:Robot_Argument_Error2', 0, 2)
  ENDIF
  ELSE
  IF ((v86 <> 2)) THEN
  IF ((v86 = 1)) THEN
  p3 = p2
  ELSE
  POST_ERR(38000, 'MM:Robot_Argument_Error3', 0, 2)
  ENDIF
  ENDIF
  ENDIF
  ENDIF
  RETURN(0)
END GET_ARG

ROUTINE INIT_SKT : INTEGER
BEGIN
  IF (UNINIT(v1) OR UNINIT(v2) OR UNINIT(v3) OR UNINIT(v4)) THEN
  v1 = ' '
  v2 = ' '
  v3 = 0
  v4 = 0
  ENDIF
  v5 = 0
  sv_i = GET_ARG(1, 3, v6, v7, v8)
  -- stmt36 stray sv_i
  sv_i = GET_ARG(2, 3, v6, v7, v9)
  -- stmt37 stray sv_i
  sv_i = GET_ARG(3, 1, v10, v7, v11)
  -- stmt38 stray sv_i
  sv_i = GET_ARG(4, 1, v12, v7, v11)
  -- stmt39 stray sv_i
  IF ((v1 <> v8) OR (v2 <> v9) OR (v3 <> v10) OR (v4 <> v12)) THEN
  v1 = v8
  v2 = v9
  v3 = v10
  v4 = v12
  v13 = '$HOSTC_CFG[' + v8 + ']'
  v14 = 'C' + v8 + ':'
  SET_VAR(v15, '*SYSTEM*', v13 + '.$COMMENT', 'MM_CLIENT', v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$PROTOCOL', 'SM', v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$SERVER_PORT', v10, v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$TIMEOUT', v12, v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$STRT_REMOTE', v9, v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$REMOTE', v9, v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$COMMENT', 'MM_CLIENT', v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$STATE', 3, v16)
  v5 = v5 + v16
  SET_VAR(v15, '*SYSTEM*', v13 + '.$OPER', 3, v16)
  v5 = v5 + v16
  IF ((v5 <> 0)) THEN
  POST_ERR(38000, 'MM:Robot_Internal_Error', 0, 2)
  ENDIF
  GET_VAR(v15, '*SYSTEM*', v13 + '.$STATE', v17, v16)
  IF ((v16 <> 0) OR (v17 <> 3)) THEN
  POST_ERR(38000, 'MM:Robot_Internal_Error', 2, 2)
  ENDIF
  sv_s = chr(155)
  sv_s = chr(50)
  WRITE(sv_s, sv_s, 'MM:Restart Robot', CR)
  ENDIF
  MSG_CONNECT(v14, v16)
  IF ((v16 = 0) OR (v16 = 67215)) THEN
  sv_s = chr(155)
  sv_s = chr(50)
  WRITE(sv_s, sv_s, 'MM:Init Connection Successfully', CR)
  DELAY 500
  MSG_DISCO(v14, v16)
  ELSE
  POST_ERR(38000, 'MM:Robot_Socket_Closed', 0, 2)
  ENDIF
  RETURN(0)
END INIT_SKT

ROUTINE OPEN_SOCKET : INTEGER
BEGIN
  MSG_DISCO(v14, v16)
  SET_FILE_ATR(v26, 2, 1)
  SET_FILE_ATR(v28, 2, 1)
  MSG_CONNECT(v14, v16)
  IF ((v16 <> 0) AND (v16 <> 67215)) THEN
  POST_ERR(38000, 'MM:Robot_Socket_Closed', 0, 2)
  ENDIF
  RETURN(0)
END OPEN_SOCKET

ROUTINE READFLPOS : INTEGER
BEGIN
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt68 stray v87_f00[1] | v0_f1c[1]
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt69 stray v87_f00[1] | v0_f58[1]
  sv_p = curpos(0, 0)
  v27 = sv_p
  RETURN(0)
END READFLPOS

