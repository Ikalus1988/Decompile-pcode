PROGRAM DCPFAULT_MH

--Sends DCP Fault text to PLC using String Registers
--Version 1.1 Corrected all the CNV_INT_STR to base 10 number system
%COMMENT = 'Version 1.1'
%NOLOCKGROUP
%NOABORT=ERROR+COMMAND
%NOPAUSE=ERROR+COMMAND+TPENABLE
%NOBUSYLAMP
%INCLUDE kliotyps
--------------------------------------------------------------------------------------------------------------------------------------------
--                 TYPE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE DCP_type
--------------------------------------------------------------------------------------------------------------------------------------------
--                 VARIABLE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE DCP_variables	

--Variable declerations
VAR
STATUS:INTEGER
paramTyp, paramNo, paramInt, intDCPFault, intProgNum, intAreaInREQ, intAreaOutRL, intToolREQ, intJobDone, intColREQ, intColREL, entry, intToolID, EplanIO :INTEGER
paramReal, realDummy:REAL
paramString:STRING[10]
RobotName:STRING[6]
DCPFaultNum, DCPFaultNum1, EplanPage,strEplanIO: STRING[5]
strProgNum, strAreaNum, strAreaInREQ, strAreaOutRL, strToolREQ, strJobDone, strColREQ, strColREL:STRING[3]
ToolID: STRING[2]
DCPPLCText, strHis1, strHis2,strHis3, str11,str12,str13: STRING[82]
EplanRef, EplanType:STRING[40]
--Delcare a Variable of Type DCPDetail which is based on the Structure Declare Above (UDT)
strTPFunc:ARRAY[5] OF STRING[8]
blKeyPressed:BOOLEAN

--------------------------------------------------------------------------------------------------------------------------------------------
--                 ROUTINE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE DCP_Routines

--Delcare  External Routines
ROUTINE GET_EPLANREF (IORef:INTEGER):STRING FROM ReadEplan

--Begin Prog
BEGIN


FORCE_SPMENU ( TP_PANEL, SPI_TPUSER, 1) -- Force the Teach Pendant user screen to be seen

 --Get tp paramater which contains DCP Fault Number
 GET_TPE_PRM(1,paramTyp,intDCPFault,paramReal,paramString,STATUS)
 
 --If data is in wrong format or does not exist, show error!
 IF ((paramTyp <> 1) OR (STATUS <> 0)) THEN
 	WRITE('Invalid Call to DCPFault Program on Robot!',CR, 'Check argument 1 is an integer!')
	DCPText.DCPLine1 = 'Invalid Call to DCPFault Program on Robot'
 ENDIF
 
 --check if paramInt is initialised, of not set DCPFault to 0, if OK get DCP Fault number
 IF ( UNINIT(intDCPFault)) THEN
	intDCPFault = 0
 ENDIF
 
 
  --Get IO Number
 GET_TPE_PRM(2,1,EplanIO,paramReal,EplanRef,STATUS)
--Get Program Number form GI[1] and put into intProgNumber
GET_PORT_VAL(io_gpin,1,intProgNum,STATUS)
--convert prog number into a string and put into strProgNumber
CNV_INT_STR(intProgNum,3,10,strProgNum)

--Get Area in Request Number form R[151]
GET_REG(151,FALSE,intAreaInREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intAreaInREQ,3,10,strAreaInREQ)

--Get Area Out Release Number form R[152]
GET_REG(152,FALSE,intAreaOutRL, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intAreaOutRL,3,10,strAreaOutRL)

--Get Tool Request Number form R[153]
GET_REG(153,FALSE,intToolREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intToolREQ,3,10,strToolREQ)

--Get Job Done Number form R[154]
GET_REG(154,FALSE,intJobDone, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intJobDone,3,10,strJobDone)

--Get Collission Zone Req Number form R[156]
GET_REG(156,FALSE,intColREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intColREQ,3,10,strColREQ)

--Get Collission Zone Release Number form R[157]
GET_REG(157,FALSE,intColREL, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intColREL,3,10,strColREL)

--Get Robot Name
GET_VAR(entry, '*SYSTEM*','$ROBOT_NAME',RobotName,STATUS)
IF UNINIT(RobotName) THEN
	RobotName = 'Unit'
ENDIF
--Get Tool ID
GET_PORT_VAL(io_gpout,3,intToolID,STATUS)
--convert intToolID into a string and put into ToolID
CNV_INT_STR(intToolID,2,10,ToolID)
	--Initilise DCP Text
	DCPText.DCPFaultNum = 0
	DCPText.DCPLine1 = ''
	DCPText.DCPLine2 = ''
	DCPText.DCPLine3 = ''
	DCPText.DCPLine4 = ''
	DCPText.DCPLine5 = ''
	FKEY_SEL = 0
	--Initialise FKEYS
	FKEYS[1]  = ''
	FKEYS[2]  = ''
	FKEYS[3]  = ''
	FKEYS[4]  = ''
	FKEYS[5]  = ''
	FKEYS[6]  = ''
	FKEYS[7]  = ''
	FKEYS[8]  = ''
	FKEYS[9]  = ''
	FKEYS[10] = ''
	FKEY_SEL = 0
	
DCPText.DCPFaultNum = intDCPFault
 
SELECT DCPText.DCPFaultNum OF
	CASE(6351):
	DCPText.DCPLine1 = 'Gripper 1 : Number of cylinders is out of range'
	DCPText.DCPFaultNum = 06351
	
	CASE(6352):
	DCPText.DCPLine1 = 'Gripper 1 : Cylinder 1 at work not on'
	DCPText.DCPFaultNum = 06352
	
	CASE(6353):
	DCPText.DCPLine1 = 'Gripper 1 : Cylinder 2 at work not on'
	DCPText.DCPFaultNum = 06353
	
