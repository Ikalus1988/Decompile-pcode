	DCPText.DCPFaultNum = 08489	
	
	else:
	DCPText.DCPLine1 = 'Undefined DCP Fault Message'

ENDSELECT

--Add Robot Name and Tool ID to String Register Text for PLC
DCPPLCText = RobotName + ',Tool-'+ToolID + ',' +  DCPText.DCPLine1 + DCPText.DCPLine2
CNV_INT_STR(DCPText.DCPFaultNum,5,10,DCPFaultNum1)
DCPFaultNum1 = SUB_STR(DCPFaultNum1,2,4)
DCPFaultNum = '0' + DCPFaultNum1
--Write DCP Fault Number to GO[4]
SET_PORT_VAL(io_gpout,4,intDCPFault,STATUS)
--Write DCP Fault Number to SR[9]
SET_STR_REG(9,DCPFaultNum,STATUS)
--Write DCP Fault Text to SR[10]
SET_STR_REG(10,DCPPLCText,STATUS)
--Get Eplan Reference
EplanRef = GET_EPLANREF(EplanIO)

--Split EplanRef into the Reference and the Page Number

EplanPage = SUB_STR(EplanRef,17,20)
EplanType = SUB_STR(EplanRef,22,40)
EplanRef = SUB_STR(EplanRef,1,16)
CNV_INT_STR(EplanIO,3,0,strEplanIO)
--Write DCP Fault to user screen
DCPText.DCPLine3 = 'GRIPPER FAULT'
DCPText.DCPLine4 = 'DI' + strEplanIO + '  ' + EplanType
DCPText.DCPLine5 =  'Eplan Ref = P.' + EplanPage + EplanRef
SET_STR_REG(11,DCPText.DCPLine3,STATUS)
SET_STR_REG(12,DCPText.DCPLine4,STATUS)
SET_STR_REG(13,DCPText.DCPLine5,STATUS)

--Set Boolean to Indicate SPR DCP Fault
  blPLC = FALSE
  blSPR	= FALSE
  blSpot  = FALSE
  blDispense  = FALSE
  blMH = TRUE
  blStud = FALSE
  blNut = FALSE
  blIsra = FALSE
  blQuiss = FALSE
  
IF FKEY_SEL = 0 THEN
	FKEYS[1] = 'ACK'
ENDIF
  --Turn On DCP Fault output 
DOUT[5] = ON
--Call Routine from DCP_FORM to display the DCP Alarm in the Form
DCPDISP(DCPText)

  
END DCPFAULT_MH
