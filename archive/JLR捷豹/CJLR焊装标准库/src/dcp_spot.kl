	DCPText.DCPLine1 = 'Tip dresser 2 forward not on'
	DCPText.DCPFaultNum = 00233
	
	CASE(234):
	DCPText.DCPLine1 = 'Tip dresser 2 forward not off'
	DCPText.DCPFaultNum = 00234
	
	CASE(235):
	DCPText.DCPLine1 = 'Tip dresser 2 backward not on'
	DCPText.DCPFaultNum = 00235
	
	CASE(236):
	DCPText.DCPLine1 = 'Tip dresser 2 backward not off'
	DCPText.DCPFaultNum = 00236
	
	CASE(237):
	DCPText.DCPLine1 = 'Tip dresser 2 motor run from PLC not on'
	DCPText.DCPFaultNum = 00237
	
	CASE(238):
	DCPText.DCPLine1 = 'Tip dresser 2 no rotation check start'
	DCPText.DCPFaultNum = 00238
	
	CASE(239):
	DCPText.DCPLine1 = 'Tip dresser 2 no rotation check end'
	DCPText.DCPFaultNum = 00239
	
	CASE(261):
	DCPText.DCPLine1 = 'Gun2 Tip Wear out of Tollerance'
	DCPText.DCPLine2 = 'Old Gun'+strWDRbtOld2+ '   New Gun'+strWDRbtNew2
	DCPText.DCPLine3 = 'Old Rbt'+strWDGunOld2+ '   New Rbt'+strWDGunNew2
	DCPText.DCPLine4 = 'Rbt Diff='+strRbtDiff2+'   Gun Diff'+strGunDiff2
	DCPText.DCPFaultNum = 00261
	
	CASE(262):
	DCPText.DCPLine1 = 'Gun2 Incorrect Tips Detected'
	DCPText.DCPFaultNum = 00262	
	
	else:
	DCPText.DCPLine1 = 'Undefined DCP Fault Message'

ENDSELECT
WRITE('DCP Fault: ', intDCPFault,CR, DCPText.DCPLine1, CR, DCPText.DCPLine2,CR)
--Add Robot Name and Tool ID to String Register Text for PLC
DCPPLCText = RobotName + ',Tool-' +ToolID + ',' +  DCPText.DCPLine1 + DCPText.DCPLine2
--Write DCP Fault Number to GO[4]
SET_PORT_VAL(io_gpout,4,intDCPFault,STATUS)
CNV_INT_STR(DCPText.DCPFaultNum,5,10,DCPFaultNum1)
DCPFaultNum = SUB_STR(DCPFaultNum1,3,3)
--Write DCP Fault Number to SR[9]
SET_STR_REG(9,DCPFaultNum,STATUS)
--Write DCP Fault Text to SR[10]
SET_STR_REG(10,DCPPLCText,STATUS)

--If DCP Fault Number = 103 or 203 Spot Plate Thickness out of Tolerance Display Actual Thickness and Requested Thickness to User Screen
IF ((intDCPFault = 111) OR (intDCPFault = 211)) THEN
	DCPText.DCPLine4 ='Requested Thickness = '+strReqThk
	DCPText.DCPLine5 ='Actual Thickness = '+ActThkStr
	SET_STR_REG(11,'Requested Thickness = '+strReqThk,STATUS)
	SET_STR_REG(12,'Actual Thickness = '+ActThkStr,STATUS)
--Else Display Nothing	
ENDIF
--Short Circuit Weld Failure
IF (intDCPFault = 108) THEN
	DCPText.DCPLine4 ='Press Retry to Redo Tip Dressing'
	DCPText.DCPLine5 ='Press ACK to Redo Short Circuit'
	SET_STR_REG(11,'Press Retry to Redo Tip Dressing',STATUS)
	SET_STR_REG(12,'Press Reset to Redo Short Circuit',STATUS)
ENDIF
	
--Decide based on Integer Value in FKEY_SEL what text to display on the Alarm page	
IF FKEY_SEL = 0 THEN
	FKEYS[1] = 'ACK'
	FKEYS[2] = ''
	FKEYS[3] = ''
	FKEYS[4] = ''
ENDIF
IF FKEY_SEL = 1 THEN
	FKEYS[1] = ''
	FKEYS[2] = 'SKIP'
	FKEYS[3] = 'RETRY'
	FKEYS[4] = ''
ENDIF
IF FKEY_SEL = 2 THEN
	FKEYS[1] = ''
	FKEYS[2] = 'IGNORE'
	FKEYS[3] = 'RETRY'
	FKEYS[4] = 'SKIP'
ENDIF
IF FKEY_SEL = 3 THEN
	FKEYS[1] = 'ACK'
	FKEYS[2] = ''
	FKEYS[3] = 'RETRY'
	FKEYS[4] = ''
ENDIF
--Set Boolean to Indicate SPR DCP Fault
  blPLC = FALSE
  blSPR	= FALSE
  blSpot  = TRUE
  blDispense  = FALSE
  blMH = FALSE
  blStud = FALSE
  blNut = FALSE
  blIsra = FALSE
  blQuiss = FALSE
  
  --Turn On DCP Fault output 
DOUT[5] = ON
--Call Routine from DCP_FORM to display the DCP Alarm in the Form
DCPDISP(DCPText)

END DCP_SPOT