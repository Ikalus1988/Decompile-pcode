PROGRAM DebugText

%COMMENT = 'Version 1.3'
%NOLOCKGROUP
%NOABORT=ERROR+COMMAND
%NOPAUSE=ERROR+COMMAND+TPENABLE
%NOBUSYLAMP
%INCLUDE kliotyps

	TYPE
	Revision FROM StdChkVer = STRUCTURE
	Major:INTEGER
	Minor:INTEGER
	ENDSTRUCTURE

--Variable declerations
VAR
STATUS:INTEGER
paramTyp, paramNo, paramInt, intDebugText, intProgNum, intAreaInREQ, intAreaOutRL, intToolREQ, intJobDone, intColREQ, intColREL,intTypeNum, intCollNum :INTEGER
paramReal, realDummy:REAL
paramString:STRING[10]
strProgNum, strAreaNum, strAreaInREQ, strAreaOutRL, strToolREQ, strJobDone, strColREQ, strColREL:STRING[3]
strDebugText: STRING[82]
currentTime, lastTime, diffTime IN CMOS : INTEGER
ClockRead								: INTEGER
entry										: INTEGER
DebugTxtVer:Revision

--Get Version Routine
ROUTINE DebugTxt_Ver:Revision

BEGIN
	
DebugTxtVer.Major = 1
DebugTxtVer.Minor = 0

RETURN(DebugTxtVer)

END DebugTxt_Ver

--Begin Prog
BEGIN
--Get Fast Clock
GET_VAR(entry, '*SYSTEM*','$FAST_CLOCK',ClockRead,STATUS)
	
--Check for Disbaling Flag to be on so Not to Force the Screen Up
IF FLG[10] = OFF THEN
	--If Disbaling Flag is off Force the User Screen Up
	FORCE_SPMENU ( TP_PANEL, SPI_TPUSER, 1) -- Force the Teach Pendant user screen to be seen
	lastTime = Clockread
ELSE
	--If Disbaling Flag is on Begin 10 Minute Timer
		IF UNINIT(lastTime)THEN
			lastTime = Clockread
		ENDIF
		
		diffTime = ClockRead - lastTime
		--600000 = 10Mins
		IF (diffTime > 600000) THEN
			FLG[10] = OFF
		ENDIF
ENDIF

--Get tp paramater which contains Debug Text Number
 GET_TPE_PRM(1,paramTyp,intDebugText,paramReal,paramString,STATUS)
 
 --If data is in wrong format or does not exist, show error!
 IF ((paramTyp <> 1) OR (STATUS <> 0)) THEN
  
 	WRITE('Invalid Call to Debug Text Program on Robot!',CR, 'Check argument 1 is an integer!')

	--strDCPText = 'Invalid Call to DCPFault Program on Robot'

 ENDIF
 
--Get Program Number form GI[1] and put into intProgNumber
GET_PORT_VAL(io_gpin,1,intProgNum,STATUS)
--Get Type Number form GI[2] and put into intCollNum
GET_PORT_VAL(io_gpin,1,intCollNum,STATUS)
--Get Type Number form GI[3] and put into intTypeNum
GET_PORT_VAL(io_gpin,1,intTypeNum,STATUS)
--convert prog number into a string and put into strProgNumber
CNV_INT_STR(intProgNum,3,3,strProgNum)

--Get Area in Request Number form R[151]
GET_REG(151,FALSE,intAreaInREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intAreaInREQ,3,3,strAreaInREQ)

--Get Area Out Release Number form R[152]
GET_REG(152,FALSE,intAreaOutRL, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intAreaOutRL,3,3,strAreaOutRL)

--Get Tool Request Number form R[153]
GET_REG(153,FALSE,intToolREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intToolREQ,3,3,strToolREQ)

--Get Job Done Number form R[154]
GET_REG(154,FALSE,intJobDone, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intJobDone,3,3,strJobDone)

--Get Collission Zone Req Number form R[156]
GET_REG(156,FALSE,intColREQ, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intColREQ,3,3,strColREQ)

--Get Collission Zone Release Number form R[157]
GET_REG(157,FALSE,intColREL, realDummy,STATUS)
--convert Number to string
CNV_INT_STR(intColREL,3,3,strColREL)

SELECT intDebugText OF

	CASE(0): 
	CASE(1): WRITE('System Initialised',CR,'Waiting for Robot in Auto')
	CASE(2): WRITE('Waiting for DI[16]=OFF',CR,'Prog Strobe Off')
	CASE(3): WRITE('Waiting for DI[16]=on',CR,'Prog Strobe On')
	CASE(4): WRITE('Waiting GI[1:Prog No.] = 1-127',CR,'Current Prog No. = ', +intProgNum)
	CASE(5): WRITE('Waiting GI[1:Prog No.] = 0',CR,'Current Prog No. = ', +intProgNum)
	CASE(6): WRITE('Waiting GI[3:Type No.] = 1-255',CR,'Curretn Type No. = ', +intTypeNum)
	CASE(7): WRITE('Waiting PLC End Cycle',CR,'In program INITRS')
	CASE(8): WRITE('')
	CASE(9): WRITE('Waiting Robot to Stop Moving',CR,'DO[15;No Motion]=ON')
	CASE(10): WRITE('')
	CASE(11): WRITE('Waiting Entry Area 1, DI[17] = On',CR,'or Return to Home DI[13] = On')
	CASE(12): WRITE('Waiting Entry Area 2, DI[18] = On',CR,'or Return to Home DI[13] = On')
	CASE(13): WRITE('Waiting Entry Area 3, DI[19] = On',CR,'or Return to Home DI[13] = On')
	CASE(14): WRITE('Waiting Entry Area 4, DI[20] = On',CR,'or Return to Home DI[13] = On')
	CASE(15): WRITE('Waiting Entry Area 5, DI[21] = On',CR,'or Return to Home DI[13] = On')
	CASE(16): WRITE('Waiting Entry Area 6, DI[22] = On',CR,'or Return to Home DI[13] = On')
	CASE(17): WRITE('Waiting Entry Area 7, DI[23] = On',CR,'or Return to Home DI[13] = On')
	CASE(18): WRITE('Waiting Entry Area 8, DI[24] = On',CR,'or Return to Home DI[13] = On')
	CASE(19): WRITE('')
	CASE(20): WRITE('')
	CASE(21): WRITE('Waiting Entry into Area 1', CR, 'DI[17;Area Ready 1] = ON')
	CASE(22): WRITE('Waiting Entry into Area 2', CR, 'DI[18;Area Ready 2] = ON')
	CASE(23): WRITE('Waiting Entry into Area 3', CR, 'DI[19;Area Ready 3] = ON')
	CASE(24): WRITE('Waiting Entry into Area 4', CR, 'DI[20;Area Ready 4] = ON')
	CASE(25): WRITE('Waiting Entry into Area 5', CR, 'DI[21;Area Ready 5] = ON')
	CASE(26): WRITE('Waiting Entry into Area 6', CR, 'DI[22;Area Ready 6] = ON')
	CASE(27): WRITE('Waiting Entry into Area 7', CR, 'DI[23;Area Ready 7] = ON')
	CASE(28): WRITE('Waiting Entry into Area 8', CR, 'DI[24;Area Ready 8] = ON')
	CASE(29): WRITE('')
	CASE(30): WRITE('')
	CASE(31): WRITE('Waiting Tool Request 1',CR,'DI[33:Tool 1 Ready]')
	CASE(32): WRITE('Waiting Tool Request 2',CR,'DI[34:Tool 2 Ready]')
	CASE(33): WRITE('Waiting Tool Request 3',CR,'DI[35:Tool 3 Ready]')
	CASE(34): WRITE('Waiting Tool Request 4',CR,'DI[36:Tool 4 Ready]')
	CASE(35): WRITE('Waiting Tool Request 5',CR,'DI[37:Tool 5 Ready]')
	CASE(36): WRITE('Waiting Tool Request 6',CR,'DI[38:Tool 6 Ready]')
	CASE(37): WRITE('Waiting Tool Request 7',CR,'DI[39:Tool 7 Ready]')
	CASE(38): WRITE('Waiting Tool Request 8',CR,'DI[40:Tool 8 Ready]')
	CASE(39): WRITE('')
	CASE(40): WRITE('')
	CASE(41): WRITE('Collision Zone Release',CR,'Wait GI[2:Coll No.] = ', +intColREQ, ' and',CR,'DI[31:Col Zone Clr] = On')
	CASE(42): WRITE('Collision Zone Release',CR,'Wait GI[2:Coll No.] = ', +intColREQ, ' and',CR,'DI[32:Col Zone Set] = On')
	CASE(43): WRITE('Collision Zone Release',CR,'Wait DI[32:Coll Zone Set.] = Off')
	CASE(44): WRITE('Collision Zone Release',CR,'Wait DI[31:Coll Zone Clr.] = Off')
	CASE(45): WRITE('Collision Zone Request',CR,'Wait GI[2:Coll No.] =',  +intColREQ, ' and',CR, 'DI[31;Coll Zone Clr = On')
	CASE(46): WRITE('Collision Zone Request',CR,'Waiting for Col Zone - ',  +intColREQ)
	CASE(47): WRITE('Collision Zone Request',CR,'Wait DI[31;Coll Zone Clr] = Off')
	CASE(48): WRITE('Collision Zone Request',CR,'Wait DI[32;Coll Zone Set] = Off')
	CASE(49): WRITE('')
	CASE(50): WRITE('')
	CASE(51): WRITE('Collision Zone Home',CR,'Waiting DO[8:At Home Pos] = On',CR, 'Robot Not At Home')
	CASE(52): WRITE('Collision Zone Home',CR,'Waiting DI[31;Col Zone Clr] = Off')
	CASE(53): WRITE('Collision Zone Home',CR,'Waiting DI[32:Col Zone Set] = Off')
	CASE(54): WRITE('Collision Zone Home',CR,'Waiting GI[2:Coll Zone No.] = 63 and',CR, 'DI[31:Coll Zone Clear] = On' )
	CASE(55): WRITE('Collision Zone Home',CR,'Waiting GI[2:Coll Zone No.] = 0 and', CR, 'DI[31:Coll Zone Clear] = Off')


	CASE(100): WRITE('No Water Flow to Electrodes',CR,'Robot waiting for DI[922] = ON',CR,'When DI[922] = On Robot will Continue')
	CASE(101): WRITE('Waiting Entry Area 9, DI[161] = On',CR,'or Return to Home DI[13] = On')
	CASE(102): WRITE('Waiting Entry Area 10, DI[162] = On',CR,'or Return to Home DI[13] = On')
	CASE(103): WRITE('Waiting Entry Area 11, DI[163] = On',CR,'or Return to Home DI[13] = On')
	CASE(104): WRITE('Waiting Entry Area 12, DI[164] = On',CR,'or Return to Home DI[13] = On')
	CASE(105): WRITE('Waiting Entry Area 13, DI[165] = On',CR,'or Return to Home DI[13] = On')
	CASE(106): WRITE('Waiting Entry Area 14, DI[166] = On',CR,'or Return to Home DI[13] = On')
	CASE(107): WRITE('Waiting Entry Area 15, DI[167] = On',CR,'or Return to Home DI[13] = On')
	CASE(108): WRITE('Waiting Entry Area 16, DI[168] = On',CR,'or Return to Home DI[13] = On')
	CASE(109): WRITE('')
	CASE(110): WRITE('')
	CASE(111): WRITE('Waiting Entry into Area 9', CR, 'DI[161:Area Ready 9] = ON')
	CASE(112): WRITE('Waiting Entry into Area 10', CR, 'DI[162:Area Ready 10] = ON')
	CASE(113): WRITE('Waiting Entry into Area 11', CR, 'DI[163:Area Ready 11] = ON')
	CASE(114): WRITE('Waiting Entry into Area 12', CR, 'DI[164:Area Ready 12] = ON')
	CASE(115): WRITE('Waiting Entry into Area 13', CR, 'DI[165:Area Ready 13] = ON')
	CASE(116): WRITE('Waiting Entry into Area 14', CR, 'DI[166:Area Ready 14] = ON')
	CASE(117): WRITE('Waiting Entry into Area 15', CR, 'DI[167:Area Ready 15] = ON')
	CASE(118): WRITE('Waiting Entry into Area 16', CR, 'DI[168:Area Ready 16] = ON')
	CASE(119): WRITE('')
	CASE(120): WRITE('')
	CASE(121): WRITE('Start Signal Response', CR, 'Process Active not ON')
	CASE(122): WRITE('Start Signal Response', CR, 'Process OK not OFF')
	CASE(123): WRITE('Waiting Start Toogle OFF', CR, 'DI[2319:TogStart] = OFF')
	CASE(124): WRITE('Waiting Start Toogle ON', CR,'DI[2319:TogStart] = ON')
	CASE(125): WRITE('Waiting Stop Toogle OFF', CR, 'DI[2320:TogStop] = OFF')
	CASE(126): WRITE('Waiting Stop Toogle ON', CR, 'DI[2320:TogStop] =  ON')
	CASE(127): WRITE('Waiting Spray Finished ON', CR, 'DI[2329:SprayRdy] = ON')
	CASE(128): WRITE('')
	CASE(129): WRITE('')
	CASE(130): WRITE('')					
	CASE(131): WRITE('Waiting Entry Area 17, DI[193] = On',CR,'or Return to Home DI[13] = On')
	CASE(132): WRITE('Waiting Entry Area 18, DI[194] = On',CR,'or Return to Home DI[13] = On')
	CASE(133): WRITE('Waiting Entry Area 19, DI[195] = On',CR,'or Return to Home DI[13] = On')
	CASE(134): WRITE('Waiting Entry Area 20, DI[196] = On',CR,'or Return to Home DI[13] = On')
	CASE(135): WRITE('Waiting Entry Area 21, DI[197] = On',CR,'or Return to Home DI[13] = On')
	CASE(136): WRITE('Waiting Entry Area 22, DI[198] = On',CR,'or Return to Home DI[13] = On')
	CASE(137): WRITE('Waiting Entry Area 23, DI[199] = On',CR,'or Return to Home DI[13] = On')
	CASE(138): WRITE('Waiting Entry Area 24, DI[200] = On',CR,'or Return to Home DI[13] = On')
	CASE(139): WRITE('')
	CASE(140): WRITE('')
	CASE(141): WRITE('Waiting Entry into Area 17', CR, 'DI[193:Area Ready 17] = ON')
	CASE(142): WRITE('Waiting Entry into Area 18', CR, 'DI[194:Area Ready 18] = ON')
	CASE(143): WRITE('Waiting Entry into Area 19', CR, 'DI[195:Area Ready 19] = ON')
	CASE(144): WRITE('Waiting Entry into Area 20', CR, 'DI[196:Area Ready 20] = ON')
	CASE(145): WRITE('Waiting Entry into Area 21', CR, 'DI[197:Area Ready 21] = ON')
	CASE(146): WRITE('Waiting Entry into Area 22', CR, 'DI[198:Area Ready 22] = ON')
	CASE(147): WRITE('Waiting Entry into Area 23', CR, 'DI[199:Area Ready 23] = ON')
	CASE(148): WRITE('Waiting Entry into Area 24', CR, 'DI[200:Area Ready 24] = ON')
	CASE(149): WRITE('')
	CASE(150): WRITE('')
	CASE(151): WRITE('Waiting Entry Area 25, DI[225] = On',CR,'or Return to Home DI[13] = On')
	CASE(152): WRITE('Waiting Entry Area 26, DI[226] = On',CR,'or Return to Home DI[13] = On')
	CASE(153): WRITE('Waiting Entry Area 27, DI[227] = On',CR,'or Return to Home DI[13] = On')
	CASE(154): WRITE('Waiting Entry Area 28, DI[228] = On',CR,'or Return to Home DI[13] = On')
	CASE(155): WRITE('Waiting Entry Area 29, DI[229] = On',CR,'or Return to Home DI[13] = On')
	CASE(156): WRITE('Waiting Entry Area 30, DI[230] = On',CR,'or Return to Home DI[13] = On')
	CASE(157): WRITE('Waiting Entry Area 31, DI[231] = On',CR,'or Return to Home DI[13] = On')
	CASE(158): WRITE('Waiting Entry Area 32, DI[232] = On',CR,'or Return to Home DI[13] = On')
	CASE(159): WRITE('')
	CASE(160): WRITE('')
	CASE(161): WRITE('Waiting Entry into Area 25', CR, 'DI[225:Area Ready 25] = ON')
	CASE(162): WRITE('Waiting Entry into Area 26', CR, 'DI[226:Area Ready 26] = ON')
	CASE(163): WRITE('Waiting Entry into Area 27', CR, 'DI[227:Area Ready 27] = ON')
	CASE(164): WRITE('Waiting Entry into Area 28', CR, 'DI[228:Area Ready 28] = ON')
	CASE(165): WRITE('Waiting Entry into Area 29', CR, 'DI[229:Area Ready 29] = ON')
	CASE(166): WRITE('Waiting Entry into Area 30', CR, 'DI[230:Area Ready 30] = ON')
	CASE(167): WRITE('Waiting Entry into Area 31', CR, 'DI[231:Area Ready 31] = ON')
	CASE(168): WRITE('Waiting Entry into Area 32', CR, 'DI[232:Area Ready 32] = ON')
	
	CASE(169):  WRITE('Waiting Tool Request 9',CR,'DI[169:Tool 9 Ready]')
	CASE(170):  WRITE('Waiting Tool Request 10',CR,'DI[170:Tool 10 Ready]')
	CASE(171):  WRITE('Waiting Tool Request 11',CR,'DI[171:Tool 11 Ready]')
	CASE(172):  WRITE('Waiting Tool Request 12',CR,'DI[172:Tool 12 Ready]')
	CASE(173):  WRITE('Waiting Tool Request 13',CR,'DI[173:Tool 13 Ready]')
	CASE(174):  WRITE('Waiting Tool Request 14',CR,'DI[174:Tool 14 Ready]')
	CASE(175):  WRITE('Waiting Tool Request 15',CR,'DI[175:Tool 15 Ready]')
	CASE(176):  WRITE('Waiting Tool Request 16',CR,'DI[176:Tool 16 Ready]')
	CASE(177): WRITE('')
	CASE(178): WRITE('')
	CASE(179): WRITE('')
	CASE(180): WRITE('')
