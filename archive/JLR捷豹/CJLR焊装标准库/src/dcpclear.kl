PROGRAM DCPCLEAR

--Sends DCP Fault text to PLC using String Registers

%COMMENT = 'Version 1.3'
%NOLOCKGROUP
%NOABORT=ERROR+COMMAND
%NOPAUSE=ERROR+COMMAND+TPENABLE
%NOBUSYLAMP

%INCLUDE kliotyps
--------------------------------------------------------------------------------------------------------------------------------------------
--                 TYPE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE DCP_type
--------------------------------------------------------------------------------------------------------------------------------------------
--                 VARIABLE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE DCP_variables

--Variable declerations
VAR
STATUS			: INTEGER
strHis1				: STRING[82]
strHis2				: STRING[82]
strHis3				: STRING[82]
EmptyString		: STRING[82]
schedule_idx	: INTEGER
TimeDate		: STRING[18]
TimeRaw			: INTEGER
--Begin Prog
BEGIN

	schedule_idx = 1
	--Check for Uninitialised Data in the DCP History Array
	FOR schedule_idx =1 TO 20 DO
		IF UNINIT(DCPTextHist[schedule_idx].DCPFaultNum) THEN
			DCPTextHist[schedule_idx].DCPFaultNum = 0
		ENDIF
		IF UNINIT(DCPTextHist[schedule_idx].DCPLine1) THEN
			DCPTextHist[schedule_idx].DCPLine1 = 'No History Data'
		ENDIF
		IF UNINIT(DCPTextHist[schedule_idx].DCPLine2) THEN
			DCPTextHist[schedule_idx].DCPLine2 = 'No History Data'
		ENDIF
		IF UNINIT(DCPTextHist[schedule_idx].DCPLine3) THEN
			DCPTextHist[schedule_idx].DCPLine3 = 'No History Data'
		ENDIF
		IF UNINIT(DCPTextHist[schedule_idx].DCPLine4) THEN
			DCPTextHist[schedule_idx].DCPLine4 = 'No History Data'
		ENDIF
		IF UNINIT(DCPTextHist[schedule_idx].DCPLine5) THEN
			DCPTextHist[schedule_idx].DCPLine5 = 'No History Data'
		ENDIF
		IF UNINIT(DCPTimeHist[schedule_idx]) THEN
			DCPTimeHist[schedule_idx] = ''
		ENDIF
	ENDFOR

 IF(DOUT[5] = ON) THEN

EmptyString = ''
--Get Time and Date
GET_TIME(TimeRaw)
CNV_TIME_STR(TimeRaw, TimeDate)

SET_STR_REG(10,EmptyString,STATUS)
SET_STR_REG(11,EmptyString,STATUS)
SET_STR_REG(12,EmptyString,STATUS)
SET_STR_REG(13,EmptyString,STATUS)
SET_STR_REG(14,EmptyString,STATUS)
SET_PORT_VAL(io_gpout,4,0,STATUS)
schedule_idx = 1
--Update DCP Fault History
FOR schedule_idx = 20 DOWNTO 2 DO
	DCPTextHist[(schedule_idx)].DCPFaultNum = DCPTextHist[(schedule_idx - 1)].DCPFaultNum
	DCPTextHist[(schedule_idx)].DCPLine1 = DCPTextHist[(schedule_idx - 1)].DCPLine1 
	DCPTextHist[(schedule_idx)].DCPLine2 = DCPTextHist[(schedule_idx - 1)].DCPLine2  
	DCPTextHist[(schedule_idx)].DCPLine3 = DCPTextHist[(schedule_idx - 1)].DCPLine3 
	DCPTextHist[(schedule_idx)].DCPLine4 = DCPTextHist[(schedule_idx - 1)].DCPLine4  
	DCPTextHist[(schedule_idx)].DCPLine5 = DCPTextHist[(schedule_idx - 1)].DCPLine5
	DCPTimeHist[(schedule_idx)] = DCPTimeHist[(schedule_idx - 1)]
ENDFOR

	DCPTextHist[1].DCPFaultNum = DCPText.DCPFaultNum 
	DCPTextHist[1].DCPLine1 = DCPText.DCPLine1
	DCPTextHist[1].DCPLine2 = DCPText.DCPLine2
	DCPTextHist[1].DCPLine3 = DCPText.DCPLine3
	DCPTextHist[1].DCPLine4 = DCPText.DCPLine4
	DCPTextHist[1].DCPLine5 = DCPText.DCPLine5
	DCPTimeHist[1] = TimeDate
	
	DCPText.DCPFaultNum = 0
	DCPText.DCPLine1 = 'No DCP Faults Active'
	DCPText.DCPLine2 = ''
	DCPText.DCPLine3 = ''
	DCPText.DCPLine4 = ''
	DCPText.DCPLine5 = ''
	FKEY_SEL = 0
ENDIF
 
--Write DCP Fault Text to User Page
WRITE (CHR(128))
WRITE TPPROMPT(CHR(128))
WRITE TPFUNC(CHR(128))
--SET DCP FAULT LOW
DOUT[5] = OFF
 
END DCPCLEAR