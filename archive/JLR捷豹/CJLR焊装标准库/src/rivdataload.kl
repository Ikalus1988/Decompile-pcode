PROGRAM RivDataLoad

%COMMENT = 'Version 1.6'
%NOLOCKGROUP
%NOABORT = COMMAND + ERROR
%NOPAUSE = COMMAND + ERROR + TPENABLE
%NOBUSYLAMP
--------------------------------------------------------------------------------------------------------------------------------------------
--                 CONSTANT DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE rtd_constants

--------------------------------------------------------------------------------------------------------------------------------------------
--                 TYPE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE rtd_types

--------------------------------------------------------------------------------------------------------------------------------------------
--                 VARIABLE DECLARATIONS
--------------------------------------------------------------------------------------------------------------------------------------------
%INCLUDE rtd_variables

VAR

fileComm 		: FILE
STATUS		: INTEGER
intSchedule		: INTEGER
intRivetID		: INTEGER
intContID		: INTEGER
intToolID		: INTEGER
intRivType		: INTEGER
intPMOffset		: INTEGER
intPMOpen		: INTEGER
strRivetID		: STRING[3]
strContID		: STRING[1]
strToolID		: STRING[1]
strRivType		: STRING[1]
strPMOffset		: STRING[2]
strPMOpen		: STRING[1]
strComment		: STRING[26]
strLine 			: STRING[35]
blDone			: BOOLEAN
realParam 		: REAL

BEGIN
	bldone = FALSE
	intSchedule = 1
	OPEN FILE fileComm('RO', 'FR:Rivet.DT')
	
IF (IO_STATUS(fileComm) = 0) THEN
    	
    FOR intSchedule = 1 TO MAXSCHEDULES DO
      	--read line from file
    	READ fileComm(strLine)
	--Write Read String to User Screen
	WRITE(strLine,CR)
   	--Break up string into the Different Parts and convert to Integers
   	--Rivet ID
   	strRivetID = SUB_STR(strLine,1,3)
   	CNV_STR_INT(strRivetID,intRivetID)
   	--Controller ID
   	strContID = SUB_STR(strLine,4,4)
   	CNV_STR_INT(strContID,intContID)
   	--Tool ID
   	strToolID = SUB_STR(strLine,5,5)
   	CNV_STR_INT(strToolID,intToolID)
   	--Rivet Type
   	strRivType = SUB_STR(strLine,6,6)
   	CNV_STR_INT(strRivType,intRivType)
   	--Post Move Offset
   	strPMOffset = SUB_STR(strLine,7,8)
   	CNV_STR_INT(strPMOffset,intPMOffset)
   	--Post Move Opening
   	strPMOpen = SUB_STR(strLine,9,9)
   	CNV_STR_INT(strPMOpen,intPMOpen)
   	--Comment
   	strComment = SUB_STR(strLine,10,35)
   	--Store the Data into the CMOS Array for RivetData
   	arrRivetData[intSchedule].RivetID = intRivetID
   	arrRivetData[intSchedule].ContID = intContID
   	arrRivetData[intSchedule].ToolID = intToolID
   	arrRivetData[intSchedule].RivType = intRivType
   	arrRivetData[intSchedule].PMOffset = intPMOffset
   	arrRivetData[intSchedule].PMOpen = intPMOpen
   	arrRivetData[intSchedule].Comment = strComment
   	
    ENDFOR

   	
	CLOSE FILE fileComm
	
	FORCE_SPMENU ( TP_PANEL, SPI_TPUSER, 1)
	WRITE(CR,'Rivet Data Load Complete')
ELSE
	FORCE_SPMENU ( TP_PANEL, SPI_TPUSER, 1)
	WRITE(CHR(128))
    WRITE ('Error Opening File',CR)
  ENDIF
END RivDataLoad