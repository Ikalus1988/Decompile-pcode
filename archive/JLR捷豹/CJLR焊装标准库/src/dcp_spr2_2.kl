	DCPText.DCPFaultNum = 02544
	
	CASE(2545):
	DCPText.DCPLine1 = 'Mag2 Mag Gate Wrong B4'
	DCPText.DCPFaultNum = 02545
	
	CASE(2546):
	DCPText.DCPLine1 = 'Mag2 Stand Gate Wrong B4'
	DCPText.DCPFaultNum = 02546
	
	CASE(2547):
	DCPText.DCPLine1 = 'Mag2 Probe Not Back A'
