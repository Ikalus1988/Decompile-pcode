-- DCP_SPR.KL (decompiled v3)
PROGRAM DCP_SPR
%COMMENT = 'Version 1.6'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  STRDCPTEXT : STRING[64]
  DCPTEXT : ALMDCP
  INTTOOLID : INTEGER
  REALDUMMY : REAL
  HENTOOLID : STRING[64]
  INTCONTID : INTEGER
  HENCONTID : STRING[64]
  TOOLID : STRING[64]
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  PARAMINT : INTEGER
  STRADDDCPTXT : STRING[64]
  FKEYS : ARRAY[64] OF STRING[64]
  FKEY_SEL : INTEGER
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPPLCTEXT : STRING[64]
  DCPFAULTNUM1 : STRING[64]
  DCPFAULTNUM : STRING[64]
  INTHENERROR : INTEGER
  STRHENERROR : STRING[64]
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  PARAMNO : INTEGER
  INTPROGNUM : INTEGER
  INTAREAINREQ : INTEGER
  INTAREAOUTRL : INTEGER
  INTTOOLREQ : INTEGER
  INTJOBDONE : INTEGER
  INTCOLREQ : INTEGER
  INTCOLREL : INTEGER
  STRPROGNUM : STRING[3]
  STRAREANUM : STRING[3]
  STRAREAINREQ : STRING[3]
  STRAREAOUTRL : STRING[3]
  STRTOOLREQ : STRING[3]
  STRJOBDONE : STRING[3]
  STRCOLREQ : STRING[3]
  STRCOLREL : STRING[3]
  CONTID : STRING[5]
  STRHIS1 : STRING[82]
  STRHIS2 : STRING[82]
  STRHIS3 : STRING[82]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR1_1(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR1_2(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR1_3(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR2_1(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR2_2(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE G_DCP_SPR2_3(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault_SPR Program on Robot!', CR, 'Check argument 1 is an integer!')
  STRDCPTEXT = 'Invalid Call to DCPFault_SCA Program on Robot'
  ENDIF
  DCPTEXT_f00 = INTDCPFAULT
  GET_REG(81, (0 <> 0), INTTOOLID, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLID, 2, 10, HENTOOLID)
  GET_REG(80, (0 <> 0), INTCONTID, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCONTID, 2, 10, HENCONTID)
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'NoName'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, STRADDDCPTXT, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  IF (UNINIT(STRADDDCPTXT)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  FKEYS[1] = ''
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  FKEYS[6] = ''
  FKEYS[7] = ''
  FKEYS[8] = ''
  FKEYS[9] = ''
  FKEYS[10] = ''
  FKEY_SEL = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  IF ((INTDCPFAULT < 301)) THEN
  WRITE('INCORRECT ERROR CODE', CR)
  FORCE_SPMENU(1, 37, 1)
  ABORT
  ENDIF
  IF ((INTTOOLID = 2)) THEN
  DCPTEXT_f00 = DCPTEXT_f00 + 330
  INTDCPFAULT = INTDCPFAULT + 330
  ENDIF
  IF ((INTTOOLID = 3)) THEN
  DCPTEXT_f00 = DCPTEXT_f00 + 660
  INTDCPFAULT = INTDCPFAULT + 660
  ENDIF
  IF ((INTDCPFAULT >= 501) AND (INTDCPFAULT <= 890)) THEN
  sv_i = G_DCP_SPR1_1(0)
  -- stmt141 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 891) AND (INTDCPFAULT <= 1220)) THEN
  sv_i = G_DCP_SPR1_2(0)
  -- stmt145 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 1221) AND (INTDCPFAULT <= 1550)) THEN
  sv_i = G_DCP_SPR1_3(0)
  -- stmt149 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 2211) AND (INTDCPFAULT <= 2540)) THEN
  sv_i = G_DCP_SPR2_1(0)
  -- stmt154 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 2541) AND (INTDCPFAULT <= 2870)) THEN
  sv_i = G_DCP_SPR2_2(0)
  -- stmt158 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 2871) AND (INTDCPFAULT <= 3200)) THEN
  sv_i = G_DCP_SPR2_3(0)
  -- stmt162 stray sv_i
  ENDIF
  IF ((INTDCPFAULT > 3200)) THEN
  WRITE('INCORRECT ERROR CODE', CR)
  FORCE_SPMENU(1, 37, 1)
  ABORT
  ENDIF
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  IF ((FKEY_SEL = 1)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[4] = 'FEED-NEW'
  ENDIF
  IF ((FKEY_SEL = 2)) THEN
  FKEYS[2] = 'RIVET'
  FKEYS[3] = 'SKIP'
  ENDIF
  IF ((FKEY_SEL = 3)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[5] = 'RETRY'
  ENDIF
  IF ((FKEY_SEL = 4)) THEN
  FKEYS[5] = 'RETRY'
  ENDIF
  BLPLC = 0
  BLSPR = 1
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, DCPTEXT_f00, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  IF ((DCPTEXT_f00 > 0) AND (DCPTEXT_f00 < 10)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 5, 1)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0000' + DCPFAULTNUM1
  ENDIF
  IF ((DCPTEXT_f00 > 9) AND (DCPTEXT_f00 < 100)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 4, 2)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '000' + DCPFAULTNUM1
  ENDIF
  IF ((DCPTEXT_f00 > 99) AND (DCPTEXT_f00 < 1000)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 3, 3)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '00' + DCPFAULTNUM1
  ENDIF
  IF ((DCPTEXT_f00 > 999) AND (DCPTEXT_f00 < 10000)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 2, 4)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0' + DCPFAULTNUM1
  ENDIF
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  DCPTEXT_fb4 = 'Henrob Controller ' + HENCONTID + ', Tool Number ' + HENTOOLID
  IF ((INTDCPFAULT >= 561) AND (INTDCPFAULT <= 815) OR (INTDCPFAULT >= 2211) AND (INTDCPFAULT <= 2465)) THEN
  IF ((INTCONTID = 1)) THEN
  GET_REG(89, (0 <> 0), INTHENERROR, REALDUMMY, STATUS)
  -- 弃参原式: 0
  INTHENERROR = INTHENERROR - 560
  ENDIF
  IF ((INTCONTID = 2)) THEN
  GET_REG(89, (0 <> 0), INTHENERROR, REALDUMMY, STATUS)
  -- 弃参原式: 0
  INTHENERROR = INTHENERROR - 2210
  ENDIF
  ELSE
  IF ((INTCONTID = 1)) THEN
  GET_PORT_VAL(18, 90, INTHENERROR, STATUS)
  ENDIF
  IF ((INTCONTID = 2)) THEN
  GET_PORT_VAL(18, 91, INTHENERROR, STATUS)
  ENDIF
  ENDIF
  CNV_INT_STR(INTHENERROR, 3, 0, STRHENERROR)
  IF ((INTHENERROR > 0)) THEN
  DCPTEXT_f88 = 'Henrob Error Code = ' + STRHENERROR
  ELSE
  DCPTEXT_f88 = ''
  ENDIF
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt11 stray sv_i
  SET_INT_REG(89, 0, STATUS)
  RETURN(0)
END POSTSTAT

BEGIN
END DCP_SPR
