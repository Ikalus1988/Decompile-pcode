-- SETRIVETDATA.KL (decompiled v3)
PROGRAM SETRIVETDATA
%COMMENT = 'Version 1.6'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  PARAMTYP : INTEGER
  PARAMINT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  INTSCHEDULE : INTEGER
  RIVDAT : INTEGER
  INTOPEN : INTEGER
  INTRIVSETOK : INTEGER
  ARRRIVID : ARRAY[64] OF INTEGER
  INTRIVCOUNT : INTEGER
  RIVDAT_f1e : INTEGER
  RIVDAT_f22 : INTEGER
  RIVDAT_f26 : INTEGER
  RIVDAT_f2a : INTEGER
  RIVDAT_f2e : INTEGER
  RIVDAT_f32 : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE INITRIVDATA(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE GETRIVDATA(p0 : INTEGER) : INTEGER FROM MI_LIB

BEGIN
  sv_s = chr(128)
  WRITE(sv_s)
  GET_TPE_PRM(1, PARAMTYP, PARAMINT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP = 1) AND (STATUS = 0)) THEN
  INTSCHEDULE = PARAMINT
  ELSE
  FORCE_SPMENU(1, 37, 1)
  WRITE('Invalid Argument Type for parameter 1:', CR, 'Schedule Number must be Integer.', CR)
  sv_i = POSTSTAT(STATUS)
  -- stmt79 stray sv_i
  ENDIF
  IF ((INTSCHEDULE < 1) OR (INTSCHEDULE > 255)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Invalid Schedule Number:', CR, 'Must be between 1 and ', 255, '.', CR)
  ABORT
  ENDIF
  sv_i = GETRIVDATA(INTSCHEDULE)
  -- stmt92 stray sv_i | RIVDAT
  SET_INT_REG(80, RIVDAT_f22, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt98 stray sv_i
  SET_INT_REG(81, RIVDAT_f26, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt101 stray sv_i
  SET_INT_REG(82, RIVDAT_f2a, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt104 stray sv_i
  SET_INT_REG(83, RIVDAT_f2e, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt107 stray sv_i
  IF ((RIVDAT_f32 >= 1) AND (RIVDAT_f32 <= 7)) THEN
  INTOPEN = 20 * RIVDAT_f32
  ENDIF
  IF ((RIVDAT_f32 = 8)) THEN
  INTOPEN = 0
  ENDIF
  IF ((RIVDAT_f32 > 8) OR (RIVDAT_f32 < 1)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Invalid Index for Post Move Open!', CR)
  WRITE('Index: ', RIVDAT_f32, CR)
  ABORT
  ENDIF
  SET_INT_REG(84, INTOPEN, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt124 stray sv_i
  SET_INT_REG(94, INTOPEN, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt126 stray sv_i
  SET_INT_REG(86, RIVDAT_f1e, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt129 stray sv_i
  INTRIVSETOK = (0 - 1)
  FOR INTSCHEDULE = 1 TO 3 DO
  IF (NOT (UNINIT(ARRRIVID[INTSCHEDULE]))) THEN
  IF ((ARRRIVID[INTSCHEDULE] = RIVDAT_f1e)) THEN
  INTRIVSETOK = 0
  ENDIF
  ENDIF
  ENDFOR
  IF (UNINIT(INTRIVCOUNT)) THEN
  INTRIVCOUNT = 1
  ELSE
  INTRIVCOUNT = INTRIVCOUNT + 1
  ENDIF
  IF ((INTRIVSETOK = (0 - 1))) THEN
  ARRRIVID[INTRIVCOUNT] = RIVDAT_f1e
  INTRIVSETOK = 1
  ENDIF
  SET_INT_REG(85, INTRIVSETOK, STATUS)
  sv_i = POSTSTAT(STATUS)
  -- stmt162 stray sv_i
END SETRIVETDATA

