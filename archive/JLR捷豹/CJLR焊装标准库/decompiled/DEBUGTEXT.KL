ROUTINE DEBUGTXT_VER : INTEGER
BEGIN
  GET_VAR(ENTRY, '*SYSTEM*', '$FAST_CLOCK', CLOCKREAD, STATUS)
  IF ((io_23[10] = 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  LASTTIME = CLOCKREAD
  ELSE
  IF (UNINIT(LASTTIME)) THEN
  LASTTIME = CLOCKREAD
  ENDIF
  DIFFTIME = CLOCKREAD - LASTTIME
  IF ((DIFFTIME > 600000)) THEN
  io_23[10] = 0
  ENDIF
  ENDIF
  GET_TPE_PRM(1, PARAMTYP, INTDEBUGTEXT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to Debug Text Program on Robot!', CR, 'Check argument 1 is an integer!')
  ENDIF
  GET_PORT_VAL(18, 1, INTPROGNUM, STATUS)
  GET_PORT_VAL(18, 1, INTCOLLNUM, STATUS)
  GET_PORT_VAL(18, 1, INTTYPENUM, STATUS)
  CNV_INT_STR(INTPROGNUM, 3, 3, STRPROGNUM)
  GET_REG(151, (0 <> 0), INTAREAINREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAINREQ, 3, 3, STRAREAINREQ)
  GET_REG(152, (0 <> 0), INTAREAOUTRL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAOUTRL, 3, 3, STRAREAOUTRL)
  GET_REG(153, (0 <> 0), INTTOOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLREQ, 3, 3, STRTOOLREQ)
  GET_REG(154, (0 <> 0), INTJOBDONE, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTJOBDONE, 3, 3, STRJOBDONE)
  GET_REG(156, (0 <> 0), INTCOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREQ, 3, 3, STRCOLREQ)
  GET_REG(157, (0 <> 0), INTCOLREL, REALDUMMY, STATUS)
  -- 弃参原式: 0
