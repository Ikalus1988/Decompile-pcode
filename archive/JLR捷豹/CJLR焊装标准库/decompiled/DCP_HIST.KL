-- DCP_HIST.KL (decompiled v3)
PROGRAM DCP_HIST
%COMMENT = 'decompiled v3'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  SCHEDULE_IDX : INTEGER
  DCPTEXTHIST : ARRAY[64] OF ALMDCP
  DCPTIMEHIST : ARRAY[64] OF STRING[64]
  ENTRY : INTEGER
  PREV_MENU : INTEGER
  STATUS : INTEGER
  PREV_SCREEN : INTEGER
  COUNT : INTEGER
  STRSCHEDULE : STRING[64]
  VALUE_ARRAY : ARRAY[64] OF STRING[64]
  TREE : ARRAY[64] OF INTEGER
  TERM_MASK : INTEGER
  DEF_ITEM : INTEGER
  INACT_ARRAY : ARRAY[64] OF BOOLEAN
  CHANGE_ARRAY : ARRAY[64] OF BOOLEAN
  TERM_CHAR : INTEGER
  DCPTEXT : REAL
  FKEYS : ARRAY[10] OF STRING[12]
  FKEY_SEL : INTEGER
  BLPLC : BOOLEAN
  BLSPR : BOOLEAN
  BLSPOT : BOOLEAN
  BLDISPENSE : BOOLEAN
  BLMH : BOOLEAN
  BLSTUD : BOOLEAN
  BLNUT : BOOLEAN
  BLISRA : BOOLEAN
  BLQUISS : BOOLEAN
  BOXID : INTEGER
  BLDONE : BOOLEAN
  INTFAULTNUM : INTEGER
  DUMMYREAL : REAL
  DCPREG : INTEGER
  DCPTEXTHIST_f00 : ARRAY[64] OF INTEGER
  DCPTEXTHIST_f04 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f30 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f5c : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f88 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_fb4 : ARRAY[64] OF STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


BEGIN
  SCHEDULE_IDX = 1
  FOR SCHEDULE_IDX = 1 TO 3 DO
  IF (UNINIT(DCPTEXTHIST_f00[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f00[SCHEDULE_IDX] = 0
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f04[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f04[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f30[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f30[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f5c[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f5c[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f88[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f88[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_fb4[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_fb4[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTIMEHIST[SCHEDULE_IDX])) THEN
  DCPTIMEHIST[SCHEDULE_IDX] = ''
  ENDIF
  ENDFOR
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SP_ID', PREV_MENU, STATUS)
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SCRN_ID', PREV_SCREEN, STATUS)
  COUNT = 0
  FOR SCHEDULE_IDX = 1 TO 3 DO
  CNV_INT_STR(SCHEDULE_IDX, 3, 10, STRSCHEDULE)
  VALUE_ARRAY[COUNT + 1] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPFaultNum'
  VALUE_ARRAY[COUNT + 2] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPLine1'
  VALUE_ARRAY[COUNT + 3] = 'tree[' + STRSCHEDULE + ']'
  VALUE_ARRAY[COUNT + 4] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPLine2'
  VALUE_ARRAY[COUNT + 5] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPLine3'
  VALUE_ARRAY[COUNT + 6] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPLine4'
  VALUE_ARRAY[COUNT + 7] = '[DCP_Form]DCPTextHist[' + STRSCHEDULE + '].DCPLine5'
  VALUE_ARRAY[COUNT + 8] = '[DCP_Form]DCPTimeHist[' + STRSCHEDULE + ']'
  TREE[SCHEDULE_IDX] = 0
  TERM_MASK = 2
  COUNT = COUNT + 8
  ENDFOR
  DEF_ITEM = 1
  DELAY 250
  FORCE_SPMENU(1, 190, 1)
  DISCTRL_FORM('HIST', 0, VALUE_ARRAY, INACT_ARRAY, CHANGE_ARRAY, TERM_MASK, DEF_ITEM, TERM_CHAR, STATUS)
  POST_ERR(STATUS, '', 0, 0)
END DCP_HIST

