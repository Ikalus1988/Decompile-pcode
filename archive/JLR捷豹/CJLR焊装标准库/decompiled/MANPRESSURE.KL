-- MANPRESSURE.KL (decompiled v3)
PROGRAM MANPRESSURE
%COMMENT = 'Version 1.2'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	REVISION = STRUCTURE
	MAJOR: INTEGER
	MINOR: INTEGER
	ENDSTRUCTURE
VAR
  MANPRESVER : INTEGER
  DCPINFO : REVISION
  STATUS : INTEGER
  BLKEYPRESSED : INTEGER
  BOSCHPRES : INTEGER
  STRTPFUNC : ARRAY[64] OF STRING[64]
  PARAMTYP : INTEGER
  PARAMNO : INTEGER
  PARAMINT : INTEGER
  PARAMREAL : REAL
  REALDUMMY : REAL
  DCPINFO_f56 : INTEGER
  DCPINFO_f5a : INTEGER
  DCPINFO_f5e : INTEGER
  DCPINFO_f62 : INTEGER
  DCPINFO_f66 : INTEGER
  MANPRESVER_f00 : INTEGER
  MANPRESVER_f04 : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE MANPRES_VER : INTEGER
BEGIN
  MANPRESVER_f00 = 1
  MANPRESVER_f04 = 0
  -- stmt46 stray MANPRESVER
  RETURN(0)
END MANPRES_VER

ROUTINE F1PRESSED : INTEGER
BEGIN
  IF ((DCPINFO_f56 <> 0)) THEN
  SET_INT_REG(56, 1, STATUS)
  BLKEYPRESSED = 1
  ENDIF
  RETURN(0)
END F1PRESSED

ROUTINE F2PRESSED : INTEGER
BEGIN
  IF ((DCPINFO_f5a <> 0)) THEN
  SET_INT_REG(56, 2, STATUS)
  BLKEYPRESSED = 1
  ENDIF
  RETURN(0)
END F2PRESSED

ROUTINE F3PRESSED : INTEGER
BEGIN
  IF ((DCPINFO_f5e <> 0)) THEN
  SET_INT_REG(56, 3, STATUS)
  BLKEYPRESSED = 1
  ENDIF
  RETURN(0)
END F3PRESSED

ROUTINE F4PRESSED : INTEGER
BEGIN
  IF ((DCPINFO_f62 <> 0)) THEN
  SET_INT_REG(56, 4, STATUS)
  BLKEYPRESSED = 1
  ENDIF
  RETURN(0)
END F4PRESSED

ROUTINE F5PRESSED : INTEGER
BEGIN
  IF ((DCPINFO_f66 <> 0)) THEN
  SET_INT_REG(56, 5, STATUS)
  BLKEYPRESSED = 1
  ENDIF
  GET_PORT_VAL(18, 32, BOSCHPRES, STATUS)
  BOSCHPRES = BOSCHPRES * 40
  DCPINFO_f56 = 1
  DCPINFO_f5a = 1
  DCPINFO_f5e = 0
  DCPINFO_f62 = 0
  DCPINFO_f66 = 0
  WRITE('        Manual Pressure Check  ', CR, CR)
  WRITE('Bosch Requested Pressure = ', BOSCHPRES, ' Newtons', CR)
  WRITE('Robot Detected Pressure = ', ' Newtons', CR)
  FORCE_SPMENU(1, 37, 1)
  IF ((DCPINFO_f56 <> 0)) THEN
  STRTPFUNC[1] = '  YES   '
  ELSE
  STRTPFUNC[1] = '        '
  ENDIF
  IF ((DCPINFO_f5a <> 0)) THEN
  STRTPFUNC[2] = '  No    '
  ELSE
  STRTPFUNC[2] = '        '
  ENDIF
  IF ((DCPINFO_f5e <> 0)) THEN
  STRTPFUNC[3] = 'SKIP    '
  ELSE
  STRTPFUNC[3] = '        '
  ENDIF
  IF ((DCPINFO_f62 <> 0)) THEN
  STRTPFUNC[4] = 'F4      '
  ELSE
  STRTPFUNC[4] = '        '
  ENDIF
  IF ((DCPINFO_f66 <> 0)) THEN
  STRTPFUNC[5] = 'F5      '
  ELSE
  STRTPFUNC[5] = '        '
  ENDIF
  WRITE(STRTPFUNC[5] + '', CR)
  -- stmt169 stray STRTPFUNC[1] | STRTPFUNC[2] + '' | STRTPFUNC[3] + '' | STRTPFUNC[4] + ''
  BLKEYPRESSED = 0
  PURGE CONDITION[1]
  -- stmt177 stray 1 | 129 | 137 | 131 | 138 | 132 | 139 | 133 | 141 | 134 | 142
  ENABLE CONDITION[1]
  sv_s = chr(128)
  WRITE(sv_s)
  sv_s = chr(128)
  WRITE(sv_s)
  WRITE('Do you want to repeat??')
  REPEAT
  DELAY 100
  UNTIL((BLKEYPRESSED <> 0))
  WRITE('')
  sv_s = chr(128)
  WRITE(sv_s)
  RETURN(0)
END F5PRESSED

BEGIN
END MANPRESSURE
