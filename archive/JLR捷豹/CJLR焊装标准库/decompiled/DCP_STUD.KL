-- DCP_STUD.KL (decompiled v3)
PROGRAM DCP_STUD
%COMMENT = 'Version 1.2'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  DCPTEXT : ALMDCP
  PARAMINT : INTEGER
  STRADDDCPTXT : STRING[64]
  INTPROGNUM : INTEGER
  STRPROGNUM : STRING[64]
  INTAREAINREQ : INTEGER
  REALDUMMY : REAL
  STRAREAINREQ : STRING[64]
  INTAREAOUTRL : INTEGER
  STRAREAOUTRL : STRING[64]
  INTTOOLREQ : INTEGER
  STRTOOLREQ : STRING[64]
  INTJOBDONE : INTEGER
  STRJOBDONE : STRING[64]
  INTCOLREQ : INTEGER
  STRCOLREQ : STRING[64]
  INTCOLREL : INTEGER
  STRCOLREL : STRING[64]
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  INTTOOLID : INTEGER
  TOOLID : STRING[64]
  FKEY_SEL : INTEGER
  FKEYS : ARRAY[64] OF STRING[64]
  DCPPLCTEXT : STRING[64]
  DCPFAULTNUM1 : STRING[64]
  DCPFAULTNUM : STRING[64]
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  PARAMNO : INTEGER
  REQTHICKNESS : INTEGER
  ACTTHICKNESS : INTEGER
  REALACTTHK : REAL
  REALREQTHK : REAL
  STRAREANUM : STRING[3]
  STRDCPTEXT : STRING[82]
  STRDCPTEXT2 : STRING[82]
  STRHIS1 : STRING[82]
  STRHIS2 : STRING[82]
  STRHIS3 : STRING[82]
  STR11 : STRING[82]
  STR12 : STRING[82]
  STR13 : STRING[82]
  ACTTHKSTR : STRING[20]
  STRREQTHK : STRING[20]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  FORCE_SPMENU(1, 37, 1)
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault Program on Robot!', CR, 'Check argument 1 is an integer!')
  DCPTEXT_f04 = 'Invalid Call to DCPFault Program on Robot'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, STRADDDCPTXT, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  IF (UNINIT(STRADDDCPTXT)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  GET_PORT_VAL(18, 1, INTPROGNUM, STATUS)
  CNV_INT_STR(INTPROGNUM, 3, 10, STRPROGNUM)
  GET_REG(151, (0 <> 0), INTAREAINREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAINREQ, 3, 10, STRAREAINREQ)
  GET_REG(152, (0 <> 0), INTAREAOUTRL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAOUTRL, 3, 10, STRAREAOUTRL)
  GET_REG(153, (0 <> 0), INTTOOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLREQ, 3, 10, STRTOOLREQ)
  GET_REG(154, (0 <> 0), INTJOBDONE, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTJOBDONE, 3, 10, STRJOBDONE)
  GET_REG(156, (0 <> 0), INTCOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREQ, 3, 10, STRCOLREQ)
  GET_REG(157, (0 <> 0), INTCOLREL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREL, 3, 10, STRCOLREL)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'Unit'
  ENDIF
  GET_REG(81, (0 <> 0), INTTOOLID, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  FKEYS[1] = ''
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  FKEYS[6] = ''
  FKEYS[7] = ''
  FKEYS[8] = ''
  FKEYS[9] = ''
  FKEYS[10] = ''
  FKEY_SEL = 0
  DCPTEXT_f00 = INTDCPFAULT
  SELECT DCPTEXT_f00 OF
  CASE(8501):
  DCPTEXT_f04 = 'Stud controllerID out of range'
  DCPTEXT_f00 = 8501
  CASE(8502):
  DCPTEXT_f04 = 'Stud toolID out of range'
  DCPTEXT_f00 = 8502
  CASE(4353):
  DCPTEXT_f04 = 'Weld ready not ON'
  DCPTEXT_f00 = 4353
  CASE(4354):
  DCPTEXT_f04 = 'Weld ready not OFF'
  DCPTEXT_f00 = 4354
  CASE(8500):
  DCPTEXT_f04 = 'In tolerance not OFF'
  DCPTEXT_f00 = 8500
  CASE(8503):
  DCPTEXT_f04 = 'Stud program number out of range'
  DCPTEXT_f00 = 8503
  CASE(8511):
  DCPTEXT_f04 = 'No fault not ON'
  DCPTEXT_f00 = 8511
  CASE(8515):
  DCPTEXT_f04 = 'Head back not ON'
  DCPTEXT_f00 = 8515
  CASE(8504):
  DCPTEXT_f04 = 'Weld in progress not OFF'
  DCPTEXT_f00 = 8504
  CASE(8518):
  DCPTEXT_f04 = 'Weld complete not OFF'
  DCPTEXT_f00 = 8518
  CASE(8516):
  DCPTEXT_f04 = 'Stud repeat error'
  DCPTEXT_f00 = 8506
  FKEY_SEL = 1
  CASE(8507):
  DCPTEXT_f04 = 'Stud number not cleared'
  DCPTEXT_f00 = 8507
  CASE(8523):
  DCPTEXT_f04 = 'Stud out of tolerance'
  DCPTEXT_f00 = 8523
  CASE(8512):
  DCPTEXT_f04 = 'Welding head fault'
  DCPTEXT_f00 = 8512
  CASE(8510):
  DCPTEXT_f04 = 'Unknown head condition'
  DCPTEXT_f00 = 8510
  CASE(8511):
  DCPTEXT_f04 = 'Weld in progress not ON'
  DCPTEXT_f00 = 8511
  ELSE:
  DCPTEXT_f04 = 'Undefined DCP Fault Message'
  ENDSELECT
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, INTDCPFAULT, STATUS)
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 2, 4)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0' + DCPFAULTNUM1
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  DCPTEXT_f5c = 'Check Tucker Controller for Errors....'
  SET_STR_REG(11, DCPTEXT_f5c, STATUS)
  BLPLC = 0
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 1
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  IF ((FKEY_SEL = 1)) THEN
  FKEYS[1] = ''
  FKEYS[3] = 'STUD'
  FKEYS[4] = 'SKIP'
  ENDIF
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt250 stray sv_i
  RETURN(0)
END POSTSTAT

BEGIN
END DCP_STUD
