  WRITE('DCP Fault: ', INTDCPFAULT, CR, DCPTEXT_f04, CR, DCPTEXT_f30, CR)
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, INTDCPFAULT, STATUS)
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 3, 3)
  DCPFAULTNUM = sv_s
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  IF ((INTDCPFAULT = 111) OR (INTDCPFAULT = 211)) THEN
  DCPTEXT_f88 = 'Requested Thickness = ' + STRREQTHK
  DCPTEXT_fb4 = 'Actual Thickness = ' + ACTTHKSTR
  SET_STR_REG(11, 'Requested Thickness = ' + STRREQTHK, STATUS)
  SET_STR_REG(12, 'Actual Thickness = ' + ACTTHKSTR, STATUS)
  ENDIF
  IF ((INTDCPFAULT = 108)) THEN
  DCPTEXT_f88 = 'Press Retry to Redo Tip Dressing'
  DCPTEXT_fb4 = 'Press ACK to Redo Short Circuit'
  SET_STR_REG(11, 'Press Retry to Redo Tip Dressing', STATUS)
  SET_STR_REG(12, 'Press Reset to Redo Short Circuit', STATUS)
  ENDIF
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  ENDIF
  IF ((FKEY_SEL = 1)) THEN
  FKEYS[1] = ''
  FKEYS[2] = 'SKIP'
  FKEYS[3] = 'RETRY'
  FKEYS[4] = ''
  ENDIF
  IF ((FKEY_SEL = 2)) THEN
  FKEYS[1] = ''
  FKEYS[2] = 'IGNORE'
  FKEYS[3] = 'RETRY'
  FKEYS[4] = 'SKIP'
  ENDIF
  IF ((FKEY_SEL = 3)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[2] = ''
  FKEYS[3] = 'RETRY'
  FKEYS[4] = ''
  ENDIF
  BLPLC = 0
  BLSPR = 0
  BLSPOT = 1
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt18 stray sv_i
  RETURN(0)
END POSTSTAT

BEGIN
END DCP_SPOT
