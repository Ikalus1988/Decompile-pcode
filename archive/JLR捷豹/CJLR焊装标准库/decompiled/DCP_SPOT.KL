  DCPTEXT_f30 = 'Old Gun' + STRWDRBTOLD + '   New Gun' + STRWDRBTNEW
  DCPTEXT_f5c = 'Old Rbt' + STRWDGUNOLD + '   New Rbt' + STRWDGUNNEW
  DCPTEXT_f88 = 'Rbt Diff=' + STRWDRBTDIFF + '   Gun Diff' + STRWDGUNDIFF
