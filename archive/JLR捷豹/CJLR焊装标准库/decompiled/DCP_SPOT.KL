-- DCP_SPOT.KL (decompiled v3)
PROGRAM DCP_SPOT
%COMMENT = 'Version 1.3'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  DCPTEXT : ALMDCP
  PARAMINT : INTEGER
  STRADDDCPTXT : STRING[64]
  OLDWEARRBT : REAL
  OLDWEARGUN : REAL
  NEWWEARRBT : REAL
  NEWWEARGUN : REAL
  RBTDIFF : REAL
  GUNDIFF : REAL
  STRWDRBTOLD : STRING[64]
  STRWDRBTNEW : STRING[64]
  STRWDGUNOLD : STRING[64]
  STRWDGUNNEW : STRING[64]
  STRWDRBTDIFF : STRING[64]
  STRWDGUNDIFF : STRING[64]
  INTPROGNUM : INTEGER
  STRPROGNUM : STRING[64]
  INTAREAINREQ : INTEGER
  REALDUMMY : REAL
  STRAREAINREQ : STRING[64]
  INTAREAOUTRL : INTEGER
  STRAREAOUTRL : STRING[64]
  INTTOOLREQ : INTEGER
  STRTOOLREQ : STRING[64]
  INTJOBDONE : INTEGER
  STRJOBDONE : STRING[64]
  INTCOLREQ : INTEGER
  STRCOLREQ : STRING[64]
  INTCOLREL : INTEGER
  STRCOLREL : STRING[64]
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  INTTOOLID : INTEGER
  TOOLID : STRING[64]
  REALACTTHK : REAL
  ACTTHKSTR : STRING[64]
  REQTHICKNESS : INTEGER
  REALREQTHK : REAL
  STRREQTHK : STRING[64]
  FKEY_SEL : INTEGER
  DCPPLCTEXT : STRING[64]
  DCPFAULTNUM1 : STRING[64]
  DCPFAULTNUM : STRING[64]
  FKEYS : ARRAY[64] OF STRING[64]
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  PARAMNO : INTEGER
  ACTTHICKNESS : INTEGER
  STRAREANUM : STRING[3]
  STRDCPTEXT : STRING[82]
  STRDCPTEXT2 : STRING[82]
  STRHIS1 : STRING[82]
  STRHIS2 : STRING[82]
  STRHIS3 : STRING[82]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  FORCE_SPMENU(1, 37, 1)
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault Program on Robot!', CR, 'Check argument 1 is an integer!')
  DCPTEXT_f04 = 'Invalid Call to DCPFault Program on Robot'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, STRADDDCPTXT, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  IF (UNINIT(STRADDDCPTXT)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  GET_REG(11, (0 <> 0), PARAMINT, OLDWEARRBT, STATUS)
  -- 弃参原式: 0
  GET_REG(12, (0 <> 0), PARAMINT, OLDWEARGUN, STATUS)
  -- 弃参原式: 0
  GET_REG(13, (0 <> 0), PARAMINT, NEWWEARRBT, STATUS)
  -- 弃参原式: 0
  GET_REG(14, (0 <> 0), PARAMINT, NEWWEARGUN, STATUS)
  -- 弃参原式: 0
  GET_REG(15, (0 <> 0), PARAMINT, RBTDIFF, STATUS)
  -- 弃参原式: 0
  GET_REG(16, (0 <> 0), PARAMINT, GUNDIFF, STATUS)
  -- 弃参原式: 0
  CNV_REAL_STR(OLDWEARRBT, 5, 3, STRWDRBTOLD)
  CNV_REAL_STR(NEWWEARRBT, 5, 3, STRWDRBTNEW)
  CNV_REAL_STR(OLDWEARGUN, 5, 3, STRWDGUNOLD)
  CNV_REAL_STR(NEWWEARGUN, 5, 3, STRWDGUNNEW)
  CNV_REAL_STR(RBTDIFF, 5, 3, STRWDRBTDIFF)
  CNV_REAL_STR(GUNDIFF, 5, 3, STRWDGUNDIFF)
  GET_PORT_VAL(18, 1, INTPROGNUM, STATUS)
  CNV_INT_STR(INTPROGNUM, 3, 10, STRPROGNUM)
  GET_REG(151, (0 <> 0), INTAREAINREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAINREQ, 3, 10, STRAREAINREQ)
  GET_REG(152, (0 <> 0), INTAREAOUTRL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAOUTRL, 3, 10, STRAREAOUTRL)
  GET_REG(153, (0 <> 0), INTTOOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLREQ, 3, 10, STRTOOLREQ)
  GET_REG(154, (0 <> 0), INTJOBDONE, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTJOBDONE, 3, 10, STRJOBDONE)
  GET_REG(156, (0 <> 0), INTCOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREQ, 3, 10, STRCOLREQ)
  GET_REG(157, (0 <> 0), INTCOLREL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREL, 3, 10, STRCOLREL)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'Unit'
  ENDIF
  GET_REG(81, (0 <> 0), INTTOOLID, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  GET_VAR(ENTRY, '*SYSTEM*', '$SGTHKRPT1.$THK_OBSV', REALACTTHK, STATUS)
  CNV_REAL_STR(REALACTTHK, 7, 10, ACTTHKSTR)
  GET_REG(31, (1 <> 0), REQTHICKNESS, REALREQTHK, STATUS)
  -- 弃参原式: 1
  IF ((REALREQTHK > 0)) THEN
  CNV_REAL_STR(REALREQTHK, 1, 10, STRREQTHK)
  ELSE
  GET_REG(31, (0 <> 0), REQTHICKNESS, REALREQTHK, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(REQTHICKNESS, 3, 0, STRREQTHK)
  ENDIF
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  DCPTEXT_f00 = INTDCPFAULT
  SELECT DCPTEXT_f00 OF
  CASE(101):
  DCPTEXT_f04 = 'Spot type ID invalid'
  DCPTEXT_f00 = 101
  CASE(102):
  DCPTEXT_f04 = 'Spot spot ID invalid'
  DCPTEXT_f00 = 102
  CASE(103):
  DCPTEXT_f04 = 'Spot plate tolerance invalid'
  DCPTEXT_f00 = 103
  FKEY_SEL = 1
  CASE(104):
