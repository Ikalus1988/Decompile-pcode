  DCPTEXT_f00 = 104
  CASE(105):
  DCPTEXT_f04 = 'Tip dresser number invalid'
  DCPTEXT_f00 = 105
  CASE(106):
  DCPTEXT_f04 = 'Spot selection not acknowledge by weld timer'
  DCPTEXT_f00 = 106
  CASE(107):
  DCPTEXT_f04 = 'Spot selection not in weld timer spot table'
  DCPTEXT_f00 = 107
  CASE(108):
  DCPTEXT_f04 = 'Short curcuit weld fault'
  DCPTEXT_f00 = 108
  FKEY_SEL = 3
  CASE(109):
  DCPTEXT_f04 = 'Spotware Process fault'
  DCPTEXT_f00 = 109
  CASE(110):
  DCPTEXT_f04 = 'Weld Complete-Timeout Fault'
  DCPTEXT_f00 = 110
  FKEY_SEL = 1
  CASE(111):
  DCPTEXT_f04 = 'Plate Thickness Error'
  DCPTEXT_f00 = 111
  FKEY_SEL = 2
  CASE(112):
  DCPTEXT_f04 = 'Bosch Not Ready'
  DCPTEXT_f00 = 112
  CASE(113):
  DCPTEXT_f04 = ''
