-- DCPFAULT.KL (decompiled v3)
PROGRAM DCPFAULT
%COMMENT = 'Version 1.4'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  STRDCPTEXT : STRING[64]
  PARAMINT : INTEGER
  STRADDDCPTXT : STRING[64]
  INTPROGNUM : INTEGER
  STRPROGNUM : STRING[64]
  INTAREAINREQ : INTEGER
  REALDUMMY : REAL
  STRAREAINREQ : STRING[64]
  INTAREAOUTRL : INTEGER
  STRAREAOUTRL : STRING[64]
  INTTOOLREQ : INTEGER
  STRTOOLREQ : STRING[64]
  INTJOBDONE : INTEGER
  STRJOBDONE : STRING[64]
  INTCOLREQ : INTEGER
  STRCOLREQ : STRING[64]
  INTCOLREL : INTEGER
  STRCOLREL : STRING[64]
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  INTTOOLID : INTEGER
  TOOLID : STRING[64]
  USERDEFINED : STRING[64]
  DCPTEXT : ALMDCP
  FKEY_SEL : INTEGER
  DCPPLCTEXT : STRING[64]
  STRDCPNUM : STRING[64]
  FKEYS : ARRAY[64] OF STRING[64]
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  PARAMNO : INTEGER
  STRAREANUM : STRING[3]
  STRDCPTEXT2 : STRING[82]
  STRHIS1 : STRING[82]
  STRHIS2 : STRING[82]
  STRHIS3 : STRING[82]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault Program on Robot!', CR, 'Check argument 1 is an integer!')
  STRDCPTEXT = 'Invalid Call to DCPFault Program on Robot'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, STRADDDCPTXT, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  IF (UNINIT(STRADDDCPTXT)) THEN
  STRADDDCPTXT = '_'
  ENDIF
  GET_PORT_VAL(18, 1, INTPROGNUM, STATUS)
  CNV_INT_STR(INTPROGNUM, 3, 10, STRPROGNUM)
  GET_REG(151, (0 <> 0), INTAREAINREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAINREQ, 3, 10, STRAREAINREQ)
  GET_REG(152, (0 <> 0), INTAREAOUTRL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTAREAOUTRL, 3, 10, STRAREAOUTRL)
  GET_REG(153, (0 <> 0), INTTOOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTTOOLREQ, 3, 10, STRTOOLREQ)
  GET_REG(154, (0 <> 0), INTJOBDONE, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTJOBDONE, 3, 10, STRJOBDONE)
  GET_REG(156, (0 <> 0), INTCOLREQ, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREQ, 3, 10, STRCOLREQ)
  GET_REG(157, (0 <> 0), INTCOLREL, REALDUMMY, STATUS)
  -- 弃参原式: 0
  CNV_INT_STR(INTCOLREL, 3, 10, STRCOLREL)
  CNV_INT_STR(PARAMINT, 3, 10, PARAMSTRING)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'Unit'
  ENDIF
  GET_PORT_VAL(19, 3, INTTOOLID, STATUS)
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  IF ((INTDCPFAULT = 5)) THEN
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, USERDEFINED, STATUS)
  ELSE
  USERDEFINED = ''
  ENDIF
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  DCPTEXT_f00 = INTDCPFAULT
  SELECT DCPTEXT_f00 OF
  CASE(0):
  CASE(1):
  DCPTEXT_f04 = 'Program Number' + STRPROGNUM + ' is not in RSR0001'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 1
  CASE(2):
  DCPTEXT_f04 = 'Area in Request Number ' + STRAREAINREQ
  DCPTEXT_f30 = 'invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 2
  CASE(3):
  DCPTEXT_f04 = 'Area out Release Number ' + STRAREAOUTRL
  DCPTEXT_f30 = ' invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 3
  CASE(4):
  DCPTEXT_f04 = 'PED Back Task still active for gun '
  DCPTEXT_f30 = ' NOT IMPLEMENTED!!'
  DCPTEXT_f00 = 4
  CASE(5):
  DCPTEXT_f04 = 'User Defined DCP Message:- '
  DCPTEXT_f30 = USERDEFINED
  DCPTEXT_f00 = 5
  CASE(6):
  DCPTEXT_f04 = 'Collision Zone Release Number ' + STRCOLREL
  DCPTEXT_f30 = ' invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 6
  CASE(7):
  DCPTEXT_f04 = 'Collision Zone Release robot '
  DCPTEXT_f30 = 'output signal mismatch'
  DCPTEXT_f00 = 7
  CASE(8):
  DCPTEXT_f04 = 'Collision Zone Release PLC  '
  DCPTEXT_f30 = 'input signal mismatch'
  DCPTEXT_f00 = 8
  CASE(9):
  DCPTEXT_f04 = 'Collision Zone Request Number ' + STRCOLREQ
  DCPTEXT_f30 = ' invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 9
  CASE(10):
  DCPTEXT_f04 = 'Collision Zone Request robot '
  DCPTEXT_f30 = 'output signal mismatch'
  DCPTEXT_f00 = 10
  CASE(11):
  DCPTEXT_f04 = 'Collision Zone Request PLC '
  DCPTEXT_f30 = 'input signal mismatch'
  DCPTEXT_f00 = 11
  CASE(12):
  DCPTEXT_f04 = 'Job Done Number ' + STRJOBDONE
  DCPTEXT_f30 = 'invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 12
  CASE(13):
  DCPTEXT_f04 = 'Tool Request Number ' + STRTOOLREQ
  DCPTEXT_f30 = 'invalid. Value should be between 1 - 8'
  DCPTEXT_f00 = 13
  CASE(14):
  DCPTEXT_f04 = 'Robot Home Position World Zone not Configured'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 14
  CASE(15):
  DCPTEXT_f04 = 'Robot @ Home Position output not on'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 15
  CASE(16):
  DCPTEXT_f04 = 'Set Tool Number ' + ' is not Implemented!!'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 16
  CASE(17):
  DCPTEXT_f04 = 'Set Tool Number too big for GO???' + ' is not Implemented!!'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 17
  CASE(18):
  DCPTEXT_f04 = 'Robot World Zone not Configured' + ' is not Implemented!!'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 18
  CASE(19):
  DCPTEXT_f04 = 'Robot not at Service position' + ' is not Implemented!!'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 19
  CASE(20):
  DCPTEXT_f04 = 'Service Tool Number is out of range' + ' is not Implemented!!'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 20
  CASE(21):
  DCPTEXT_f04 = 'Last Collision Zone Request not Set'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 21
  CASE(22):
  DCPTEXT_f04 = 'Last Collision Zone Request Invalid'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 22
  CASE(23):
  DCPTEXT_f04 = 'Last Collision Zone Release not Set'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 23
  CASE(24):
  DCPTEXT_f04 = 'Last Collision Zone Release Invalid'
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 24
  CASE(25):
  DCPTEXT_f04 = '00025: '
  DCPTEXT_f30 = ''
  CASE(50):
  DCPTEXT_f04 = 'Ethernet Comms not Running Slot' + PARAMSTRING
  DCPTEXT_f30 = ''
  DCPTEXT_f00 = 50
  ELSE:
  DCPTEXT_f04 = 'Undefined DCP Fault Message'
  DCPTEXT_f04 = ''
  ENDSELECT
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, DCPTEXT_f00, STATUS)
  CNV_INT_STR(DCPTEXT_f00, 3, 10, STRDCPNUM)
  SET_STR_REG(9, STRDCPNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  SET_INT_REG(56, 0, STATUS)
  FKEYS[1] = ''
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  FKEYS[6] = ''
  FKEYS[7] = ''
  FKEYS[8] = ''
  FKEYS[9] = ''
  FKEYS[10] = ''
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  BLPLC = 1
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt58 stray sv_i
  RETURN(0)
END POSTSTAT

BEGIN
END DCPFAULT
