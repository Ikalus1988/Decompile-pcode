-- DCP_ISRA.KL (decompiled v3)
PROGRAM DCP_ISRA
%COMMENT = 'Version 1.0'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  DCPTEXT : ALMDCP
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  INTTOOLID : INTEGER
  REALDUMMY : REAL
  TOOLID : STRING[64]
  FKEY_SEL : INTEGER
  FKEYS : ARRAY[64] OF STRING[64]
  DCPPLCTEXT : STRING[64]
  DCPFAULTNUM1 : STRING[64]
  DCPFAULTNUM : STRING[64]
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  PARAMNO : INTEGER
  PARAMINT : INTEGER
  INTPROGNUM : INTEGER
  INTAREAINREQ : INTEGER
  INTAREAOUTRL : INTEGER
  INTTOOLREQ : INTEGER
  INTJOBDONE : INTEGER
  INTCOLREQ : INTEGER
  INTCOLREL : INTEGER
  REQTHICKNESS : INTEGER
  ACTTHICKNESS : INTEGER
  REALACTTHK : REAL
  REALREQTHK : REAL
  STRPROGNUM : STRING[3]
  STRAREANUM : STRING[3]
  STRAREAINREQ : STRING[3]
  STRAREAOUTRL : STRING[3]
  STRTOOLREQ : STRING[3]
  STRJOBDONE : STRING[3]
  STRCOLREQ : STRING[3]
  STRCOLREL : STRING[3]
  ACTTHKSTR : STRING[20]
  STRREQTHK : STRING[20]
  STRADDDCPTXT : STRING[20]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  FORCE_SPMENU(1, 37, 1)
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault Program on Robot!', CR, 'Check argument 1 is an integer!')
  DCPTEXT_f04 = 'Invalid Call to DCPFault Program on Robot'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'Unit'
  ENDIF
  GET_REG(81, (0 <> 0), INTTOOLID, REALDUMMY, STATUS)
  -- Æú²ÎÔ­Ê½: 0
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  FKEYS[1] = ''
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  FKEYS[6] = ''
  FKEYS[7] = ''
  FKEYS[8] = ''
  FKEYS[9] = ''
  FKEYS[10] = ''
  FKEY_SEL = 0
  DCPTEXT_f00 = INTDCPFAULT
  SELECT DCPTEXT_f00 OF
  CASE(8301):
  DCPTEXT_f04 = 'ISRA Type ID Out of Range (1-32)'
  DCPTEXT_f00 = 8301
  CASE(8302):
  DCPTEXT_f04 = 'ISRA No Comms or Data'
  DCPTEXT_f00 = 8302
  CASE(8303):
  DCPTEXT_f04 = 'ISRA Recognition Error'
  DCPTEXT_f00 = 8303
  CASE(8304):
  DCPTEXT_f04 = 'ISRA No Robot Comms'
  DCPTEXT_f00 = 8304
  CASE(8305):
  DCPTEXT_f04 = 'ISRA Wrong Type Selected'
  DCPTEXT_f00 = 8305
  CASE(8306):
  DCPTEXT_f04 = 'ISRA Tollerance or Calculation Error'
  DCPTEXT_f00 = 8306
  CASE(8307):
  DCPTEXT_f04 = 'ISRA Multiple Errors'
  DCPTEXT_f00 = 8307
  CASE(8308):
  DCPTEXT_f04 = 'ISRA Run-Mode Mis-match'
  DCPTEXT_f00 = 8308
  CASE(8309):
  DCPTEXT_f04 = 'ISRA Ready Not On'
  DCPTEXT_f00 = 8309
  CASE(8310):
  DCPTEXT_f04 = 'ISRA Load Prepare Not On'
  DCPTEXT_f00 = 8310
  CASE(8311):
  DCPTEXT_f04 = 'ISRA Start Ok Not On'
  DCPTEXT_f00 = 8311
  CASE(8312):
  DCPTEXT_f04 = 'ISRA Start Ok Not Off'
  DCPTEXT_f00 = 8312
  CASE(8313):
  DCPTEXT_f04 = 'ISRA Measurement In Progress Not Off'
  DCPTEXT_f00 = 8313
  CASE(8314):
  DCPTEXT_f04 = 'Zero Offset Supplied by ISRA System'
  DCPTEXT_f30 = 'Press Acknowledge to re-take Vision'
  DCPTEXT_f00 = 8314
  ELSE:
  DCPTEXT_f04 = 'Undefined DCP Fault Message'
  ENDSELECT
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, INTDCPFAULT, STATUS)
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 2, 4)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0' + DCPFAULTNUM1
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  DCPTEXT_f5c = 'Check ISRA PC For Errors'
  BLPLC = 0
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 1
  BLQUISS = 0
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt187 stray sv_i
  RETURN(0)
END POSTSTAT

BEGIN
END DCP_ISRA
