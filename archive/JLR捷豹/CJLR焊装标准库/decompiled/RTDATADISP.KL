-- RTDATADISP.KL (decompiled v3)
PROGRAM RTDATADISP
%COMMENT = 'Version 1.6'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  INTSCHEDULE : INTEGER
  ARRRIVETDATA : ARRAY[64] OF INTEGER
  STRSCHEDULE : STRING[64]
  DEF_ITEM : INTEGER
  TOP_ARRAY : ARRAY[64] OF STRING[64]
  INACT_ARRAY : ARRAY[64] OF BOOLEAN
  CHANGE_ARRAY : ARRAY[64] OF BOOLEAN
  TERM_CHAR : INTEGER
  STAT_DISCTRL : INTEGER
  BLDONE : INTEGER
  NEXTSCREEN : INTEGER
  DET_ARRAY : ARRAY[64] OF STRING[64]
  ENTRY : INTEGER
  PREV_MENU : INTEGER
  STATUS : INTEGER
  PREV_SCREEN : INTEGER
  ARRRIVETDATA_f00 : ARRAY[64] OF STRING[64]
  ARRRIVETDATA_f1e : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f22 : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f26 : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f2a : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f2e : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f32 : ARRAY[64] OF INTEGER
  r1_lc14_f00 : STRING[64]
  r1_lc14_f1e : INTEGER
  r1_lc14_f22 : INTEGER
  r1_lc14_f26 : INTEGER
  r1_lc14_f2a : INTEGER
  r1_lc14_f2e : INTEGER
  r1_lc14_f32 : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE INITRIVDATA : INTEGER
BEGIN
  FOR INTSCHEDULE = 1 TO 3 DO
  IF (UNINIT(ARRRIVETDATA_f00[INTSCHEDULE])) THEN
  CNV_INT_STR(INTSCHEDULE, 3, 10, STRSCHEDULE)
  ARRRIVETDATA_f00[INTSCHEDULE] = 'Schedule' + STRSCHEDULE
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f1e[INTSCHEDULE])) THEN
  ARRRIVETDATA_f1e[INTSCHEDULE] = 0
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f22[INTSCHEDULE])) THEN
  ARRRIVETDATA_f22[INTSCHEDULE] = 1
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f26[INTSCHEDULE])) THEN
  ARRRIVETDATA_f26[INTSCHEDULE] = 1
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f2a[INTSCHEDULE])) THEN
  ARRRIVETDATA_f2a[INTSCHEDULE] = 1
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f2e[INTSCHEDULE])) THEN
  ARRRIVETDATA_f2e[INTSCHEDULE] = 0
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f32[INTSCHEDULE])) THEN
  ARRRIVETDATA_f32[INTSCHEDULE] = 1
  ENDIF
  ENDFOR
  RETURN(0)
END INITRIVDATA

ROUTINE GETRIVDATA(p0 : INTEGER) : INTEGER
VAR
  r1_lc14 : INTEGER
BEGIN
  sv_s = chr(128)
  WRITE(sv_s)
  IF (UNINIT(ARRRIVETDATA_f00[p0])) THEN
  r1_lc14_f00 = ''
  ELSE
  r1_lc14_f00 = ARRRIVETDATA_f00[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f1e[p0])) THEN
  WRITE('Rivet ID in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it in DATA Screen', CR)
  sv_s = chr(128)
  WRITE(sv_s)
  sv_s = chr(128)
  WRITE(sv_s)
  WRITE('Rivet Schedule ', p0, ' contains no Data')
  ELSE
  r1_lc14_f1e = ARRRIVETDATA_f1e[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f22[p0])) THEN
  WRITE('Controller ID in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it IN DATA Screen', CR)
  ELSE
  r1_lc14_f22 = ARRRIVETDATA_f22[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f26[p0])) THEN
  WRITE('Tool ID in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it in DATA Screen', CR)
  ELSE
  r1_lc14_f26 = ARRRIVETDATA_f26[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f2a[p0])) THEN
  WRITE('Rivet Type in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it in DATA Screen', CR)
  ELSE
  r1_lc14_f2a = ARRRIVETDATA_f2a[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f2e[p0])) THEN
  WRITE('Post Move Offset in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it in DATA Screen', CR)
  ELSE
  r1_lc14_f2e = ARRRIVETDATA_f2e[p0]
  ENDIF
  IF (UNINIT(ARRRIVETDATA_f32[p0])) THEN
  WRITE('Post Move Open in Schedule[', p0, ']', CR, 'is not initialized.', CR, 'Please set it in DATA Screen', CR)
  ELSE
  r1_lc14_f32 = ARRRIVETDATA_f32[p0]
  ENDIF
  -- stmt152 stray r1_lc14
  RETURN(0)
END GETRIVDATA

ROUTINE GET_INDX(p0 : INTEGER) : INTEGER
VAR
  indx : INTEGER
BEGIN
  SELECT p0 OF
  CASE(1):
  indx = 2 * INTSCHEDULE - 1
  CASE(2):
  indx = DEF_ITEM + 1 DIV 2
  ELSE:
  indx = 1
  ENDSELECT
  RETURN(indx)
  RETURN(0)
END GET_INDX

ROUTINE DISPTOP : INTEGER
VAR
  schedule_idx : INTEGER
BEGIN
  FOR schedule_idx = 1 TO 3 DO
  CNV_INT_STR(schedule_idx, 3, 10, STRSCHEDULE)
  TOP_ARRAY[2 * schedule_idx - 1] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].RivetID'
  TOP_ARRAY[2 * schedule_idx] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].Comment'
  ENDFOR
  DISCTRL_FORM('SPRD', 0, TOP_ARRAY, INACT_ARRAY, CHANGE_ARRAY, 2, DEF_ITEM, TERM_CHAR, STAT_DISCTRL)
  sv_i = GET_INDX(2)
  INTSCHEDULE = sv_i
  SELECT TERM_CHAR OF
  CASE(129):
  BLDONE = 1
  CASE(131):
  IF ((STAT_DISCTRL = 0)) THEN
  NEXTSCREEN = 3
  DEF_ITEM = 1
  ELSE
  BLDONE = 1
  ENDIF
  CASE(0):
  BLDONE = 1
  ELSE:
  IF ((STAT_DISCTRL = 0)) THEN
  ELSE
  BLDONE = 1
  ENDIF
  ENDSELECT
  RETURN(0)
END DISPTOP

ROUTINE DISPDET : INTEGER
BEGIN
  CNV_INT_STR(INTSCHEDULE, 2, 10, STRSCHEDULE)
  DET_ARRAY[1] = 'intSchedule'
  DET_ARRAY[2] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].Comment'
  DET_ARRAY[3] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].RivetID'
  DET_ARRAY[4] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].ContID'
  DET_ARRAY[5] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].ToolID'
  DET_ARRAY[6] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].RivType'
  DET_ARRAY[7] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].PMOffset'
  DET_ARRAY[8] = '[RIVET]arrRivetData[' + STRSCHEDULE + '].PMOpen'
  DISCTRL_FORM('SPRD', 3, DET_ARRAY, INACT_ARRAY, CHANGE_ARRAY, 2 + 8192, DEF_ITEM, TERM_CHAR, STAT_DISCTRL)
  SELECT TERM_CHAR OF
  CASE(128):
  CASE(131):
  IF ((STAT_DISCTRL = 0)) THEN
  NEXTSCREEN = 0
  sv_i = GET_INDX(1)
  DEF_ITEM = sv_i
  ELSE
  BLDONE = 1
  ENDIF
  CASE(0):
  BLDONE = 1
  ELSE:
  IF ((STAT_DISCTRL = 0)) THEN
  ELSE
  BLDONE = 1
  ENDIF
  ENDSELECT
  RETURN(0)
END DISPDET

ROUTINE INIT_CHECK : INTEGER
BEGIN
  IF (UNINIT(STAT_DISCTRL)) THEN
  STAT_DISCTRL = 0
  ENDIF
  IF ((STAT_DISCTRL <> 0) OR UNINIT(NEXTSCREEN) OR UNINIT(DEF_ITEM)) THEN
  NEXTSCREEN = 0
  DEF_ITEM = 1
  ENDIF
  IF (NOT ((NEXTSCREEN = 0) OR (NEXTSCREEN = 3))) THEN
  NEXTSCREEN = 0
  ENDIF
  SELECT NEXTSCREEN OF
  CASE(0):
  sv_i = GET_INDX(2)
  INTSCHEDULE = sv_i
  IF (NOT ((INTSCHEDULE >= 1) AND (INTSCHEDULE <= 255))) THEN
  DEF_ITEM = 1
  ENDIF
  CASE(3):
  IF (NOT ((DEF_ITEM >= 1) AND (DEF_ITEM <= 8))) THEN
  DEF_ITEM = 1
  ELSE
  ENDIF
  ENDSELECT
  sv_i = INIT_CHECK
  -- stmt19 stray sv_i
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SP_ID', PREV_MENU, STATUS)
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SCRN_ID', PREV_SCREEN, STATUS)
  FORCE_SPMENU(1, 190, 1)
  BLDONE = 0
  SELECT NEXTSCREEN OF
  CASE(0):
  sv_i = DISPTOP
  CASE(3):
  sv_i = DISPDET
  ELSE:
  BLDONE = 1
  ENDSELECT
  IF ((BLDONE <> 0)) THEN
  IF ((TERM_CHAR <> 0)) THEN
  FORCE_SPMENU(1, PREV_MENU, PREV_SCREEN)
  ENDIF
  ENDIF
  RETURN(0)
END INIT_CHECK

BEGIN
END RTDATADISP
