-- ISRA_AV.KL (decompiled v3)
PROGRAM ISRA_AV
%COMMENT = 'Version 1.0'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  INTARRNUM : INTEGER
  ARRX : ARRAY[64] OF INTEGER
  ARRY : ARRAY[64] OF INTEGER
  ARRZ : ARRAY[64] OF INTEGER
  ARRW : ARRAY[64] OF INTEGER
  ARRP : ARRAY[64] OF INTEGER
  ARRR : ARRAY[64] OF INTEGER
  CALCX : INTEGER
  CALCY : INTEGER
  CALCZ : INTEGER
  CALCW : INTEGER
  CALCP : INTEGER
  CALCR : INTEGER
  USEAV : INTEGER
  PARAMTYP : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  PARAMINT : INTEGER
  AVX : REAL
  AVY : REAL
  AVZ : REAL
  AVW : REAL
  AVP : REAL
  AVR : REAL
  AVERAGE : POSITION
  PARAMNO : INTEGER
  XYZCONFIG : INTEGER
  AVERAGE_f04 : REAL
  AVERAGE_f08 : REAL
  AVERAGE_f0c : REAL
  AVERAGE_f10 : REAL
  AVERAGE_f14 : REAL
  AVERAGE_f18 : REAL
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE INIT : INTEGER
BEGIN
  FOR INTARRNUM = 1 TO 3 DO
  IF (UNINIT(ARRX[INTARRNUM])) THEN
  ARRX[INTARRNUM] = 0
  ENDIF
  IF (UNINIT(ARRY[INTARRNUM])) THEN
  ARRY[INTARRNUM] = 0
  ENDIF
  IF (UNINIT(ARRZ[INTARRNUM])) THEN
  ARRZ[INTARRNUM] = 0
  ENDIF
  IF (UNINIT(ARRW[INTARRNUM])) THEN
  ARRW[INTARRNUM] = 0
  ENDIF
  IF (UNINIT(ARRP[INTARRNUM])) THEN
  ARRP[INTARRNUM] = 0
  ENDIF
  IF (UNINIT(ARRR[INTARRNUM])) THEN
  ARRR[INTARRNUM] = 0
  ENDIF
  ENDFOR
  CALCX = 0
  CALCY = 0
  CALCZ = 0
  CALCW = 0
  CALCP = 0
  CALCR = 0
  USEAV = 0
  sv_i = INIT
  -- stmt90 stray sv_i
  GET_TPE_PRM(1, PARAMTYP, USEAV, PARAMREAL, PARAMSTRING, STATUS)
  IF ((USEAV = 0)) THEN
  FOR INTARRNUM = 10 TO 3 DO
  ARRX[INTARRNUM] = ARRX[INTARRNUM - 1]
  ARRY[INTARRNUM] = ARRY[INTARRNUM - 1]
  ARRZ[INTARRNUM] = ARRZ[INTARRNUM - 1]
  ARRW[INTARRNUM] = ARRW[INTARRNUM - 1]
  ARRP[INTARRNUM] = ARRP[INTARRNUM - 1]
  ARRR[INTARRNUM] = ARRR[INTARRNUM - 1]
  ENDFOR
  GET_REG(40, (1 <> 0), PARAMINT, (ARRX[1]), STATUS)
  -- 弃参原式: 1
  GET_REG(41, (1 <> 0), PARAMINT, (ARRY[1]), STATUS)
  -- 弃参原式: 1
  GET_REG(42, (1 <> 0), PARAMINT, (ARRZ[1]), STATUS)
  -- 弃参原式: 1
  GET_REG(43, (1 <> 0), PARAMINT, (ARRW[1]), STATUS)
  -- 弃参原式: 1
  GET_REG(44, (1 <> 0), PARAMINT, (ARRP[1]), STATUS)
  -- 弃参原式: 1
  GET_REG(45, (1 <> 0), PARAMINT, (ARRR[1]), STATUS)
  -- 弃参原式: 1
  ENDIF
  FOR INTARRNUM = 1 TO 3 DO
  CALCX = CALCX + ARRX[INTARRNUM]
  CALCY = CALCY + ARRY[INTARRNUM]
  CALCZ = CALCZ + ARRZ[INTARRNUM]
  CALCW = CALCW + ARRW[INTARRNUM]
  CALCP = CALCP + ARRP[INTARRNUM]
  CALCR = CALCR + ARRR[INTARRNUM]
  ENDFOR
  AVX = CALCX / 10
  AVY = CALCY / 10
  AVZ = CALCZ / 10
  AVW = CALCW / 10
  AVP = CALCP / 10
  AVR = CALCR / 10
  sv_p = GET_POS_REG(40, STATUS)
  AVERAGE = sv_p
  AVERAGE_f04 = AVX
  AVERAGE_f08 = AVY
  AVERAGE_f0c = AVZ
  AVERAGE_f10 = AVW
  AVERAGE_f14 = AVP
  AVERAGE_f18 = AVR
  IF ((USEAV = 1)) THEN
  SET_POS_REG(40, AVERAGE, STATUS)
  ENDIF
  RETURN(0)
END INIT

BEGIN
END ISRA_AV
