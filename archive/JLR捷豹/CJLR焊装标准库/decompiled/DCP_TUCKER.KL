  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  IF ((INTDCPFAULT < 101)) THEN
  WRITE('INCORRECT ERROR CODE', CR)
  FORCE_SPMENU(1, 37, 1)
