  ENDIF
  IF ((INTDCPFAULT >= 401) AND (INTDCPFAULT <= 700)) THEN
  sv_i = G_DCP_SPR1_2(0)
  -- stmt116 stray sv_i
  ENDIF
  IF ((INTDCPFAULT >= 701) AND (INTDCPFAULT <= 800)) THEN
  sv_i = G_DCP_SPR1_3(0)
  -- stmt120 stray sv_i
  ENDIF
  IF ((INTDCPFAULT > 800)) THEN
  WRITE('INCORRECT ERROR CODE', CR)
  FORCE_SPMENU(1, 37, 1)
  ABORT
  ENDIF
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  IF ((FKEY_SEL = 1)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[4] = 'FEED-NEW'
  ENDIF
  IF ((FKEY_SEL = 2)) THEN
  FKEYS[2] = 'RE-RIVET'
  FKEYS[3] = 'SKIP'
  ENDIF
  IF ((FKEY_SEL = 3)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[5] = 'RETRY'
  ENDIF
  IF ((FKEY_SEL = 4)) THEN
  FKEYS[5] = 'RETRY'
  ENDIF
  BLPLC = 0
  BLSPR = 1
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  DCPPLCTEXT = ROBOTNAME + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, DCPTEXT_f00, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  IF ((DCPTEXT_f00 > 0) AND (DCPTEXT_f00 < 10)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 5, 1)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0000' + DCPFAULTNUM1
  ENDIF
  IF ((DCPTEXT_f00 > 9) AND (DCPTEXT_f00 < 100)) THEN
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 4, 2)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '000' + DCPFAULTNUM1
