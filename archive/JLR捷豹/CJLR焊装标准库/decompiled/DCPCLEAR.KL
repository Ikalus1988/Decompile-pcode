  DCPTEXTHIST_f04 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f30 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f5c : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_f88 : ARRAY[64] OF STRING[64]
  DCPTEXTHIST_fb4 : ARRAY[64] OF STRING[64]
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


BEGIN
  SCHEDULE_IDX = 1
  FOR SCHEDULE_IDX = 1 TO 3 DO
  IF (UNINIT(DCPTEXTHIST_f00[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f00[SCHEDULE_IDX] = 0
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f04[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f04[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f30[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f30[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f5c[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f5c[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_f88[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_f88[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTEXTHIST_fb4[SCHEDULE_IDX])) THEN
  DCPTEXTHIST_fb4[SCHEDULE_IDX] = 'No History Data'
  ENDIF
  IF (UNINIT(DCPTIMEHIST[SCHEDULE_IDX])) THEN
  DCPTIMEHIST[SCHEDULE_IDX] = ''
  ENDIF
  ENDFOR
  IF ((io_02[5] = 1)) THEN
  EMPTYSTRING = ''
  GET_TIME(TIMERAW)
  CNV_TIME_STR(TIMERAW, TIMEDATE)
  SET_STR_REG(10, EMPTYSTRING, STATUS)
  SET_STR_REG(11, EMPTYSTRING, STATUS)
  SET_STR_REG(12, EMPTYSTRING, STATUS)
  SET_STR_REG(13, EMPTYSTRING, STATUS)
  SET_STR_REG(14, EMPTYSTRING, STATUS)
  SET_PORT_VAL(19, 4, 0, STATUS)
  SCHEDULE_IDX = 1
  FOR SCHEDULE_IDX = 20 TO 3 DO
  DCPTEXTHIST_f00[SCHEDULE_IDX] = DCPTEXTHIST_f00[SCHEDULE_IDX - 1]
  DCPTEXTHIST_f04[SCHEDULE_IDX] = DCPTEXTHIST_f04[SCHEDULE_IDX - 1]
  DCPTEXTHIST_f30[SCHEDULE_IDX] = DCPTEXTHIST_f30[SCHEDULE_IDX - 1]
  DCPTEXTHIST_f5c[SCHEDULE_IDX] = DCPTEXTHIST_f5c[SCHEDULE_IDX - 1]
  DCPTEXTHIST_f88[SCHEDULE_IDX] = DCPTEXTHIST_f88[SCHEDULE_IDX - 1]
  DCPTEXTHIST_fb4[SCHEDULE_IDX] = DCPTEXTHIST_fb4[SCHEDULE_IDX - 1]
  DCPTIMEHIST[SCHEDULE_IDX] = ''
  -- stmt82 stray DCPTIMEHIST[SCHEDULE_IDX - 1]
  ENDFOR
  DCPTEXTHIST_f00[1] = DCPTEXT_f00
  DCPTEXTHIST_f04[1] = DCPTEXT_f04
  DCPTEXTHIST_f30[1] = DCPTEXT_f30
  DCPTEXTHIST_f5c[1] = DCPTEXT_f5c
  DCPTEXTHIST_f88[1] = DCPTEXT_f88
  DCPTEXTHIST_fb4[1] = DCPTEXT_fb4
  DCPTIMEHIST[1] = TIMEDATE
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = 'No DCP Faults Active'
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  ENDIF
  sv_s = chr(128)
  WRITE(sv_s)
  sv_s = chr(128)
  WRITE(sv_s)
  sv_s = chr(128)
  WRITE(sv_s)
  io_02[5] = 0
END DCPCLEAR

