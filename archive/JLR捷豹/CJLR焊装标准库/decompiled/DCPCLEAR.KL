	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
