-- SETUP_JLR.KL (decompiled v3)
PROGRAM SETUP_JLR
%COMMENT = 'decompiled v3'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  io_02 : ARRAY[512] OF INTEGER
  io_23 : ARRAY[512] OF INTEGER
  DEBUGFORM : INTEGER
  STATUS : INTEGER
  YAMFORM : INTEGER
  TOOLFORM : INTEGER
  BLDONE : INTEGER
  ENTRY : INTEGER
  PREV_MENU : INTEGER
  PREV_SCREEN : INTEGER
  VALUE_ARRAY : ARRAY[64] OF STRING[64]
  TERM_MASK : INTEGER
  INACT_ARRAY : ARRAY[64] OF BOOLEAN
  CHANGE_ARRAY : ARRAY[64] OF BOOLEAN
  DEF_ITEM : INTEGER
  TERM_CHAR : INTEGER
  PARAMINT : INTEGER
  PARAMTYP : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[80]
  DEVICE_STAT : INTEGER
  DEBUGENABLE : BOOLEAN
  YAMENABLE : BOOLEAN
  TOOLPRESENT : BOOLEAN
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE INIT : INTEGER
BEGIN
  IF (UNINIT(DEBUGFORM)) THEN
  DEBUGFORM = 5
  io_23[10] = 0
  SET_PORT_CMT(35, 10, 'Disable Debug Text', STATUS)
  ENDIF
  IF (UNINIT(YAMFORM)) THEN
  YAMFORM = 5
  io_02[3094] = 0
  SET_PORT_CMT(2, 3094, 'Enable Yamazumi', STATUS)
  ENDIF
  IF (UNINIT(TOOLFORM)) THEN
  TOOLFORM = 5
  io_02[3095] = 0
  SET_PORT_CMT(2, 3095, 'Enable Tool Changer', STATUS)
  ENDIF
  sv_s = chr(128)
  WRITE(sv_s)
  sv_i = INIT
  -- stmt57 stray sv_i
  BLDONE = 0
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SP_ID', PREV_MENU, STATUS)
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SCRN_ID', PREV_SCREEN, STATUS)
  VALUE_ARRAY[1] = '[JLRSETUP]debugForm'
  VALUE_ARRAY[2] = '[JLRSETUP]YamForm'
  VALUE_ARRAY[3] = '[JLRSETUP]ToolForm'
  VALUE_ARRAY[4] = '[*SYSTEM*]$ROBOT_NAME'
  IF (8192 <> 0) OR (2 <> 0) OR (2048 <> 0) THEN
    TERM_MASK = 1
  ELSE
    TERM_MASK = 0
  ENDIF
  FORCE_SPMENU(1, 190, 1)
  DISCTRL_FORM('SETP', 0, VALUE_ARRAY, INACT_ARRAY, CHANGE_ARRAY, TERM_MASK, DEF_ITEM, TERM_CHAR, STATUS)
  SELECT TERM_CHAR OF
  CASE(128):
  FORCE_SPMENU(1, PREV_MENU, PREV_SCREEN)
  BLDONE = 1
  CASE(0):
  BLDONE = 1
  ELSE:
  BLDONE = 0
  WRITE('Test', CR)
  IF ((DEBUGFORM = 4)) THEN
  io_23[10] = 1
  ELSE
  io_23[10] = 0
  ENDIF
  IF ((YAMFORM = 4)) THEN
  io_02[3094] = 1
  ELSE
  io_02[3094] = 0
  ENDIF
  IF ((TOOLFORM = 4)) THEN
  io_02[3095] = 1
  ELSE
  io_02[3095] = 0
  ENDIF
  BLDONE = 0
  ENDSELECT
  IF ((BLDONE <> 0)) THEN
  ENDIF
  RETURN(0)
END INIT

BEGIN
END SETUP_JLR
