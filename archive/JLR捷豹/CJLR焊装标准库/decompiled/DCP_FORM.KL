-- DCP_FORM.KL (decompiled v3)
PROGRAM DCP_FORM
%COMMENT = 'decompiled v3'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  STATUS : INTEGER
  DCPTEXT : ALMDCP
  FKEY_SEL : INTEGER
  BLSPR : INTEGER
  BLPLC : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  ENTRY : INTEGER
  PREV_MENU : INTEGER
  PREV_SCREEN : INTEGER
  VALUE_ARRAY : ARRAY[64] OF STRING[64]
  TERM_MASK : INTEGER
  BLDONE : INTEGER
  INACT_ARRAY : ARRAY[64] OF BOOLEAN
  CHANGE_ARRAY : ARRAY[64] OF BOOLEAN
  DEF_ITEM : INTEGER
  TERM_CHAR : INTEGER
  DCPREG : INTEGER
  DUMMYREAL : REAL
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  FKEYS : ARRAY[10] OF STRING[12]
  DEVICE_STAT : INTEGER
  INTFAULTNUM : INTEGER
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE SPRRESET : INTEGER
BEGIN
  SET_PORT_VAL(2, 3099, 1, STATUS)
  SET_PORT_VAL(2, 3100, 1, STATUS)
  DELAY 500
  SET_PORT_VAL(2, 3099, 0, STATUS)
  SET_PORT_VAL(2, 3100, 0, STATUS)
  RETURN(0)
END SPRRESET

ROUTINE EXIT_FORM : INTEGER
BEGIN
  FORCE_MENU(1, 252)
  RETURN(0)
END EXIT_FORM

ROUTINE FORM_INIT : INTEGER
BEGIN
  IF (UNINIT(DCPTEXT_f00)) THEN
  DCPTEXT_f00 = 0
  ENDIF
  IF (UNINIT(DCPTEXT_f04)) THEN
  DCPTEXT_f04 = 'No DCP Faults Active'
  ENDIF
  IF (UNINIT(DCPTEXT_f30)) THEN
  DCPTEXT_f30 = ''
  ENDIF
  IF (UNINIT(DCPTEXT_f5c)) THEN
  DCPTEXT_f5c = ''
  ENDIF
  IF (UNINIT(DCPTEXT_f88)) THEN
  DCPTEXT_f88 = ''
  ENDIF
  IF (UNINIT(DCPTEXT_fb4)) THEN
  DCPTEXT_fb4 = ''
  ENDIF
  IF (UNINIT(FKEY_SEL)) THEN
  FKEY_SEL = 0
  ENDIF
  IF (UNINIT(BLSPR) AND UNINIT(BLPLC) AND UNINIT(BLSPOT) AND UNINIT(BLDISPENSE) AND UNINIT(BLMH) AND UNINIT(BLSTUD) AND UNINIT(BLNUT) AND UNINIT(BLISRA) AND UNINIT(BLQUISS)) THEN
  BLPLC = 1
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  ENDIF
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  PURGE CONDITION[1]
  -- stmt96 stray 3 | 516 | 1
  -- stmt101 stray 4 | 517 | 1
  IF ((DCPTEXT_f00 = 851)) THEN
  ENABLE CONDITION[1]
  ENDIF
  IF ((DCPTEXT_f00 = 852)) THEN
  ENABLE CONDITION[1]
  ENDIF
  RETURN(0)
END FORM_INIT

ROUTINE DCPDISPALM : INTEGER
BEGIN
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SP_ID', PREV_MENU, STATUS)
  GET_VAR(ENTRY, '*SYSTEM*', '$TP_CURSCRN[1].$SCRN_ID', PREV_SCREEN, STATUS)
  sv_i = FORM_INIT
  -- stmt124 stray sv_i
  VALUE_ARRAY[1] = 'DCPText.DCPFaultNum'
  VALUE_ARRAY[2] = 'DCPText.DCPLine1'
  VALUE_ARRAY[3] = 'DCPText.DCPLine2'
  VALUE_ARRAY[4] = 'DCPText.DCPLine3'
  VALUE_ARRAY[5] = 'DCPText.DCPLine4'
  VALUE_ARRAY[6] = 'DCPText.DCPLine5'
  TERM_MASK = 2
  FORCE_SPMENU(1, 190, 1)
  BLDONE = 0
  -- stmt136 stray 1 | 733 | 1
  IF ((DCPTEXT_f00 = 6194)) THEN
  ENABLE CONDITION[1]
  ENDIF
  IF ((BLSPR = 1)) THEN
  ENDIF
  DELAY 250
  DISCTRL_FORM('DCPs', 0, VALUE_ARRAY, INACT_ARRAY, CHANGE_ARRAY, TERM_MASK, DEF_ITEM, TERM_CHAR, STATUS)
  POST_ERR(STATUS, '', 0, 0)
  SELECT TERM_CHAR OF
  CASE(129):
  CASE(137):
  IF ((FKEY_SEL = 0) OR (FKEY_SEL = 1) OR (FKEY_SEL = 3)) THEN
  SET_INT_REG(56, 1, STATUS)
  BLDONE = 1
  sv_i = SPRRESET
  -- stmt159 stray sv_i
  ENDIF
  CASE(131):
  CASE(138):
  IF ((FKEY_SEL = 2)) THEN
  SET_INT_REG(56, 2, STATUS)
  BLDONE = 1
  sv_i = SPRRESET
  -- stmt166 stray sv_i
  ENDIF
  CASE(132):
  CASE(139):
  IF ((FKEY_SEL = 2)) THEN
  SET_INT_REG(56, 3, STATUS)
  BLDONE = 1
  sv_i = SPRRESET
  -- stmt173 stray sv_i
  ENDIF
  CASE(133):
  CASE(140):
  IF ((FKEY_SEL = 1)) THEN
  SET_INT_REG(56, 4, STATUS)
  BLDONE = 1
  sv_i = SPRRESET
  -- stmt180 stray sv_i
  ENDIF
  CASE(134):
  CASE(141):
  IF ((FKEY_SEL = 3) OR (FKEY_SEL = 4)) THEN
  SET_INT_REG(56, 5, STATUS)
  BLDONE = 1
  sv_i = SPRRESET
  -- stmt187 stray sv_i
  ENDIF
  CASE(252):
  SET_INT_REG(56, 6, STATUS)
  BLDONE = 1
  ELSE:
  SET_INT_REG(56, 0, STATUS)
  BLDONE = 1
  ENDSELECT
  IF ((BLDONE <> 0)) THEN
  GET_REG(56, (0 <> 0), DCPREG, DUMMYREAL, STATUS)
  -- 弃参原式: 0
  IF ((DCPREG > 0)) THEN
  FORCE_SPMENU(1, PREV_MENU, PREV_SCREEN)
  ENDIF
  ENDIF
  IF ((BLSPOT = 1)) THEN
  ENDIF
  DELAY 250
  DISCTRL_FORM('DCPs', 5, VALUE_ARRAY, INACT_ARRAY, CHANGE_ARRAY, TERM_MASK, DEF_ITEM, TERM_CHAR, STATUS)
  POST_ERR(STATUS, '', 0, 0)
