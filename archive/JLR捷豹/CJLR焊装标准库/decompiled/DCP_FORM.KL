  CASE(129):
  CASE(137):
  IF ((FKEY_SEL = 0) OR (FKEY_SEL = 3)) THEN
  SET_INT_REG(56, 1, STATUS)
  BLDONE = 1
  ENDIF
  CASE(131):
  CASE(138):
  IF ((FKEY_SEL = 1) OR (FKEY_SEL = 2)) THEN
  SET_INT_REG(56, 2, STATUS)
  BLDONE = 1
  ENDIF
  CASE(132):
  CASE(139):
  IF ((FKEY_SEL = 1) OR (FKEY_SEL = 2) OR (FKEY_SEL = 3)) THEN
  SET_INT_REG(56, 3, STATUS)
  BLDONE = 1
  ENDIF
  CASE(133):
