PROGRAM RIVDATALOAD
%COMMENT = 'Version 1.6'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  BLDONE : INTEGER
  INTSCHEDULE : INTEGER
  FILECOMM : FILE
  STRLINE : STRING[64]
  STRRIVETID : STRING[64]
  INTRIVETID : INTEGER
  STRCONTID : STRING[64]
  INTCONTID : INTEGER
  STRTOOLID : STRING[64]
  INTTOOLID : INTEGER
  STRRIVTYPE : STRING[64]
  INTRIVTYPE : INTEGER
  STRPMOFFSET : STRING[64]
  INTPMOFFSET : INTEGER
  STRPMOPEN : STRING[64]
  INTPMOPEN : INTEGER
  STRCOMMENT : STRING[64]
  ARRRIVETDATA : ARRAY[64] OF INTEGER
  STATUS : INTEGER
  REALPARAM : REAL
  ARRRIVETDATA_f00 : ARRAY[64] OF STRING[64]
  ARRRIVETDATA_f1e : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f22 : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f26 : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f2a : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f2e : ARRAY[64] OF INTEGER
  ARRRIVETDATA_f32 : ARRAY[64] OF INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


BEGIN
  BLDONE = 0
  INTSCHEDULE = 1
  OPEN FILE FILECOMM('RO', 'FR:Rivet.DT')
  IF ((sv_i = 0)) THEN
  FOR INTSCHEDULE = 1 TO 3 DO
  -- stmt54 stray FILECOMM | STRLINE
  WRITE(STRLINE, CR)
  sv_s = sub_str(STRLINE, 1, 3)
  STRRIVETID = sv_s
  CNV_STR_INT(STRRIVETID, INTRIVETID)
  sv_s = sub_str(STRLINE, 4, 4)
  STRCONTID = sv_s
  CNV_STR_INT(STRCONTID, INTCONTID)
  sv_s = sub_str(STRLINE, 5, 5)
  STRTOOLID = sv_s
  CNV_STR_INT(STRTOOLID, INTTOOLID)
  sv_s = sub_str(STRLINE, 6, 6)
  STRRIVTYPE = sv_s
  CNV_STR_INT(STRRIVTYPE, INTRIVTYPE)
  sv_s = sub_str(STRLINE, 7, 8)
  STRPMOFFSET = sv_s
  CNV_STR_INT(STRPMOFFSET, INTPMOFFSET)
  sv_s = sub_str(STRLINE, 9, 9)
  STRPMOPEN = sv_s
  CNV_STR_INT(STRPMOPEN, INTPMOPEN)
  sv_s = sub_str(STRLINE, 10, 35)
  STRCOMMENT = sv_s
  ARRRIVETDATA_f1e[INTSCHEDULE] = INTRIVETID
  ARRRIVETDATA_f22[INTSCHEDULE] = INTCONTID
  ARRRIVETDATA_f26[INTSCHEDULE] = INTTOOLID
  ARRRIVETDATA_f2a[INTSCHEDULE] = INTRIVTYPE
  ARRRIVETDATA_f2e[INTSCHEDULE] = INTPMOFFSET
  ARRRIVETDATA_f32[INTSCHEDULE] = INTPMOPEN
  ARRRIVETDATA_f00[INTSCHEDULE] = STRCOMMENT
  ENDFOR
  -- stmt90 stray FILECOMM
  WRITE('Error Opening File', CR)
  ENDIF
END RIVDATALOAD

