  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 2, 4)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0' + DCPFAULTNUM1
  SET_PORT_VAL(19, 4, INTDCPFAULT, STATUS)
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  sv_s = GET_EPLANREF(EPLANIO)
  EPLANREF = sv_s
  sv_s = sub_str(EPLANREF, 17, 20)
  EPLANPAGE = sv_s
  sv_s = sub_str(EPLANREF, 22, 40)
  EPLANTYPE = sv_s
  sv_s = sub_str(EPLANREF, 1, 16)
  EPLANREF = sv_s
  CNV_INT_STR(EPLANIO, 3, 0, STREPLANIO)
  DCPTEXT_f5c = 'GRIPPER FAULT'
  DCPTEXT_f88 = 'DI' + STREPLANIO + '  ' + EPLANTYPE
  DCPTEXT_fb4 = 'Eplan Ref = P.' + EPLANPAGE + EPLANREF
  SET_STR_REG(11, DCPTEXT_f5c, STATUS)
  SET_STR_REG(12, DCPTEXT_f88, STATUS)
  SET_STR_REG(13, DCPTEXT_fb4, STATUS)
  BLPLC = 0
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 1
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  ENDIF
  io_02[5] = 1
  sv_i = DCPDISP(DCPTEXT)
  -- stmt165 stray sv_i
  RETURN(0)
END POSTSTAT

