-- DCP_TC.KL (decompiled v3)
PROGRAM DCP_TC
%COMMENT = 'Version 1.0'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	ALMDCP = STRUCTURE
	DCPFAULTNUM: INTEGER
	DCPLINE1: STRING[40]
	DCPLINE2: STRING[40]
	DCPLINE3: STRING[40]
	DCPLINE4: STRING[40]
	DCPLINE5: STRING[40]
	ENDSTRUCTURE
VAR
  io_02 : ARRAY[512] OF INTEGER
  PARAMTYP : INTEGER
  INTDCPFAULT : INTEGER
  PARAMREAL : REAL
  PARAMSTRING : STRING[64]
  STATUS : INTEGER
  STRDCPTEXT : STRING[64]
  INTARG : INTEGER
  STRARG : STRING[64]
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  INTTOOLID : INTEGER
  TOOLID : STRING[64]
  DCPTEXT : ALMDCP
  FKEY_SEL : INTEGER
  FKEYS : ARRAY[64] OF STRING[64]
  DCPPLCTEXT : STRING[64]
  DCPFAULTNUM1 : STRING[64]
  DCPFAULTNUM : STRING[64]
  BLPLC : INTEGER
  BLSPR : INTEGER
  BLSPOT : INTEGER
  BLDISPENSE : INTEGER
  BLMH : INTEGER
  BLSTUD : INTEGER
  BLNUT : INTEGER
  BLISRA : INTEGER
  BLQUISS : INTEGER
  DCPTEXTHIST : ARRAY[64] OF INTEGER
  DCPTIMEHIST : ARRAY[20] OF STRING[18]
  PARAMNO : INTEGER
  PARAMINT : INTEGER
  INTPROGNUM : INTEGER
  INTAREAINREQ : INTEGER
  INTAREAOUTRL : INTEGER
  INTTOOLREQ : INTEGER
  INTJOBDONE : INTEGER
  INTCOLREQ : INTEGER
  INTCOLREL : INTEGER
  REALDUMMY : REAL
  REALACTTHK : REAL
  REALREQTHK : REAL
  STRPROGNUM : STRING[3]
  STRAREANUM : STRING[3]
  STRAREAINREQ : STRING[3]
  STRAREAOUTRL : STRING[3]
  STRTOOLREQ : STRING[3]
  STRJOBDONE : STRING[3]
  STRCOLREQ : STRING[3]
  STRCOLREL : STRING[3]
  STRDCPTEXT2 : STRING[82]
  ACTTHKSTR : STRING[20]
  STRREQTHK : STRING[20]
  STRADDDCPTXT : STRING[20]
  STRTPFUNC : ARRAY[5] OF STRING[8]
  BLKEYPRESSED : BOOLEAN
  DCPTEXT_f00 : INTEGER
  DCPTEXT_f04 : STRING[64]
  DCPTEXT_f30 : STRING[64]
  DCPTEXT_f5c : STRING[64]
  DCPTEXT_f88 : STRING[64]
  DCPTEXT_fb4 : STRING[64]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL

ROUTINE DCPDISP(p0 : ALMDCP) : INTEGER FROM MI_LIB
ROUTINE DCPDISPALM(p0 : INTEGER) : INTEGER FROM MI_LIB
ROUTINE DCP_CLR(p0 : INTEGER) : INTEGER FROM MI_LIB

ROUTINE POSTSTAT(p0 : INTEGER) : INTEGER
BEGIN
  IF ((p0 <> 0)) THEN
  POST_ERR(p0, '', 0, 2)
  ENDIF
  GET_TPE_PRM(1, PARAMTYP, INTDCPFAULT, PARAMREAL, PARAMSTRING, STATUS)
  IF ((PARAMTYP <> 1) OR (STATUS <> 0)) THEN
  WRITE('Invalid Call to DCPFault Program on Robot!', CR, 'Check argument 1 is an integer!')
  STRDCPTEXT = 'Invalid Call to DCPFault Program on Robot'
  ENDIF
  IF (UNINIT(INTDCPFAULT)) THEN
  INTDCPFAULT = 0
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, INTARG, PARAMREAL, PARAMSTRING, STATUS)
  CNV_INT_STR(INTARG, 5, 10, STRARG)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  IF (UNINIT(ROBOTNAME)) THEN
  ROBOTNAME = 'Unit'
  ENDIF
  GET_PORT_VAL(19, 3, INTTOOLID, STATUS)
  CNV_INT_STR(INTTOOLID, 2, 10, TOOLID)
  DCPTEXT_f00 = 0
  DCPTEXT_f04 = ''
  DCPTEXT_f30 = ''
  DCPTEXT_f5c = ''
  DCPTEXT_f88 = ''
  DCPTEXT_fb4 = ''
  FKEY_SEL = 0
  FKEYS[1] = ''
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  FKEYS[6] = ''
  FKEYS[7] = ''
  FKEYS[8] = ''
  FKEYS[9] = ''
  FKEYS[10] = ''
  FKEY_SEL = 0
  DCPTEXT_f00 = INTDCPFAULT
  DCPPLCTEXT = ROBOTNAME + ',Tool-' + TOOLID + ',' + DCPTEXT_f04 + DCPTEXT_f30
  SET_PORT_VAL(19, 4, INTDCPFAULT, STATUS)
  CNV_INT_STR(DCPTEXT_f00, 5, 10, DCPFAULTNUM1)
  sv_s = sub_str(DCPFAULTNUM1, 2, 4)
  DCPFAULTNUM1 = sv_s
  DCPFAULTNUM = '0' + DCPFAULTNUM1
  SET_STR_REG(9, DCPFAULTNUM, STATUS)
  SET_STR_REG(10, DCPPLCTEXT, STATUS)
  BLPLC = 1
  BLSPR = 0
  BLSPOT = 0
  BLDISPENSE = 0
  BLMH = 0
  BLSTUD = 0
  BLNUT = 0
  BLISRA = 0
  BLQUISS = 0
  IF ((FKEY_SEL = 0)) THEN
  FKEYS[1] = 'ACK'
  FKEYS[2] = ''
  FKEYS[3] = ''
  FKEYS[4] = ''
  FKEYS[5] = ''
  ENDIF
  SELECT DCPTEXT_f00 OF
  CASE(7151):
  DCPTEXT_f04 = 'Tool Stand ? : LH PP not on / GeoPP1 not on'
  DCPTEXT_f00 = 7151
  CASE(7152):
  DCPTEXT_f04 = 'Tool Stand ? : LH PP not off / GeoPP1 not off'
  DCPTEXT_f00 = 7152
  CASE(7153):
  DCPTEXT_f04 = 'Tool Stand ? : RH PP not on / GeoPP2 not on'
