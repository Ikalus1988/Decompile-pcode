-- YAMAZUMI.KL (decompiled v3)
PROGRAM YAMAZUMI
%COMMENT = 'Version 1.0'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
VAR
  io_02 : ARRAY[512] OF INTEGER
  BLEND : INTEGER
  DIV_NUM : INTEGER
  IDX : INTEGER
  CALCVAL : ARRAY[64] OF INTEGER
  CLKSPLIT : ARRAY[64] OF INTEGER
  CLKSPLITDES : ARRAY[64] OF STRING[64]
  CLKSPLITACT : ARRAY[64] OF STRING[64]
  CLKSTART : INTEGER
  CLKSTOP : INTEGER
  CLKSPLITTIME : ARRAY[64] OF STRING[64]
  DAYCHGD : INTEGER
  TIMERAW : INTEGER
  TIMEDATE : STRING[64]
  STRDAY : STRING[64]
  INTDAY : INTEGER
  MEMDAY : INTEGER
  OVERWRITE_SW : INTEGER
  NOWAIT_SW : INTEGER
  STATUS : INTEGER
  FILE260 : FILE
  ENTRY : INTEGER
  ROBOTNAME : STRING[64]
  PARAMTYP : INTEGER
  PARAMINT : INTEGER
  PARAMREAL : REAL
  YAMACTION : STRING[64]
  YAMDES : STRING[64]
  NUMREQ : INTEGER
  PARAMSTRING : STRING[64]
  PROGNUM : INTEGER
  CLOCKREAD : INTEGER
  STRNUMREQ : STRING[64]
  YAMNO : INTEGER
  CLKSPLITMEM : INTEGER
  TESTDISP : REAL
  STRCLKSPLIT : ARRAY[64] OF INTEGER
  YAMX260_1 : ARRAY[64] OF INTEGER
  YAMCAR : STRING[4]
  DESTFILE : STRING[14]
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE INIT : INTEGER
BEGIN
  IF (UNINIT(BLEND)) THEN
  BLEND = 0
  ENDIF
  IF (UNINIT(DIV_NUM)) THEN
  DIV_NUM = 0
  ENDIF
  FOR IDX = 1 TO 3 DO
  IF (UNINIT(CALCVAL[IDX])) THEN
  CALCVAL[IDX] = 0
  ENDIF
  ENDFOR
  FOR IDX = 1 TO 3 DO
  IF (UNINIT(CLKSPLIT[IDX])) THEN
  CLKSPLIT[IDX] = 0
  ENDIF
  IF (UNINIT(CLKSPLITDES[IDX])) THEN
  CLKSPLITDES[IDX] = ''
  ENDIF
  IF (UNINIT(CLKSPLITACT[IDX])) THEN
  CLKSPLITACT[IDX] = ''
  ENDIF
  IF (UNINIT(CLKSTART)) THEN
  CLKSTART = 0
  ENDIF
  IF (UNINIT(CLKSTOP)) THEN
  CLKSTOP = 0
  ENDIF
  ENDFOR
  RETURN(0)
END INIT

ROUTINE OLDAVERAGE(p0, p1, p2, p3, p4 : ARRAY OF INTEGER) : INTEGER
VAR
  r1_lc256 : ARRAY[64] OF INTEGER
  r1_lc512 : ARRAY[64] OF REAL
  r1_lc513 : INTEGER
  r1_lc514 : INTEGER
BEGIN
  WRITE('Test 1', CR)
  r1_lc513 = 0
  r1_lc514 = 0
  IF ((p0[1] > 0)) THEN
  r1_lc513 = r1_lc513 + 1
  ENDIF
  IF ((p1[1] > 0)) THEN
  r1_lc513 = r1_lc513 + 1
  ENDIF
  IF ((p2[1] > 0)) THEN
  r1_lc513 = r1_lc513 + 1
  ENDIF
  IF ((p3[1] > 0)) THEN
  r1_lc513 = r1_lc513 + 1
  ENDIF
  IF ((p4[1] > 0)) THEN
  r1_lc513 = r1_lc513 + 1
  ENDIF
  WRITE('Test 2', CR)
  FOR r1_lc514 = 1 TO 3 DO
  r1_lc512[r1_lc514] = p0[r1_lc514] + p1[r1_lc514] + p2[r1_lc514] + p3[r1_lc514] + p4[r1_lc514] / r1_lc513
  ENDFOR
  WRITE('TEST 3')
  FOR r1_lc514 = 1 TO 3 DO
  sv_i = trunc((r1_lc512[r1_lc514]))
  r1_lc256[r1_lc514] = sv_i
  ENDFOR
  -- stmt229 stray r1_lc256
  RETURN(0)
END OLDAVERAGE

ROUTINE CLRX260CLOCK : INTEGER
BEGIN
  FOR IDX = 1 TO 3 DO
  CLKSPLIT[IDX] = 0
  CLKSPLITDES[IDX] = ''
  CLKSPLITACT[IDX] = ''
  CLKSPLITTIME[IDX] = ''
  CLKSTART = 0
  CLKSTOP = 0
  ENDFOR
  RETURN(0)
END CLRX260CLOCK

ROUTINE CHKDAYCHG : INTEGER
BEGIN
  DAYCHGD = 0
  GET_TIME(TIMERAW)
  CNV_TIME_STR(TIMERAW, TIMEDATE)
  sv_s = sub_str(TIMEDATE, 1, 2)
  STRDAY = sv_s
  CNV_STR_INT(STRDAY, INTDAY)
  IF (UNINIT(MEMDAY)) THEN
  MEMDAY = INTDAY
  ENDIF
  IF ((MEMDAY <> INTDAY)) THEN
  DAYCHGD = 1
  ENDIF
  RETURN(0)
END CHKDAYCHG

ROUTINE YAMARCHIVE : INTEGER
BEGIN
  OVERWRITE_SW = 1
  NOWAIT_SW = 0
  DELETE_FILE('FR:YAMAZUMI.CSV', (NOWAIT_SW <> 0), STATUS)
  -- 弃参原式: NOWAIT_SW
  MEMDAY = INTDAY
  OPEN FILE FILE260('AP', 'FR:YAMAZUMI.CSV')
  IF ((sv_i = 0)) THEN
  WRITE('FILE OPENED File260')
  WRITE('Robot Name,Timer Name, Duration MS, Action, Time/Date', CR)
  -- stmt101 stray FILE260
  -- stmt103 stray FILE260
  ELSE
  WRITE('Error Opening File', CR)
  ENDIF
  sv_s = chr(128)
  WRITE(sv_s)
  GET_VAR(ENTRY, '*SYSTEM*', '$ROBOT_NAME', ROBOTNAME, STATUS)
  sv_i = INIT
  -- stmt115 stray sv_i
  sv_i = CHKDAYCHG
  -- stmt117 stray sv_i
  IF ((DAYCHGD = 1)) THEN
  sv_i = YAMARCHIVE
  -- stmt120 stray sv_i
  ENDIF
  GET_TPE_PRM(1, PARAMTYP, PARAMINT, PARAMREAL, YAMACTION, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Invalid Yamazumi Action in Argument 1')
  ABORT
  ENDIF
  GET_TPE_PRM(2, PARAMTYP, PARAMINT, PARAMREAL, YAMDES, STATUS)
  IF ((PARAMTYP <> 3) OR (STATUS <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  WRITE('Invalid Yamazumi Action Description in Argument 2')
  ABORT
  ENDIF
  GET_TPE_PRM(3, PARAMTYP, NUMREQ, PARAMREAL, PARAMSTRING, STATUS)
  GET_REG(160, (0 <> 0), PROGNUM, PARAMREAL, STATUS)
  -- 弃参原式: 0
  sv_s = chr(128)
  WRITE(sv_s)
  IF ((io_02[3073] = 1) AND (io_02[3094] = 1)) THEN
  WRITE('JLR: Yamazumi Active')
  IF ((YAMACTION = 'Start') OR (YAMACTION = 'START')) THEN
  sv_i = CLRX260CLOCK
  -- stmt158 stray sv_i
  GET_VAR(ENTRY, '*SYSTEM*', '$FAST_CLOCK', CLOCKREAD, STATUS)
  CNV_INT_STR(PROGNUM, 2, 10, STRNUMREQ)
  YAMNO = 1
  CLKSTART = CLOCKREAD
  CLKSPLITMEM = CLOCKREAD
  CLKSPLIT[YAMNO] = CLOCKREAD
  CLKSPLITACT[YAMNO] = YAMACTION
  CLKSPLITDES[YAMNO] = YAMDES + ' ' + STRNUMREQ
  GET_TIME(TIMERAW)
  CNV_TIME_STR(TIMERAW, '')
  -- 弃参原式: (CLKSPLITTIME[YAMNO])
  BLEND = 0
  YAMNO = YAMNO + 1
  WRITE('START', CR)
  ENDIF
  IF ((YAMACTION = 'VA') OR (YAMACTION = 'NVA') OR (YAMACTION = 'ENVA')) THEN
  GET_VAR(ENTRY, '*SYSTEM*', '$FAST_CLOCK', CLOCKREAD, STATUS)
  CLKSPLIT[YAMNO] = CLOCKREAD
  CLKSPLITACT[YAMNO] = YAMACTION
  IF (UNINIT(NUMREQ) OR (NUMREQ = 0)) THEN
  CLKSPLITDES[YAMNO] = YAMDES
  ELSE
  CNV_INT_STR(NUMREQ, 2, 10, STRNUMREQ)
  CLKSPLITDES[YAMNO] = YAMDES + ' ' + STRNUMREQ
  ENDIF
  GET_TIME(TIMERAW)
  CNV_TIME_STR(TIMERAW, '')
  -- 弃参原式: (CLKSPLITTIME[YAMNO])
  IF ((YAMNO > 1)) THEN
  CLKSPLIT[YAMNO] = CLKSPLIT[YAMNO] - CLKSPLITMEM * 2
  ENDIF
  CLKSPLITMEM = CLOCKREAD
  YAMNO = YAMNO + 1
  ENDIF
  IF ((YAMACTION = 'end') OR (YAMACTION = 'END') OR (YAMACTION = 'End')) THEN
  GET_VAR(ENTRY, '*SYSTEM*', '$FAST_CLOCK', CLOCKREAD, STATUS)
  CLKSTOP = CLOCKREAD
  CLKSPLIT[YAMNO] = CLKSTOP - CLKSPLITMEM * 2
  CLKSPLITACT[YAMNO] = YAMACTION
  CLKSPLITDES[YAMNO] = YAMDES
  GET_TIME(TIMERAW)
  CNV_TIME_STR(TIMERAW, '')
  -- 弃参原式: (CLKSPLITTIME[YAMNO])
  TESTDISP = CLKSTOP - CLKSTART / 1000
  WRITE('STOP', CR)
  DELAY 0
  -- stmt219 stray TESTDISP | 13 | -5
  BLEND = 1
  ENDIF
  IF ((YAMACTION = 'end') OR (YAMACTION = 'END') OR (YAMACTION = 'End')) THEN
  CLKSPLIT[1] = PROGNUM * 1000
  FOR IDX = 1 TO 3 DO
  CNV_INT_STR((CLKSPLIT[IDX]), 5, 10, '')
  -- 弃参原式: (STRCLKSPLIT[IDX])
  ENDFOR
  OPEN FILE FILE260('AP', 'FR:YAMAZUMI.CSV')
  IF ((sv_i = 0)) THEN
  WRITE('FILE OPENED File260')
  FOR IDX = 1 TO 3 DO
  WRITE(CLKSPLITTIME[IDX] + '', CR)
  -- stmt240 stray FILE260 | ROBOTNAME + ',' | CLKSPLITDES[IDX] + '' + ',' | '' + ',' | CLKSPLITACT[IDX] + '' + ','
  ENDFOR
  -- stmt243 stray FILE260
  WRITE(CR, STATUS)
  DELAY 500
  WRITE('Error Opening File', CR)
  ENDIF
  ENDIF
  ENDIF
  RETURN(0)
END YAMARCHIVE

BEGIN
END YAMAZUMI
