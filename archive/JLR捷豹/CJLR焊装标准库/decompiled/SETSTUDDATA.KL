-- SETSTUDDATA.KL (decompiled v3)
PROGRAM SETSTUDDATA
%COMMENT = 'Version 1.3'
%NOBUSYLAMP
%NOLOCKGROUP
%NOPAUSE = COMMAND + TPENABLE + ERROR
%NOABORT = ERROR + COMMAND
TYPE
	T_POS = STRUCTURE
	X: INTEGER
	Y: INTEGER
	Z: INTEGER
	W: INTEGER
	P: INTEGER
	R: INTEGER
	ENDSTRUCTURE
	REVISION = STRUCTURE
	MAJOR: INTEGER
	MINOR: INTEGER
	ENDSTRUCTURE
VAR
  WELDDATAVER : REVISION
  INTSTUDID : INTEGER
  STATUS : INTEGER
  INTERROR : INTEGER
  INTPARAM : INTEGER
  REALPARAM : REAL
  STRPARAM : STRING[64]
  STRSTUDID : STRING[64]
  INTSTUDSETOK : INTEGER
  INTIDX : INTEGER
  ARRSTUDID : ARRAY[64] OF STRING[64]
  INTSTUDCOUNT : INTEGER
  INTTEMP : INTEGER
  INTTYPEID : INTEGER
  INTLOOPS : INTEGER
  INTREADOK : INTEGER
  INTSTUDOK : INTEGER
  STRTYPEID : STRING[12]
  STRSEP : STRING[12]
  BLTIMEOUT : BOOLEAN
  WELDDATAVER_f00 : INTEGER
  WELDDATAVER_f04 : INTEGER
  sv_i : INTEGER
  sv_s : STRING[64]
  sv_p : POSITION
  sv_j : JOINTPOS
  sv_r : REAL
  sv_b : BOOLEAN
  sv_a : ARRAY[9] OF REAL


ROUTINE WELDDATA_VER : INTEGER
BEGIN
  WELDDATAVER_f00 = 1
  WELDDATAVER_f04 = 0
  -- stmt55 stray WELDDATAVER
  RETURN(0)
END WELDDATA_VER

ROUTINE SETGROUPIO : INTEGER
VAR
  intLS : INTEGER
  intMS : INTEGER
BEGIN
  intMS = INTSTUDID DIV 65536
  intLS = INTSTUDID MOD 65536
  SET_PORT_VAL(19, 25, intLS, STATUS)
  IF ((STATUS <> 0)) THEN
  INTERROR = 4
  ENDIF
  SET_PORT_VAL(19, 26, intMS, STATUS)
  IF ((STATUS <> 0)) THEN
  INTERROR = 5
  ENDIF
  INTERROR = 0
  GET_TPE_PRM(1, 3, INTPARAM, REALPARAM, STRPARAM, STATUS)
  IF ((STATUS = 0)) THEN
  STRSTUDID = STRPARAM
  CNV_STR_INT(STRSTUDID, INTSTUDID)
  sv_i = SETGROUPIO
  -- stmt109 stray sv_i
  ELSE
  INTERROR = 1
  ENDIF
  INTSTUDSETOK = (0 - 1)
  INTIDX = 1
  FOR INTIDX = 1 TO 3 DO
  IF (NOT (UNINIT(ARRSTUDID[INTIDX]))) THEN
  IF (('' = STRSTUDID)) THEN
  WRITE('Duplicate Stud ID!', CR)
  WRITE('ID: ', STRSTUDID, CR)
  INTSTUDSETOK = 0
  ENDIF
  ENDIF
  ENDFOR
  IF (UNINIT(INTSTUDCOUNT)) THEN
  INTSTUDCOUNT = 1
  ELSE
  INTSTUDCOUNT = INTSTUDCOUNT + 1
  ENDIF
  IF ((INTSTUDSETOK = (0 - 1))) THEN
  ARRSTUDID[INTSTUDCOUNT] = STRSTUDID
  INTSTUDSETOK = 1
  ENDIF
  SET_INT_REG(195, INTSTUDSETOK, STATUS)
  SET_INT_REG(33, INTERROR, STATUS)
  RETURN(0)
END SETGROUPIO

BEGIN
END SETSTUDDATA
