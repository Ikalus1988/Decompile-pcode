  ELSE
  io_02[p0 + r1_lc2 - 1] = 0
  ENDIF
  r1_lc3 = r1_lc3 DIV 2
  ENDFOR
  ENDIF
  ENDIF
  RETURN(0)
END ISV2_GOUT

ROUTINE ISV2_B2D1(p0, p1 : INTEGER) : REAL
