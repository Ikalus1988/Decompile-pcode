  IF ((CURRES[p0].OFFSET.Y > VGCONFIG.MAX_OFFSET.Y) OR (CURRES[p0].OFFSET.Y < VGCONFIG.MIN_OFFSET.Y)) THEN
  r5_lc1 = 91
  ENDIF
  IF ((CURRES[p0].OFFSET.Z > VGCONFIG.MAX_OFFSET.Z) OR (CURRES[p0].OFFSET.Z < VGCONFIG.MIN_OFFSET.Z)) THEN
  r5_lc1 = 91
  ENDIF
  IF ((CURRES[p0].OFFSET.W > VGCONFIG.MAX_OFFSET.W) OR (CURRES[p0].OFFSET.W < VGCONFIG.MIN_OFFSET.W)) THEN
  r5_lc1 = 91
  ENDIF
  IF ((CURRES[p0].OFFSET.P > VGCONFIG.MAX_OFFSET.P) OR (CURRES[p0].OFFSET.P < VGCONFIG.MIN_OFFSET.P)) THEN
  r5_lc1 = 91
  ENDIF
  IF ((CURRES[p0].OFFSET.R > VGCONFIG.MAX_OFFSET.R) OR (CURRES[p0].OFFSET.R < VGCONFIG.MIN_OFFSET.R)) THEN
  r5_lc1 = 91
  ENDIF
