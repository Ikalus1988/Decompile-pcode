  ENDIF
  r0_lc2 = r0_lc2 * 2
  ENDFOR
  ENDIF
  RETURN(r0_lc1)
  RETURN(0)
END ISV2_GIN

ROUTINE ISV2_GOUT(p0, p1, p2 : INTEGER) : INTEGER
VAR
