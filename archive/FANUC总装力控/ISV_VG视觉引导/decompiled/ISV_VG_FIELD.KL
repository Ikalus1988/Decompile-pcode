  ENDIF
  IF (UNINIT(VGCONFIG.COMTOUT)) THEN
  VGCONFIG.COMTOUT = 5
  ELSE
  IF ((VGCONFIG.COMTOUT <= 0)) THEN
  VGCONFIG.COMTOUT = 5
  ENDIF
  ENDIF
  IF (UNINIT(VGCONFIG.MEATOUT)) THEN
  VGCONFIG.MEATOUT = 30
  ELSE
  IF ((VGCONFIG.MEATOUT <= 0)) THEN
  VGCONFIG.MEATOUT = 30
  ENDIF
  ENDIF
  IF (UNINIT(VGCONFIG.RDY_CHK)) THEN
  VGCONFIG.RDY_CHK = 0
  ENDIF
  GET_TPE_PRM(1, 1, INTVAL1, REALVAL, STRVAL, STATUS)
  SELECT INTVAL1 OF
  CASE(1):
  IF ((VGCONFIG.APP_ID > 1)) THEN
  GET_TPE_PRM(2, 1, INTVAL2, REALVAL, STRVAL, STATUS)
  GET_TPE_PRM(3, 1, INTVAL3, REALVAL, STRVAL, STATUS)
  sv_i = VG_CYCEND2(INTVAL2, INTVAL3)
  -- stmt246 stray sv_i
  ENDIF
  CASE(2):
  IF ((VGCONFIG.RDY_CHK <> 0)) THEN
  IF ((io_23[VGCONFIG.FLAG_VGNOK] <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'ISV_VG: Confirm all clear BEFORE press "OK"')
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'OK')
  -- stmt254 stray 129
  ENDIF
  ENDIF
  RETURN(0)
  ENDSELECT
END VG_RP

BEGIN
END ISV_VG
