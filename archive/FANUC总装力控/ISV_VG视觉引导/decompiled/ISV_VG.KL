  sv_i = ISV2_GOUT(VGCONFIG_f84_f04, 16, (r15_lc20[3]))
  -- stmt144 stray sv_i
  sv_i = ISV2_GOUT(VGCONFIG_f84_f04 + 16, 16, (r15_lc20[4]))
  -- stmt145 stray sv_i
  sv_i = ISV2_GOUT(VGCONFIG_f84_f08, 16, (r15_lc20[5]))
  -- stmt146 stray sv_i
  sv_i = ISV2_GOUT(VGCONFIG_f84_f08 + 16, 16, (r15_lc20[6]))
  -- stmt147 stray sv_i
  sv_i = ISV2_GOUT(VGCONFIG_f04, 8, r15_lc100)
  -- stmt149 stray sv_i
  r15_lc96 = CURRES_f00[r15_lc100]
  r15_lc69 = r15_lc96
  r15_lc54 = r15_lc69
  -- stmt153 stray r15_lc39
  r15_lc87 = r15_lc54
  r15_lc87_f08 = r15_lc87_f08 + r15_lc100 * CURRES_f24_f00[r15_lc100]
  r15_lc87_f0c = r15_lc87_f0c + r15_lc100 * CURRES_f24_f04[r15_lc100]
  r15_lc87_f10 = r15_lc87_f10 + r15_lc100 * CURRES_f24_f08[r15_lc100]
  r15_lc54 = r15_lc87
  CNV_INT_STR(p2, 1, 0, r15_lc24)
  SET_VAR(r15_lc97, '*SYSTEM*', '$MNUFRAME[1,' + r15_lc24 + ']', r15_lc54, STATUS)
  IF ((STATUS = 0)) THEN
  io_23[VGCONFIG_f90] = 0
  WRITE('Set user frame', p2, ' success.', CR)
  ELSE
  io_23[VGCONFIG_f90] = 1
  WRITE('Set user frame', p2, ' failed.', CR)
  FORCE_SPMENU(1, 37, 1)
  PAUSE
  ENDIF
  IF (UNINIT(VGCONFIG_f00)) THEN
  VGCONFIG_f00 = 1
  ENDIF
  IF (UNINIT(VGCONFIG_f94)) THEN
  VGCONFIG_f94 = VGCONFIG_f90
  ENDIF
  IF (UNINIT(VGCONFIG_f98)) THEN
  VGCONFIG_f98 = VGCONFIG_f90
  ENDIF
  IF (UNINIT(VGCONFIG_fe4)) THEN
  VGCONFIG_fe4 = 5
  ELSE
  IF ((VGCONFIG_fe4 <= 0)) THEN
  VGCONFIG_fe4 = 5
  ENDIF
  ENDIF
  IF (UNINIT(VGCONFIG_fe8)) THEN
  VGCONFIG_fe8 = 30
  ELSE
  IF ((VGCONFIG_fe8 <= 0)) THEN
  VGCONFIG_fe8 = 30
  ENDIF
  ENDIF
  IF (UNINIT(VGCONFIG_fec)) THEN
  VGCONFIG_fec = 0
  ENDIF
  GET_TPE_PRM(1, 1, INTVAL1, REALVAL, STRVAL, STATUS)
  SELECT INTVAL1 OF
  CASE(1):
  IF ((VGCONFIG_f00 > 1)) THEN
  GET_TPE_PRM(2, 1, INTVAL2, REALVAL, STRVAL, STATUS)
  GET_TPE_PRM(3, 1, INTVAL3, REALVAL, STRVAL, STATUS)
  sv_i = VG_CYCEND2(INTVAL2, INTVAL3)
  -- stmt246 stray sv_i
  ENDIF
  CASE(2):
  IF ((VGCONFIG_fec <> 0)) THEN
  IF ((io_23[VGCONFIG_f90] <> 0)) THEN
  FORCE_SPMENU(1, 37, 1)
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'ISV_VG: Confirm all clear BEFORE press "OK"')
  sv_s = chr(128)
  sv_s = chr(137)
  WRITE(sv_s, sv_s, 'OK')
  -- stmt254 stray 129
  ENDIF
  ENDIF
  RETURN(0)
  ENDSELECT
END VG_RP

BEGIN
END ISV_VG
