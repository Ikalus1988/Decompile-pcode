ROUTINE ISV2_GIN(p0, p1 : INTEGER) : INTEGER
VAR
  r0_lc1 : INTEGER
  r0_lc2 : INTEGER
  r0_lc3 : INTEGER
BEGIN
  r0_lc1 = 0
  IF ((p0 > 0) AND (p1 > 0)) THEN
  r0_lc2 = 1
  FOR r0_lc3 = 1 TO 3 DO
  IF ((io_01[p0 + r0_lc3 - 1] <> 0)) THEN
  r0_lc1 = r0_lc1 + r0_lc2
  ENDIF
  r0_lc2 = r0_lc2 * 2
  ENDFOR
  ENDIF
  RETURN(r0_lc1)
  RETURN(0)
END ISV2_GIN

ROUTINE ISV2_GOUT(p0, p1, p2 : INTEGER) : INTEGER
VAR
  r1_lc1 : INTEGER
  r1_lc2 : INTEGER
  r1_lc3 : INTEGER
  r1_lc4 : INTEGER
BEGIN
  IF ((p0 > 0) AND (p1 > 0) AND (p2 >= 0)) THEN
  r1_lc1 = 1
  FOR r1_lc2 = 1 TO 3 DO
  r1_lc1 = r1_lc1 * 2
  ENDFOR
  IF ((p2 >= r1_lc1) OR (p2 < 0)) THEN
  ELSE
  r1_lc3 = p2
  FOR r1_lc2 = 1 TO 3 DO
  r1_lc4 = r1_lc3 MOD 2
  IF ((r1_lc4 = 1)) THEN
  io_02[p0 + r1_lc2 - 1] = 1
  ELSE
  io_02[p0 + r1_lc2 - 1] = 0
  ENDIF
  r1_lc3 = r1_lc3 DIV 2
  ENDFOR
  ENDIF
  ENDIF
  RETURN(0)
END ISV2_GOUT

ROUTINE ISV2_B2D1(p0, p1 : INTEGER) : REAL
VAR
  r2_lc1 : REAL
BEGIN
  IF ((p0 < 32768)) THEN
  r2_lc1 = p0 / p1
  ELSE
  r2_lc1 = 32768 - p0 / p1
  ENDIF
  RETURN(r2_lc1)
  RETURN(sv_r)
END ISV2_B2D1

ROUTINE ISV2_B2D(p0, p1 : INTEGER) : REAL
VAR
  r3_lc1 : REAL
BEGIN
  IF ((p0 < 32768)) THEN
  r3_lc1 = p0 + p1 / 10000
  ELSE
  r3_lc1 = 32768 - p0 - p1 / 10000
  ENDIF
  RETURN(r3_lc1)
  RETURN(sv_r)
END ISV2_B2D

ROUTINE ISV2_D2B(p0 : REAL; p1 : BOOLEAN) : INTEGER
VAR
  r4_lc1 : INTEGER
  r4_lc2 : INTEGER
  r4_lc3 : REAL
BEGIN
  IF ((p1 = 1)) THEN
  sv_i = trunc(p0)
  r4_lc1 = sv_i
  IF ((p0 < 0)) THEN
  r4_lc2 = 32768 - r4_lc1
  ELSE
  r4_lc2 = r4_lc1
  ENDIF
  RETURN(r4_lc2)
  IF ((p0 < 0)) THEN
  sv_i = trunc(p0)
  r4_lc3 = sv_i - p0
  ELSE
  sv_i = trunc(p0)
  r4_lc3 = p0 - sv_i
  ENDIF
  sv_i = trunc(r4_lc3 * 10000)
  r4_lc2 = sv_i
  RETURN(r4_lc2)
  ENDIF
  RETURN(0)
END ISV2_D2B

